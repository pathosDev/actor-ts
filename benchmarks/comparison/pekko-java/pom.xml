<?xml version="1.0" encoding="UTF-8"?>
<!--
  The second JVM arm of the framework comparison (#27).

  Pekko is the Apache-licensed fork of the other JVM framework's 2.6 line,
  taken up after that project moved to the Business Source Licence. Measuring
  both answers a question the licence change made real: what does staying on
  Apache-2.0 cost in throughput?

  Version 1.6.0 is the newest STABLE release. 2.0.0-M3 exists and is newer,
  and is deliberately not used: publishing a comparison against a milestone
  would compare a released framework to an unreleased one.

  Everything else mirrors ../akka deliberately — same Java sources modulo the
  package prefix, same hand-mirrored harness, same result schema. The two arms
  differing only in their dependency is the point: any gap between them is the
  fork, not the benchmark.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.actor-ts</groupId>
  <artifactId>comparison-pekko</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>actor-ts comparison — Pekko (JVM) arm</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <pekko.version>1.6.0</pekko.version>
    <scala.binary.version>2.13</scala.binary.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.pekko</groupId>
      <artifactId>pekko-actor-typed_${scala.binary.version}</artifactId>
      <version>${pekko.version}</version>
    </dependency>
    <!--
      A no-op SLF4J binding: without one the runtime prints a substitute-logger
      warning to stderr, with a real one the arm would be measuring its logger.
      Fairness rule 3 — logging off in every arm.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.16</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>comparison.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
