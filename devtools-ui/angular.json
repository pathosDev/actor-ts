{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "actor-ts-devtools-ui": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "devtools",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": ".angular-build",
              "browser": ""
            },
            "index": "index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [
              "src/styles/base.css"
            ],
            "scripts": [],
            "baseHref": "./"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "statsJson": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none",
              "outputPath": {
                "base": ".dev",
                "browser": ""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "actor-ts-devtools-ui:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "include": [
              "src/**/*.ng-spec.ts"
            ],
            "watch": false
          }
        }
      }
    }
  }
}
