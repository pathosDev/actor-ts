{"nodes": [{"id": "docs_src_content_docs_de_observability_devtools_profiler_profiler_panel", "label": "Profiler-Panel", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beantwortet beide Fragen: welcher Actor mit welcher Nachricht die Zeit ausmacht (Wallclock) und welche JavaScript-Frames CPU verbrennen (CPU)."}, {"id": "docs_src_content_docs_de_observability_devtools_profiler_wallclock_mode", "label": "Wallclock-Modus", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregierter Flame-Graph nach Actor-Pfad und Nachrichtentyp, schwerste Geschwister links. Gemessen wird mit den frameworkeigenen Per-Message-Zeiten hinter actor_message_handler_seconds \u2014 das Profil misst also, was das System getan hat, nicht was ein Sampler erwischt hat."}, {"id": "docs_src_content_docs_de_observability_devtools_profiler_cpu_mode", "label": "CPU-Modus", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Liefert ein normales V8-.cpuprofile, das das Panel bewusst nicht rendert \u2014 die Chrome DevTools koennen das besser. Es braucht node:inspector, deshalb fragt das Panel die Faehigkeit vorab ab und graut die Option mit Begruendung aus, statt erst beim Start zu scheitern."}, {"id": "docs_src_content_docs_de_observability_devtools_profiler_speedscope_export", "label": "Export nach speedscope", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wallclock erzeugt speedscope-JSON, das speedscope.app unveraendert oeffnet \u2014 praktisch fuer einen Bugreport oder zwei Laeufe nebeneinander."}, {"id": "docs_src_content_docs_de_observability_devtools_profiler_aggregated_not_timeline", "label": "Aggregiert, keine Zeitachse", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identische Stacks werden summiert; ein zehntausendmal aufgerufener Handler erscheint einmal, so breit wie seine Gesamtzeit. Fuer einen einzelnen Request ist das Tracing-Panel das richtige."}, {"id": "docs_src_content_docs_de_observability_devtools_profiler_single_session_constraint", "label": "Nur eine Session gleichzeitig", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zwei ueberlappende Profile saehen je einen Teil des Bildes und keines waere richtig. Eine Session, die weiterlaeuft, weil ein Tab geschlossen wurde, wird beim Detachen gestoppt \u2014 der Hook ueberlebt nie das, was ihn angefordert hat."}, {"id": "docs_src_content_docs_de_observability_devtools_profiler_profiler_cost", "label": "Kosten des Profilers", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Genau ein Observer auf dem Dispatch-Pfad fuer die Dauer einer Session, danach inklusive Wiederherstellung dessen, was vorher dort war; ausserhalb einer Session ein Null-Check pro Nachricht. durationMs ist bei zehn Minuten gedeckelt \u2014 ein Profiler ist eine Messung, kein Monitoring-Agent."}], "edges": [{"source": "docs_src_content_docs_de_observability_devtools_profiler_profiler_panel", "target": "docs_src_content_docs_de_observability_devtools_profiler_wallclock_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_profiler_profiler_panel", "target": "docs_src_content_docs_de_observability_devtools_profiler_cpu_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_profiler_wallclock_mode", "target": "docs_src_content_docs_de_observability_devtools_profiler_speedscope_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_profiler_aggregated_not_timeline", "target": "docs_src_content_docs_de_observability_devtools_profiler_wallclock_mode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_profiler_single_session_constraint", "target": "docs_src_content_docs_de_observability_devtools_profiler_profiler_panel", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_profiler_profiler_cost", "target": "docs_src_content_docs_de_observability_devtools_profiler_profil