{"nodes": [{"id": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "label": "Diagnose-nach-Symptom-Katalog", "file_type": "document", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jeder Abschnitt ist ein Symptom, die wahrscheinlichen Ursachen und was zu pruefen, loggen oder messen ist, um die Diagnose zu bestaetigen."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_cluster_bildet_sich_nicht", "label": "Symptom: Cluster bildet sich nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds unerreichbar, Cluster-Port via Firewall blockiert, unterschiedliche System-Namen, TLS-Fehlkonfiguration (Handshake scheitert lautlos). Pruefen, ob SelfUp feuert, und die Ausgabe des Seed-Providers ansehen."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_cluster_flappt", "label": "Symptom: Cluster flappt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zu enge Failure-Detector-Schwellen fuer den Netzwerk-Jitter, echte Netzwerk-Partitionen oder GC-Pausen laenger als die Unreachable-Schwelle."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_sharded_entities_spawnen_nicht", "label": "Symptom: Sharded Entities spawnen nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordinator noch nicht gestartet (Nachrichten werden gepuffert), keine Nodes matchen die role, oder extractEntityId liefert undefined. no-candidates im Log heisst, der role-Filter lehnt jeden Node ab."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_rebalance_storm", "label": "Symptom: Rebalance-Storm", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggressive Allocation-Strategy mit rebalanceThreshold 1 plus haeufige Mitgliedschaftsaenderungen, oder ein flappender Cluster - hoehere Schwelle senkt die Empfindlichkeit."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_langsamer_actor_start", "label": "Symptom: Actor braucht 30 Sekunden zum Starten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tiefes Journal ohne Snapshots - Recovery liest jedes jemals gespeicherte Event; bei P99-Recovery ueber 1 s eine Snapshot-Policy setzen."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_state_falsch_nach_recovery", "label": "Symptom: Events wiederhergestellt, aber State ist falsch", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onEvent hat einen Seiteneffekt, nutzt Date.now() oder Zufall, oder ein Schema wurde ohne Adapter geaendert."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_speicher_waechst", "label": "Symptom: Speicher waechst unbegrenzt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Mailbox mit langsamem Consumer (Default unbounded), Subscriber-Set-Leaks am Event-Stream oder DistributedPubSub, sich sammelnde DistributedData-Keys, persistente Puffer (Stash, Ask-Reply-To-Refs)."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_http_latenz_unter_last", "label": "Symptom: HTTP-Latenz unter Last hoch", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Actor monopolisiert die Event Loop und hungert HTTP-Handler aus."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_tests_haengen", "label": "Symptom: Tests haengen am Ende", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "await system.terminate() fehlt im Fixture-Teardown; geleakte Scheduler und Actor-Cells halten die Event Loop am Leben."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_shutdown_verwarf_nachrichten", "label": "Symptom: Shutdown hat meine Nachrichten verworfen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "terminate() leert zuerst die Actors unter /user, wartet aber nicht auf vier Dinge: abgelaufenes Drain-Budget, eine geparkte Mailbox (throttle oder Supervisor-Suspend), Arbeit, die noch in keiner Mailbox lag, und Nachrichten an /system."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_drain_budget", "label": "actor-ts.system.shutdown-drain-timeout", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 2 s; ein Actor, der beim Leeren immer neue Arbeit erzeugt, wird nie ruhig - nur das Budget beendet ihn. Mit ihm auch coordinated-shutdown.default-phase-timeout erhoehen."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_flaky_timing_tests", "label": "Symptom: Flaky timing-sensitive Tests", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die uebliche Ursache ist Real-Clock-Timing - ein fester Sleep, der auf einer unbeschaeftigten Maschine lang genug ist und auf einem ausgelasteten CI-Runner zu kurz; ManualScheduler oder auf beobachtbaren Zustand warten. Nicht die einzige Ursache, und zwischen ihnen zu raten kostet einen Nachmittag."}, {"id": "docs_src_content_docs_de_operations_troubleshooting_startpunkt_wenn_nichts_offensichtlich", "label": "Womit anfangen, wenn nichts offensichtlich ist", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERROR-Logs im Zeitfenster, Stock-Metriken auf Veraenderung, Cluster-Events am Event-Stream, der Trace-ID folgen, wenn moeglich in einem Multi-Node-Spec-Test reproduzieren."}], "edges": [{"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_cluster_bildet_sich_nicht", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_cluster_flappt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_sharded_entities_spawnen_nicht", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_rebalance_storm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_langsamer_actor_start", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_state_falsch_nach_recovery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_troubleshooting_speicher_waechst", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_troubleshooting_symptom_katalog", "target": "docs_src_content_docs_de_operations_tr