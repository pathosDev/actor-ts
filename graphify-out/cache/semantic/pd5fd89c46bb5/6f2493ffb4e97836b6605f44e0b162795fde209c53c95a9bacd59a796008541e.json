{"nodes": [{"id": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_service", "label": "k3s API Server Service", "file_type": "code", "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_brokers_k8s_docker_compose_k8s_k8s_runner_service", "label": "Kubernetes Runner Service", "file_type": "code", "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_over_kind_choice", "label": "k3s Chosen Over kind", "file_type": "rationale", "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kind needs nested Docker, which is brittle in CI and slow to boot; k3s is a single binary in one container that boots in ~5s and still presents the full K8s API, which is all the seed provider reads from."}, {"id": "tests_integration_brokers_k8s_docker_compose_k8s_privileged_test_container_tradeoff", "label": "Privileged Test Container Trade-Off", "file_type": "rationale", "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k3s server needs privileged to mount its own cgroups and iptables for kube-proxy; on a test-only container on a dev/CI host the security trade-off is accepted for the test scope."}, {"id": "tests_integration_brokers_k8s_docker_compose_k8s_kubeconfig_server_url_rewrite", "label": "Kubeconfig Server URL Rewrite", "file_type": "rationale", "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "k3s writes 127.0.0.1 into the kubeconfig \u2014 its own perspective \u2014 so the runner rewrites the server URL to the compose service name at runtime."}, {"id": "tests_integration_brokers_k8s_docker_compose_k8s_kubeconfig_shared_volume", "label": "Shared kubeconfig Volume", "file_type": "concept", "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The written kubeconfig file is both the handoff to the runner and the readiness signal: it appears when the API server is up."}], "edges": [{"source": "tests_integration_brokers_k8s_docker_compose_k8s_k8s_runner_service", "target": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_over_kind_choice", "target": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_service", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_k8s_docker_compose_k8s_privileged_test_container_tradeoff", "target": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_service", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/k8s/docker-compose.k8s.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_k8s_docker_compose_k8s_kubeconfig_server_url_rewrite", "target": "tests_integration_brokers_k8s_docker_compose_k8s_k8s_runner_service", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fil