{"nodes": [{"id": "docs_src_content_docs_serialization_overview_serializer_interface", "label": "Serializer interface", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deliberately small surface - id, name, includesManifest, manifest, toBinary, fromBinary - so encode, decode and identify are all a format has to supply."}, {"id": "docs_src_content_docs_serialization_overview_serialization_extension", "label": "SerializationExtension", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A registry mapping classes to serializer ids via register plus bind; its bindings are consulted only by ext.encode, and nothing in the framework calls that yet, so neither the wire nor the stores route through it (tracked in #450)."}, {"id": "docs_src_content_docs_serialization_overview_tagged_json_tree", "label": "Tagged JSON tree format", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One tree format shared by JsonSerializer, every journal, snapshot and durable-state store, and the cluster wire, so Date, Map, Set, bigint and Uint8Array round-trip everywhere without configuration."}, {"id": "docs_src_content_docs_serialization_overview_cluster_wire_framing", "label": "Cluster wire envelope framing", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cross-node tell wraps the message in an envelope, turns embedded ActorRefs into wire-safe markers, encodes the whole envelope as a tagged JSON tree and sends a length-prefixed frame; class identity is still lost because the only type hint is tag, the constructor name, and there is no serializerId or manifest framing on the wire."}, {"id": "docs_src_content_docs_serialization_overview_serialization_boundaries", "label": "Where serialization fires", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only at process, disk and cluster boundaries: the wire, journal events, durable state, snapshot writes and DistributedData. In-process tells hand the receiver the exact in-memory reference."}, {"id": "docs_src_content_docs_serialization_overview_wire_upgrade_hazard", "label": "The tagged-tree wire change is breaking in both directions", "file_type": "rationale", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moving the wire off raw JSON.stringify (#450) means an old node reads a tag wrapper as plain data, and a legacy body that already had a single-key __tag__ shape is silently reinterpreted (bad base64 becoming a Uint8Array, a junk string becoming an Invalid Date) or throws and costs the whole TCP connection - so only a plain-data cluster can roll node by node."}, {"id": "docs_src_content_docs_serialization_overview_json_or_cbor_choice", "label": "Picking JSON or CBOR", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CBOR is 20-40% smaller and faster on binary, JSON is trivially debuggable; for most apps the perf difference does not matter and debuggability wins."}], "edges": [{"source": "docs_src_content_docs_serialization_overview_serializer_interface", "target": "docs_src_content_docs_serialization_overview_serialization_extension", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_overview_serialization_extension", "target": "docs_src_content_docs_serialization_json_jsonserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_overview_serialization_extension", "target": "docs_src_content_docs_serialization_cbor_cborserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_overview_serialization_extension", "target": "docs_src_content_docs_serialization_custom_avroserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_overview_serialization_extension", "target": "docs_src_content_docs_serialization_custom_protobufserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_overview_cluster_wire_framing", "target": "docs_src_content_docs_serialization_overview_tagged_json_tree", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/overview.mdx", "source_location": null, "weight