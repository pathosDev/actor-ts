{"nodes": [{"id": "docs_src_content_docs_io_jetstream_jetstream", "label": "NATS JetStream", "file_type": "document", "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_jetstream_jetstreamactor", "label": "JetStreamActor", "file_type": "concept", "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_jetstream_ack_handshake", "label": "JetStream ack handshake", "file_type": "concept", "rationale": "With ackPolicy:'explicit' every delivered message must be resolved with exactly one of acknowledgment, negativeAcknowledgment or terminate, keyed by streamSeq; inProgress is non-terminal and resets the ack-wait timer so a slow handler is not redelivered mid-flight.", "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_jetstream_push_vs_pull_consumers", "label": "Push vs pull consumers", "file_type": "concept", "rationale": "Push is the natural fit for actor-style fan-out; pull lets the application self-pace with fetch(batch, expiresMs) and fits slow or bursty consumers better. A fetch sent to a push consumer is a no-op logged as a warning.", "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_jetstream_idempotent_publish", "label": "Idempotent JetStream publish", "file_type": "concept", "rationale": "messageId is sent as Nats-Msg-Id and dedupes re-publishes inside the stream's dedup window; expectedLastSeq gives optimistic concurrency by rejecting the publish if the stream head moved.", "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_jetstream_create_or_update_only", "label": "Create-or-update only, never delete", "file_type": "rationale", "rationale": "The actor only ever creates or updates streams and consumers at connect time; destroying a stream is an operator concern, not a runtime one.", "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_io_jetstream_jetstream", "target": "docs_src_content_docs_io_jetstream_jetstreamactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_jetstream_jetstream", "target": "docs_src_content_docs_io_jetstream_ack_handshake", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_jetstream_jetstream", "target": "docs_src_content_docs_io_jetstream_push_vs_pull_consumers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_jetstream_jetstream", "target": "docs_src_content_docs_io_jetstream_idempotent_publish", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/jetstream.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_jetstream_jetstream", "target": "docs_src_content_docs_io_jetstream_create_or_update_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source