{"nodes": [{"id": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_code_only_upgrade", "label": "Code-only-Upgrade", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": "Code-only-Upgrades", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neue Binary, gleiche Schemas - Gossip, Sharding-Rebalance und Coordinated Shutdown uebernehmen die Choreographie, Downtime null. Voraussetzungen: replicas >= 2 (ein Ein-Replica-Cluster kann nicht sauber drainen), vernuenftige Phasen-Timeouts, korrekt gatende Health-Checks."}, {"id": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_schema_breaking_upgrade", "label": "Schema-brechendes Upgrade", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": "Schema-brechende Upgrades", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Betrifft Event-Shapes, State-Shapes, Message-Shapes die Nodes im Rolling-Fenster austauschen, und zwischen Major-Versionen bewegte Config-Keys. Das Muster: die Aenderung additiv machen, dann upgraden. Schritt 1 und 3 in einen Deploy zusammenzulegen nimmt genau das Koexistenz-Fenster weg, das ein Rolling Update braucht."}, {"id": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_additive_change", "label": "Additive Event-Shapes (defaultsAdapter)", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": "Muster - additive Event-Shapes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schreibt V2, liest V1 mit gedefaultetem Feld, funktioniert in alten und neuen Clustern. Weil Schritt 1 additiv war, liest der vorherige Code die neuen Shapes - Rollback ist sicher. Ohne Adapter oder Default scheitern nach dem Deploy alle alten Events beim Deserialisieren."}, {"id": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_inter_actor_message_changes", "label": "Inter-Actor-Message-Aenderungen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": "Inter-Actor-Message-Aenderungen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waehrend eines Rolling Deployments senden alte Nodes v1 an neue und umgekehrt. Das neue Feld optional ergaenzen, im neuen Code defaulten, deployen - alt->neu funktioniert ohne das Feld, neu->alt ignoriert es. Erst wenn alles auf v2 ist, kann es in einem spaeteren Deployment required werden."}, {"id": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_rollback_strategy", "label": "Rollback-Strategie", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": "Rollback-Strategie", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code-only rollt einfach zurueck; schema-brechend ist sicher, WEIL Schritt 1 additiv war; nicht-additive Aenderungen brauchen einen Rollback-Schritt, der auch die neue Form kennt - dort Feature-Flags nutzen. Rollback in Staging ueben: Produktion ist nicht die Zeit herauszufinden, dass der Rollback bricht."}], "edges": [{"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_code_only_upgrade", "target": "docs_src_content_docs_de_operations_deployment_kubernetes_rolling_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_schema_breaking_upgrade", "target": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_additive_change", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_schema_breaking_upgrade", "target": "docs_src_content_docs_de_operations_upgrades_rolling_migration_migratingadapter_writeversion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_schema_breaking_upgrade", "target": "docs_src_content_docs_de_operations_upgrades_rolling_migration_four_phase_deploy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_rollback_strategy", "target": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_additive_change", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_inter_actor_message_changes", "target": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_code_only_upgrade", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_additive_change", "target": "docs_src_content_docs_de_operations_upgrades_upgrade_strategies_inter_actor_message_changes", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}