{"nodes": [{"id": "docs_src_content_docs_operations_troubleshooting_troubleshooting", "label": "Troubleshooting (page)", "file_type": "document", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_troubleshooting_cluster_wont_form", "label": "Symptom: cluster will not form", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds unreachable, cluster port firewalled, different system names, or TLS misconfiguration failing the handshake silently; check whether SelfUp fires and read the seed-provider output."}, {"id": "docs_src_content_docs_operations_troubleshooting_cluster_flaps", "label": "Symptom: cluster flaps", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tight failure-detector thresholds for the network jitter, real partitions, or GC pauses longer than the unreachable threshold."}, {"id": "docs_src_content_docs_operations_troubleshooting_sharded_entities_dont_spawn", "label": "Symptom: sharded entities do not spawn", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordinator not yet started, no node matching the role, or extractEntityId returning undefined."}, {"id": "docs_src_content_docs_operations_troubleshooting_rebalance_storm", "label": "Symptom: rebalance storm", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An aggressive allocation strategy with a threshold of 1 plus frequent membership changes, or a flapping cluster."}, {"id": "docs_src_content_docs_operations_troubleshooting_slow_actor_start_recovery", "label": "Symptom: actor takes 30 seconds to start", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deep journal without snapshots \u2014 recovery reads every event ever; set a snapshot policy when p99 recovery exceeds a second."}, {"id": "docs_src_content_docs_operations_troubleshooting_wrong_recovered_state", "label": "Symptom: events recovered but state is wrong", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A side effect in onEvent, non-determinism such as Date.now() or random during replay, or a schema change without an adapter."}, {"id": "docs_src_content_docs_operations_troubleshooting_unbounded_memory_growth", "label": "Symptom: memory grows unboundedly", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mailbox with a slow consumer, subscriber sets that never unsubscribe, DistributedData keys accumulating, or persistent stash and ask buffers."}, {"id": "docs_src_content_docs_operations_troubleshooting_http_latency_under_load", "label": "Symptom: HTTP latency high under load", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An actor monopolizing the event loop starves HTTP handlers; the fix is dispatcher-side."}, {"id": "docs_src_content_docs_operations_troubleshooting_tests_hang", "label": "Symptom: tests hang at the end", "file_type": "concept", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing await system.terminate() in fixture teardown leaves schedulers and cells keeping the loop alive."}, {"id": "docs_src_content_docs_operations_troubleshooting_shutdown_dropped_messages", "label": "Symptom: shutdown dropped my messages", "file_type": "rationale", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "terminate() drains /user first, but not past the drain budget, not a parked mailbox (a throttle or a suspended mailbox counts as quiet), not work not yet in a mailbox, and not anything addressed to /system. Subscribing to DeadLetter has to happen before shutting down, because publishing is all that happens by default."}, {"id": "docs_src_content_docs_operations_troubleshooting_flaky_timing_tests", "label": "Symptom: flaky timing-sensitive tests", "file_type": "rationale", "source_file": "docs/src/content/docs/operations/troubleshooting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The usual cause is a fixed sleep long enough on an idle machine and too short on a loaded runner \u2014 but guessing between causes wastes an afternoon, so use the repeat-run harness that separates a flake from a broken test."}], "edges": [{"source": "docs_src_content_docs_operations_troubleshooting_troubleshooting", "target": "docs_src_content_docs_operations_troubleshooting_cluster_wont_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_f