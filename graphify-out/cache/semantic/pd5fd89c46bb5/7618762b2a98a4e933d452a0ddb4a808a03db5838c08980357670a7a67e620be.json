idence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockwireformat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockgc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclocksizecost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_overview_replicatedeventsourcing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## How replicated ES uses them", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "targ