{"nodes": [{"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "label": "VectorClock", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A logical timestamp distributed across replicas - a per-replica counter embedded in every persisted event. Comparing two clocks yields happens-before, equal, or concurrent; the third case is what detects 'two replicas wrote independently and neither saw the other'."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "label": "VectorClockData", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## The data shape", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readonly<Record<ReplicaId, number>> - a plain object where missing replicas are treated as 0, which keeps zero components off the wire."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclocktick", "label": "tick(replicaId)", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Operations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bumps this replica's component; called on every persist."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockmerge", "label": "merge(other)", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Operations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-replica max."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockcompareto", "label": "compareTo(other)", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Operations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 'before' / 'after' / 'equal' / 'concurrent' - the comparison the whole machinery is built on."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_concurrencydetection", "label": "Concurrency detection loop", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## How replicated ES uses them", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On persist increment this replica's component and embed the full clock; on reading another replica's event compare the embedded clock to local state's - concurrent invokes the resolver, causally prior is ignored or folded, causally later is applied."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_partialorder", "label": "Causality is partial-ordered", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Causality is partial-ordered", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector clocks give no total order: { A: 5 } and { B: 5 } are concurrent and their journal order is incidental. That is the whole point - replicas write independently and clocks track causality, not wall-clock time. For a total order, pair with a single-writer lease."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_replicaidstability", "label": "Replica IDs must be stable forever", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Replica IDs must be stable forever", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A replica's id is part of the vector clock, so restarting with a new id makes the instance look like a different replica while old clocks still carry the old id's entries. Use stable ids (pod name plus region)."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockwireformat", "label": "_vc wire format", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Wire format", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector clocks serialize as plain JSON objects under `_vc`, with zero components omitted. The actor's current clock has no public getter, so diagnostics read it out of the journal or snapshot JSON rather than off the actor."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockgc", "label": "Vector-clock garbage collection is out of scope for v1", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Garbage collection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The framework never prunes retired replicas' entries, so a clock grows with every replica it has ever seen. Fine for a stable cluster; compaction for churn-heavy deployments is future work rather than a supported feature."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclocksizecost", "label": "Vector-clock size grows with replica count", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": "## Vector clock size grows with replica count", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each event carries the full clock, so 50 replicas mean up to 50 entries per event of wire and storage overhead. Most deployments have 10 or fewer replicas."}], "edges": [{"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclocktick", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockmerge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_vector_clocks_vectorclockcompareto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, 