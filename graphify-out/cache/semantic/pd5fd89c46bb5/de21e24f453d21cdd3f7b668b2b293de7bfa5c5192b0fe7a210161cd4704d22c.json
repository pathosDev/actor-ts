{"nodes": [{"id": "docs_src_content_docs_de_io_overview_broker_actor_muster", "label": "Das gemeinsame Broker-Actor-Muster", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes Protokoll wird in einen Actor verpackt, der es hinter einem einheitlichen Vertrag verbirgt: Connect bei preStart, Events an Subscriber, Puffern bei Trennung, Reconnect mit Backoff, Lifecycle-Events auf dem Event-Stream."}, {"id": "docs_src_content_docs_de_io_overview_broker_katalog", "label": "Katalog der ausgelieferten Broker-Actors", "file_type": "document", "source_file": "docs/src/content/docs/de/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_overview_kafkaactor", "label": "KafkaActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_overview_mqttactor", "label": "MqttActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_overview_natsactor", "label": "NatsActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_overview_amqpactor", "label": "AmqpActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_overview_jetstreamactor", "label": "Jet