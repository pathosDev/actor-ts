{"nodes": [{"id": "docs_src_content_docs_cluster_singleton_overview_clustersingleton", "label": "Cluster singleton", "file_type": "concept", "rationale": "Exactly one actor instance cluster-wide, for invariants that need a single source of truth \u2014 a coordinator, an external-resource owner, a leader-elected service.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_clustersingletonproxy", "label": "ClusterSingletonProxy", "file_type": "code", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_clustersingletonmanager", "label": "ClusterSingletonManager", "file_type": "code", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_singletonkey", "label": "SingletonKey", "file_type": "code", "rationale": "Declaring it as a static readonly field ties the singleton's name to its message type so neither is repeated at the call site; the explicit type argument is load-bearing or every ref degrades to ActorRef<unknown>.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_buffersize", "label": "bufferSize (proxy buffer)", "file_type": "concept", "rationale": "Bounds what the proxy holds while no node hosts the singleton \u2014 normally a gossip round, unbounded in an outage \u2014 so past the cap (default 1000) messages dead-letter with a warning instead of growing forever. It drains on any cluster event that can have produced a host, not only a leader change.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_ref_without_hosting", "label": "Getting a ref without hosting", "file_type": "rationale", "rationale": "start puts a node into rotation, ref only addresses the singleton; both return the same memoised ref, and ref.stop() is a warning no-op because it would otherwise kill whatever the current host is running.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_no_singletonactor_interface", "label": "There is deliberately no SingletonActor interface", "file_type": "rationale", "rationale": "TypeScript's implements constrains only the instance side and abstract static is a compile error, so a marker interface would be structurally empty. A static field is the carrier that works and composes with any base class; enforcement happens at the start call site.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_failover", "label": "Singleton failover", "file_type": "rationale", "rationale": "Detection, election, spawn, routing shift \u2014 bounded by the failure detector's timeout. Singletons trade unavailability during failover for the exactly-one invariant.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_state_across_failover", "label": "State across failover", "file_type": "rationale", "rationale": "The new instance starts clean, so state must survive through PersistentActor, DurableState, or DistributedData when it has to be readable before the singleton restarts.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_overview_singleton_cost", "label": "Singleton cost", "file_type": "rationale", "rationale": "A manager on every node, a proxy hop on every tell, and a few seconds of unavailability per leader change; a singleton is a scalar, so throughput is capped at one actor no matter the cluster size.", "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_singleton_overview_clustersingleton", "target": "docs_src_content_docs_cluster_singleton_overview_clustersingletonmanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_clustersingleton", "target": "docs_src_content_docs_cluster_singleton_overview_clustersingletonproxy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_clustersingleton", "target": "docs_src_content_docs_cluster_singleton_overview_singletonkey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_clustersingletonproxy", "target": "docs_src_content_docs_cluster_singleton_overview_buffersize", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_ref_without_hosting", "target": "docs_src_content_docs_cluster_singleton_overview_clustersingletonproxy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_no_singletonactor_interface", "target": "docs_src_content_docs_cluster_singleton_overview_singletonkey", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_failover", "target": "docs_src_content_docs_cluster_singleton_overview_clustersingleton", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_state_across_failover", "target": "docs_src_content_docs_cluster_singleton_overview_failover", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_overview_singleton_cost", "target": "docs_src_content_docs_cluster_singleton_overview_clustersingleton", "relation": "rationale_for", "confidence": "EXTR