{"nodes": [{"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "label": "SqliteSnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots in a SQLite file - durable, zero-dependency on Bun, peer-dep on Node. Paired with SqliteJournal it is the standard single-node production setup."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstoreoptions", "label": "SqliteSnapshotStoreOptions", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "## Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "path, snapshotsTable, keepN, busyTimeoutMs and driver. There is deliberately no `wal` option here, unlike the journal."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitebusytimeout", "label": "busyTimeoutMs has a framework-set default", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "## Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The drivers ship different ones - 0 ms on bun:sqlite and node:sqlite, 5000 ms on better-sqlite3 - and the lock wait is synchronous, so it blocks the event loop. The framework picks one rather than inheriting whichever driver is present."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitekeepn", "label": "keepN retention (SQLite)", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "## Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maximum snapshots retained per persistenceId, older ones pruned on each save; default 3."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotschema", "label": "snapshots SQL table keyed (persistence_id, sequence_nr)", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "## Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same pattern as the journal; loadLatest reads the highest sequence_nr for a persistence_id."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqliteseparatefiles", "label": "Journal and snapshot store as independent files", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "## Pairing with the journal", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They can share one file with different table names, but two files keep operations simpler - back up and vacuum independently."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotperformance", "label": "SQLite snapshot performance", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": "## Performance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write is a single INSERT (~100 us) dominated by serialization rather than SQLite I/O; read is a single sub-millisecond SELECT. For multi-MB state, serialization is the bottleneck."}], "edges": [{"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstoreoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitebusytimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitekeepn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotschema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqliteseparatefiles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotperformance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "doc