{"nodes": [{"id": "docs_src_content_docs_persistence_journals_mongodb_mongojournal", "label": "MongoJournal", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_mongosnapshotstore", "label": "MongoSnapshotStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_mongodurablestatestore", "label": "MongoDurableStateStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_mongoquery", "label": "MongoQuery", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_registermongoplugins", "label": "registerMongoPlugins", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_unique_index_is_load_bearing", "label": "The unique index is load-bearing", "file_type": "rationale", "rationale": "The unique compound index on (persistenceId, sequenceNr) is not a performance tweak \u2014 it IS the journal's optimistic-concurrency backstop, playing the part a primary key plays in the relational backends. Without it a racing writer silently overwrites an event, so autoCreateIndexes:false means 'I created them myself', not 'I don't need them'.", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_no_transactions_required", "label": "No transactions required", "file_type": "rationale", "rationale": "Multi-document transactions would need a replica set, so the backend deliberately avoids them and works on a standalone mongod. It is sound rather than lucky: appends are contiguous from the head, so the losing writer's insertMany fails on its very first document and ordered:true stops the batch there. A dropped connection mid-batch can still persist a prefix.", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_multikey_tag_index", "label": "Multikey tag index", "file_type": "rationale", "rationale": "Because tags is an array, MongoDB indexes it as a multikey index \u2014 one entry per tag per event \u2014 so a query on one tag plus a timestamp lower bound walks a contiguous range instead of scanning. Cross-tag all/any/not are refined in memory, and a filter with only not falls back to the journal-walking scan.", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_mongodb_7_bun_incompatibility", "label": "mongodb@7 cannot be imported on Bun", "file_type": "rationale", "rationale": "Version 7 bundles a bson that calls v8.startupSnapshot.isBuildingSnapshot() at module scope, which Bun does not implement, so the import throws ERR_NOT_IMPLEMENTED before any framework code runs. The peer range is pinned to ^6, which imports cleanly on Bun, Node and Deno alike.", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mongodb_payloads_are_json_text", "label": "Payloads are JSON text, not BSON documents", "file_type": "rationale", "rationale": "BSON would reject or mangle a payload whose keys contain a dot or start with $, and would quietly change how undefined and dates come back. Storing JSON text keeps fidelity and makes an event stream mean the same thing on every backend; the framework never queries inside a payload anyway.", "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_journals_mongodb_mongojournal", "target": "docs_src_content_docs_persistence_overview_journal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_mongosnapshotstore", "target": "docs_src_content_docs_persistence_overview_snapshotstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_mongodurablestatestore", "target": "docs_src_content_docs_persistence_overview_durablestatestore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_registermongoplugins", "target": "docs_src_content_docs_persistence_journals_mongodb_mongojournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_registermongoplugins", "target": "docs_src_content_docs_persistence_journals_mongodb_mongosnapshotstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_registermongoplugins", "target": "docs_src_content_docs_persistence_journals_mongodb_mongodurablestatestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_mongoquery", "target": "docs_src_content_docs_persistence_journals_mongodb_mongojournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_unique_index_is_load_bearing", "target": "docs_src_content_docs_persistence_journals_mongodb_mongojournal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mongodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mongodb_no_transactions_required", "target": "docs_src_content_docs_persistence_journals_mongodb_mongojournal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "