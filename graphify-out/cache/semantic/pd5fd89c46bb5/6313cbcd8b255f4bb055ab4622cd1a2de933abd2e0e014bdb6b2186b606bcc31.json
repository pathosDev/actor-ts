{"nodes": [{"id": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "label": "ProducerController", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Umwickelt ausgehende Nachrichten, vergibt Sequence Numbers und haelt sie bis zum ACK; nur fuer Streams nehmen, in denen Verlust inakzeptabel ist (~50us Overhead pro Nachricht gegenueber rohem tell)."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_producercontrolleroptions", "label": "ProducerControllerOptions", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_delivery_producer_controller_windowsize", "label": "windowSize (Flow-Control-Window)", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 16 unbestaetigte In-Flight-Nachrichten; darueber hinaus wird eingereiht statt gesendet."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_resendtimeout", "label": "resendTimeout", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_delivery_producer_controller_producerid", "label": "producerId", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stabiler Identifier fuer Logs, Metriken und die Dedup-Map des Consumers; traegt aber KEIN Dedup-Fenster ueber einen Restart."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_incarnation", "label": "Producer-Inkarnation", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nicht erratbares Token pro Konstruktion, weil producerId zwei Fragen nicht beantworten kann: (1) Retransmit oder neu gestarteter Producer - ein Consumer, der nur an producerId festmacht, absorbierte das ganze Praefix nach dem Restart als Duplikate und meldete es trotzdem als zugestellt; (2) kam das Ack von einem echten Delivery - producerId und seq sind beide erratbar, das Token verlaesst den Producer nur auf tatsaechlich gesendeten Deliveries."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_retransmission", "label": "Retransmission", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retransmits nutzen dieselbe Seq und dieselbe Inkarnation, damit der Consumer sie als dieselbe Nachricht erkennt."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_confirm_callback", "label": "confirm-Callback beim Send", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein reliable-delivery.send ist Fire-and-Forget - es gibt kein ask-basiertes ACK; der confirm-Callback ist der einzige Rueckkanal (null bei Erfolg, Error wenn der Producer mit wartender Nachricht stoppt)."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_backpressure", "label": "Backpressure durch Queuing", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt kein Signal zurueck an den Caller, wenn eingereiht wird; echtes Backpressure entsteht erst, wenn der Sender sein Tempo an den confirm-Bestaetigungen ausrichtet."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_consumercontroller", "label": "ConsumerController", "file_type": "code", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jeder ProducerController ist 1:1 mit einem ConsumerController; Fan-out braucht mehrere Producer oder einen eigenen Router."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_at_least_once", "label": "At-least-once-Vertrag", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_delivery_producer_controller_in_memory_buffer", "label": "In-Memory-Buffer des Producers", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Buffer liegt lokal und ist in-memory - ausreichend fuer ephemere Streams; fuer Durability den Producer in ein PersistentActor-Muster wickeln, sonst sind unbestaetigte Nachrichten beim Crash verloren."}], "edges": [{"source": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "target": "docs_src_content_docs_de_delivery_producer_controller_producercontrolleroptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location":