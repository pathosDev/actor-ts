{"nodes": [{"id": "docs_src_content_docs_de_io_websocket_websocketclientactor", "label": "WebsocketClientActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oeffnet eine clientseitige WebSocket-Verbindung. Die Typparameter sind aus Sicht des Clients zu lesen: TOut sind die Nachrichten, die dieser Client sendet, TIn die dekodierten Server-Nachrichten."}, {"id": "docs_src_content_docs_de_io_websocket_websocketclientoptionstype", "label": "WebsocketClientOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nur url ist erforderlich; alles andere hat einen Default. Da die Settings BrokerCommonOptionsType erweitern, gelten reconnect, outboundBuffer und circuitBreaker mit."}, {"id": "docs_src_content_docs_de_io_websocket_websocket_codecs", "label": "WebSocket-Codecs", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jsonCodec() ist der Default (Text-Frames <-> JSON, optional mit Runtime-Validierung); rawCodec() ist die Ausweichluke fuer Binaerprotokolle, bei der TOut = TIn = WebsocketFrame."}, {"id": "docs_src_content_docs_de_io_websocket_websocketframe", "label": "WebsocketFrame", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_websocket_websocketsend_helper", "label": "websocketSend-Helper", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Andere Actors rufen send nicht direkt auf, sondern pushen einen typisierten Send ueber die Ref."}, {"id": "docs_src_content_docs_de_io_websocket_ws_hooks", "label": "Hooks des WebSocket-Clients", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onMessage ist abstrakt; onConnected (Handshake / Re-Subscribe), onDisconnected, onInvalidMessage und onSelfMessage sind optionale Overrides."}, {"id": "docs_src_content_docs_de_io_websocket_maxframebytes_enforcement", "label": "maxFrameBytes am rohen Frame", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Groessenlimit wird am rohen Frame vor dem Dekodieren durchgesetzt; ein zu grosser Frame wird mit einer Warnung verworfen, eine pro Frame."}, {"id": "docs_src_content_docs_de_io_websocket_redacted_url_label", "label": "redactedUrlLabel", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weil das Gegenueber bestimmt, wie oft die Oversize-Warnung geschrieben wird, benennt sie die Verbindung mit einem redigierten Label statt mit url: Userinfo und Query-String fallen weg (ein WS-Endpunkt wird ueblicherweise mit ?token=... authentifiziert), der Pfad bleibt, weil er zwei Verbindungen zum selben Host unterscheidet."}, {"id": "docs_src_content_docs_de_io_websocket_application_level_ping", "label": "Ping auf Anwendungsebene", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verhindert, dass zwischengeschaltete Proxies und Load-Balancer Idle-Verbindungen schliessen. Der Protokoll-Ping (Control-Frame) ist separat und Sache der Runtime; der Anwendungs-Ping ist fuer Proxies, die Payloads inspizieren, keine Frames."}, {"id": "docs_src_content_docs_de_io_websocket_no_custom_handshake_headers", "label": "Keine eigenen Handshake-Header", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Client nutzt das native WebSocket der Runtime (keine ws-Peer-Dependency) und erlaubt deshalb, genau wie die Browser-API, keine eigenen Handshake-Header. Credentials gehen per Query-Parameter oder Subprotocol."}, {"id": "docs_src_content_docs_de_io_websocket_renamed_from_websocketactor", "label": "Umbenannt von WebsocketActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Command-Schnittstelle ({ kind: subscribe | send }) ist weg: onMessage implementieren, this.send(message) rufen, typisierte Sends aus anderen Actors ueber websocketSend pushen."}], "edges": [{"source": "docs_src_content_docs_de_io_websocket_websocketclientactor", "target": "docs_src_content_docs_de_io_websocket_websocketclientoptionstype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_websocketclientactor", "target": "docs_src_content_docs_de_io_websocket_websocket_codecs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_websocketclientactor", "target": "docs_src_content_docs_de_io_websocket_ws_hooks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_websocketclientactor", "target": "docs_src_content_docs_de_io_websocket_websocketsend_helper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_websocket_codecs", "target": "docs_src_content_docs_de_io_websocket_websocketframe", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_maxframebytes_enforcement", "target": "docs_src_content_docs_de_io_websocket_websocketclientactor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_redacted_url_label", "target": "docs_src_content_docs_de_io_websocket_maxframebytes_enforcement", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_application_level_ping", "target": "docs_src_content_docs_de_io_websocket_websocketclientactor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_websocket_no_custom_handshake_headers", "target": "docs_src_content_docs_de_io_websocket_