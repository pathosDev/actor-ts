{"nodes": [{"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_timerscheduler", "label": "TimerScheduler (context.timers)", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default for actor-internal timers: auto-cancels on stop and on restart, fires by telling this.self so the work is serialized with the actor other messages, supervised by its supervisor and visible in traces."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_scheduler", "label": "system.scheduler (Scheduler)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three legitimate cases: initiating work from outside the actor world, work that must outlive a specific actor, and framework code with no actor context."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_timer_keys", "label": "String-keyed timers", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-starting the same key replaces the existing timer instead of adding a duplicate fire, which is what makes reset-on-activity patterns work; cancelAll runs automatically on postStop."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_cancellable", "label": "Cancellable", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_manualscheduler", "label": "ManualScheduler", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implements the same Scheduler interface but only advances on advance(ms), making time deterministic in tests; context.timers respects it through the system Scheduler injection."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_schedulererror", "label": "SchedulerError", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The function-form schedules run in a raw timer callback with no cell and no supervisor above them, so a throw is caught and reported twice over \u2014 system logger plus event stream \u2014 instead of escalating; a repeating schedule keeps ticking past it. The message-delivery forms never publish one, because a throw inside the target handler is the parent business."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_tick_no_mdc", "label": "A tick carries no diagnostic context", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whatever armed a schedule, the schedule does not belong to it. Without this, one setInterval armed while handling one tenant request would pin that tenant identifiers to every tick for the life of the process and \u2014 because a tell re-snapshots its context \u2014 forward them to whoever the tick messaged next."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_fixed_rate_semantics", "label": "Fixed-rate semantics (no catch-up, no compression)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A still-queued tick when the next interval elapses gives two ticks in the mailbox; there is no built-in missed-firing detection \u2014 record the last-fire timestamp yourself."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_raw_settimeout_antipattern", "label": "Raw setTimeout inside onReceive", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs outside the message-processing turn, escapes supervision, and can fire after the actor stopped with this.context operating on a destroyed cell."}, {"id": "docs_src_content_docs_fundamentals_timers_and_scheduling_high_frequency_timer_pressure", "label": "High-frequency timers are mailbox pressure", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pick an interval slower than the worst-case handler latency, or bound the mailbox and accept dropped ticks \u2014 mailboxes are unbounded, so the queue grows until the heap does."}], "edges": [{"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_timerscheduler", "target": "docs_src_content_docs_fundamentals_timers_and_scheduling_timer_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_scheduler", "target": "docs_src_content_docs_fundamentals_timers_and_scheduling_cancellable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_scheduler", "target": "docs_src_content_docs_fundamentals_timers_and_scheduling_schedulererror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_schedulererror", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatchererror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_scheduler", "target": "docs_src_content_docs_fundamentals_timers_and_scheduling_manualscheduler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_timerscheduler", "target": "docs_src_content_docs_fundamentals_timers_and_scheduling_manualscheduler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_timers_and_scheduling_timerscheduler", "target": "docs_src_content_docs_fundamentals_timers_and_scheduling_fixed_rate_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fu