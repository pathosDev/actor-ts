{"nodes": [{"id": "docs_src_content_docs_observability_devtools_profiler_profiler", "label": "Profiler panel", "file_type": "document", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_devtools_profiler_wallclock_mode", "label": "Wallclock profiling mode", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Groups by actor path then message type, always available. The timings are the framework own per-message measurements, so the profile measures what the actor system actually did rather than what a sampler happened to catch."}, {"id": "docs_src_content_docs_observability_devtools_profiler_cpu_mode", "label": "CPU profiling mode", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hands back a standard V8 cpuprofile that the panel deliberately does not render - Chrome DevTools does that better than a bundled UI would. It needs node:inspector, so the panel asks before offering the mode and greys it out with the reason rather than failing at start."}, {"id": "docs_src_content_docs_observability_devtools_profiler_aggregated_flame_graph", "label": "Aggregated flame graph", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This flame graph has no clock: identical stacks are summed, so a handler called ten thousand times appears once, as wide as the time it consumed in total. Use the tracing panel when you care about a single request and this one when you care about the whole system."}, {"id": "docs_src_content_docs_observability_devtools_profiler_heaviest_handlers", "label": "Heaviest handlers ranking", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranks the leaves by their own time - the shortest route from something is slow to this handler is slow."}, {"id": "docs_src_content_docs_observability_devtools_profiler_single_profiling_session", "label": "One profiling session at a time", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two overlapping profiles would each see part of the picture and neither would be right. A session left running because a browser tab closed is stopped when DevTools detaches, so the hook never outlives the thing that asked for it, and sessions can auto-stop after a duration capped at ten minutes because a profiler is a measurement, not a monitoring agent."}, {"id": "docs_src_content_docs_observability_devtools_profiler_speedscope_export", "label": "Speedscope export", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wallclock produces speedscope JSON that speedscope.app opens unchanged - useful for keeping a profile alongside a bug report or comparing two runs."}], "edges": [{"source": "docs_src_content_docs_observability_devtools_profiler_profiler", "target": "docs_src_content_docs_observability_devtools_profiler_wallclock_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_profiler_profiler", "target": "docs_src_content_docs_observability_devtools_profiler_cpu_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_profiler_profiler", "target": "docs_src_content_docs_observability_devtools_profiler_aggregated_flame_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_profiler_profiler", "target": "docs_src_content_docs_observability_devtools_profiler_heaviest_handlers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_profiler_profiler", "target": "docs_src_content_docs_observability_devtools_profiler_single_profiling_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_profiler_profiler", "target": "docs_src_content_docs_observability_devtools_profiler_speedscope_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/profiler.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_profiler_aggregated_flame_graph", "target": "docs_src_content_docs_observability_devtools_profiler