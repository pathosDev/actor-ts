{"nodes": [{"id": "docs_src_content_docs_de_runtime_overview_runtime_erkennung", "label": "Runtime-Erkennungs-Modell", "file_type": "concept", "rationale": "Beim Modul-Laden wird auf Bun, dann Deno, dann process geprueft; spezifische Subsysteme (SQLite, TCP, fs) haben eigene Adapter-Dateien, die jeweils selbst erkennen und waehlen. Ergebnis: KEIN Runtime-Flag \u2014 derselbe Code passt sich der startenden Runtime an.", "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_runtime_overview_drei_runtimes", "label": "Drei Ziel-Runtimes", "file_type": "concept", "rationale": "Bun primaer, Node voll unterstuetzt (better-sqlite3 als Peer-Dep), Deno Best-Effort. Fuer den meisten Code unterscheidet sich nichts \u2014 Actor-Lebenszyklus, Cluster-Gossip, Persistenz, HTTP und die meisten Broker sind runtime-blind.", "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_runtime_overview_runtime_unterschiede", "label": "Was sich zwischen Runtimes unterscheidet", "file_type": "concept", "rationale": "SQLite (bun:sqlite / better-sqlite3 / nicht unterstuetzt), TCP (Bun.connect / node:net / Deno.connect), WebSocket-Server (Bun.serve / ws / Deno.serve via Hono), File-I/O und Test-Runner.", "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_runtime_overview_cross_runtime_cluster", "label": "Cross-Runtime-Cluster", "file_type": "concept", "rationale": "Gossip und Transport sind wire-format-kompatibel ueber alle drei, ein gemischter Cluster ist also moeglich \u2014 vor allem nuetzlich fuer graduelle Migration. In der Praxis eine Runtime pro Cluster bevorzugen, weil Mischen das Debuggen erschwert (andere Stack-Traces, Fehlermeldungen, Perf-Profile).", "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_runtime_overview_runtime_pinning", "label": "Runtime-Versionen pinnen", "file_type": "rationale", "rationale": "Im Container-Image ein explizites Tag statt latest. Patch- und Minor-Upgrades sind drop-in; Major-Upgrades und ein Wechsel Bun<->Node brauchen einen vollen Workload-Test, weil das Perf-Profil sich unterscheidet.", "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_runtime_overview_drei_runtimes", "target": "docs_src_content_docs_de_runtime_bun_bun", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_runtime_overview_drei_runtimes", "target": "docs_src_content_docs_de_runtime_node_node", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_runtime_overview_drei_runtimes", "target": "docs_src_content_docs_de_runtime_deno_deno", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_runtime_overview_drei_runtimes", "target": "docs_src_content_docs_de_runtime_compatibility_matrix_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_runtime_overview_runtime_erkennung", "target": "docs_src_content_docs_de_runtime_overview_runtime_unterschiede", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_runtime_overview_cross_runtime_cluster", "target": "docs_src_content_docs_de_serialization_overview_cluster_wire", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_runtime_overview_runtime_pinning", "target": "docs_src_content_docs_de_runtime_compatibility_matrix_version_pinning", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/de/runtime/overview.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}