{"nodes": [{"id": "docs_src_content_docs_de_persistence_overview_persistentactor", "label": "PersistentActor (Event Sourcing)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gewinnt, wenn die Historie wichtig ist, der State gross aber die Aenderungen klein sind, Projektionen gebraucht werden, oder Schema-Evolution ein langes Spiel ist."}, {"id": "docs_src_content_docs_de_persistence_overview_durablestateactor", "label": "DurableStateActor (Durable State)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gewinnt, wenn die Historie nicht nuetzlich ist, der State klein und einfach ist, oder optimistische Concurrency ueber den Revision Counter gebraucht wird."}, {"id": "docs_src_content_docs_de_persistence_overview_event_sourcing_vs_durable_state", "label": "Entscheidungsbaum Event Sourcing vs. Durable State", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erste Frage: brauchst du eine Historie der Zustandsaenderungen? Zweite: ist der State einfach und klein genug, dass das Neuschreiben des Ganzen bei jeder Aenderung okay ist? Viele Produktionssysteme mischen beides."}, {"id": "docs_src_content_docs_de_persistence_overview_journal", "label": "Journal (Append-only Event-Log)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Journal.read() ist die Methode, deren Vertrag der Replay einfordert: aufsteigende Sequenznummern, lueckenlos, im angefragten Fenster. delete() kompaktiert nur ein Praefix, nie ein Loch - eine Luecke kann also nur ein Defekt sein."}, {"id": "docs_src_content_docs_de_persistence_overview_durablestatestore", "label": "DurableStateStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_overview_snapshotstore", "label": "SnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_overview_journalintegrityerror", "label": "JournalIntegrityError", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_overview_durablestateconcurrencyerror", "label": "DurableStateConcurrencyError", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_overview_backend_matrix", "label": "Backend-Matrix (Journal / Durable State / Snapshot / Tag-Index)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CockroachDB und YugabyteDB sind keine eigenen Backends - sie sprechen das PostgreSQL-Wire-Protokoll. SQLite laeuft auf jeder Runtime, seit der eingebaute node:sqlite-Treiber dazugekommen ist."}, {"id": "docs_src_content_docs_de_persistence_overview_indexed_tag_query", "label": "Indizierte Tag-Query vs. Polling-Scan", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beschreibt, was currentEventsByTag in den Storage hinunterdruecken kann: ein Backend mit Tag-Index laeuft ihn ab, die uebrigen scannen das Journal und verfeinern im Speicher - korrekt in beiden Faellen, aber nur mit Index in den Kosten begrenzt."}, {"id": "docs_src_content_docs_de_persistence_overview_tagged_json_tree_format", "label": "Getaggtes JSON-Tree-Format fuer alle Payloads", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes Backend speichert im selben Format, sodass Date / Map / Set / bigint / Uint8Array ueberall round-trippen."}, {"id": "docs_src_content_docs_de_persistence_overview_projection", "label": "Projektion (Read-Side-View)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entkoppelt Writes vom Journal des PersistentActor von Reads der Projektions-View; die Read-Seite kann fuer ihre Query-Muster denormalisiert werden."}, {"id": "docs_src_content_docs_de_persistence_overview_when_not_to_persist", "label": "Wann NICHT persistieren", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache-artige Actors (per Definition neu aufbaubar - Speicherkosten verdoppelt ohne Recovery-Nutzen), winziger State ohne Failover-Anforderung, und reine Transformations-Actors ohne internen State."}], "edges": [{"source": "docs_src_content_docs_de_persistence_overview_e