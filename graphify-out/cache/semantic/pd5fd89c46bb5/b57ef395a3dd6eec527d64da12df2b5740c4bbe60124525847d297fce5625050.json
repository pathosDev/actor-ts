{"nodes": [{"id": "docs_src_content_docs_persistence_journals_mariadb_mariadbjournal", "label": "MariaDbJournal", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mariadb_mariadbsnapshotstore", "label": "MariaDbSnapshotStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mariadb_mariadbdurablestatestore", "label": "MariaDbDurableStateStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mariadb_mariadbquery", "label": "MariaDbQuery", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mariadb_registermariadbplugins", "label": "registerMariaDbPlugins", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mariadb_contention_backstop_classification", "label": "Contention backstop classification (ER_CHECKREAD 1020)", "file_type": "rationale", "rationale": "Under real contention InnoDB aborts the loser before it reaches the primary key, so the duplicate-key backstop alone would hand back an opaque JournalError. Those aborts (1020, 1213, 1205) are classified too, but only reported as JournalConcurrencyError once a re-read shows the head actually moved \u2014 otherwise a lock-wait timeout against an unrelated long transaction would send the caller into a retry spin.", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_mariadb_case_insensitive_tag_collation", "label": "Tags compare case-insensitively in the index", "file_type": "rationale", "rationale": "tag is declared without an explicit COLLATE and inherits the server's case-insensitive default, so the index also returns rows differing only in case. Results stay correct because MariaDbQuery re-checks every row against the event's own tag list; the cost is a less selective pre-filter than on Postgres.", "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_journals_mariadb_mariadbjournal", "target": "docs_src_content_docs_persistence_overview_journal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mariadb_mariadbsnapshotstore", "target": "docs_src_content_docs_persistence_overview_snapshotstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/mariadb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_mariadb_mariadbdurablestatestore", "target": "docs_src_content_docs_persistence_overview_durablestatestore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"