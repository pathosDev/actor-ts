{"nodes": [{"id": "src_io_broker_emailbridgeactor_emailbridgeactor", "label": "EmailBridgeActor", "file_type": "code", "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_brokers_email_docker_compose_email_greenmail", "label": "GreenMail service", "file_type": "code", "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apache-2.0 mail server speaking both halves of the bridge - SMTP 3025 and IMAP 3143 in one container - so a scenario can send a message and watch the same server hand it back. The user is declared up front rather than left to GreenMail's auto-create: the bridge authenticates, and a server that invents accounts on demand would make a wrong credential look like a pass."}, {"id": "tests_integration_brokers_email_docker_compose_email_runner", "label": "Email runner service", "file_type": "code", "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMAIL_HOST greenmail with SMTP 3025 / IMAP 3143, logging in as the full address bridge@example.test."}, {"id": "tests_integration_brokers_email_docker_compose_email_users_login_email", "label": "greenmail.users.login=email", "file_type": "rationale", "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "greenmail.users=<local-part>:<password>@<domain> creates the mailbox but authenticates under the local part alone - GreenMail's default since 1.6.1. Setting users.login=email lets the bridge log in with the full address the way a real provider expects; bending the client to a test server's default would be fitting the wrong way round."}, {"id": "tests_integration_brokers_email_docker_compose_email_mailpit_rejected", "label": "Mailpit rejected: no IMAP", "file_type": "rationale", "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The other obvious candidate is out because its maintainer has explicitly declined IMAP support, and IMAP is the inbound half of the bridge."}, {"id": "tests_integration_brokers_email_docker_compose_email_two_port_readiness", "label": "Two-port readiness gate", "file_type": "rationale", "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "service_started rather than a healthcheck - a slim JRE with no curl or nc, so compose cannot probe from the inside. The runner's waitForPort gates on BOTH ports from the outside: a two-port service is only ready when both listen, and SMTP comes up before IMAP."}], "edges": [{"source": "tests_integration_brokers_email_docker_compose_email_runner", "target": "tests_integration_brokers_email_docker_compose_email_greenmail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_email_docker_compose_email_runner", "target": "src_io_broker_emailbridgeactor_emailbridgeactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_email_docker_compose_email_users_login_email", "target": "tests_integration_brokers_email_docker_compose_email_greenmail", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_email_docker_compose_email_mailpit_rejected", "target": "tests_integration_brokers_email_docker_compose_email_greenmail", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_email_docker_compose_email_two_port_readiness", "target": "tests_integration_brokers_email_docker_compose_email_runner", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_email_docker_compose_email_two_port_readiness", "target": "tests_integration_brokers_lib_waitforport_waitforport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_email_docker_compose_email_users_login_email", "target": "tests_integration_brokers_readme_auth_connection_bring_up", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_dynamodb_docker_compose_dynamodb_service_started_gate", "target": "tests_integration_brokers_email_docker_compose_email_two_port_readiness", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tests/integration/brokers/email/docker-compose.email.yml", "source_location": null, 