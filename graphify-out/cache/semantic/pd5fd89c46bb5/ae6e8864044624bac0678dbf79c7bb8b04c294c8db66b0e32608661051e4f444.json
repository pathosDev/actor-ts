{"nodes": [{"id": "docs_src_content_docs_http_middleware_ip_allowlist_ip_allowlist", "label": "IP allowlist (page)", "file_type": "document", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlist", "label": "IpAllowlist middleware", "file_type": "concept", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defence-in-depth on top of BearerTokenAuth: even a leaked token is useless off an allowlisted network."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlistoptions", "label": "IpAllowlistOptions", "file_type": "concept", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_trustedproxies", "label": "trustedProxies option", "file_type": "rationale", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unset means no forwarding header is read at all. It checks the socket peer first, so it needs nothing from the backend and works identically on Fastify, Express and Hono."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_forwardedheader", "label": "forwardedHeader option", "file_type": "concept", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default x-forwarded-for; point the same walk at CF-Connecting-IP where a proxy sets rather than appends."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_getclientip", "label": "getClientIp escape hatch", "file_type": "concept", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces IP extraction wholesale; returning null denies the request (fail-closed) and it is mutually exclusive with trustedProxies."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_right_to_left_chain_walk", "label": "Right-to-left forwarded-chain walk", "file_type": "rationale", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NGINX, AWS ALB and Cloudflare all append rather than replace, so the leftmost entry is whatever the client typed. Walking from the socket end inwards means a direct client is never trusted through the header and prepended junk is never reached."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_fail_closed", "label": "Fail-closed on a missing or non-matching client IP", "file_type": "rationale", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "403 on no match; an entry that is not a valid address matches no CIDR, counts as untrusted, ends the walk, and then fails allow too."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_hop_count_is_not_enough", "label": "A hop count is not enough", "file_type": "rationale", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A numeric trust-proxy count compares indexes and never addresses, so it believes the header on a request that passed no proxy at all: two forged entries are two believed entries."}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_withmiddleware", "label": "withMiddleware route wrapper", "file_type": "concept", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_middleware_ip_allowlist_bearertokenauth", "label": "BearerTokenAuth", "file_type": "concept", "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_http_middleware_ip_allowlist_ip_allowlist", "target": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlist", "target": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlistoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlistoptions", "target": "docs_src_content_docs_http_middleware_ip_allowlist_trustedproxies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/http/middleware/ip-allowlist.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_http_middleware_ip_allowlist_ipallowlistoptions", "target": "docs_src_content_docs_http_middleware_ip_allowlist_forwardedheader", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/c