{"nodes": [{"id": "tests_integration_brokers_amqp_docker_compose_amqp_rabbitmq", "label": "RabbitMQ service (AMQP suite)", "file_type": "code", "source_file": "tests/integration/brokers/amqp/docker-compose.amqp.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "~10s boot, slower than MinIO/Mosquitto, but the de-facto AMQP 0.9.1 reference broker. Healthcheck is rabbitmq-diagnostics check_running, faster than check_port_connectivity because it needs no management plugin. The image relaxes the loopback-only restriction so guest:guest works from any client on the compose bridge."}, {"id": "tests_integration_brokers_amqp_docker_compose_amqp_runner", "label": "AMQP runner service", "file_type": "code", "source_file": "tests/integration/brokers/amqp/docker-compose.amqp.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built from the repo-root context, gated on service_healthy, connects as AMQP_URL amqp://guest:guest@rabbitmq:5672/ over the amqpnet bridge."}, {"id": "tests_integration_brokers_amqp_docker_compose_amqp_rabbitmq_conf", "label": "rabbitmq.conf transient-queue permission", "file_type": "rationale", "source_file": "tests/integration/brokers/amqp/docker-compose.amqp.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mounted read-only to permit transient non-exclusive queues; without it RabbitMQ 4.x rejects the test scenarios' ephemeral-queue declarations."}], "edges": [{"source": "tests_integration_brokers_amqp_docker_compose_amqp_runner", "target": "tests_integration_brokers_amqp_docker_compose_amqp_rabbitmq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/amqp/docker-compose.amqp.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_amqp_docker_co