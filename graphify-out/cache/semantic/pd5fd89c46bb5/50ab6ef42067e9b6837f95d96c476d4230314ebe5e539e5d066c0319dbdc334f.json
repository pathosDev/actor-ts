{"nodes": [{"id": "docs_src_content_docs_de_observability_overview_vier_saeulen", "label": "Vier Saeulen der Observability", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logging laeuft immer; Metriken, Tracing und Management sind Extensions und laufen nicht, bis man danach greift - eine App, die sie ignoriert, hat keinen Overhead durch ungenutzte Puffer oder nicht gestartete Exporter."}, {"id": "docs_src_content_docs_de_observability_overview_multisinklogger", "label": "MultiSinkLogger / withLogSinks", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records werden einmal gebaut, an jeden Sink mit passendem Level aufgefaechert, ueber eine begrenzte Queue zugestellt und beim Terminieren geflusht; ein kaputtes Ziel reisst weder die anderen noch die Anwendung mit."}, {"id": "docs_src_content_docs_de_observability_overview_sink_auswahl_otlp", "label": "Fang mit OTLP an", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Endpunktformat erreicht Loki 3+, Parseable, SigNoz, Datadog, Axiom, Honeycomb, New Relic und jeden OTel-Collector - ein plattformspezifischer Sink lohnt nur dort, wo OTLP nicht hinkommt oder etwas verliert."}, {"id": "docs_src_content_docs_de_observability_overview_kein_journald_sink", "label": "Kein journald- und kein Windows-Event-Log-Sink", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beide erreicht man, indem man NDJSON nach stdout schreibt und die Plattform es einsammeln laesst - was der ConsoleSink im json-Modus schon tut; ein eigener Sink braechte ein Binaerprotokoll ohne zusaetzliche Reichweite."}, {"id": "docs_src_content_docs_de_observability_overview_metricsextension", "label": "MetricsExtension", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_overview_metrik_typen", "label": "Counter / Gauge / Histogram / Timer", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Metrik hat Namen + Labels; Labels erlauben, dieselbe Metrik nach Dimensionen zu zerlegen. Timer baut auf Histogram fuer timing-spezifische Ergonomie auf."}, {"id": "docs_src_content_docs_de_observability_overview_exporter", "label": "PrometheusExporter / PromClientAdapter", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_overview_stock_metriken", "label": "Stock-Metriken (Basislinie)", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_overview_tracingextension", "label": "TracingExtension / otelTracer", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_overview_span_pro_nachricht", "label": "Ein Span pro Actor-Nachricht", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Span traegt Actor-Pfad, Klasse der Nachricht, Parent-Span-Kontext und die Dauer von onReceive."}, {"id": "docs_src_content_docs_de_observability_overview_span_verkettung", "label": "Spans verketten sich ueber Tells hinweg", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Sender gibt den aktuellen Span-Kontext via Envelope weiter, sodass ein Trace pro logischem Request entsteht, selbst wenn er durch 4-5 Actors huepft."}, {"id": "docs_src_content_docs_de_observability_overview_managementroutes", "label": "managementRoutes", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_overview_health_checks", "label": "Health Checks (/health, /ready)", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein fehlschlagender eigener Readiness-Check laesst den Endpunkt 503 zurueckgeben, was K8s als nicht-zu-diesem-Pod-routen liest."}, {"id": "docs_src_content_docs_de_observability_overview_was_zuerst_verdrahten", "label": "Reihenfolge beim Verdrahten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs an einen dauerhaften Ort, dann Metriken, dann Health Checks, Tracing zuletzt - Tracing ist aufwendiger (Exporter, Sampling, Kosten) und bringt abnehmenden Grenznutzen fuer einfache Apps."}, {"id": "docs_src_content_docs_de_observability_overview_sampling_hochdurchsatz", "label": "Sampling am Exporter bei Hochdurchsatz", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Framework zeichnet Spans fuer jede Nachricht auf, egal was; eine Million Spans pro Sekunde ueberlastet die meisten Collector, also entscheidet der Exporter, was er sendet."}, {"id": "docs_src_content_docs_de_observability_overview_metrics_endpoint_nicht_oeffentlich", "label": "/metrics nicht oeffentlich exponieren", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Endpunkt enthaelt exakte Request-Volumina und Fehlerzahlen; im Internet exponiert leakt er Betriebszustand - hinter privates Netz, VPN oder authentifizierten Proxy stellen."}, {"id": "docs_src_content_docs_de_observability_overview_devtools_debugger", "label": "DevTools ist ein Debugger, kein Monitoring-Stack", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die drei Saeulen beobachten von aussen und ueber die Zeit; DevTools schaut gerade jetzt hinein - standardmaessig Loopback, ohne Auth und aus, bis man danach greift."}], "edges": [{"source": "docs_src_content_docs_de_observability_overview_vier_saeulen", "target": "docs_src_content_docs_de_observability_overview_multisinklogger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src