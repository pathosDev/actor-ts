{"nodes": [{"id": "docs_src_content_docs_operations_tuning_gossip_cadence_gossip_cadence", "label": "Gossip cadence", "file_type": "document", "rationale": "Every interval each member picks a random reachable peer and exchanges its membership view; after a few rounds the cluster converges.", "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_gossip_cadence_gossipintervalms", "label": "gossipIntervalMs", "file_type": "concept", "rationale": "Defaults to one second and most clusters never need to change it; lower for latency-sensitive failover on small clusters, raise for 20-plus nodes or bandwidth-constrained WAN links.", "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_gossip_cadence_bandwidth_math", "label": "Gossip bandwidth math", "file_type": "concept", "rationale": "Gossip size runs 100 to 500 bytes per member with one peer per round, so a 50-node cluster at one second is about 250 KB/s aggregate - negligible on a LAN, but each WAN round adds its RTT to convergence.", "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_gossip_cadence_downstream_timing_effects", "label": "What a slower gossip interval also slows", "file_type": "rationale", "rationale": "Convergence after join, failure-detector last-seen propagation, sharding rebalance decisions, DistributedPubSub topic maps and the receptionist registry all ride on gossip, so one knob moves all of them.", "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_gossip_cadence_symmetric_interval", "label": "Same gossip interval on every node", "file_type": "rationale", "rationale": "Each node uses its own interval for sending but receives at whatever cadence peers send, so asymmetric values produce confusing convergence behaviour.", "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_operations_tuning_gossip_cadence_gossip_cadence", "target": "docs_src_content_docs_operations_tuning_gossip_cadence_gossipintervalms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_gossip_cadence_gossip_cadence", "target": "docs_src_content_docs_operations_tuning_gossip_cadence_bandwidth_math", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_gossip_cadence_gossip_cadence", "target": "docs_src_content_docs_operations_tuning_gossip_cadence_downstream_timing_effects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/gossip-cadence.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_gossip_cadence_gossip_cadence", "target": "docs_src_content_docs_operations_tuning_gossip_cadence_symmetric_interval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/do