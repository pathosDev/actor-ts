{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_page", "label": "Replicated Event Sourcing im \u00dcberblick", "file_type": "document", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "label": "ReplicatedEventSourcedActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Basisklasse statt PersistentActor; nichts wird in den Konstruktor gereicht, sie liest den Cluster vom ActorSystem. Das Journal muss \u00fcber Replicas geteilt sein."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "label": "ConflictResolver", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional; Default ist Last-Writer-Wins. Wenn 'was gewinnt' keine sinnvolle Antwort hat, ist Replicated ES die falsche Form."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicaid", "label": "replicaId", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default ist die Cluster-Adresse des Nodes; nur \u00fcberschreiben, wenn die Id eine Adress\u00e4nderung \u00fcberleben muss. Zwei Replicas, die sich je eine Id teilen, teilen sich eine Vector-Clock-Komponente \u2014 der Default ist also der sichere."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_distributedpubsub_delivery", "label": "Cross-Replica-Auslieferung \u00fcber DistributedPubSub", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes Feld eines eintreffenden Event-Envelopes wurde von einem anderen Node geschrieben; alles, was den Cluster-Handshake abschlie\u00dfen kann, erreicht einen replizierten Actor, Mitgliedschaft ist keine Voraussetzung."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_envelope_validation", "label": "Vollst\u00e4ndige Envelope-Validierung vor der Anwendung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "replica und eventId nicht-leer und begrenzt, seqAtReplica positive Ganzzahl, timestamp endlich, Vector Clock ein einfaches Objekt aus endlichen, nicht-negativen Komponenten mit begrenzter Eintr\u00e4gezahl. Ein Fehlschlag verwirft genau diesen Envelope mit WARN, l\u00e4sst den Actor nie fehlschlagen und hinterl\u00e4sst nie ein halb angewendetes Event."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_eventid_entropy", "label": "eventId aus Entropie (Replica-Id + # + 96 Bit Zufall)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Deduplizierungs-Treffer bedeutet stilles Verwerfen: eine aus replica und seqAtReplica abgeleitete Identit\u00e4t ist per Arithmetik vorhersagbar, ein Peer k\u00f6nnte also noch nicht ausgegebene Identit\u00e4ten beanspruchen und die echten Events dauerhaft unterdr\u00fccken, weil das Identit\u00e4ts-Set gesnapshottet wird. seqAtReplica ist nur noch letzter Tie-Break der kanonischen Ordnung."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_maxobservedevents", "label": "maxObservedEvents", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 100 000. Es gibt noch keine Compaction, die kanonische Historie w\u00e4chst also nur; an der Obergrenze werden weitere Remote-Events abgelehnt, lokale persist-Aufrufe nie. Ablehnen statt Verdr\u00e4ngen, weil Events zu verwerfen die Faltung \u00e4ndert und Identit\u00e4ten zu verwerfen das Doppelt-Anwenden wieder \u00f6ffnet."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_authorship_unauthenticated", "label": "Die Autorschaft ist noch nicht authentifiziert", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nichts bindet das replica-Feld an den sendenden Node; ein Mitglied kann ein Event unter der Id eines Peers verfassen. Unterdr\u00fccken kann es die echten Events eines Peers nicht \u2014 das schlie\u00dft die Entropie. Replicated ES hinter mTLS betreiben und Mitgliedschaft als Privileg behandeln."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_availability_tradeoff", "label": "Einfachheit gegen Verf\u00fcgbarkeit getauscht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partielle statt totaler Event-Order, Fold plus Conflict Resolution statt deterministischem Fold, Validierung gegen die Sicht der lokalen Replica. Mental-Model: CRDT-artig f\u00fcr Events. F\u00fcr typische Sharded-Entity-Setups ist Sharding + PersistentActor einfacher."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicaid", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_distributedpubsub_delivery", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_envelope_validation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_envelope_validation", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_eventid_entropy", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_seenids", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_authorship_unauthenticated", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_eventid_entropy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_maxobservedevents", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_availability_tradeoff", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicaid", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_stable_replica_ids", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_eventid_entropy", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_revision_rollback_protection", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "replicated_event_sourcing_machinery", "label": "Die Maschinerie von Replicated Event Sourcing", "nodes": ["docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_hook", "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx"}]}