{"nodes": [{"id": "docs_src_content_docs_serialization_cbor_cborserializer", "label": "CborSerializer", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RFC 8949 binary encoding with the same API surface as JsonSerializer; worth switching to when messages carry binary data, bandwidth is metered, storage scales with payload size, or JSON parse cost shows in profiles."}, {"id": "docs_src_content_docs_serialization_cbor_cbor_size_savings", "label": "CBOR size savings", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typically 20-40%, largest on binary payloads where JSON pays a 33% base64 tax and on repeated field names."}, {"id": "docs_src_content_docs_serialization_cbor_cbor_undefined_native", "label": "CBOR carries undefined natively", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CBOR simple value 23 makes CborSerializer the more permissive of the two codecs - JsonSerializer rejects undefined outright - which is one of only two deliberate remaining differences (the other being little-endian non-Uint8Array typed arrays)."}, {"id": "docs_src_content_docs_serialization_cbor_cbor_collection_regression", "label": "#1036 CBOR collection-flattening regression", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CborSerializer used to flatten Map, Set and the two bidirectional collections to an empty object and lose every entry without raising anything; a shared test suite now asserts both codecs agree on every rich type, so pre-encoding workarounds are no longer needed."}, {"id": "docs_src_content_docs_serialization_cbor_cbor_debuggability_tradeoff", "label": "CBOR debuggability trade-off", "file_type": "rationale", "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw CBOR needs a CBOR-aware tool to read, so a common split is JSON on disk for debuggability and CBOR on the wire, or a temporary switch to JSON while hunting a bug."}, {"id": "docs_src_content_docs_serialization_cbor_serializer_default_scope_limit", "label": "setDefault does not retrofit the wire or the stores", "file_type": "rationale", "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ext.setDefault only changes what ext.encode uses for unbound values; persistence needs the store's own withSerializer option and the cluster wire has no equivalent yet (#450), so a per-payload need is served by using the serializer directly."}], "edges": [{"source": "docs_src_content_docs_serialization_cbor_cborserializer", "target": "docs_src_content_docs_serialization_overview_serializer_interface", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cborserializer", "target": "docs_src_content_docs_serialization_cbor_cbor_size_savings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cborserializer", "target": "docs_src_content_docs_serialization_cbor_cbor_undefined_native", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cbor_collection_regression", "target": "docs_src_content_docs_serialization_cbor_cborserializer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cbor_debuggability_tradeoff", "target": "docs_src_content_docs_serialization_cbor_cborserializer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_serializer_default_scope_limit", "target": "docs_src_content_docs_serialization_overview_serialization_extension", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cbor_undefined_native", "target": "docs_src_content_docs_serialization_json_serializationerror", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cbor_size_savings", "target": "docs_src_content_docs_serialization_json_json_type_tags", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_cbor_collection_regression", "target": "docs_src_content_docs_serialization_json_bidirectional_map_tags", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_cbor_serializer_default_scope_limit", "target": "docs_src_content_docs_serialization_custom_serialized_row_framing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/cbor.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}