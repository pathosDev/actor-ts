{"nodes": [{"id": "docs_src_content_docs_de_http_marshalling_entity", "label": "entity<T>(req)", "file_type": "concept", "rationale": "Reduces Content-Type to the bare media type, picks a serializer or throws 415, decodes the byte body, and casts \u2014 it throws on a missing or malformed body, so do not call it when no body is expected.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_marshal", "label": "marshal(req, value)", "file_type": "concept", "rationale": "Content negotiation from the Accept header \u2014 worth it when different clients want different formats or CBOR's compactness pays; otherwise completeJson.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_completejson", "label": "completeJson", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_jsonserializer", "label": "JsonSerializer", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_cborserializer", "label": "CborSerializer", "file_type": "concept", "rationale": "RFC 8949 binary format, typically 20\u201340 % smaller than JSON and first-class for binary payloads with no base64 wrapping \u2014 but JSON stays better for human-debuggable APIs.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_formurlencodedserializer", "label": "FormUrlEncodedSerializer", "file_type": "concept", "rationale": "Decodes to a flat record of strings \u2014 the format carries no types, a repeated field widens to an array, and nesting is not expressible, so use JSON when you need it.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_serializer_interface", "label": "Serializer-Interface", "file_type": "concept", "rationale": "Custom serializers are possible, but the HTTP module's media-type mapping is a private constant, so branch before the entity call instead.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_unsupported_media_type_415", "label": "415 f\u00fcr nicht unterst\u00fctzte Media-Types", "file_type": "rationale", "rationale": "An unknown type is refused rather than guessed as JSON, and the accepted list also goes out as the Accept response header per RFC 9110; matching is against the parsed media type, so naming a known type inside a parameter selects nothing.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_structured_syntax_suffix", "label": "Structured-Syntax-Suffixe (+json)", "file_type": "concept", "rationale": "vnd.api+json, merge-patch+json and problem+json follow their base type per RFC 6839; a missing Content-Type still decodes as JSON because RFC 9110 leaves the receiver free to guess and HttpClient omits the header for string bodies.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_streaming_responses", "label": "Streaming-Responses", "file_type": "concept", "rationale": "All three backends stream a ReadableStream straight to the client without buffering; streams are single-use, so a streaming response must not go through caching middleware.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_marshalling_entity_no_validation", "label": "entity<T> validiert nicht", "file_type": "rationale", "rationale": "The cast is trust-based: at runtime the value is unknown, so a wrong-shaped request yields undefined fields and downstream errors unless a validator is layered on top.", "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_marshalling_entity", "target": "docs_src_content_docs_de_http_marshalling_jsonserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_marshalling_entity", "target": "docs_src_content_docs_de_http_marshalling_cborserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_marshalling_entity", "target": "docs_src_content_docs_de_http_marshalling_formurlencodedserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/m