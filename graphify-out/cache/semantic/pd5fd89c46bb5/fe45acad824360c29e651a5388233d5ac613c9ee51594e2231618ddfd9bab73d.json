{"nodes": [{"id": "docs_src_content_docs_de_http_middleware_csp_contentsecuritypolicy", "label": "contentSecurityPolicy()", "file_type": "rationale", "rationale": "The only place that sends a policy \u2014 a CSP is far too application-specific for the server-wide security-header bundle, so responses created outside its subtree (backend 404, generic 500) carry none; it does travel with a throwing short-circuit.", "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csp_cspoptions", "label": "CspOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csp_baseline", "label": "Helmet-nahe CSP-Baseline", "file_type": "concept", "rationale": "default-src 'self', object-src 'none', base-uri 'self', frame-ancestors 'self'; own directives override per directive, an empty array removes one, withoutDefaults skips the baseline.", "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csp_report_only", "label": "Content-Security-Policy-Report-Only", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csp_injection_guard", "label": "Injection-Guard f\u00fcr Source-Tokens", "file_type": "rationale", "rationale": "A source token containing ';', ',' or whitespace throws at construction \u2014 no silent header injection.", "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csp_nonces_missing", "label": "Per-Request-Nonces fehlen", "file_type": "rationale", "rationale": "Nonces would need a template/SSR integration to reach the rendered HTML, which the framework does not have; a handler that needs one sets its own header, and the middleware never overwrites a header the handler already set.", "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_middleware_csp_contentsecuritypolicy", "target": "docs_src_content_docs_de_http_middleware_csp_cspoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csp_baseline", "target": "docs_src_content_docs_de_http_middleware_csp_contentsecuritypolicy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csp_report_only", "target": "docs_src_content_docs_de_http_middleware_csp_cspoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csp_injection_guard", "target": "docs_src_content_docs_de_http_middleware_csp_cspoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csp.mdx", "source_location": null, "weight": 1.0}, 