cs_src_content_docs_de_persistence_object_storage_encryption_reencryptobjectstorage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_revision_rollback_protection", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_objectstoragedurablestatestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_withrejectrevisionrollback", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_revision_rollback_protection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_reencryptobjectstorage", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_masterkeyring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionbyprefix", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionconfig", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_key_sources", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_masterkeyring", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_context_binding", "target": "docs_src_content_docs_de_persistence_migration_schema_registry_one_adapter_one_manifest", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "object_storage_body_protections", "label": "Die vier Schutzschichten eines Object-Storage-Bodys", "nodes": ["docs_src_content_docs_de_persistence_object_storage_encryption_client_aes256_gcm", "docs_src_content_docs_de_persistence_object_storage_encryption_hmac_integrity", "docs_src_content_docs_de_persistence_object_storage_encryption_context_binding", "docs_src_content_docs_de_persistence_object_storage_encryption_revision_rollback_protection"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx"}]}