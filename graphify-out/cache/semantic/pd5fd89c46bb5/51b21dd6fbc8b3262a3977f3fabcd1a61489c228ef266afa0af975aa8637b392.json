{"nodes": [{"id": "docs_src_content_docs_observability_devtools_send_message_send_message", "label": "DevTools send-message panel (page)", "file_type": "document", "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_devtools_send_message_allowmessagesending", "label": "allowMessageSending acknowledgement", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every other panel reads; this one writes, so it has a different default. While off the actors.send method is not registered at all \u2014 a client that knows the name is told there is no such method rather than being refused by a guard."}, {"id": "docs_src_content_docs_observability_devtools_send_message_two_switches", "label": "Two switches, only one a security decision", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hiding a view and making a system writable are different decisions, so they are different settings. With the acknowledgement unset the panel still appears as a disabled entry naming the setting to change, rather than silently absent."}, {"id": "docs_src_content_docs_observability_devtools_send_message_server_side_validation", "label": "What the server accepts", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validated on the server and refused verbatim to the panel, because two copies of a rule is how they drift apart: JSON object or array only, 64 KiB at most, under /user only, and no sender \u2014 forging one would point a reply at an actor that never sent anything."}, {"id": "docs_src_content_docs_observability_devtools_send_message_json_cannot_construct_poisonpill", "label": "JSON cannot construct a PoisonPill", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The message is a plain object, so it cannot be a PoisonPill, a Kill or any other class the system treats specially; that bound is structural rather than enforced by a check, which is why it holds."}], "edges": [{"source": "docs_src_content_docs_observability_devtools_send_message_send_message", "target": "docs_src_content_docs_observability_devtools_send_message_allowmessagesending", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_send_message", "target": "docs_src_content_docs_observability_devtools_send_message_two_switches", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_send_message", "target": "docs_src_content_docs_observability_devtools_send_message_server_side_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_json_cannot_construct_poisonpill", "target": "docs_src_content_docs_observability_devtools_send_message_server_side_validation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_allowmessagesending", "target": "docs_src_content_docs_observability_devtools_overview_devtoolsoptions", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_two_switches", "target": "docs_src_content_docs_observability_devtools_overview_panels", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_allowmessagesending", "target": "docs_src_content_docs_observability_devtools_overview_security", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_send_message_server_side_validation", "target": "docs_src_content_docs_operations_security_cluster_security_wire_edge_frame_validation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/observability/devtools/send-message.mdx", "source_location": null, "weight": 1}], "hyperedges": []}