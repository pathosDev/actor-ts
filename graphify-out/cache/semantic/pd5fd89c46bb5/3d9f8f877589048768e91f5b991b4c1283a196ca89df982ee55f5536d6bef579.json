{"nodes": [{"id": "docs_src_content_docs_de_cache_memcached_memcachedcache", "label": "MemcachedCache", "file_type": "document", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verteilter Cache \u00fcber Pods, geteilt \u00fcber Prozesse hinweg; einfacher als Redis \u2014 weniger Features, geringerer operativer Footprint."}, {"id": "docs_src_content_docs_de_cache_memcached_memjs", "label": "memjs", "file_type": "concept", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der zugrunde liegende Client: SASL-Auth, clientseitiges Hashing \u00fcber mehrere Server, eigener Connection-Pool."}, {"id": "docs_src_content_docs_de_cache_memcached_memcached_vs_redis", "label": "Memcached vs. Redis", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F\u00fcr puren Cache funktioniert beides; Redis gewinnt bei fast allem anderen, Memcached bei minimalem operativem Footprint."}, {"id": "docs_src_content_docs_de_cache_memcached_server_side_eviction", "label": "Serverseitige LRU-Eviction", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Entscheidung f\u00e4llt im Server und der Client wird nicht gefragt, es gibt hier also kein Gegenst\u00fcck zur Garantie-Ordnung von InMemoryCache: ein von setIfAbsent geschriebener Eintrag kann mit dem gr\u00f6\u00dften Teil seiner TTL verschwinden, und nichts in der API meldet es."}, {"id": "docs_src_content_docs_de_cache_memcached_add_atomic_per_server", "label": "ADD ist pro Server atomar, nicht pro Cluster", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Genau das macht setIfAbsent und acquireLock im eingeschwungenen Zustand korrekt: alle Konkurrenten um einen Key landen auf demselben Server."}, {"id": "docs_src_content_docs_de_cache_memcached_topology_rehash", "label": "Topologie-\u00c4nderung bricht die Lock-Annahme", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "memjs rehasht den Keyspace, der Key kann auf einem Server ohne Eintrag landen und das Lock wird zweimal vergeben. Clientseitig gibt es kein Mittel, ohne in memjs internen Hashring zu greifen \u2014 also in genau das Detail, das memjs zu verbergen da ist."}, {"id": "docs_src_content_docs_de_cache_memcached_memcached_fencing_token", "label": "Fencing-Token als Absicherung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wer acquireLock auf Memcached nutzt, h\u00e4lt entweder die Serverliste \u00fcber die Lebensdauer des Locks stabil oder sichert die Ressource mit einem Fencing-Token ab; Redis ist das bessere Backend zum Locken."}], "edges": [{"source": "docs_src_content_docs_de_cache_memcached_memcachedcache", "target": "docs_src_content_docs_de_cache_memcached_memjs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/cache/memcached.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_cache_memcached_memcachedcache", "target": "docs_src_content_docs_de_cache_memcached_memcached_vs_redis", "relation": "references", "co