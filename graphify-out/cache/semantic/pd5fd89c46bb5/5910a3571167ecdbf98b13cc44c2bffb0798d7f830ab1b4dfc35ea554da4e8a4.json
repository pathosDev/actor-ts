{"nodes": [{"id": "docs_src_content_docs_de_observability_tracing_tracer_api_tracer", "label": "Tracer-Interface", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": "Das Interface", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimale Abstraktion ueber verteiltes Tracing - nahe an OpenTelemetry, aber kleiner. Keine SDK-Dependency: actor-ts zieht kein @opentelemetry/sdk-*, Spans serialisieren zu W3C-traceparent."}, {"id": "docs_src_content_docs_de_observability_tracing_tracer_api_span", "label": "Span-Interface", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": "Lebensdauer eines Spans", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spans muessen beendet werden, sonst leakt der Tracer Speicher; nach end() sind weitere Methoden No-Ops. Das Framework beendet die Spans des Message-Handlings selbst, User-Code ist fuer seine eigenen verantwortlich (try/finally). Keine PII in Attribute - Traces sind meist weniger geschuetzt als primaere Datenbanken."}, {"id": "docs_src_content_docs_de_observability_tracing_tracer_api_nooptracer", "label": "NoopTracer", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": "Die Tracing-API des Frameworks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default. Seit #411 loest der Nachrichtenpfad den Tracer ueber ein einfaches Feld am ActorSystem auf statt ueber die Extension-Registry - vorher loeste der Receive-Pfad die Extension zweimal pro Nachricht auf, der Send-Pfad ein weiteres Mal, jedes Mal ein Map-Lookup plus zwei Aufrufe, egal ob getract wurde. Die Aussage ist jetzt 'ein Feldzugriff und ein Null-Check', nicht 'nichts' - die frueher behaupteten Null-Kosten stimmten nicht."}, {"id": "docs_src_content_docs_de_observability_tracing_tracer_api_tracecarrier", "label": "TraceCarrier (injectContext / extractContext)", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": "Cross-Wire-Propagierung", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key/Value-Map, die der Cluster-Transport automatisch in Wire-Envelopes legt. Ausserhalb des Actor-Systems (HTTP, Broker) inject/extract man manuell."}], "edges": [{"source": "docs_src_content_docs_de_observability_tracing_tracer_api_tracer", "target": "docs_src_content_docs_de_observability_tracing_tracer_api_span", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_tracer_api_tracer", "target": "docs_src_content_docs_de_observability_tracing_tracer_api_tracecarrier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_tracer_api_nooptracer", "target": "docs_src_content_docs_de_observability_tracing_tracer_api_tracer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_tracer_api_tracecarrier", "target": "docs_src_content_docs_de_observability_tracing_actor_tracing_pipeto_span_gap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/tracer-api.mdx", "source_location": null, "weight": 1.0}, {