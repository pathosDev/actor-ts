{"nodes": [{"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_compression_hook", "label": "compression()-Hook pro Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_encryption_hook", "label": "encryption()-Hook pro Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PCI / HIPAA / GDPR-Scope: als sensibel klassifizierte Daten verwenden einen separaten Master-Key UND einen separaten HKDF-Kontext, sodass die Kompromittierung eines Keyrings den anderen nicht exponiert."}, {"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_integrity_hook", "label": "integrity()-Hook pro Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der dritte Hook neben compression() und encryption() - lohnt auch fuer Daten, die nicht geheim sind, weil er Manipulation an Ort und Stelle beim Lesen erkennbar macht."}, {"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_self_describing_ats1_on_read", "label": "Reads folgen dem selbstbeschreibenden ATS1-Manifest, nicht den aktuellen Overrides", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein unter pciKeyRing verschluesseltes Objekt wird ueber pciKeyRing entschluesselt, egal was encryption() aktuell sagt - das Rotieren einer Actor-Policy bricht alte Daten also nicht, solange die noetigen Keys verfuegbar sind."}, {"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_hooks_ignored_by_non_object_stores", "label": "Nur die Object-Storage-Stores lesen diese Hooks (#960)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zehn der elf Snapshot-Stores und neun der zehn Durable-State-Stores nehmen PersistenceOptions entgegen und sehen sie nie an. Auf SQLite, Postgres, Cassandra, Mongo, DynamoDB und dem In-Memory-Referenz-Store bringt ein Override keine Manipulationserkennung und wirft keinen Fehler - die Direktive wird fallen gelassen."}, {"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_cluster_wide_key_consistency", "label": "Gleiche Verschluesselungs-Config ueber alle Cluster-Nodes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sonst koennen Sharded Entities nach der Migration auf einem anderen Node nicht gelesen werden - Key-Rings von derselben Quelle auf jedem Node hereinreichen."}, {"id": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_override_allocates_per_call", "label": "Override gibt bei jedem Aufruf ein neues Objekt zurueck", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuer die Korrektheit in Ordnung, aber pro Persist allokiert - bei Perf-Sensitivitaet zu einer statischen Konstante hochheben."}], "edges": [{"source": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_encryption_hook", "target": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_compression_hook", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_integrity_hook", "target": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_compression_hook", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_self_describing_ats1_on_read", "target": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_encryption_hook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_self_describing_ats1_on_read", "target": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_compression_hook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/per-actor-policies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_hooks_ignored_by_non_object_stores", "target": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_integrity_hook", "relation": "rationale_for", "confidence": 