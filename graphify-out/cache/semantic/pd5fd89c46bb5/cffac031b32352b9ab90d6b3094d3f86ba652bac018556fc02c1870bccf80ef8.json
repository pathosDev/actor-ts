{"nodes": [{"id": "benchmarks_readme_micro_benchmark_suite", "label": "actor-ts micro-benchmark suite", "file_type": "document", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_comparative_not_absolute", "label": "Comparative, not absolute numbers", "file_type": "rationale", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-machine, single-JIT measurements say nothing about a production cluster; treat them as a lower bound on latency and an upper bound on throughput, useful for detecting regressions between commits, not as marketing material."}, {"id": "benchmarks_readme_highresnow", "label": "highResNow runtime-neutral timer", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun.nanoseconds() on Bun, performance.now() x 1e6 elsewhere, so one harness measures identically on all three runtimes."}, {"id": "benchmarks_readme_run_all", "label": "run-all.ts discovery driver", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spawns every discovered benchmark file in its own subprocess and exits non-zero if any suite failed, so one broken benchmark neither hides the rest nor passes CI."}, {"id": "benchmarks_readme_smoke_mode", "label": "ACTOR_TS_BENCH_SMOKE smoke mode", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collapses every case to one unwarmed iteration; the numbers are meaningless by design and the point is proving each suite still executes against the current src/ API."}, {"id": "benchmarks_readme_typecheck_bench", "label": "typecheck:bench benchmarks-only compile", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The build tsconfig excludes benchmarks/, so a src/ change that orphaned a benchmark used to be invisible; the typecheck is stricter than smoke because a missing barrel export is a compile error even when the binding is never called."}, {"id": "benchmarks_readme_group_single_node", "label": "single-node benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_group_cluster", "label": "cluster benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_group_worker", "label": "worker benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun Workers give true multi-core parallelism, unlike a router pool inside one ActorSystem which only gives in-flight concurrency."}, {"id": "benchmarks_readme_group_memory", "label": "memory benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_group_persistence", "label": "persistence benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_group_http", "label": "http benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_group_comparison", "label": "comparison benchmark group", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one directory run-all.ts does not discover: its targets are third-party code that must not enter the shipped dependency closure, bun audit's surface, or bun run bench on a clean clone."}, {"id": "benchmarks_readme_harness", "label": "lib/harness.ts measurement harness", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmarks_readme_output_table", "label": "Bordered benchmark result table", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memory is printed with an explicit sign and tinted above 10 MB / 100 MB so leaky cases stand out; colours honour NO_COLOR and drop when stdout is not a TTY."}, {"id": "benchmarks_readme_underscore_helper_convention", "label": "Underscore-prefixed helper files", "file_type": "concept", "source_file": "benchmarks/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files named _x.ts are used BY benchmarks and skipped by the discovery driver, so a bootstrap file is never run as a suite."}], "edges": [{"source": "benchmarks_readme_micro_benchmark_suite", "target": "benchmarks_readme_run_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmarks/README.md", "source_location": null, "weight": 1.0}, {"source": "benchmarks_readme_micro_b