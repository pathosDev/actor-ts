{"nodes": [{"id": "docs_src_content_docs_de_persistence_object_storage_compression_compressionconfig", "label": "CompressionConfig (none / gzip / zstd)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt bewusst kein brotli und kein deflate. Level sind rein encoder-seitig, werden geclamped und stehen nicht auf dem Wire."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_zstd", "label": "zstd-Kompression", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bestes Verhaeltnis bei konkurrenzfaehiger Geschwindigkeit und asymmetrisch guenstigem Decode auf jedem Level - deshalb stark fuer lese-lastigen State."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_gzip", "label": "gzip-Kompression (Store-Default)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store-Default, weil es keine native Runtime-Unterstuetzung und keine Zusatz-Dependency braucht - node:zlib laeuft auf Bun, Node und Deno."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_ats1_manifest_header", "label": "ATS1-Manifest-Header mit Kompressions-Flag", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Dekompression wird ausschliesslich vom 2-Bit-Flag im Manifest gesteuert, nie von einem HTTP-Header. Weil jeder Body seinen Algorithmus selbst beschreibt, mischen none/gzip/zstd problemlos im selben Bucket."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_decompression_bomb_limit", "label": "Dekompressions-Limit (512 MiB Bomb-Schutz)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Security audit #3: wenige KB, die sich auf viele GB aufblaehen, duerfen beim Recovery nicht den Speicher sprengen. gzip und zstd reichen die Grenze ueber zlibs maxOutputLength an den Decoder durch, der Body wird also abgelehnt BEVOR sein Output allokiert ist; auf den beiden Pfaden ohne Option (Bun.zstdDecompressSync, fzstd) greift die Grenze erst nach dem Output und ist eher Korrektheitspruefung als Bomb-Schutz."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_withmaxdecompressedbytes", "label": "withMaxDecompressedBytes", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_fzstd_fallback", "label": "fzstd-Pure-JS-Decompress-Fallback", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kann nur dekomprimieren, nie schreiben, und deckelt die Backreference-Distanz bei 2^25 (32 MB) - zstd-Ultra-Level (>= 20) sind darauf evtl. nicht lesbar. Level <= 19 halten, wenn irgendein Leser ohne natives zstd laufen koennte."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_capability_probing_by_calling", "label": "Faehigkeit durch Aufrufen pruefen, nicht durch Existenzcheck", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auf Deno exportiert node:zlib zstd-Einsprungpunkte, hinter denen kein Binding steht. Ein Existenzcheck waere dort falsch positiv; das Aufrufen laesst die Meldung die fehlende Faehigkeit benennen und haelt den fzstd-Fallback darunter erreichbar."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_compress_before_encrypt", "label": "Komprimieren vor dem Verschluesseln", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ciphertext zu komprimieren ist sinnlos (hochentrop), und die feste Reihenfolge vermeidet zudem CRIME-artige Seitenkanaele."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_level_change_needs_no_migration", "label": "Level-Wechsel braucht keine Migration", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Level steht nicht auf dem Wire (das Manifest haelt den Algorithmus fest) und der Decompressor braucht es nie - gzip- und zstd-Frames sind selbst-beschreibend."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_tiny_payload_overhead", "label": "Kompression auf winzigen Objekten lohnt nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unter ~100 Bytes uebersteigen die Header des Compressors die Einsparungen; der Output kann groesser sein als der Input."}, {"id": "docs_src_content_docs_de_persistence_object_storage_compression_per_actor_compression_override", "label": "Per-Actor-compression()-Override", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_persistence_object_storage_compression_compressionconfig", "target": "docs_src_content_docs_de_persistence_object_storage_compression_zstd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_compression_compressionconfig", "target": "docs_src_content_docs_de_persistence_object_storage_compression_gzip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_compression_ats1_manifest_header", "target": "docs_src_content_docs_de_persistence_object_storage_compression_compressionconfig", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_compression_decompression_bomb_limit", "target": "docs_src_content_docs_de_persistence_object_storage_compression_withmaxdecompressedbytes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/compression.mdx", "source_location": null, "weight": 1.0}, 