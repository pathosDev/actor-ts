dx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_metrics", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_dead_letters_total", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_metrics", "target": "docs_src_content_docs_observability_metrics_stock_metrics_cluster_metrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_metrics", "target": "docs_src_content_docs_observability_metrics_stock_metrics_distributeddata_metrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_metrics", "target": "docs_src_content_docs_observability_metrics_stock_metrics_projection_metrics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_depth", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_size", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_wait_seconds", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_metrics", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_depth", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_metrics", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_size", "target": "docs_src_content_docs_observability_metrics_stock_metrics_cardinality_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_projection_metrics", "target": "docs_src_content_docs_observability_metrics_stock_metrics_cardinality_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_label_rule", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_dropped_total", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_label_rule", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_size", 