{"nodes": [{"id": "docs_src_content_docs_persistence_journals_libsql_libsqljournal", "label": "LibSqlJournal", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_libsqlsnapshotstore", "label": "LibSqlSnapshotStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_libsqldurablestatestore", "label": "LibSqlDurableStateStore", "file_type": "document", "rationale": "The first durable-state store in the SQLite family \u2014 the local SQLite backend ships journal + snapshot only.", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_registerlibsqlplugins", "label": "registerLibSqlPlugins", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_no_native_binding", "label": "No native binding", "file_type": "rationale", "rationale": "The @libsql/client driver speaks HTTP and WebSocket, so it runs on every supported runtime and inside edge sandboxes that cannot load native addons \u2014 the only SQLite-flavoured backend that works on Deno and at the edge.", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_sqlite_schema_compatibility", "label": "SQLite schema compatibility", "file_type": "rationale", "rationale": "The tables and statements are identical to the local SQLite backend (and Cloudflare D1), so a database moves between a local file and Turso in either direction without a migration.", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_interactive_transaction_append", "label": "Interactive-transaction append", "file_type": "rationale", "rationale": "The append reads the head and inserts inside one interactive transaction; the primary key translates SQLITE_CONSTRAINT into JournalConcurrencyError as a backstop, so the guarantee holds even when the transport cannot give strict isolation. Write transactions hold the server's write lock for roughly five seconds.", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_libsql_remote_databases_only", "label": "Remote databases only", "file_type": "rationale", "rationale": "A file: or :memory: URL is rejected at construction with a pointer to SqliteJournal, rather than letting the driver's HTTP entry point raise URL_SCHEME_NOT_SUPPORTED on the first append.", "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_journals_libsql_libsqljournal", "target": "docs_src_content_docs_persistence_overview_journal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/libsql.mdx", "source_location": null, "weight": 1.0}