{"nodes": [{"id": "docs_src_content_docs_de_observability_management_http_endpoints_management_endpoint_surface", "label": "Management-Endpunkt-Oberflaeche", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein kleiner Satz operativer Endpunkte: die meisten read-only, die Admin-Endpunkte opt-in und standardmaessig aus."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_health_endpoint", "label": "GET /health", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Liveness \u2014 200, wenn jeder Liveness-Check besteht, sonst 503 mit { status: DOWN, checks }."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_ready_endpoint", "label": "GET /ready", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readiness; clusterReady ist das Ergebnis von cluster-membership selbst, aus dem checks-Array zurueckgelesen statt separat berechnet \u2014 Flag und Check koennen sich also nie widersprechen. Ohne Cluster ist es true."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_members_endpoint", "label": "GET /cluster/members", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voller Membership-Snapshot mit Adresse, Status, Version und Rollen plus self."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_leader_endpoint", "label": "GET /cluster/leader", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leader-Adresse plus isSelf; leader ist null, bevor einer gewaehlt wurde."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_shards_endpoint", "label": "GET /cluster/shards", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shard-zu-Region-Allokation fuer einen sharded Typ \u2014 fuer die Verifikation gleichmaessiger Verteilung nach einem Rebalance und fuers Diagnostizieren heisser Regionen."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_metrics_endpoint", "label": "GET /metrics", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in via enableMetricsEndpoint; Prometheus-Textformat."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_leave_endpoint", "label": "POST /cluster/leave", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in; 202 mit dem Klartext-Body leaving, weil der Leave Fire-and-forget ist. Der Node laeuft durch leaving -> exiting -> removed und kann im selben Prozess nicht rejoinen \u2014 Restart zum Rejoinen."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_down_endpoint", "label": "POST /cluster/down", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in; force-downt ein Remote-Mitglied per Adresse, 202 mit { downed } oder 404 bei unbekannter oder bereits terminaler Adresse. Destruktiv und irreversibel \u2014 fuer Split-Brain-Recovery ohne Downing-Strategie und haengende unreachable-Mitglieder."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_topology_exposure_risk", "label": "Auch read-only legt Topologie offen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Member-Adressen, Rollen, Leader und Shard-Map sind interner Zustand (security audit #8) \u2014 der Management-Server gehoert an ein internes Interface gebunden und mit ipAllowlist und/oder auth geschuetzt, statt oeffentlich exponiert zu werden."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_auth_ipallowlist_policy_split", "label": "Policy-Trennung von auth und ipAllowlist", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auth wrappt nur die privilegierte Teilmenge; /health und /ready bleiben anonym, weil K8s-Probes nicht so leicht einen Authorization-Header mitschicken koennen \u2014 authProtectHealth deckt sie ein, wo das Deployment es garantiert. ipAllowlist wrappt jeden Endpunkt, weil Netzwerk-Isolation unabhaengig davon ist, wer authentifiziert ist (#312)."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_response_format_rules", "label": "Response-Format und Status-Codes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads und /cluster/down liefern JSON, /metrics Prometheus-text/plain, /cluster/leave einen Klartext-Body; Fehler sind Klartext, kein strukturiertes Objekt. 200 fuer Reads, 202 fuer Admin-Aktionen, 4xx fuer Client-Fehler, 503 wenn Cluster oder Health-Check nicht verfuegbar ist."}], "edges": [{"source": "docs_src_content_docs_de_observability_management_http_endpoints_management_endpoint_surface", "target": "docs_src_content_docs_de_observability_management_http_endpoints_health_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_management_http_endpoints_management_endpoint_surface", "target": "docs_src_content_docs_de_observability_management_http_endpoints_ready_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_management_http_endpoints_management_endpoint_surface", "target": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_members_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_management_http_endpoints_management_endpoint_surface", "target": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_leader_endpoint", "relation": "co