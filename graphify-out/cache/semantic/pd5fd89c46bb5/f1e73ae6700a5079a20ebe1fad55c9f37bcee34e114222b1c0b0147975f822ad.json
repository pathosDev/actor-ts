{"nodes": [{"id": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "label": "Singleton single-writer lease", "file_type": "concept", "rationale": "The manager only spawns after acquiring the lease, so two managers both claiming leadership race on it and only one wins \u2014 the atomic exactly-one-holder guarantee beyond gossip's eventual consistency.", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_startsingletonoptions", "label": "StartSingletonOptions", "file_type": "code", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "code", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_lease_loss_handling", "label": "Lease loss handling", "file_type": "rationale", "rationale": "On revocation the manager stops the singleton immediately with no graceful drain and retries acquire periodically, so a brief backend hiccup reads as a brief actor restart.", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_failover_window", "label": "Failover window equals the lease TTL", "file_type": "rationale", "rationale": "A crashed holder's lease only frees at TTL expiry, so during that gap no singleton exists anywhere and messages dead-letter; a shorter TTL buys faster failover at the price of more renewal traffic.", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_protection_level", "label": "Reading the protection level", "file_type": "rationale", "rationale": "No downing and no lease is best-effort, downing alone is strong on stable networks, downing plus lease is paranoid-safe \u2014 use both where dual execution would double-charge customers or double-publish events.", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_singleton_vs_sharding_lease", "label": "Singleton-lease versus sharding-lease", "file_type": "rationale", "rationale": "Singleton failover is more disruptive because the singleton is the workload; sharding failover only queues new allocations while existing entities keep processing.", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_rbac_lease_permissions", "label": "RBAC for lease CRUD", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_startsingletonoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "d