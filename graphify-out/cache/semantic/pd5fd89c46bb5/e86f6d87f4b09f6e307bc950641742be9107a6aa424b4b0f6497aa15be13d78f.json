{"nodes": [{"id": "docs_src_content_docs_de_http_websocket_websocket_directive", "label": "websocket()-Direktive", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_websocketserveractor", "label": "WebsocketServerActor", "file_type": "concept", "rationale": "Ein Actor pro Route \u2014 der Hub sieht die Events jeder Verbindung serialisiert. Die Typparameter sind aus Sicht des Servers zu lesen: TOut sendet er, TIn empfaengt er dekodiert.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_websocketconnection", "label": "WebsocketConnection", "file_type": "concept", "rationale": "Erweitert ActorRef, ist aber bewusst nicht death-watchbar; onClientDisconnected ist das einzige geordnete End-of-Life-Signal pro Verbindung.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_websocketrouteoptions", "label": "WebsocketRouteOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_maxframebytes_two_layers", "label": "maxFrameBytes auf zwei Ebenen", "file_type": "rationale", "rationale": "Im Transport wird der Frame abgewiesen, waehrend er eintrifft, damit ein feindlicher Peer nicht 16 MiB (Bun) oder 100 MiB (ws) Pufferung erzwingt; im Connection-Actor wird derselbe Wert am vollstaendigen Frame vor dem Dekodieren geprueft und mit 1009 geschlossen. Nur die zweite Ebene ist die Zusage. Ein Server hat einen Transport fuer alle WS-Routen, deshalb nimmt der Transport das groesste Limit.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_transport_limit_gaps", "label": "Zwei Laufzeit/Backend-Paare ohne Transport-Limit", "file_type": "rationale", "rationale": "Deno.upgradeWebSocket bietet kein Payload-Limit; auf Bun loest der Spezifizierer ws auf Buns eingebauten Shim auf, der maxPayload annimmt und zurueckliefert, aber nicht durchsetzt (gemessen: 2-MiB-Frame gegen 1-MiB-Limit erreichte den Handler). Die Zusage gilt weiter, aber der Speicher ist ausgegeben, bevor abgelehnt wird \u2014 davor gehoert ein Proxy mit eigenem Frame-Limit.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_origin_allowlist", "label": "Origin-Allowlist (CSWSH-Schutz)", "file_type": "rationale", "rationale": "Browser haengen Cookies automatisch an einen WebSocket-Upgrade an, eine Route mit ambienter Auth ist damit hijackbar. Ein gelisteter Origin fehlt zu haben, ist erlaubt (Nicht-Browser-Clients), weil CSWSH ein reiner Browser-Angriff ist; BearerTokenAuth ist bereits geschuetzt, weil Browser beim Handshake keinen Authorization-Header setzen koennen.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_middleware_at_upgrade", "label": "Middleware laeuft zur Upgrade-Zeit", "file_type": "rationale", "rationale": "withMiddleware laeuft einmal gegen den HTTP-Upgrade-Request, nicht pro Nachricht \u2014 eine ablehnende Middleware verhindert das Upgrade. Backend-eigene Middleware laeuft ebenfalls; der Guard des Frameworks laeuft nach allen anderen und hat damit das letzte Wort.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_codecs", "label": "WebSocket-Codecs (jsonCodec, rawCodec)", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_per_connection_ordering", "label": "Reihenfolge pro Verbindung", "file_type": "rationale", "rationale": "onClientConnected, dann null oder mehr onMessage in Frame-Reihenfolge, dann genau ein onClientDisconnected. Weil alles auf einem einzelnen Actor laeuft, gilt die uebliche Garantie des Actor-Modells: keine nebenlaeufige Handler-Ausfuehrung, keine Locks.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_backpressure_policy", "label": "Backpressure bei langsamen Clients", "file_type": "rationale", "rationale": "Ab maxBufferedBytes verwirft die Verbindung Frames (Default drop) oder wird geschlossen. Broadcasts an viele langsame Clients sind der Ort, wo das zubeisst.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_internal_connection_actor", "label": "Interner Connection-Actor pro Socket", "file_type": "rationale", "rationale": "onReceive ist versiegelt: pro Verbindung spawnt das Framework ein Kind des Server-Actors, das den Socket besitzt, Frames dekodiert und beim Schliessen automatisch gestoppt wird. Verbindungen sind keine per-Verbindung-Child-Actors mehr, die der Anwender spawnt.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_websocket_hono_node_ws_floor", "label": "@hono/node-ws ab 1.2.0", "file_type": "rationale", "rationale": "Das Limit wird auf den ws-Server geschrieben, den @hono/node-ws erst ab 1.2.0 als wss herausgibt. Statt einen unbegrenzten Socket zu binden, verweigert das Backend den Aufbau der WebSocket-Bruecke und nennt die Version im Fehler.", "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_websocket_websocket_directive", "target": "docs_src_content_docs_de_http_websocket_websocketserveractor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_websocket_websocket_directive", "target": "docs_src_content_docs_de_http_websocket_websocketrouteoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_websocket_websocketserveractor", "target": "docs_src_content_docs_de_http_websocket_websocketconnection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/websocket.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_websocket_maxframebytes_two_layers", "target": "docs_src_content_docs_de_http_websocket_websocketrouteoptions", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/conte