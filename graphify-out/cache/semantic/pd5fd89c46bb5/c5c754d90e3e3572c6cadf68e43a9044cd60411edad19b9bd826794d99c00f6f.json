{"nodes": [{"id": "docs_src_content_docs_de_operations_deployment_docker_compose_docker_compose_deployment", "label": "Docker-Compose-Multi-Node-Cluster", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/docker-compose.mdx", "source_location": "Warum Docker Compose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuer lokale Entwicklung: Cluster-Verhalten ohne K8s testen, produktionsnahe Topologie reproduzieren. Nicht fuer Produktion - Compose fehlen Cross-Host-Scheduling, Rolling Updates, health-basiertes Replacement und Autoscaling."}, {"id": "docs_src_content_docs_de_operations_deployment_docker_compose_configseedprovider", "label": "ConfigSeedProvider (statische Seed-Liste)", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/docker-compose.mdx", "source_location": "Cluster-Discovery", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Seed-Liste jedes Nodes enthaelt sich selbst plus alle Peers; Composes DNS loest die Namen zu Container-IPs auf. Auf 4 Nodes zu skalieren erfordert ein Update der Env-Vars auf allen Containern - fuer dynamische Groessen den DNS-Seed-Provider nehmen."}, {"id": "docs_src_content_docs_de_operations_deployment_docker_compose_shared_journal", "label": "Geteiltes Journal fuer Entity-Migration", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/deployment/docker-compose.mdx", "source_location": "Geteilte Persistence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein geteiltes Journal laesst sharded Entities natuerlich zwischen Nodes migrieren. Mit SQLite pro Node koennten sie es nicht - jeder Node kennt nur seine eigene Datei."}], "edges": [{"source": "docs_src_content_docs_de_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_de_operations_deployment_docker