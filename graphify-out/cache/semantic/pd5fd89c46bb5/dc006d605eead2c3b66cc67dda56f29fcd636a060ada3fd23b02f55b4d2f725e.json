{"nodes": [{"id": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance", "label": "Rebalance", "file_type": "document", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absichtlich konservativ: gepufferte Nachrichten warten auf HandOffComplete, damit nichts an einer halb-verschobenen Entity vorbei rast."}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_handoff", "label": "HandOff-Direktive", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_handoffcomplete", "label": "HandOffComplete", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance_triggers", "label": "Drei Ausl\u00f6ser f\u00fcr Rebalance", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_region_stopping", "label": "Eine Region, die stoppt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ohne diesen Pfad blieben Shards verwaist: der Koordinator nannte die gestoppte Region weiterhin als Zuhause, und die Kandidatenmenge wird ohne Liveness-Pr\u00fcfung aus der Registry abgeleitet, der Rebalance-Tick sah also einen ausgeglichenen Cluster."}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_directive_authorization", "label": "Wer einen Handoff anordnen darf", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Frame muss \u00fcber den Envelope-Pfad der Region kommen, gestempelt mit dem authentifizierten Peer \u2014 nie mit einem Feld aus der Payload \u2014, und dieser Peer muss der aktuelle Leader sein. Vorher konnte jeder Peer mit einem kleinen Frame die Entities eines Shards abr\u00e4umen. Das ist Autorisierung, keine Authentifizierung."}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_ownership_check", "label": "Besitz und Einmaligkeit des Handoffs", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Besitz richtet sich nach der Allokation, nicht danach, ob der Shard-Actor gerade l\u00e4uft; ein passivierter Shard geh\u00f6rt weiterhin dazu und wird weiterhin abgegeben."}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_handofftimeoutms", "label": "handOffTimeoutMs", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_force_reallocation", "label": "Zwangsweise Neuallokation", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_split_brain_entities", "label": "Split-Brain-Entities", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_buffered_messages", "label": "Gepufferte Nachrichten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine w\u00e4hrend des Handoffs gesendete Nachricht ist verz\u00f6gert, nicht verloren; der Puffer ist unbegrenzt. Das Nachfragen nach Abschluss ist wichtig, weil der Koordinator eine neue Platzierung nur dem neuen Besitzer und Regionen mit offener Anfrage verk\u00fcndet."}, {"id": "docs_src_content_docs_de_cluster_sharding_rebalance_work_shedding", "label": "Rebalance ist Arbeitsabgabe", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance", "target": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance_triggers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance_triggers", "target": "docs_src_content_docs_de_cluster_sharding_rebalance_region_stopping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/cluster/sharding/rebalance.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance", "target": "docs_src_content_docs_de_cluster_sharding_rebalance_handoff", "relation": "references", "confidence": "EXTRACTED", "co