", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_actor_dead_letters_total", "target": "docs_src_content_docs_operations_dead_letters_deadletterqueue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_metrics", "target": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_exporter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_metrics", "target": "docs_src_content_docs_observability_overview_observability_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_stock_metrics_stock_label_rule", "target": "docs_src_content_docs_observability_metrics_core_metrics_cardinality_discipline", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/observability/metrics/stock-metrics.mdx", "source_location": null, "weight": 1}], "hyperedges": []}