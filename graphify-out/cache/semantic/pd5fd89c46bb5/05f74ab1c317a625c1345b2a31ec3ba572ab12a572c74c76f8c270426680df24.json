{"nodes": [{"id": "docs_src_content_docs_observability_overview_observability_overview", "label": "Observability overview (page)", "file_type": "document", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_overview_four_pillars", "label": "The four observability pillars", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logging is always on; metrics, tracing and management are extensions that do not run unless you reach for them, so an app that ignores them carries no unused metric buffers or unstarted trace exporters."}, {"id": "docs_src_content_docs_observability_overview_multisinklogger", "label": "MultiSinkLogger", "file_type": "concept", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records are built once, fanned out to every sink whose level passes, delivered on a bounded queue and flushed at termination, so a destination that breaks cannot take the others or the application with it."}, {"id": "docs_src_content_docs_observability_overview_sink_selection", "label": "Start with OTLP", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One endpoint format reaches Loki 3+, Parseable, SigNoz, Datadog, Axiom, Honeycomb, New Relic and every Collector, so a platform-specific sink only earns its place where OTLP does not reach or loses something. journald and the Windows Event Log are deliberately absent \u2014 stdout NDJSON already reaches them, and a dedicated sink would add a binary protocol for no reach."}, {"id": "docs_src_content_docs_observability_overview_metricsextension", "label": "MetricsExtension", "file_type": "concept", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counter, gauge, histogram and timer, each with name plus labels, exported through PrometheusExporter or PromClientAdapter."}, {"id": "docs_src_content_docs_observability_overview_tracingextension", "label": "TracingExtension", "file_type": "concept", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every actor message gets a span carrying the actor path, message kind, parent context and onReceive duration; spans chain across tells, giving one trace per logical request."}, {"id": "docs_src_content_docs_observability_overview_managementroutes", "label": "managementRoutes", "file_type": "concept", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_overview_what_to_wire_up_first", "label": "What to wire up first", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs somewhere durable, then metrics, then health checks for K8s, then tracing last, because tracing costs exporter configuration, sampling and money for diminishing returns on a simple app."}, {"id": "docs_src_content_docs_observability_overview_exposing_metrics_publicly", "label": "Exposing /metrics publicly", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A metrics endpoint leaks exact request volumes and error counts, so the management server belongs behind a private network, VPN or authenticated proxy."}, {"id": "docs_src_content_docs_observability_overview_tracing_sampling_hazard", "label": "Tracing every message at high throughput", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A million messages per second traced without sampling is a million spans per second, enough to swamp most collectors; the framework records spans regardless and the exporter decides what to send."}], "edges": [{"source": "docs_src_content_docs_observability_overview_observability_overview", "target": "docs_src_content_docs_observability_overview_four_pillars", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_four_pillars", "target": "docs_src_content_docs_observability_overview_multisinklogger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_four_pillars", "target": "docs_src_content_docs_observability_overview_metricsextension", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_four_pillars", "target": "docs_src_content_docs_observability_overview_tracingextension", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_four_pillars", "target": "docs_src_content_docs_observability_overview_managementroutes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_sink_selection", "target": "docs_src_content_docs_observability_overview_multisinklogger", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_what_to_wire_up_first", "target": "docs_src_content_docs_observability_overview_four_pillars", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_exposing_metrics_publicly", "target": "docs_src_content_docs_observability_overview_managementroutes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_tracing_sampling_hazard", "target": "docs_src_content_docs_observability_overview_tracingextension", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_overview_managementroutes", "target": "docs_src_content_docs_observability_management_overview_managementroutes", "relat