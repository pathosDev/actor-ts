{"nodes": [{"id": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "label": "ConsumerController", "file_type": "concept", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Receives Delivery envelopes, dedups on (producerId, seq), calls the handler and auto-acks on resolve. The only setting is the handler \u2014 dedup state, buffer sizing and consumer id are all internal."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_contiguous_high_watermark", "label": "Contiguous high-watermark dedup", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A contiguous watermark plus a set of already-delivered out-of-order seqs above it; every arrival is checked against both, duplicates skip the handler and re-ACK. There is no fixed buffer size and no silent drop \u2014 the producer keeps retransmitting until the handler resolves."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_throw_is_the_only_nack", "label": "Throwing is the only NACK", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no explicit NACK message: throwing or rejecting suppresses the ACK, the producer's resendTimeout fires and the same seq is sent again."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_per_producer_dedup", "label": "Per-producer dedup state", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate (contiguous, above) pair per producerId, so two producers' seq spaces cannot collide. The handler only sees the body; producerId and seq stay the controller's business."}], "edges": [{"source": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "target": "docs_src_content_docs_de_delivery_consumer_controller_contiguous_high_watermark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_consumer_controller_throw_is_the_only_nack", "target": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_consumer_controller_per_producer_dedup", "target": "docs_src_content_docs_de_delivery_consumer_controller_contiguous_high_watermark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "target": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "target": "docs_src_content_docs_de_cluster_refs_across_nodes_remoteactorref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/consum