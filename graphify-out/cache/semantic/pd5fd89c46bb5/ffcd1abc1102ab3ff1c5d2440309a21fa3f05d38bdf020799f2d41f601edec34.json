{"nodes": [{"id": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "label": "Gossip-Replikation von DistributedData", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alle gossipIntervalMs waehlt jeder Node EINEN zufaelligen erreichbaren Peer und sendet ihm einen vollstaendigen Snapshot; der Peer merged und benachrichtigt seine Subscriber bei Aenderung. Zufaellige statt Round-Robin-Auswahl vermeidet synchronisierte Wellen und konvergiert typischerweise in O(log N) Runden, in der Praxis schneller, weil Gossip multi-hop ist. Gossip ueberbrueckt keine Partitionen."}, {"id": "docs_src_content_docs_de_distributed_data_replication_gossipinterval", "label": "gossipIntervalMs", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 1 s als Balance zwischen Propagationsgeschwindigkeit und Bandbreite; 250-500 ms fuer latenz-empfindlichen State, 5-10 s fuer sehr grosse Cluster. Auch aus der application.conf setzbar (actor-ts.distributed-data.gossip-interval), wobei der Builder gewinnt."}, {"id": "docs_src_content_docs_de_distributed_data_replication_full_state_gossip", "label": "Full-State-Gossip ohne Delta-Tracking", "file_type": "rationale", "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein Digest, keine Empfangs-Historie pro Peer, kein Delta - jedes Gossip traegt die komplette Menge. Damit ist das Volumen proportional zur Gesamt-State-Groesse statt zur Update-Rate: ein kleiner Counter kostet fast nichts, egal wie oft er inkrementiert wird, eine Million-Eintraege-Map kostet ihre volle Groesse auch im Idle. Bewusst simpel und billig zu implementieren; bei grossem Store das Intervall erhoehen."}, {"id": "docs_src_content_docs_de_distributed_data_replication_crdt_tombstones", "label": "CRDT-Tombstones", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein entferntes ORSet-Element oder ein null-Register in einer LWWMap wird nie garbage-collected, damit ein veraltetes Gossip einen entfernten Key nicht wiederauferstehen lassen kann. Ueber einen langlebigen Store mit starkem Churn ist die Tombstone-Akkumulation der praktische Kostenpunkt. Beim MemberRemoved tut DistributedData nichts - es gibt keinen Zustand pro Peer aufzuraeumen."}], "edges": [{"source": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "target": "docs_src_content_docs_de_distributed_data_replication_gossipinterval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_full_state_gossip", "target": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "target": "docs_src_content_docs_de_distributed_data_replication_crdt_tombstones", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "target": "docs_src_content_docs_de_distributed_data_overview_dd_subscribe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "target": "docs_src_content_docs_de_distributed_data_quorum_reads_writes_getasync", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "target": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_crdt_tombstones", "target": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_crdt_tombstones", "target": "docs_src_content_docs_de_distributed_data_crdt_types_maps_lwwmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "target": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/replication.mdx", "source_location": null, "weight": 1}], "hyperedges": []}