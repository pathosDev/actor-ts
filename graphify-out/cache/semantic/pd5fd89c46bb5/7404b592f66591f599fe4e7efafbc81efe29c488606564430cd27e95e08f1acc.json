covery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_cluster_router_routee_discovery", "target": "docs_src_content_docs_de_cluster_overview_membership_states", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/de/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_cluster_router_consistent_hashing", "target": "docs_src_content_docs_cluster_sharding_sharded_daemon_process_cardinality_rule", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/de/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_cluster_router_empty_routee_set", "target": "docs_src_content_docs_cluster_singleton_overview_buffersize", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}