{"nodes": [{"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "label": "Single-writer lease", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The middle ground between replicated availability and single-writer consistency: exactly one replica holds the lease and writes, the others read, and if the holder fails another acquires. Effectively a failover-capable single-writer system with replicated-ES recovery semantics underneath."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "label": "isLeaseHolder write gate", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## How read-only replicas behave", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The write gate is a cached local getter (sub-microsecond), so the lease does not slow normal writes - they proceed locally without a network round-trip per call. persist() also throws for a non-holder as a backstop."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_onleaselostreplicated", "label": "onLeaseLost(reason) on a replica", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops the replica back to read-only; another replica eventually acquires the lease."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_readonlyreplica", "label": "Read-only replica behavior", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## How read-only replicas behave", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A non-holder still replays the journal, maintains state and answers read-side queries, but rejects writes. That is harsh for a client routing writes transparently - the common pattern is a proxy actor watching lease ownership."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_failoverwindow", "label": "Failover window = lease TTL", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Failover sequence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typically 15-30 s. A shorter TTL means faster failover but more renewal traffic; renewal runs every ttl/3."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_resolverstillrequired", "label": "A resolver is still required with a lease", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Conflict-resolver still needed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "During the failover window both the old and the new writer might briefly write, and a partition between the lease backend and a replica lets a replica that thinks it holds the lease write while another actually holds it. The lease reduces conflict frequency to near-zero but does not eliminate it."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Lease backends", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production lease backend on Kubernetes, using native Lease CRDs."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_inmemorylease", "label": "InMemoryLease", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Lease backends", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For tests."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_leasebackendspof", "label": "The lease backend becomes a SPOF", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Lease backend availability", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Putting the lease backend (K8s API server, etcd) in the write path means its availability bounds writes: backend down, no replica can acquire, no writes. For multi-region active-active, use a region-replicated lease backend."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_leaseresolvermismatch", "label": "Lease + conflict-resolver mismatch", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Lease + conflict resolver mismatch", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An expensive merge resolver is unnecessary when the lease keeps conflicts near-zero; keep the resolver simple and safe, because lease-guarded systems rarely exercise its complex paths."}], "edges": [{"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_onleaselostreplicated", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_readonlyreplica", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_failoverwindow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_resolverstillrequired", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_resolverstillrequired", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Conflict-resolver still needed", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_kuberneteslease", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_inmemorylease", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_leasebackendspof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_leaseresolvermismatch", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## Lease + conflict resolver mismatch", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_overview_replicatedeventsourcing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "intro", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_overview_replicaid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "intro example", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_singlewriterlease", "target": "docs_src_content_docs_persistence_persistent_actor_lease", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "intro", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "target": "docs_src_content_docs_persistence_persistent_actor_lostracebackstop", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "## How read-only replicas behave", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_single_writer_lease_onleaselostreplicated", "target": "docs_src_content_docs_persistence_persistent_actor_onleaselost", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": "intro", "weight": 1.0}], "hyperedges": []}