{"nodes": [{"id": "docs_src_content_docs_intro_why_actors_why_actors", "label": "Why actors?", "file_type": "document", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_shared_mutable_state_race", "label": "Shared mutable state under concurrency", "file_type": "concept", "rationale": "The Promise/async-await model gives parallelism but no synchronization primitive: two concurrent deposits both read 0 and one write is lost. In the small you reach for mutexes, in the medium a queue, in the large you start hand-rolling actor-ish patterns.", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_actors_encapsulate_state", "label": "Actors encapsulate state", "file_type": "concept", "rationale": "The actor IS the serialization boundary \u2014 count++ is safe because messages run sequentially, so no mutex, lock or atomic is needed.", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_messages_are_the_only_contract", "label": "Messages are the only contract", "file_type": "concept", "rationale": "Holding only an ActorRef with a tell verb looks restrictive until you see it makes asynchrony, backpressure and location transparency free.", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_backpressure", "label": "Backpressure via mailbox length", "file_type": "concept", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_supervisors_handle_failure", "label": "Supervisors handle failure as a first-class concern", "file_type": "concept", "rationale": "Configure Restart / Resume / Stop / Escalate per actor class once and every failure is handled the same way \u2014 no more 'did I remember to wrap that in try?'", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_counter", "label": "Counter actor sample", "file_type": "concept", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_when_not_to_use_actors", "label": "When NOT to use actors", "file_type": "rationale", "rationale": "Stateless request/response services, pure data transformations, and code that must block synchronously all fit poorly \u2014 actor overhead (mailbox bookkeeping, supervisor tree) is wasted on workloads with nothing to encapsulate.", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_why_actors_progressive_adoption", "label": "Progressive adoption from in-process to cluster", "file_type": "concept", "rationale": "A first iteration runs entirely in-process, a second moves hot-path actors to a worker pool, a third introduces sharding across machines \u2014 the actor's own code does not change.", "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_shared_mutable_state_race", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_actors_encapsulate_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_messages_are_the_only_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_backpressure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_supervisors_handle_failure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_counter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/why-actors.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_why_actors_why_actors", "target": "docs_src_content_docs_intro_why_actors_when_not_to_use_actors", "relation": "references", "confid