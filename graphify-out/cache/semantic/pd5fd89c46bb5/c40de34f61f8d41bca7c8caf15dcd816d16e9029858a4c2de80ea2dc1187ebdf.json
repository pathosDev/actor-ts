{"nodes": [{"id": "docs_src_content_docs_de_persistence_projections_projectionactor", "label": "ProjectionActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wickelt die Query-API ein mit Offset-Persistenz, Supervised-Restart, Shutdown-Bewusstsein und konfigurierbarem Retry/Backoff - fuer Produktion; die Query-API direkt fuer Einmal-Skripte und Ad-hoc-Admin-Queries."}, {"id": "docs_src_content_docs_de_persistence_projections_bytagprojectionoptions", "label": "ByTagProjectionOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_projections_bypersistenceidprojectionoptions", "label": "ByPersistenceIdProjectionOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Actor pro persistenceId - fuer hunderte oder tausende langlebige Entities, nicht fuer Millionen kurzlebiger. Dort ist eine Tag-Projektion die Antwort."}, {"id": "docs_src_content_docs_de_persistence_projections_offsetstore", "label": "OffsetStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuer Produktion den Offset-Store mit dem Read-Model kollokieren, sodass sie zusammen abstuerzen - das minimiert das Re-Processing-Fenster."}, {"id": "docs_src_content_docs_de_persistence_projections_inmemoryoffsetstore", "label": "InMemoryOffsetStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_projections_durablestateoffsetstore", "label": "DurableStateOffsetStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_projections_at_least_once_delivery", "label": "At-least-once Delivery", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Cursor wird erst nach dem Handler gespeichert; ein Crash dazwischen liefert dasselbe Event erneut. Handler muessen idempotent sein - UPSERT statt blindem INSERT, oder die sequenceNr als Per-pid-Dedup-Key, die pro pid monoton ist."}, {"id": "docs_src_content_docs_de_persistence_projections_head_of_line_blocking", "label": "Ein fehlschlagender Handler blockiert den Kopf der Warteschlange", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Cursor rueckt erst vor, nachdem handle zurueckgekehrt ist - jedes spaetere Event wartet hinter dem fehlgeschlagenen. recoveryStrategy entscheidet, wie lange das so bleibt."}, {"id": "docs_src_content_docs_de_persistence_projections_recoverystrategy", "label": "recoveryStrategy (retry-and-fail / retry-and-skip / fail / skip)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default retry-and-fail: eine still veraltete View ist schlimmer als eine sichtbar gestoppte. Retries sind verzoegert und verdoppeln sich bis maxRetryBackoffMs."}, {"id": "docs_src_content_docs_de_persistence_projections_fail_stops_the_actor", "label": "`fail` stoppt den Actor, statt den Fehler entkommen zu lassen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Supervisor der Projektions-Gruppe startet seine Kinder neu; ein entkommender Fehler wuerde denselben Cursor neu laden und am selben Event scheitern - eine Restart-Schleife, die lauter und kein bisschen nuetzlicher ist. Eine gestoppte Projektion behaelt ihren Cursor."}, {"id": "docs_src_content_docs_de_persistence_projections_onfailure_hook", "label": "onFailure-Hook", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das strukturierte Signal fuer Alerting. Ein Hook, der selbst wirft, wird geloggt und verschluckt - ein kaputter Reporter darf die Projektion nicht mitreissen."}, {"id": "docs_src_content_docs_de_persistence_projections_dead_letter_for_skipped_events", "label": "Dead Letter fuer uebersprungene Events", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishen ist standardmaessig alles, was passiert - ohne Abonnent ist das Event weg. Die Dead-Letter-Queue bewahrt sie stattdessen auf, filterbar nach der ueberspringenden Projektion."}, {"id": "docs_src_content_docs_de_persistence_projections_projection_metrics", "label": "Projektions-Metriken (stalled / failures_total / events_skipped_total)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs geben eine Error-Zeile beim Beginn und beim Ende einer Fehlerserie; die Retries dazwischen gehen nach debug, sodass eine tagelang festhaengende Projektion zwei Error-Zeilen kostet statt einer pro Poll."}, {"id": "docs_src_content_docs_de_persistence_projections_fanout_via_allpersistenceids", "label": "Fan-out ueber allPersistenceIds", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Schleife endet nie - in einem eigenen Task laufen lassen und beim Shutdown herausbreaken. Fuer einen einmaligen Backfill stattdessen currentPersistenceIdsPaginated."}, {"id": "docs_src_content_docs_de_persistence_projections_many_projections_one_journal", "label": "Mehrere Projektionen, dasselbe Journal", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede haelt ihren eigenen Offset-Cursor und liest unabhaengig - ein Event-Stream, viele abgeleitete Views, keine an die andere gekoppelt. Das ist die Staerke von Event Sourcing."}], "edges": [{"source": "docs_src_content_docs_de_persistence_projections_projectionactor", "target": "docs_src_content_docs_de_persistence_projections_bytagprojectionoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/projections.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_projections_projectionactor", "target": "docs_src_content_docs_de_persistence_projections_bypersistenceidprojectionoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source