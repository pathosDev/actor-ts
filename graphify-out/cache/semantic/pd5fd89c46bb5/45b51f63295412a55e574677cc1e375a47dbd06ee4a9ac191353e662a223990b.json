{"nodes": [{"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "label": "AllocationStrategy", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two entry points: allocate() on first contact with a shard id, rebalance() every rebalanceIntervalMs. allocate is bounded by numShards so even an expensive one is fine; rebalance should stay under ~100 ms so it does not block the coordinator."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_hashallocationstrategy", "label": "HashAllocationStrategy", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "shardId mod sorted-candidates \u2014 deterministic, stateless, minimal rebalance; the sensible default while you measure whether anything smarter is needed. Does not balance by load or compensate for slow nodes."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_leastshardallocationstrategy", "label": "LeastShardAllocationStrategy", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts shards, not work: two shards with very different workloads look identical. Throttled by maxSimultaneousRebalance, so a 100-shard cluster gaining a node needs ~33 passes to converge."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_rebalancethreshold", "label": "rebalanceThreshold", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Higher means less churn and more tolerance for imbalance; 1 lets any imbalance trigger a rebalance."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_maxsimultaneousrebalance", "label": "maxSimultaneousRebalance", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep it low (<= 5) for big-state workloads: every shard move stops entities, waits for the ack, allocates a new home, respawns and replays journals."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_coordinator_side_determinism", "label": "Coordinator-side strategy determinism", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The strategy runs inside the coordinator, a singleton on the cluster leader, so it must be deterministic enough that two coordinators mid-handover converge on the same decision \u2014 or at least not undo each other's work."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_no_least_load_strategy", "label": "No built-in least-load strategy", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing ships that reads per-node CPU or memory; a custom strategy is the only route to genuinely load-aware allocation. The built-ins cover ~95% of cases, so do not reach for a custom one pre-emptively."}, {"id": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_strategy_blind_to_remember_entities", "label": "Strategies are not synchronised with the entity store", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rememberEntities influences only the shard count, never placement \u2014 a node full of lazily remembered entities looks exactly as loaded as one running active ones."}], "edges": [{"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_hashallocationstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_leastshardallocationstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_leastshardallocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_rebalancethreshold", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_leastshardallocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_maxsimultaneousrebalance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_coordinator_side_determinism", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_no_least_load_strategy", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_leastshardallocationstrategy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_strategy_blind_to_remember_entities", "target": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentities", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_rebalance_rebalance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_overview_sharding_coordinator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_leastshardallocationstrategy", "target": "docs_src_content_docs_de_cluster_sharding_sharded_daemon_process_shardeddaemonprocess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/allocation-strategy.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}