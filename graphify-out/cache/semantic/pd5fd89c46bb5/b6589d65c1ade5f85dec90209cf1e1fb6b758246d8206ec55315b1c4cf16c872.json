{"nodes": [{"id": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_exporter", "label": "Prometheus exporter", "file_type": "document", "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_metrics_prometheus_exporter_exportprometheus", "label": "exportPrometheus", "file_type": "concept", "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns the in-process registry into a single string in Prometheus 0.0.4 exposition format, ready to serve from a scrape endpoint."}, {"id": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_text_format", "label": "Prometheus text exposition format", "file_type": "concept", "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One line per series for counters and gauges; for histograms one bucket line per bound plus count and sum."}, {"id": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_naming_conventions", "label": "Prometheus naming conventions", "file_type": "concept", "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counters end in _total, histograms carry the unit in the name, _count and _sum are framework-appended suffixes, and labels are snake_case. The framework does not enforce these, but Prometheus tooling expects them."}, {"id": "docs_src_content_docs_observability_metrics_prometheus_exporter_scrape_cadence", "label": "Scrape cadence versus gauge update rate", "file_type": "concept", "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prometheus only sees a value at scrape time and computes counter rates from successive scrapes, so a fast-changing gauge may be stale when scraped - that is fine, since Prometheus is eventually consistent with its samples. Storage scales with series count times scrape interval, so bound label cardinality before adding labels."}], "edges": [{"source": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_exporter", "target": "docs_src_content_docs_observability_metrics_prometheus_exporter_exportprometheus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_exporter", "target": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_text_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_exporter", "target": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_naming_conventions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/metrics/prometheus-exporter.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_metrics_prometheus_exporter_prometheus_exporter", "target": "docs_src_content_docs_observability_metrics_prometheus_exporter_scrape_cadence", "r