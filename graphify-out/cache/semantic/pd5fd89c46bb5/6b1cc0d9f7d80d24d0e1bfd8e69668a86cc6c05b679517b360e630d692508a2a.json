{"nodes": [{"id": "docs_src_content_docs_io_websocket_websocket", "label": "WebsocketClientActor page", "file_type": "document", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_websocket_websocketclientactor", "label": "WebsocketClientActor", "file_type": "concept", "rationale": "An abstract subclass-first actor: TOut is what this client sends, TIn the decoded server messages. It uses the runtime's native WebSocket (no ws peer dep), which like the browser API allows no custom handshake headers \u2014 pass credentials via query parameter or subprotocol.", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_websocket_websocketcodec", "label": "WebSocket codec (jsonCodec / rawCodec)", "file_type": "concept", "rationale": "jsonCodec() is the default and accepts a validate hook for zod-style runtime validation; rawCodec() is the escape hatch for binary protocols where TOut = TIn = WebsocketFrame.", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_websocket_maxframebytes", "label": "maxFrameBytes inbound cap", "file_type": "concept", "rationale": "Enforced on the RAW frame before decode (1 MiB default). An oversize frame is dropped with one warning per frame \u2014 so the peer decides how often that line is written.", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_websocket_redactedurllabel", "label": "redactedUrlLabel connection label", "file_type": "rationale", "rationale": "The warning names the connection by a redacted label rather than by url: userinfo and query string are stripped because a WebSocket endpoint is commonly authenticated with a ?token=..., and the path is kept because it is what tells two connections to the same host apart.", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_websocket_ping_keep_alive", "label": "Application-level ping keep-alive", "file_type": "concept", "rationale": "The protocol-level WebSocket ping control frame is handled by the runtime; the application-level ping every pingIntervalMs exists for proxies that inspect payload rather than frames and would otherwise close an idle connection.", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_websocket_websocketsend", "label": "websocketSend helper", "file_type": "concept", "rationale": "Other actors do not call send directly; they push a typed send through the ref with websocketSend, which replaced the removed { kind: 'subscribe' | 'send' } command interface of the old WebsocketActor.", "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_websocket_websocketclientactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_websocket_websocketcodec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_websocket_maxframebytes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_websocket_redactedurllabel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_websocket_ping_keep_alive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_websocket_websocketsend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_overview_io_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_sse_sse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/websocket.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_websocket_websocket", "target": "docs_src_content_docs_io_broker_actor_base_broker_actor_base", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "s