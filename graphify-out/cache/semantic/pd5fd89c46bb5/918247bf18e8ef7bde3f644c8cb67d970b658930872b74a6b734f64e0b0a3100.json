{"nodes": [{"id": "docs_src_content_docs_persistence_migration_wrap_legacy_wrapeventasenvelope", "label": "wrapEventAsEnvelope", "file_type": "document", "rationale": "The pure, idempotent per-row primitive: an event that already looks like an envelope is returned unchanged, so re-running a migration built on it is safe.", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_wrap_legacy_wrapstateasenvelope", "label": "wrapStateAsEnvelope", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_wrap_legacy_migrateinmemoryjournal", "label": "migrateInMemoryJournal", "file_type": "document", "rationale": "Does the whole walk-and-rewrite for the in-memory journal, preserving sequence numbers, timestamps and tags. It relies on an internal _remapForMigration hook only the in-memory journal exposes, so Cassandra / SQLite / Postgres / S3 need their own backend-specific rewrite path around wrapEventAsEnvelope.", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_wrap_legacy_migratesnapshotstore", "label": "migrateSnapshotStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_wrap_legacy_migrationresult", "label": "MigrationResult", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_wrap_legacy_one_shot_bulk_migration", "label": "One-shot bulk migration, not a read-time shim", "file_type": "rationale", "rationale": "Walk the journal once, wrap every raw event as a version-1 envelope, write it back \u2014 a real rewrite of the stored data. It must run before an actor with the new adapter recovers, otherwise the first raw event throws MigrationError. Afterwards a normal adapter replays them; there is no special legacy-wrapping adapter at read time.", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_wrap_legacy_manifestfor_stability", "label": "manifestFor must be stable and match the adapter", "file_type": "rationale", "rationale": "The _t that manifestFor produces is baked into the stored envelope, so it must equal the manifest the adapter declares and must be derived deterministically from the event.", "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_migration_wrap_legacy_one_shot_bulk_migration", "target": "docs_src_content_docs_persistence_migration_wrap_legacy_migrateinmemoryjournal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_migration_wrap_legacy_manifestfor_stability", "target": "docs_src_content_docs_persistence_migration_wrap_legacy_wrapeventasenvelope", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/wrap-legacy.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}