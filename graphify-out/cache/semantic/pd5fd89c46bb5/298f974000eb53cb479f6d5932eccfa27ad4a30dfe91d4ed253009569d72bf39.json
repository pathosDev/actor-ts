{"nodes": [{"id": "_github_workflows_docs_checks_docs_checks_workflow", "label": "docs-checks workflow", "file_type": "document", "source_file": ".github/workflows/docs-checks.yml", "rationale": "Fast, dependency-free documentation checks on every docs change - distinct from docs.yml, which does the slow TypeDoc + Astro + Mermaid build and only deploys from main at release time.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_docs_checks_api_drift_guard", "label": "API-drift guard", "file_type": "concept", "source_file": ".github/workflows/docs-checks.yml", "rationale": "Doc code fences are never type-checked, so a renamed or removed API silently rots in a snippet until a reader copies it; docs/scripts/check-api-drift.mjs greps for the names that have bitten the project. A pure node:fs/url script, so the job needs no install step.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_docs_checks_lockfile_sync", "label": "docs/bun.lock frozen-install sync job", "file_type": "rationale", "source_file": ".github/workflows/docs-checks.yml", "rationale": "Dependabot bumps docs/package.json but never regenerates docs/bun.lock - it does not speak the Bun lockfile format. Since the slow docs.yml build only runs on main at release time, a drifted lockfile, or a bump whose peer ranges do not actually resolve, stayed invisible for weeks and then broke the release docs deploy (#473). This job is a ~10 s frozen install that fails on the PR instead.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_docs_checks_docs_checks_workflow", "target": "_github_workflows_docs_checks_api_drift_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/docs-checks.yml", "source