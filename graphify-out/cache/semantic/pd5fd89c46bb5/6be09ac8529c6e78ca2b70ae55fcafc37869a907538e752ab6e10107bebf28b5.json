{"nodes": [{"id": "docs_src_content_docs_de_http_static_files_getfromfile", "label": "getFromFile", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_getfromdirectory", "label": "getFromDirectory", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_getfrombrowseabledirectory", "label": "getFromBrowseableDirectory", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_static_security_model", "label": "Sicherheitsmodell der Static-File-Auslieferung", "file_type": "rationale", "rationale": "Der URL-Rest wird vor der Validierung vollstaendig dekodiert, dann wird jedes Segment mit .., leer, NUL, Backslash oder : abgelehnt; der Pfad wird auf die Wurzel eingegrenzt und ein Symlink, der sie verlaesst, verweigert. Geprueft wird bei jedem Dateisystem-Sprung \u2014 auch Index-Datei und Listing-Eintrag. Jede Ablehnung ist ein einheitlicher 404, damit nichts ueber Existierendes leckt.", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_contenttypefor", "label": "contentTypeFor", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_conditional_requests_and_ranges", "label": "Conditional Requests und Range", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_buffered_bodies", "label": "Bodies werden gepuffert (maxFileSize)", "file_type": "rationale", "rationale": "Dateien werden in den Speicher gelesen, begrenzt durch maxFileSize (50 MiB, darueber 413). Das haelt die Auslieferung korrekt und identisch ueber Bun, Node und Deno; Streaming sehr grosser Dateien ist eine kuenftige Erweiterung. Range-Requests schneiden aus dem Puffer.", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_static_files_no_hocon_for_static", "label": "Nur Optionen \u2014 kein HOCON", "file_type": "rationale", "rationale": "Static-Einstellungen sind Per-Route-Code; ein HTTP-Handler hat zur Request-Zeit kein ActorSystem, daher gibt es dafuer keine HOCON-Schicht \u2014 anders als bei der WebSocket-Policy.", "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_static_files_getfromdirectory", "target": "docs_src_content_docs_de_http_static_files_getfromfile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/static-files.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_static_files_getfrombrowseabledirectory", "target": "docs_src_content_docs_de_http_static_files_getfromdirectory", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/sta