_singleton_manager_handovertimeoutms", "target": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_sharding_rebalance_directive_authorization", "target": "docs_src_content_docs_cluster_singleton_manager_handover_authorization", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_sharding_rebalance_buffered_messages", "target": "docs_src_content_docs_cluster_singleton_manager_message_hold", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_worker_mesh_restart_budget", "target": "docs_src_content_docs_cluster_singleton_manager_child_death_watch", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_sharding_overview_numshards_agreement", "target": "docs_src_content_docs_cluster_singleton_manager_unreachability_not_trigger", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_sharding_rebalance_handofftimeoutms", "target": "docs_src_content_docs_cluster_singleton_manager_handovertimeoutms", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.