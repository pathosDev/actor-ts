{"nodes": [{"id": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteltracer", "label": "otelTracer", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": "OTel-Tracing-Adapter", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Funktion, keine Klasse: man reicht ihr die @opentelemetry/api-Namespace, und dank struktureller Typisierung importiert das Framework das Paket nie selbst. Das SDK erledigt Export, Sampling und Batching; der Adapter uebersetzt nur."}, {"id": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteladapteroptions", "label": "OtelAdapterOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": "Konfiguration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "withApi ist Pflicht - der Adapter delegiert an das, was uebergeben wird. Statt Name/Version kann auch ein vorgefertigter tracer uebergeben werden."}, {"id": "docs_src_content_docs_de_observability_tracing_otel_adapter_sampling", "label": "Sampling auf SDK-Ebene", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": "Sampling", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Framework zeichnet mit voller Rate auf, das SDK entscheidet was exportiert wird. Ungesampelte Spans propagieren weiterhin Kontext zur Korrelation, kosten das Backend aber nichts. Bei hohem Durchsatz immer samplen - 10 % ist typisch, manche Teams gehen auf 0,1 %."}, {"id": "docs_src_content_docs_de_observability_tracing_otel_adapter_no_otel_metrics_bridge", "label": "Keine OTel-Metrik-Bruecke", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": "Metriken und Logs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuer Metriken gibt es keine OTel-Bruecke - nimm den Prometheus-Exporter (scrape ihn in einen Collector, wenn er in die OTLP-Pipeline soll) oder den prom-client-Adapter. Fuer Logs existiert mit otelLogger das Pendant zu otelTracer."}], "edges": [{"source": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteltracer", "target": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteladapteroptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteltracer", "target": "docs_src_content_docs_de_observability_tracing_tracer_api_tracer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_otel_adapter_sampling", "target": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteltracer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_otel_adapter_no_otel_metrics_bridge", "target": "docs_src_content_docs_de_observability_metrics_prometheus_exporter_exportprometheus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_otel_adapter_no_otel_metrics_bridge", "target": "docs_src_content_docs_de_observability_metrics_prom_client_adapter_promclientregistry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_otel_adapter_oteltracer", "target": "docs_src_content_docs_de_observability_tracing_recording_tracer_recordingtracer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/otel-adapter.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}