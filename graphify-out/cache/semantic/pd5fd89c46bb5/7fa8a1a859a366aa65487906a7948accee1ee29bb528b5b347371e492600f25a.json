{"nodes": [{"id": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "label": "DistributedData", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Schicht fuer eventually consistent shared state: jeder Node haelt eine lokale Replika jedes Keys, Updates werden zuerst lokal angewendet, Gossip propagiert, Konflikte mergen ueber die CRDT-Semantik. Reads sind immer lokal und damit billig. Nicht geeignet bei noetiger starker Konsistenz, hoher Keyspace-Kardinalitaet, grossen Werten pro Key oder reihenfolge-empfindlicher Logik."}, {"id": "docs_src_content_docs_de_distributed_data_overview_crdt", "label": "CRDT (Conflict-free Replicated Data Type)", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Handvoll Typen, deren Merge-Operation kommutativ, assoziativ und idempotent ist - Gossip darf Updates in beliebiger Reihenfolge zustellen, wiederholen oder verlieren, die Replikas konvergieren trotzdem zum selben Wert."}, {"id": "docs_src_content_docs_de_distributed_data_overview_consistency_levels", "label": "Konsistenz-Level (local / majority / all / from)", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quorum aendert die Merge-Semantik nicht - jedes Update merged irgendwann in jede Replika. Es gibt nur eine Garantie darueber, WANN genug Replikas den Write gesehen haben. local ist fuer die meisten Reads und Writes der richtige Default."}, {"id": "docs_src_content_docs_de_distributed_data_overview_dd_subscribe", "label": "dd.subscribe", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callback feuert synchron nach jedem erfolgreichen Update oder Merge, der den lokalen Wert aendert (Deep-Equal ueber toJSON). Idempotente Updates feuern nicht. Subscriptions sind lokal: ein Update von node-B triggert den Subscriber auf node-A erst, wenn das Gossip eintrifft."}], "edges": [{"source": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "target": "docs_src_content_docs_de_distributed_data_overview_crdt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "target": "docs_src_content_docs_de_distributed_data_overview_consistency_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "target": "docs_src_content_docs_de_distributed_data_overview_dd_subscribe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "target": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "target": "docs_src_content_docs_de_distributed_data_q