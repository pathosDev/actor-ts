{"nodes": [{"id": "docs_src_content_docs_de_http_html_xss_escapehtml", "label": "escapeHtml", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_html_xss_html_template", "label": "html-Tagged-Template", "file_type": "concept", "rationale": "Escaping every interpolation by default makes building an HTML response safe without thinking about it; SafeHtml values are inserted verbatim so fragments nest, arrays render element-wise, null/undefined become empty.", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_html_xss_safehtml", "label": "SafeHtml", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_html_xss_rawhtml", "label": "rawHtml", "file_type": "rationale", "rationale": "Inserts the string verbatim and therefore trusts the caller \u2014 feeding untrusted input in reintroduces exactly the XSS the template prevents.", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_html_xss_completehtml", "label": "completeHtml", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_html_xss_untrusted_markup_sanitizing", "label": "Sanitisieren von untrusted Markup", "file_type": "rationale", "rationale": "Escaping neutralizes markup but does not make attacker-authored HTML safe to render, so rich HTML needs a dedicated battle-tested sanitizer before it goes into rawHtml; a built-in conservative sanitizer is tracked separately.", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_html_xss_context_specific_escaping", "label": "Escaping ist kontextspezifisch", "file_type": "rationale", "rationale": "escapeHtml covers element content and quoted attribute values only \u2014 script blocks, CSS and URLs need their own encoding, so never build a javascript: URL or inline script from untrusted input.", "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_html_xss_html_template", "target": "docs_src_content_docs_de_http_html_xss_escapehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_html_xss_html_template", "target": "docs_src_content_docs_de_http_html_xss_safehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_html_xss_rawhtml", "target": "docs_src_content_docs_de_http_html_xss_safehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_html_xss_completehtml", "target": "docs_src_content_docs_de_http_html_xss_safehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_