{"nodes": [{"id": "docs_src_content_docs_de_persistence_push_based_query_journal_events_bus", "label": "journal.events (In-Process-Event-Bus)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das In-Memory- und das SQLite-Journal verdrahten ihn automatisch; ein Journal ohne Bus pollt einfach. Ein eigenes Journal macht mit, indem es einen events-Bus bereitstellt und bei jedem erfolgreichen Append publiziert."}, {"id": "docs_src_content_docs_de_persistence_push_based_query_push_delivery", "label": "Automatische Push-Delivery fuer Live-Streams", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein Opt-in-Flag: es passiert, sobald das Journal einen Bus hat. Der Stream abonniert zuerst, macht dann den Catch-up-Read und drainiert gepufferte Bus-Events - es gibt also keine Startup-Luecke. Jede Publikation traegt das Event-Objekt selbst, der Stream fragt das Journal nicht neu ab."}, {"id": "docs_src_content_docs_de_persistence_push_based_query_at_least_once_preserved", "label": "At-least-once bleibt erhalten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verpasst ein Abonnement eine Publikation (Startup-Race, Crash), holt das Fallback-Polling sie nach - das Polling bleibt als Sicherheitsnetz, man kann pollIntervalMs also hoeher setzen statt niedriger."}, {"id": "docs_src_content_docs_de_persistence_push_based_query_projectionactor_polls_only", "label": "ProjectionActor nutzt den Bus nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Er treibt sich durch Polling der einmaligen current*-Methoden auf einem Timer; die Latenz einer Projektion ist also durch ihr Poll-Intervall begrenzt. Fuer echte Push-Latenz den Live-events*-Stream direkt konsumieren."}, {"id": "docs_src_content_docs_de_persistence_push_based_query_in_process_only", "label": "Nur In-Process - der Bus reicht nicht ueber Knoten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Push funktioniert nur, wenn Writer und Stream-Consumer ein ActorSystem teilen. Ueber Knoten hinweg begrenzt Polling, die Replikation/CDC des Journals, oder selbst auf DistributedPubSub zu publizieren."}, {"id": "docs_src_content_docs_de_persistence_push_based_query_synchronous_publish_on_hot_path", "label": "Synchrones Publish auf dem Append-Pfad", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Bus feuert synchron auf dem Append-Pfad des Writers - bei sehr hohen Event-Raten Arbeit auf dem Persist-Pfad. Bus-Subscriber leicht halten: Event yielden, schwere Arbeit nachgelagert."}], "edges": [{"source": "docs_src_content_docs_de_persistence_push_based_query_push_delivery", "target": "docs_src_content_docs_de_persistence_push_based_query_journal_events_bus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_push_based_query_at_least_once_preserved", "target": "docs_src_content_docs_de_persistence_push_based_query_push_delivery", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_push_based_query_projectionactor_polls_only", "target": "docs_src_content_docs_de_persistence_push_based_query_journal_events_bus", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_push_based_query_in_process_only", "target": "docs_src_content_docs_de_persistence_push_based_query_journal_events_bus", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_push_based_query_synchronous_publish_on_hot_path", "target": "docs_src_content_docs_de_persistence_push_based_query_journal_events_bus", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_push_based_query_journal_events_bus", "target": "docs_src_content_docs_de_persistence_persistence_query_persistencequery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_push_based_query_projectionactor_polls_only", "target": "docs_src_content_docs_de_persistence_projections_projectionactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_projections_at_least_once_delivery", "target": "docs_src_content_docs_de_persistence_push_based_query_at_least_once_preserved", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/persistence/push-based-query.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}