{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "label": "ConflictResolver<E>", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der app-spezifischste Teil von Replicated ES. Einzelner Typparameter (das Event, nicht der State): resolve gibt genau ein Event zurueck, das dann ueber das normale onEvent angewandt wird. Sind mehr als zwei Events nebenlaeufig, faltet das Framework sie paarweise."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictcandidate", "label": "ConflictCandidate<E> (event, timestamp, replica, vc)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_lastwriterwinsresolver", "label": "LastWriterWinsResolver (Default)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hoeherer timestamp gewinnt, bei Gleichstand die hoehere Replica-ID - jede Replica konvergiert. Setzt grob vergleichbare Wall-Clocks ueber Replicas voraus, derselbe Trade-off wie LWWRegister."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_custommergeresolver", "label": "CustomMergeResolver", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sortiert die Kandidaten vor dem Aufruf nach Replica-ID, sodass das Merge eine deterministische Argumentreihenfolge sieht, selbst wenn es nicht perfekt symmetrisch ist - der Vertrag verlangt trotzdem Kommutativitaet."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_determinism_and_commutativity", "label": "Zwei harte Vertraege: deterministisch und kommutativ", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events kommen auf verschiedenen Replicas in unterschiedlicher Reihenfolge an - ein nicht-kommutativer Resolver laesst Replicas divergieren, ein nicht-deterministischer laesst den Cluster sich nie einigen. Den Gewinner aus den Daten der Kandidaten entscheiden, nie aus der Ankunftsreihenfolge."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_when_merge_is_the_wrong_abstraction", "label": "Wann ein Merge die falsche Abstraktion ist", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manchmal sollten nebenlaeufige Events nicht mergen, weil sie sich semantisch widersprechen (Konto schliessen nebenlaeufig zu Einzahlung). Replicated ES, wenn Events natuerlich mergen; das Lease, wenn sie gar nicht auftreten sollen."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_resolve_runs_rarely", "label": "resolve laeuft nur bei erkanntem nebenlaeufigen Write", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Begrenzt durch die Rate replica-uebergreifender Events, typischerweise selten - selbst ein aufwaendigeres Merge ist billig neben dem Journal-I/O."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictcandidate", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_lastwriterwinsresolver", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_custommergeresolver", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflict-resolver.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_determinism_and_commutativity", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_conflict_resolver_conflictresolver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/conflic