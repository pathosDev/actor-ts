{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_single_writer_lease", "label": "Single-Writer-Lease", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Mittelweg: genau eine Replica haelt das Lease und schreibt, andere lesen. Verwandelt Replicated ES in ein failover-faehiges Single-Writer-System mit den Recovery-Semantiken von Replicated ES darunter - fuer Workloads, in denen Konflikte Bugs waeren (Finanzen, Inventar, Workflow-Zustandsmaschinen)."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease", "label": "Lease (lease()-Override)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default gibt null zurueck - kein Lease. Beim preStart erworben; Erfolg macht die Replica zum Writer, Misserfolg startet sie read-only."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_inmemorylease", "label": "InMemoryLease", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "label": "isLeaseHolder (gecachter Getter)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Write-Gate ist lokal und sub-mikrosekunden - das Lease verlangsamt normale Writes nicht, sie laufen ohne Netzwerk-Round-Trip pro Call."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_onleaselost", "label": "onLeaseLost(reason)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_failover_sequence", "label": "Failover-Sequenz (TTL-begrenztes Fenster)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failover-Fenster ist die TTL des Leases, typischerweise 15-30 s; kuerzere TTL bedeutet schnelleres Failover, aber mehr Renewal-Traffic (Renewal jedes ttl/3)."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_resolver_still_required", "label": "Der Conflict-Resolver bleibt Pflicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waehrend des Failover-Fensters koennen alter und neuer Writer kurz gleichzeitig schreiben, und bei einer Partition zwischen Lease-Backend und Replica denkt eine Replica, sie halte das Lease. Das Lease reduziert die Konflikt-Frequenz auf nahe null, eliminiert sie aber nicht."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_backend_becomes_spof", "label": "Das Lease-Backend liegt jetzt im Write-Pfad", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seine Verfuegbarkeit wird zu einem SPOF - fuer Multi-Region Active-Active ein regions-repliziertes Lease-Backend verwenden."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_read_only_replica_behavior", "label": "Verhalten von Read-only-Replicas", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sie spielen das Journal trotzdem ab und bedienen Read-Side-Queries, lehnen aber Writes ab. Fuer einen Client, der Writes transparent routen soll, ist das hart - das uebliche Muster ist ein Proxy-Actor, der den Lease-Besitz beobachtet."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_single_writer_lease", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_kuberneteslease", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_inmemorylease", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_onleaselost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_failover_sequence", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_onleaselost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source"