{"nodes": [{"id": "docs_src_content_docs_testing_test_probe_testprobe", "label": "TestProbe", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ActorRef that runs no user code - every tell lands in a buffer the test asserts on - so it can stand in for any downstream actor or reply-to target."}, {"id": "docs_src_content_docs_testing_test_probe_testprobeoptions", "label": "TestProbeOptions", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional default timeout (3 s otherwise) and a name that makes the probe visible in logs."}, {"id": "docs_src_content_docs_testing_test_probe_expectmessage", "label": "expectMessage", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits for the next message and deep-equals it, returning it so assertions can chain. It consumes from the buffer, so asserting twice on one message means capturing the return value."}, {"id": "docs_src_content_docs_testing_test_probe_expectnomessage", "label": "expectNoMessage", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asserts nothing arrives in a window; the 300 ms default is short enough to keep tests fast and long enough to catch most spurious sends."}, {"id": "docs_src_content_docs_testing_test_probe_fishformessage", "label": "fishForMessage", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discards messages until a predicate matches - useful against a stream of traffic, at the cost that discarded messages cannot be re-asserted."}, {"id": "docs_src_content_docs_testing_test_probe_probe_sender_and_reply", "label": "probe.sender and probe.reply", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sender of the just-consumed message, plus a shortcut that tells it back - the shape for simulating a two-way conversation."}, {"id": "docs_src_content_docs_testing_test_probe_clearinbox", "label": "clearInbox", "file_type": "concept", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops everything queued so a later phase asserts only on what comes next."}, {"id": "docs_src_content_docs_testing_test_probe_no_generic_createtestprobe", "label": "No createTestProbe<T>", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A probe's value is standing in for recipients whose message types differ - the same probe is handed to actors with unrelated protocols in one test - so pinning it to a single T would be widened back at most call sites; expectMessage, expectMessageType and fishForMessage are generic individually instead."}], "edges": [{"source": "docs_src_content_docs_testing_test_probe_testprobe", "target": "docs_src_content_docs_testing_test_probe_expectmessage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/test-probe.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_conte