pen_flake_entries", "target": "docs_src_content_docs_testing_diagnosing_flakes_port_and_filesystem_races", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/diagnosing-flakes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_diagnosing_flakes_dispatcher_hop_between_wait_and_assert", "target": "docs_src_content_docs_testing_overview_wait_on_state_not_elapsed_time", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/diagnosing-flakes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_diagnosing_flakes_fixed_sleep_before_assertion", "target": "docs_src_content_docs_testing_overview_fixed_sleep_exceptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/diagnosing-flakes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_diagnosing_flakes_hung_run_detection", "target": "docs_src_content_docs_testing_diagnosing_flakes_flaky_vs_broken", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/diagnosing-flakes.mdx", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "worker_thread_quarantine_and_exit_criteria", "label": "The worker-thread quarantine and its exit criteria", "nodes": ["docs_src_content_docs_testing_diagnosing_flakes_skip_flaky_mns_quarantine", "docs_src_content_docs_testing_diagnosing_flakes_nightly_flakes_workflow", "docs_src_content_docs_testing_diagnosing_flakes_fourteen_green_nights", "docs_src_content_docs_testing_diagnosing_flakes_unquarantine_checklist", "docs_src_content_docs_testing_diagnosing_flakes_test_stress_harness", "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/diagnosing-flakes.mdx"}]}