entvsdurablestate", "target": "docs_src_content_docs_persistence_persistent_actor_persistentactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "### PersistentActor or DurableStateActor?", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_faqprojectionsatleastonce", "target": "docs_src_content_docs_persistence_projections_atleastoncedelivery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "### Are projections delivered exactly-once?", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_faqprojectionsatleastonce", "target": "docs_src_content_docs_persistence_projections_idempotenthandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "### Are projections delivered exactly-once?", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_debuggingnotreceiving", "target": "docs_src_content_docs_persistence_persistent_actor_onrecoveryfailure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "## Debugging", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_debuggingeventsdontreplay", "target": "docs_src_content_docs_persistence_persistent_actor_persistenceid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "## Debugging", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_debuggingeventsdontreplay", "target": "docs_src_content_docs_reference_configuration_persistenceconfigkeys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "## Debugging", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_productionreadiness", "target": "docs_src_content_docs_reference_version_policy_versionpolicy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "### Is actor-ts production-ready?", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_productionreadiness", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_overview_replicatedeventsourcing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "### Is actor-ts production-ready?", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_bunvsnode", "target": "docs_src_content_docs_runtime_bun_bunruntime", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "### Bun vs Node - which should I pick?", "weight": 1.0}, {"source": "docs_src_content_docs_reference_faq_debuggingeventsdontreplay", "target": "docs_src_content_docs_persistence_persistent_actor_persistenceidvalidation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/reference/faq.mdx", "source_location": "## Debugging", "weight": 1.0}], "hyperedges": []}