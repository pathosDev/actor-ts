{"nodes": [{"id": "docs_src_content_docs_de_distributed_data_crdt_types_sets_gset", "label": "GSet<E>", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add-only-Set; State ist ein einfaches Set, Merge ist Vereinigung. Kleiner und einfacher als ORSet, weil keine Tag-Buchhaltung anfaellt - richtig, wenn Entfernen nicht Teil des Workflows ist."}, {"id": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "label": "ORSet<E> (Observed-Remove Set)", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes add stempelt das Element mit einem eindeutigen Tag; remove entfernt nur die fuer die entfernende Replika sichtbaren Tags. Damit loest sich nebenlaeufiges Add+Remove zugunsten des Add auf - richtig fuer Shopping-Carts, Presence-Sets und Subscription-Listen. Kosten: bei hoher Add/Remove-Churn waechst das Tag-Set, auch wenn das sichtbare Set klein bleibt. remove ist replika-agnostisch, nur add nimmt eine Replika-ID."}, {"id": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset_tag_generation", "label": "ORSet-Tag-Generierung", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tags sind replicaId x 96 Zufallsbits aus der kryptografischen Zufallsquelle der Plattform - eindeutig selbst innerhalb derselben Millisekunde und, anders als der abgeloeste Per-Replika-Zaehler, nicht vorab berechenbar. Das ist Korrektheit, nicht Haertung: Tombstones vetoen beim Merge anhand des Tags und werden nie aufgeraeumt, ein Peer mit vorhersagbaren Tags koennte die naechsten Writes einer Replika vorab tombstonen - lautlos und ohne API zum Zuruecknehmen."}, {"id": "docs_src_content_docs_de_distributed_data_crdt_types_sets_element_identity_function", "label": "identity-Funktion fuer Element-Dedup", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardmaessig werden Elemente per JSON.stringify dedupliziert; eine identity: (e) => string erlaubt eigene Dedup-Logik fuer Objekte mit stabiler ID und veraenderlichen Feldern. Die Identity bestimmt die Deduplikation, die Tag-Mechanik arbeitet pro Add unabhaengig davon."}], "edges": [{"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset_tag_generation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_gset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_sets_element_identity_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_sets_element_identity_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_gset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset_tag_generation", "target": "docs_src_content_docs_de_distributed_data_replication_crdt_tombstones", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_maps_ormap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_gset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_counters_gcounter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "target": "docs_src_content_docs_de_distributed_data_crdt_types_designing_data_crdt_decision_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/crdt-types/sets.mdx", "source_location": null, "weight": 1}], "hyperedges": []}