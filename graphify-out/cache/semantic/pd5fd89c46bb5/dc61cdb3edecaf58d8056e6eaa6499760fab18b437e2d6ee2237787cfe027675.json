{"nodes": [{"id": "docs_src_content_docs_fundamentals_supervision_supervision", "label": "Supervision", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A throw from onReceive travels to the parent rather than crashing the process; the parent has a wider view \u2014 it knows whether the crashed actor is replaceable, holds critical state, or should give up."}, {"id": "docs_src_content_docs_fundamentals_supervision_let_it_crash", "label": "Let it crash", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handling every error inline at the call site is brittle; restart trusts the recovery path more than the per-message guard, which is why it explicitly does not preserve in-memory state."}, {"id": "docs_src_content_docs_fundamentals_supervision_directive_restart", "label": "Directive.Restart", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_supervision_directive_resume", "label": "Directive.Resume", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps state and skips the failing message \u2014 right for transient errors, wrong when the state itself caused the throw, because the next message will likely fail the same way."}, {"id": "docs_src_content_docs_fundamentals_supervision_directive_stop", "label": "Directive.Stop", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_supervision_directive_escalate", "label": "Directive.Escalate", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_supervision_oneforonestrategy", "label": "OneForOneStrategy", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_supervision_allforonestrategy", "label": "AllForOneStrategy", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reach for it only when the children states are explicitly coupled \u2014 a producer/consumer pair over an internal channel, actors that must restart together."}, {"id": "docs_src_content_docs_fundamentals_supervision_decideby", "label": "decideBy (per-error decider)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_supervision_defaultstrategy", "label": "defaultStrategy / stoppingStrategy / escalatingStrategy", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "defaultStrategy restarts everything capped at 10 per minute \u2014 the cap exists precisely to break the infinite restart loop of a child that crashes on every message."}, {"id": "docs_src_content_docs_fundamentals_supervision_maxretries_window", "label": "maxRetries + withinTimeRangeMs", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past the bound the supervisor stops the affected children instead of restarting. The parent-side counter is inclusive of the failure that trips it, so maxRetries 10 tolerates eleven restarts before the twelfth failure stops the child."}, {"id": "docs_src_content_docs_fundamentals_supervision_restart_semantics", "label": "Restart semantics \u2014 what is lost, what is kept", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "preRestart on the doomed instance, all instance fields dropped, a fresh instance built, postRestart on it, mailbox retained and the failed message dropped. Children are stopped and awaited first, so the fresh incarnation preStart starts from an empty child map."}, {"id": "docs_src_content_docs_fundamentals_supervision_stopchildrenonrestart", "label": "stopChildrenOnRestart()", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Children are stopped by default because the alternative made an ordinary pattern impossible: postRestart re-runs preStart, so an actor that spawned a named child there hit 'Child name is not unique' on its first restart and never recovered. Opting out means adopting the survivor from the cell, not from an instance field, which is always unset on a fresh instance. It is a separate hook rather than a preRestart override because the teardown has to be awaited."}, {"id": "docs_src_content_docs_fundamentals_supervision_escalation_chain", "label": "The escalation chain", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncaught errors only happen if every level explicitly chooses to escalate all the way to the root user-guardian; stops are a normal expected outcome, escalation-to-root is the we-do-not-know-what-to-do signal."}, {"id": "docs_src_content_docs_fundamentals_supervision_typed_wrapper_counting", "label": "The typed wrapper counts differently", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Behaviors.supervise reads maxRetries literally and escalates past the bound rather than stopping \u2014 it has to, because the typed wrapper lives inside the failing actor rather than in a parent that stays around to observe the death, so stopping there would discard the error. Wrappers nest, making a typed chain a supervision hierarchy inside one actor."}, {"id": "docs_src_content_docs_fundamentals_supervision_async_escape", "label": "Detached callbacks bypass supervision", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/supervision.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The supervisor only sees what onReceive throws or rejects with; a raw setTimeout or an escaping then-chain runs outside the turn. Use context.timers, whose fires propagate errors back through the mailbox."}], "edges": [{"source": "docs_src_content_docs_fundamentals_supervision_supervision", "target": "docs_src_content_docs_fundamentals_supervision_let_it_crash", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 