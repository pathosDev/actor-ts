{"nodes": [{"id": "docs_src_content_docs_de_operations_overview_production_checklist", "label": "Produktions-Checkliste", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/overview.mdx", "source_location": "Eine Produktions-Checkliste", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistence, Cluster-Seeds, Downing-Strategie, Coordinated Shutdown, Health-Checks, Metriken, Log-Aggregation, TLS auf dem Cluster-Transport, Secrets via Env-Vars statt application.conf, K8s-Manifeste mit PreStop-Hook, optional Tracing, plus ein Runbook. Nichts davon sind framework-spezifische Tricks - es ist allgemeine Produktions-Hygiene, angewendet auf ein Actor-System."}, {"id": "docs_src_content_docs_de_operations_overview_diagnosis_order", "label": "Logs, dann Metriken, dann Traces", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/overview.mdx", "source_location": "Wenn etwas schieflaeuft", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Supervisor-Entscheidung, jedes Cluster-Event und jeder Dead-Letter wird geloggt, und LogContext-MDC fuegt einen Multi-Actor-Request in einer einzigen Abfrage zusammen. Metriken erkennen 'irgendwas laeuft schief' bevor Nutzer es merken; Traces geben die Ende-zu-Ende-Sicht eines einzelnen Requests."}, {"id": "docs_src_content_docs_de_operations_overview_tune_only_on_symptom", "label": "Tune nicht, wenn du das Symptom nicht benennen kannst", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/overview.mdx", "source_location": "Tuning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults sind nicht optimal, aber selten schlecht. Jeder Tuning-Knopf - Gossip-Kadenz, Failure Detector, Mailbox-Sizing, Dispatcher - hat ein benennbares Symptom, das ihn rechtfertigt."}], "edges": [{"source": "docs_src_content_docs_de_operations_overview