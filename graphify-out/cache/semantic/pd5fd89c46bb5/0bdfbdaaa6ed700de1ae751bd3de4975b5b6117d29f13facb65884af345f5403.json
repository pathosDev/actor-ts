{"nodes": [{"id": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "label": "Sharding coordinator lease", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional split-brain protection: even if two nodes both believe they lead, only one holds the lease and only that coordinator processes allocations. The backend's atomic CAS is the source of truth beyond gossip."}, {"id": "docs_src_content_docs_de_cluster_sharding_with_lease_gates_coordinator_writes", "label": "The lease gates coordinator-state writes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates allocations, rebalance decisions and handoff coordination \u2014 not per-region entity hosting (regions hang off actual members) and not entity messaging (routing uses the last known allocation; the lease is not in the message path). Worst case during a partition is slightly stale assignments, not stopped entities."}, {"id": "docs_src_content_docs_de_cluster_sharding_with_lease_backend_spof", "label": "Lease backend as a single point of failure", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "K8s API outage means nobody can acquire and no new shard allocations happen; existing entities keep running, new entity ids queue. Acceptable for most setups because API availability usually exceeds the cluster's own, but it must be planned for."}, {"id": "docs_src_content_docs_de_cluster_sharding_with_lease_protection_levels", "label": "Reading the protection level (downing + lease)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No downing and no lease is best-effort; a downing strategy alone is strong on stable networks; both together is paranoid-safe. A lease alone protects coordinator uniqueness but never resolves the partition \u2014 both halves run on their pre-partition state forever."}], "edges": [{"source": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "target": "docs_src_content_docs_de_cluster_sharding_overview_sharding_coordinator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_with_lease_gates_coordinator_writes", "target": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_with_lease_backend_spof", "target": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "target": "docs_src_content_docs_de_coordination_kubernetes_lease_kuberneteslease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "target": "docs_src_content_docs_de_coordination_overview_lease_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_with_lease_protection_levels", "target": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/with-lease.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}