{"nodes": [{"id": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_service", "label": "YugabyteDB Service", "file_type": "code", "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`yugabyted` brings up a single-node cluster with YSQL enabled; staying in the foreground is what lets compose manage the lifecycle. First boot initializes the system catalogs and takes noticeably longer than any other image in the matrix."}, {"id": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_runner_service", "label": "YugabyteDB Runner Service", "file_type": "code", "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_advertise_address_healthcheck_probe", "label": "Advertise-Address Healthcheck Probe", "file_type": "rationale", "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "yugabyted binds every service to the node's advertise address, so loopback is never listening and a 127.0.0.1 probe fails forever even once the cluster is fully up; the probe must target the container's own address via `hostname -i`."}, {"id": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_sqlstate_40001_serializable_abort", "label": "SQLSTATE 40001 Serializable Abort", "file_type": "rationale", "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yugabyte reasonably rewords some Postgres error messages, which is harmless because the dialect classifies by SQLSTATE and never by message text \u2014 but matching the code was necessary and not sufficient: at SERIALIZABLE the losing append aborts as 40001 before it ever reaches the primary key."}, {"id": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_ysql_port_5433", "label": "YSQL on Port 5433", "file_type": "concept", "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YSQL listens on 5433, not 5432, and comes up well after the process starts."}, {"id": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_silently_never_ran_certification", "label": "Silently-Never-Ran Certification", "file_type": "rationale", "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the wrong probe the container went unhealthy after a clean startup banner, compose refused to start the runner on the unmet service_healthy condition, and the whole certification never ran at all while merely looking like a slow image."}], "edges": [{"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_runner_service", "target": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_advertise_address_healthcheck_probe", "target": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_service", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_silently_never_ran_certification", "target": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_advertise_address_healthcheck_probe", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_advertise_address_healthcheck_probe", "target": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_ysql_port_5433", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_runner_service", "target": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_ysql_port_5433", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_runner_service", "target": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_wire_label_env", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/yugabytedb/docker-compose.yugabytedb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_yugabytedb_docker_compose_yugabytedb_yugabytedb_runner_service", "target": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_postgres_wire_compatibility_certification", "relation": "refer