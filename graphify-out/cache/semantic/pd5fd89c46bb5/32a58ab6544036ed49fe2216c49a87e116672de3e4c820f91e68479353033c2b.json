{"nodes": [{"id": "docs_src_content_docs_operations_deployment_kubernetes_kubernetes_deployment", "label": "Kubernetes deployment recipe", "file_type": "document", "rationale": "Stable identity, seed discovery and a clean shutdown path are the three things K8s must get right for an actor cluster.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_rbac_pod_reader", "label": "ServiceAccount and pod-reader RBAC", "file_type": "concept", "rationale": "The K8s API seed provider must list pods matching a label selector; without the grant it gets 403 and the cluster never forms.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_headless_service", "label": "Headless Service for cluster gossip", "file_type": "rationale", "rationale": "clusterIP None returns pod IPs directly, because failure-detector heartbeats target specific pod identities, not a load-balanced address.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_statefulset_vs_deployment", "label": "StatefulSet versus Deployment", "file_type": "rationale", "rationale": "StatefulSet buys stable pod names for per-pod identity and volumes; Deployment is fine when persistence is external, such as a shared Cassandra journal or S3 snapshot store.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_termination_grace_period", "label": "terminationGracePeriodSeconds sizing", "file_type": "concept", "rationale": "Must cover the preStop sleep plus the pipeline; the pipeline worst case is default-phase-timeout times the phases that actually have tasks, not times twelve.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_prestop_hook", "label": "preStop sleep for load-balancer drain", "file_type": "rationale", "rationale": "Without the sleep, SIGTERM races load-balancer deregistration and in-flight requests see draining responses.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_readiness_liveness_probes", "label": "Readiness and liveness probe split", "file_type": "rationale", "rationale": "ready asks whether to send traffic and may depend on external systems; health asks whether a restart would help, so it must depend on nothing outside the process or a shared outage restarts the whole fleet.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_rolling_update_flow", "label": "Rolling update ordering", "file_type": "rationale", "rationale": "Terminating, ten second drain, SIGTERM, coordinated-shutdown phases, then a fresh pod rejoins via the seed provider and shards rebalance automatically.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_kubernetesapiseedprovider", "label": "KubernetesApiSeedProvider", "file_type": "concept", "rationale": "Queries pods matching a label selector and uses their IPs as seeds; on the first pod the seed list is itself, the auto-promote-to-leader path.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_kubernetes_single_replica_hazard", "label": "Single-replica cluster hazard", "file_type": "rationale", "rationale": "A one-replica cluster has nowhere to fail over to and is briefly empty mid-rolling-update, so sharded singletons go down and in-flight requests fail.", "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_operations_deployment_kubernetes_kubernetes_deployment", "target": "docs_src_content_docs_operations_deployment_kubernetes_rbac_pod_reader", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_deployment_kubernetes_kubernetes_deployment", "target": "docs_src_content_docs_operations_deployment_kubernetes_headless_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/deployment/kubernetes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_deployment_kubernetes_kubernetes_deployment", "target": "docs_src_content_docs_operations_deployment_kubernetes_statefulset_vs_deployment", "relation": "references", "confidence": "EXTRA