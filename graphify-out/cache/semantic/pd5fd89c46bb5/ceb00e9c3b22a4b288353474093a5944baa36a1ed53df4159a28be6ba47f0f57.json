{"nodes": [{"id": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "label": "Explain plan", "file_type": "document", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_enableexplainplan", "label": "ActorContext.enableExplainPlan", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_explainplan_accessor", "label": "ActorContext.explainPlan", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the ring entries oldest-first; disableExplainPlan stops and discards them."}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_opt_in_per_actor", "label": "Opt-in per actor", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording every message on every actor would cost more than many of the handlers being measured. The question is asked about one actor at a time, so the cost is paid for one actor at a time - an actor with no plan runs exactly as before, down to a single null check on the dispatch path."}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_mailbox_wait_timestamping", "label": "Mailbox-wait timestamping", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enabling a plan also starts timestamping that actor incoming envelopes, which is what makes the wait figure possible and why an actor without a plan pays nothing for it. A message already queued when recording started has no timestamp, so its wait shows as an em dash rather than a made-up zero."}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_stashed_message_wait", "label": "A stashed message keeps its original timestamp", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stashed message replayed later keeps the stamp from its original arrival, so its wait spans the whole stash residency. That is the honest answer to how long did this message wait - a message that sat in a stash for four seconds did wait four seconds."}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_explain_ring_capacity", "label": "Explain-plan ring capacity", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed-size ring that never grows past its capacity, with the panel capping a requested capacity at 10 000 - it is a debugging aid, not a log."}, {"id": "docs_src_content_docs_observability_devtools_explain_plan_explain_outcome_dot", "label": "Per-row outcome dot", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green for a clean return, amber for a message the actor stashed, red for a handler that threw."}], "edges": [{"source": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "target": "docs_src_content_docs_observability_devtools_explain_plan_enableexplainplan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "target": "docs_src_content_docs_observability_devtools_explain_plan_explainplan_accessor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "target": "docs_src_content_docs_observability_devtools_explain_plan_opt_in_per_actor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "target": "docs_src_content_docs_observability_devtools_explain_plan_mailbox_wait_timestamping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "target": "docs_src_content_docs_observability_devtools_explain_plan_stashed_message_wait", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/explain-plan.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_explain_plan_explain_plan", "target": "docs_src_content_docs_observability_devtools_explain_plan_explain_ring_capacity", "relation": "r