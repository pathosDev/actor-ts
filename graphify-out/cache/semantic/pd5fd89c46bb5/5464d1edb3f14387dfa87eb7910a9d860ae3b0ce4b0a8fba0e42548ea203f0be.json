{"nodes": [{"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_updateasync", "label": "updateAsync \u2014 quorum write", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies the update locally first and only then waits for replica acknowledgments, so a timeout or a cap refusal never undoes the local write; the rejection only means \"I am not sure enough replicas saw it inside the deadline\"."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_getasync", "label": "getAsync \u2014 read with consistency", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queries other replicas and merges their responses, so a majority read sees at least every write that majority-acknowledged \u2014 the latest confirmed value."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_consistencylevel", "label": "Consistency level (local / majority / all)", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'majority' is the sweet spot for important reads and writes \u2014 it covers most failure scenarios at modest latency. 'all' guarantees agreement but fails whenever any replica is down or slow, which makes it brittle, so it is reserved for truly irrevocable state transitions."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_maxpendingquorumrequests", "label": "maxPendingQuorumRequests cap", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounds the unsettled set rather than the mailbox. Without a cap, a partition that stops quorums completing lets promises, timers and target sets pile up and then expire together as a timeout storm; the cap converts that into immediate rejections still attributable to the caller that made them."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_maxquorumtimeout", "label": "maxQuorumTimeout ceiling", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clamps a caller-supplied timeoutMs down to a ceiling so one call cannot park a record indefinitely."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_distributeddataoptions", "label": "DistributedDataOptions", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_writemajorityreadlocal", "label": "Write majority + read local pattern", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The common production pattern \u2014 writes pay the majority cost, reads stay cheap, and the cluster converges eventually. Making every read a majority read defeats the local-first design."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_pendingquorumset", "label": "Unsettled quorum-request set", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each pending request keeps a promise, a timer and a target set alive until its deadline passes; the replicator mailbox itself stays unbounded, so nothing is discarded on the way in."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_quorummetrics", "label": "DistributedData quorum metrics", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed label sets keep the series count to a handful. A rising rejected_total means callers are outrunning the cap; a rising dropped_values_total means a broken or hostile peer, not a tuning problem."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_majoritynotlinearizable", "label": "'majority' is not linearizability", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent writes still merge per CRDT rules; majority only guarantees enough replicas are in the loop. True linearizable shared state needs a singleton."}, {"id": "docs_src_content_docs_distributed_data_quorum_reads_writes_quorumatthemoment", "label": "Quorum is evaluated at-the-moment", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the cluster's up-member set changes mid-call the quorum criterion may temporarily fail, so the resulting timeout has to be handled \u2014 retry or accept."}], "edges": [{"source": "docs_src_content_docs_distributed_data_quorum_reads_writes_updateasync", "target": "docs_src_content_docs_distributed_data_quorum_reads_writes_consistencylevel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_quorum_reads_writes_getasync", "target": "docs_src_content_docs_distributed_data_quorum_reads_writes_consistencylevel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_quorum_reads_writes_updateasync", "target": "docs_src_content_docs_distributed_data_quorum_reads_writes_maxquorumtimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_quorum_reads_writes_distributeddataoptions", "target": "docs_src_content_docs_distributed_data_quorum_reads_writes_maxpendingquorumrequests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_quorum_reads_writes_distributeddataoptions", "target": "docs_src_content_docs_distributed_data_quorum_reads_writes_maxquorumtimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/quorum-reads-writes.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_quorum_reads_writes_pendingquorumset", "target": "docs_src_content_docs_distributed_data_quorum_reads_writes_maxpendingquorumrequests", "relation": "rationale_for", "confidence": "EXTRACTED", "con