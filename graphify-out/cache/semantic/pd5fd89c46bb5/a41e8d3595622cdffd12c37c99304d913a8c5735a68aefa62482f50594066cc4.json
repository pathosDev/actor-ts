{"nodes": [{"id": "docs_src_content_docs_migration_from_pekko_from_pekko", "label": "From Apache Pekko", "file_type": "document", "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_pekko_pekko_package_rename", "label": "Pekko package rename", "file_type": "concept", "rationale": "Pekko is a drop-in replacement for Akka 2.6 with one notable change \u2014 every package moved from akka.* to org.apache.pekko.*. Otherwise the API is identical, so a Pekko codebase migrates exactly like Akka 2.6.", "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_pekko_why_migrate_from_pekko", "label": "Why migrate from Pekko at all", "file_type": "rationale", "rationale": "If Pekko works for you, do not migrate. The case for actor-ts is wanting a TypeScript-first stack rather than the JVM, container-first deployment where sub-second startup matters, or avoiding the JVM for operational reasons (memory profile, GC tuning). Licensing is not a reason \u2014 Pekko is Apache 2.0 and actor-ts is also permissively licensed.", "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_migration_from_pekko_from_pekko", "target": "docs_src_content_docs_migration_from_pekko_pekko_package_rename", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_pekko_from_pekko", "target": "docs_src_content_docs_migration_from_pekko_why_migrate_from_pekko", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_pekko_from_pekko", "target": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_pekko_from_pekko", "target": "docs_src_content_docs_intro_quickstart_quickstart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_pekko_pekko_package_rename", "target": "docs_src_content_docs_migration_from_akka_jvm_concept_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_pekko_why_migrate_from_pekko", "target": "docs_src_content_docs_migration_from_pekko_from_pekko", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-pekko.mdx", "source_location": null, "weight": 1}], "hyperedges": []}