e_file": "docs/src/content/docs/operations/upgrades/rolling-migration.md", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_upgrades_rolling_migration_migratebetweenjournals", "target": "docs_src_content_docs_persistence_journals_cassandra_cassandrajournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/upgrades/rolling-migration.md", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_upgrades_rolling_migration_four_phase_deploy", "target": "docs_src_content_docs_operations_upgrades_upgrade_strategies_additive_change_first", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/operations/upgrades/rolling-migration.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "rolling_deploy_shipped_features", "label": "The four shipped features the rolling deploy composes", "nodes": ["docs_src_content_docs_operations_upgrades_rolling_migration_four_phase_deploy", "docs_src_content_docs_operations_upgrades_rolling_migration_write_version_pin", "docs_src_content_docs_operations_upgrades_rolling_migration_migrationchain", "docs_src_content_docs_operations_upgrades_rolling_migration_masterkeyring_parallel_story", "docs_src_content_docs_operations_upgrades_rolling_migration_migratebetweenjournals"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/upgrades/rolling-migration.md"}]}