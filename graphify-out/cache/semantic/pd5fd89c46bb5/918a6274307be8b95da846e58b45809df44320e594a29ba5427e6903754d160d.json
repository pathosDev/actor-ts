{"nodes": [{"id": "docs_src_content_docs_fundamentals_ask_pattern_ask", "label": "ask (request/response)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allocates a one-shot reply ref, attaches it as both context.sender and message.replyTo, and resolves with the first reply or rejects on timeout."}, {"id": "docs_src_content_docs_fundamentals_ask_pattern_replyto", "label": "replyTo field convention", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit replyTo makes the type contract obvious \u2014 the request shape declares the reply type \u2014 while this.sender is more implicit and suits actors handling both ask-style and fire-and-forget messages."}, {"id": "docs_src_content_docs_fundamentals_ask_pattern_asktimeouterror", "label": "AskTimeoutError", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reply ref is one-shot: once settled on a timeout or a first reply, any later reply is discarded in place rather than dead-lettered, and the actor itself never learns the asker gave up."}, {"id": "docs_src_content_docs_fundamentals_ask_pattern_errorreply", "label": "Error-typed reply rejects the promise", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deliberate convention \u2014 reserve it for genuine failure states and carry domain errors through the typed reply union instead."}, {"id": "docs_src_content_docs_fundamentals_ask_pattern_omitreplyto", "label": "OmitReplyTo parameter type", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subtracts replyTo from every variant that declares it, so callers never write the field themselves."}, {"id": "docs_src_content_docs_fundamentals_ask_pattern_whennottoask", "label": "When not to use ask", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ask cycle allocates and tears down a temporary ref, so high-frequency fire-and-forget, a recipient that never replies, and awaiting inside onReceive (which blocks this actor mailbox) are all cases for plain tell."}], "edges": [{"source": "docs_src_content_docs_fundamentals_ask_pattern_ask", "target": "docs_src_content_docs_fundamentals_actor_system_actorsystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_ask", "target": "docs_src_content_docs_fundamentals_ask_pattern_replyto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_ask", "target": "docs_src_content_docs_fundamentals_ask_pattern_asktimeouterror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_ask", "target": "docs_src_content_docs_fundamentals_ask_pattern_omitreplyto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_errorreply", "target": "docs_src_content_docs_fundamentals_ask_pattern_ask", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_whennottoask", "target": "docs_src_content_docs_fundamentals_ask_pattern_ask", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_replyto", "target": "docs_src_content_docs_fundamentals_actor_senderoption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_replyto", "target": "docs_src_content_docs_fundamentals_messages_replytoref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_ask_pattern_ask", "target": "docs_src_content_docs_fundamentals_actor_actor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/ask-pattern.mdx", "source_location": null, "weight": 1}], "hyperedges": []}