{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "label": "VectorClock", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "label": "VectorClockData (Record<ReplicaId, number>)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein plain Object; fehlende Replicas werden als 0 behandelt - nuetzlich fuer Kompaktheit auf dem Wire, weil Null-Komponenten weggelassen werden koennen."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_compareto", "label": "compareTo -> before / after / equal / concurrent", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_tick", "label": "tick(replicaId)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_merge", "label": "merge(other) - Per-Replica-Maximum", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_concurrency_detection", "label": "Konflikterkennung ueber den nebenlaeufigen Fall", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weder < noch > heisst: zwei Replicas haben unabhaengig geschrieben und keine hat den Write der anderen gesehen - genau das laesst die Maschinerie den Conflict Resolver aufrufen."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_causality_is_partially_ordered", "label": "Kausalitaet ist partiell geordnet", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector Clocks geben keine Totalordnung: { A: 5 } und { B: 5 } sind nebenlaeufig, keines ist zuerst passiert, und die Journal-Reihenfolge ist zufaellig. Das ist der ganze Punkt - Clocks verfolgen Kausalitaet, nicht Wall-Clock-Zeit."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_replica_id_stability", "label": "Replica-IDs muessen fuer immer stabil sein", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die ID ist Teil der Vector Clock; mit einer neuen ID neu zu starten laesst die Instanz wie eine andere Replica aussehen, waehrend alte Clocks die alten Eintraege behalten. Stabile IDs verwenden (Pod-Name + Region)."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_clock_size_grows_with_replica_count", "label": "Clock-Groesse waechst mit der Replica-Anzahl", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes Event traegt die volle vc - Wire- und Storage-Overhead bei sehr grossen Replica-Zahlen. Die meisten Deployments haben <= 10 Replicas."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_clock_is_private_inspect_the_wire", "label": "Die Clock des Actors ist privat - im _vc-Feld inspizieren", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein oeffentlicher Getter; sie wird mit jedem persistierten Event und Snapshot mitgefuehrt, also im Journal-/Snapshot-JSON nachsehen statt sie vom Actor abzulesen."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vector_clock_gc_out_of_scope", "label": "Vector-Clock-GC ausserhalb des Scopes fuer v1", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Framework entfernt Eintraege pensionierter Replicas nie, sodass eine Clock mit jeder je gesehenen Replica waechst - fuer ein stabiles Cluster in Ordnung, bei viel Node-Churn kuenftige Arbeit."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persis