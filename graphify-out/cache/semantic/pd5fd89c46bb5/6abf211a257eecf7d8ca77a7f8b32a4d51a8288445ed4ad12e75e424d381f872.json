{"nodes": [{"id": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbjournal", "label": "DynamoDbJournal", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbsnapshotstore", "label": "DynamoDbSnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "keepN behaelt die neuesten N Snapshots pro pid, Default 3; <= 0 behaelt alle."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbdurablestatestore", "label": "DynamoDbDurableStateStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_registerdynamodbplugins", "label": "registerDynamoDbPlugins", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Verbindung wird einmal am Composite gesetzt, dann erben sie alle drei Komponenten; Credentials kommen aus der Standard-AWS-Provider-Kette."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_optionale_peer_dependency", "label": "@aws-sdk/client-dynamodb als optionale Peer-Dependency", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dieselbe SDK-Familie wie das S3-Object-Storage-Backend; lazy importiert, erst wenn ein DynamoDB-Store zum ersten Mal genutzt wird."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_lokale_entwicklung", "label": "dynamodb-local mit Endpoint-Override", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das SDK signiert keinen Request ohne Credentials, auch wenn der Emulator sie ignoriert."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_tabellen", "label": "Tabellen-Layout (pid / seq)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "actor_ts_events (pid, seq; seq = 0 ist die Kompaktierungs-Marke), actor_ts_snapshots (pid, seq), actor_ts_durable_state (pid)."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_autocreatetables", "label": "autoCreateTables wartet auf ACTIVE", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CreateTable kehrt zurueck, waehrend die Tabelle noch CREATING ist, und jede Operation darauf scheitert bis zum Umschalten; das Warten passiert im Lazy-Init, der erste Aufrufer blockiert und alle dahinter bekommen eine funktionierende Tabelle."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_transactwriteitems", "label": "Atomarer Append ueber TransactWriteItems", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alle Events gehen in ein einzelnes TransactWriteItems, jedes Put mit ConditionExpression attribute_not_exists(pid) - ein konkurrierender Writer kann keinen partiellen Append gewinnen; die relationalen Backends und MongoDB koennen bei einem Fehler mitten im Batch ein Teilstueck hinterlassen."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_journalconcurrencyerror", "label": "JournalConcurrencyError", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Abbruch der Transaktion wird dazu; der vorausgehende Head-Read ist nur eine Optimierung fuer die Sicherheit des Writes, aber sein Wert ist tragend."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_consistentread", "label": "ConsistentRead auf jedem tragenden Read", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein veralteter Read ist hier nicht etwas-aeltere-Daten: ein Head von einer nachhaengenden Replica laesst einen intakten Stream zurueckgespult aussehen, und eine veraltete Replay-Seite kuerzt die Historie so, dass es niemand merken kann - die Integritaetspruefungen erkennen Loch, Reihenfolge und Fenster, aber nichts sagt, wo der Stream enden soll."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_durable_state_cas", "label": "Durable-State-CAS als nativer konditionaler Write", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PutItem mit attribute_not_exists(pid) zum Anlegen, UpdateItem mit revision = :expected zum Aktualisieren - ohne Transaktion und ohne Ruecklesen."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_kompaktierungs_marke", "label": "Die Kompaktierungs-Marke steigt nur", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aktualisiert mit attribute_not_exists(deletedTo) OR deletedTo < :value, also GREATEST als Bedingung; ein niedrigerer Wert wird abgelehnt, und diese Ablehnung ist das erwartete Ergebnis, kein Fehler."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_starke_reads_kosten", "label": "Starke Reads kosten das Doppelte", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nicht nur bei der Recovery: read und highestSeq rufen auch currentEventsByTag, Remember-Entities und Projection-Tooling. Es ist der richtige Default, weil eine Projection, die neueste Events still uebergeht, ein eigener Defekt ist. persistenceIds und das Snapshot-Pruning bleiben eventually consistent, weil ein veralteter Read dort nur zu wenig loeschen kann."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_limit_100_events", "label": "Ein Append ist auf 100 Events begrenzt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DynamoDB erlaubt hoechstens 100 Items in einem TransactWriteItems; ein groesserer Append wird mit klarem Fehler abgelehnt statt in Chunks zerlegt, denn Chunking wuerde die Atomaritaet brechen, auf der das Concurrency-Modell beruht."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_persistenceids_scan", "label": "persistenceIds ist ein voller Table-Scan", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DynamoDB kann Partition Keys nur per Scan aufzaehlen; das Framework nutzt den Aufruf nie auf einem Hot Path - er ist fuer Projection-Tooling."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_keine_indizierte_tag_query", "label": "Noch keine indizierte Tag-Query", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "currentEventsByTag faellt auf den Journal-Scan zurueck; ein indizierter Pfad braucht eine zweite, nach Tag geschluesselte Tabelle - eigene Designarbeit, kein Konfigurationsschalter."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_item_limit_400kb", "label": "400-KB-Item-Limit und Pagination", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Query liefert hoechstens 1 MB, die Recovery paginiert also ueber LastEvaluatedKey; ein einzelnes Event, dessen JSON 400 KB ueberschreitet, wird vom Service abgelehnt - Events klein halten, was Event-Sourcing ohnehin will."}, {"id": "docs_src_content_docs_de_persistence_journals_dynamodb_optionsvalidierung", "label": "Optionsvalidierung bei der Konstruktion", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Tabellenname wird gegen DynamoDBs Zeichensatz und Laengengrenze geprueft, und Kapazitaetseinheiten werden abgelehnt, solange billingMode nicht PROVISIONED ist - AWS ignoriert sie sonst still, was den Fehler unsichtbar macht."}], "edges": [{"source": "docs_src_content_docs_de_persistence_journals_dynamodb_registerdynamodbplugins", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_registerdynamodbplugins", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbsnapshotstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_registerdynamodbplugins", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbdurablestatestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_optionale_peer_dependency", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_lokale_entwicklung", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_optionale_peer_dependency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_tabellen", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_autocreatetables", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_tabellen", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_transactwriteitems", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_journalconcurrencyerror", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_transactwriteitems", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_consistentread", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_transactwriteitems", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_consistentread", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbsnapshotstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_starke_reads_kosten", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_consistentread", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_durable_state_cas", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbdurablestatestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_kompaktierungs_marke", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_tabellen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_limit_100_events", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_transactwriteitems", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_persistenceids_scan", "target": "docs_src_content_docs_de_persistence_journals_dynamodb_dynamodbjournal", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_persistence_journals_dynamodb_keine_indizierte_tag_query", "targ