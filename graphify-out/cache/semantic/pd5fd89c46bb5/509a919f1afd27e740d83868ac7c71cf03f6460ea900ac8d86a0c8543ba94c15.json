{"nodes": [{"id": "docs_src_content_docs_intro_quickstart_quickstart", "label": "Quickstart", "file_type": "document", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_greeter", "label": "Greeter hello-actor sample", "file_type": "concept", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_counter", "label": "Counter actor sample", "file_type": "concept", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_discriminated_union_messages", "label": "Typed messages with a discriminated union", "file_type": "concept", "rationale": "Every message carries a `kind` literal that narrows the union inside onReceive; match(command).exhaustive() from ts-pattern turns a missing variant into a build failure instead of a runtime surprise.", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_spawn_class_not_instance", "label": "Pass the class, not an instance", "file_type": "rationale", "rationale": "The system needs to control when the actor is constructed (on its mailbox thread, not the caller's) and it rebuilds the actor on every restart, so construction has to stay in its hands. A factory is only for constructor arguments.", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_ask_reply_actor", "label": "One-shot reply actor behind ask", "file_type": "concept", "rationale": "The framework spawns a one-shot reply actor, fills it in as replyTo AND as context.sender on the target, and resolves with the first reply (or rejects with AskTimeoutError) \u2014 callers never write replyTo themselves.", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_cluster_bootstrap", "label": "Cluster.bootstrap", "file_type": "concept", "rationale": "Builds the ActorSystem, joins the cluster, starts the Receptionist and wires SIGTERM/SIGINT shutdown in one call; discovery defaults to CLUSTER_SEEDS -> Kubernetes API -> DNS so the same code runs single-node in dev and joins a cluster in production without a config change.", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_quickstart_shutdown_drain", "label": "Terminate drains mailboxes", "file_type": "concept", "rationale": "terminate() drains the mailboxes under /user before stopping anything, so a message told just before shutdown is still handled. It does not wait for un-fired timers, un-awaited promises, throttled or suspended mailboxes; the whole drain is bounded by actor-ts.system.shutdown-drain-timeout (2 s, 0 disables) and the remainder goes to dead letters.", "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_intro_quickstart_quickstart", "target": "docs_src_content_docs_intro_quickstart_greeter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/quickstart.mdx", "source_location": n