{"nodes": [{"id": "docs_src_content_docs_persistence_fsm_fsm_fsm", "label": "FSM base class", "file_type": "concept", "rationale": "In-memory state machine over three type parameters - state names, state data, message type. Transitions are configured in the constructor and the base onReceive routes each message to the handler for the current state.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_when", "label": "when state handler", "file_type": "concept", "rationale": "Receives the current data and the incoming message and returns a transition; may be async, in which case it serializes like any onReceive so the next message waits.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_goto_and_stay", "label": "goto and stay", "file_type": "concept", "rationale": "goto fires onExitState, sets the new state and data, then fires onEnter; stay updates data without firing either hook.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_onenter_onexitstate", "label": "onEnter and onExitState", "file_type": "concept", "rationale": "The natural home for setting up a timer on entry and tearing it down on exit, and for logging transitions without coupling that to message handling.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_callback_errors_are_swallowed", "label": "Errors in enter and exit hooks are logged, not escalated", "file_type": "rationale", "rationale": "They are caught and warned rather than reaching the supervisor, and the transition completes regardless.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_ontransition", "label": "onTransition listener", "file_type": "concept", "rationale": "Fires on every transition with from, to and the new data, so global instrumentation needs no per-state callbacks; multiple listeners append.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_restart_semantics", "label": "FSM restart resets to the initial state", "file_type": "rationale", "rationale": "There is no event log to replay, so a restart runs the constructor and starts over at the initial state and data; use PersistentFSM if the state must survive.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_fsm_fsm_serializable_state_data", "label": "Keep state data serializable and immutable", "file_type": "rationale", "rationale": "Closures and actor refs do not survive a restart and can leak; treating data as immutable per transition keeps the machine testable and makes a later move to PersistentFSM possible.", "source_file": "docs/src/content/docs/persistence/fsm/fsm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_fsm_fsm_fsm", "target": "docs_src_content_docs_persistence_fsm_fsm_when", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.