{"nodes": [{"id": "docs_src_content_docs_de_persistence_fsm_overview_finitestatemachine", "label": "Endliche Zustandsmaschine (FSM-Muster)", "file_type": "rationale", "rationale": "Richtig, wenn ein Actor 3+ benannte Zustaende mit unterschiedlichem Verhalten hat, Uebergaenge explizit sind und Seiteneffekte zu Zustandsuebergaengen gehoeren. Fuer einen einzelnen Zustand oder Boolean-Toggle liest sich ein gewoehnlicher Actor sauberer; fuer hierarchische oder parallele Substates ist die bewusst flache FSM von actor-ts das falsche Werkzeug.", "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_fsm_overview_fsm_vs_become", "label": "FSM vs. become", "file_type": "rationale", "rationale": "FSM hat benannte Zustaende, explizite Uebergaenge und typisierte Zustands-Inspektion; become sind anonyme Closures, die das aktuelle Verhalten nicht exponieren. Fuer 2 Zustaende ist become in Ordnung, ab 4 ist FSM einfacher zu lesen.", "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_fsm_overview_fsm_vs_persistentfsm", "label": "FSM vs. PersistentFSM", "file_type": "rationale", "rationale": "Fuer eine Saga, die ueber Stunden durch 10 Schritte laeuft, ist das Persistieren jedes Uebergangs kritisch. Fuer einen Connection-Actor, der ein paar Sekunden lebt, ist es verschwenderisch - bei einem Crash einfach von disconnected neu starten. Die beiden Varianten haben ausserdem unterschiedliche Formen: DSL-getrieben vs. tabellengetrieben.", "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_persistence_fsm_overview_finitestatemachine", "target": "docs_src_content_docs_de_persistence_fsm_fsm_fsm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_fsm_overview_finitestatemachine", "target": "docs_src_content_docs_de_persistence_fsm_persistent_fsm_persistentfsm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_fsm_overview_fsm_vs_become", "target": "docs_src_content_docs_de_persistence_fsm_fsm_fsm", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_fsm_overview_fsm_vs_persistentfsm", "target": "docs_src_content_docs_de_persistence_fsm_persistent_fsm_persistentfsm", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_fsm_overview_fsm_vs_persistentfsm", "target": "docs_src_content_docs_de_persistence_fsm_fsm_restart_semantics", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/fsm/overview.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}