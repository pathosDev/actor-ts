{"nodes": [{"id": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_with_lease", "label": "Singleton mit Lease", "file_type": "document", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Manager spawnt erst nach dem Erwerb der Lease; zwei Manager, die gleichzeitig Leadership beanspruchen, liefern sich ein Rennen, nur einer gewinnt."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_single_writer_lease", "label": "Single-Writer-Lease", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Lease-Backend liefert die atomare Exactly-One-Holder-Garantie jenseits der eventuellen Konsistenz von Gossip."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_protection_levels", "label": "Das Schutzniveau lesen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keine Zeile sagt \"unm\u00f6glich\": ohne Lease h\u00e4lt der Hand-over nur, solange der Amtsinhaber erreichbar ist und antwortet; mit Lease liegt der Schiedsrichter au\u00dferhalb beider H\u00e4lften, und was bleibt, ist die Garantie des Providers selbst."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_lease_loss_handling", "label": "Behandlung von Lease-Verlust", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auf diesem Pfad ist Promptheit die Sicherheitseigenschaft, und ein Drain ist nicht prompt: behandle den Widerruf als den Moment, ab dem die Instanz nicht mehr autoritativ ist, nicht als den Moment, in dem sie stoppt."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_lease_backend_spof", "label": "Das Lease-Backend wird zum SPOF", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_failover_window_ttl", "label": "Failover-Fenster gleich Lease-TTL", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_vs_sharding_lease", "label": "Singleton + Lease gegen\u00fcber Sharding + Lease", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Singleton-Failover ist disruptiver, weil der Singleton die Workload ist; Sharding-Failover betrifft nur neue Allokationen."}], "edges": [{"source": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_de_cluster_singleton_with_lease_single_writer_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_d