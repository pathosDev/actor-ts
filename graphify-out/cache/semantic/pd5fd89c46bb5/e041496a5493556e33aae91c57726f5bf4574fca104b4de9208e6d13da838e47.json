{"nodes": [{"id": "devtools_ui_src_app_appshellcomponent_app_shell", "label": "DevTools app shell", "file_type": "concept", "source_file": "devtools-ui/src/app/AppShellComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devtools_ui_src_app_appshellcomponent_navigation", "label": "Panel navigation with unavailable items", "file_type": "concept", "source_file": "devtools-ui/src/app/AppShellComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unusable panel renders as a disabled span carrying the reason in its title and aria-label rather than vanishing from the nav."}, {"id": "devtools_ui_src_app_appshellcomponent_unavailable_notice", "label": "Server-decided panel availability", "file_type": "rationale", "source_file": "devtools-ui/src/app/AppShellComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundle ships every panel, but whether one can do anything depends on the system being looked at, so the decision is the server's; a route guard would send the reader somewhere else instead of saying why."}, {"id": "devtools_ui_src_app_appshellcomponent_offline_dialog", "label": "No node reachable dialog", "file_type": "concept", "source_file": "devtools-ui/src/app/AppShellComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything behind the dialog is the last thing the node said, frozen; the dialog closes by itself once something answers, and it points out that another node serves its own DevTools port."}, {"id": "devtools_ui_src_app_appshellcomponent_incompatible_status", "label": "UI/server protocol version mismatch", "file_type": "concept", "source_file": "devtools-ui/src/app/AppShellComponent.html", "source_location": null, "source_url": null,