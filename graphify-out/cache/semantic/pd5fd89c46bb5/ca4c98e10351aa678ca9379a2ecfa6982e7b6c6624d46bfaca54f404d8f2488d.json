{"nodes": [{"id": "docs_src_content_docs_cache_in_memory_inmemorycache", "label": "InMemoryCache", "file_type": "concept", "rationale": "A Map with LRU eviction, lazy per-entry TTL and an optional background sweep; in-process, zero dependencies, lost on restart, and right for tests, dev and single-process production.", "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_in_memory_inmemorycacheoptions", "label": "InMemoryCacheOptions", "file_type": "concept", "rationale": "maxEntries and cleanupMs are validated once at construction on the merged settings, so the builder, a plain object and HOCON all hit the same check and a bad value throws OptionsError.", "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_in_memory_lru_bound", "label": "LRU bound (maxEntries)", "file_type": "rationale", "rationale": "The default 10 000-entry cap keeps a flood of distinct, never-re-read keys from growing the map without limit; only a read counts as a use, so an idempotency record written once and never read back ages towards eviction from the moment it is stored.", "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_in_memory_ttl_handling", "label": "Lazy expiry plus background sweep", "file_type": "concept", "rationale": "Deadlines are checked on every read, and a sweep every cleanupMs reclaims expired entries nobody touches again so they do not sit in the Map waiting for a read.", "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_in_memory_eviction_blind", "label": "Eviction is blind to what an entry protects", "file_type": "rationale", "rationale": "Recency is the only criterion, so dropping a rate-limit counter silently resets the window and dropping an idempotency record makes an honest retry run the handler twice - a double charge on a payments endpoint. At the default bound and 100 rps a caller turns the whole map over in ~100 s, inside the documented rate limit.", "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_in_memory_cacheextensionid", "label": "CacheExtensionId named caches", "file_type": "concept", "rationale": "Each name resolves to its own instance so a flood through one cannot reach the others; this narrows the blast radius rather than removing it, and a security-relevant consumer is better backed by Redis.", "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cache_in_memory_inmemorycache", "target": "docs_src_content_docs_cache_overview_cache", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_inmemorycache", "target": "docs_src_content_docs_cache_in_memory_inmemorycacheoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_lru_bound", "target": "docs_src_content_docs_cache_in_memory_inmemorycache", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_ttl_handling", "target": "docs_src_content_docs_cache_overview_ttl_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_eviction_blind", "target": "docs_src_content_docs_cache_in_memory_cacheextensionid", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_eviction_blind", "target": "docs_src_content_docs_cache_in_memory_lru_bound", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_cacheextensionid", "target": "docs_src_content_docs_cache_in_memory_inmemorycache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_inmemorycache", "target": "docs_src_content_docs_cache_redis_rediscache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_inmemorycache", "target": "docs_src_content_docs_cache_overview_acquirelock", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_inmemorycacheoptions", "target": "readme_typed_options", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cache_in_memory_lru_bound", "target": "docs_src_content_docs_cluster_pubsub_bounded_registries", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/cache/in-memory.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}