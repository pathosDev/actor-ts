{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_messages_message", "label": "Nachricht", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_discriminated_union_convention", "label": "Discriminated-Union-Konvention", "file_type": "rationale", "rationale": "Buys three things: compile-time exhaustiveness, type narrowing inside handlers, and wire-format stability \u2014 the wire carries no type identity, so the discriminant must travel inside the payload.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_kind_discriminant", "label": "kind-Diskriminator", "file_type": "concept", "rationale": "Lowercase, kebab-case for multiple words; the project-wide convention the receiving actor's match dispatches on.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_immutability_rules", "label": "Immutability-Regeln", "file_type": "rationale", "rationale": "A message can be processed twice (restart replay, reliable redelivery), and cross-process sends hand the receiver a copy \u2014 the asymmetry between local and remote mutation is what produces confusing bugs.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_replyto_ref", "label": "Reply-to-Ref", "file_type": "concept", "rationale": "Clumsier than a method call but decouples request from reply in time, lets a different actor answer, and works identically locally and across the cluster.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_reply_type_generics", "label": "Reply-Type-Generics", "file_type": "concept", "rationale": "ActorRef<unknown> swallows the reply type; a discriminated union for the reply lets the caller match success and failure the way it dispatches its own commands.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_command_event_split", "label": "Command-vs-Event-Split", "file_type": "rationale", "rationale": "Events are the durable record replayed on restart while commands are transient, so past tense for events and imperative for commands keeps the conceptual line visible.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_messages_no_functions_in_messages", "label": "Keine Funktionen in Nachrichten", "file_type": "rationale", "rationale": "No process boundary carries function pointers: the tagged JSON tree rejects them, JSON.stringify drops them silently, and structured clone throws DataCloneError \u2014 so a callback works in-process and breaks the moment the actor moves node.", "source_file": "docs/src/content/docs/de/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_fundamentals_messages_message", "target": "docs_src_content_docs_de_fundamentals_messages_discriminated_union_convention", 