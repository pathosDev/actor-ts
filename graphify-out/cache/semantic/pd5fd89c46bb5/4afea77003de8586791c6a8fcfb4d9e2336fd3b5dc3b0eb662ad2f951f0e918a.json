{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_death_watch_death_watch", "label": "Death Watch", "file_type": "rationale", "rationale": "Kept deliberately distinct from supervision: a failing child is its parent's problem, while a stopping sibling is a notification event any actor may subscribe to.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_terminated", "label": "Terminated (Systemnachricht)", "file_type": "concept", "rationale": "Delivered through the mailbox so ordering against user messages is well defined; watching an already-stopped actor delivers immediately.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_context_watch", "label": "context.watch(ref)", "file_type": "concept", "rationale": "Opt-in per watcher; the observed actor is never told it is watched, so no message reaches it.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_context_watchwith", "label": "context.watchWith(ref, message)", "file_type": "rationale", "rationale": "Moves the 'what does this death mean' decision to registration time, so the watcher's union stays a description of what it does instead of carrying Terminated.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_context_unwatch", "label": "context.unwatch(ref)", "file_type": "concept", "rationale": "Idempotent and registration-agnostic; a stopping actor cleans up its own registrations, so unwatch is only for interest that changes mid-flight.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_deathpacterror", "label": "DeathPactError", "file_type": "rationale", "rationale": "The runtime never throws it: a death pact is a policy about one watcher, and onReceive returns void so the cell cannot tell an ignored death from a quietly handled one.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_addressterminated", "label": "addressTerminated-Flag", "file_type": "concept", "rationale": "Reserved for the cluster case where a whole node disappears; always false today because node-wide Terminated notifications are not raised yet.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_existenceconfirmed", "label": "existenceConfirmed-Feld", "file_type": "concept", "rationale": "Always the constructor default true in framework-delivered notifications, so it must not be relied on as an error signal.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_registration_incarnation", "label": "Eine Registrierung, ein Tod (Inkarnation als Schl\u00fcssel)", "file_type": "rationale", "rationale": "Bookkeeping keys on the incarnation, not the path, so a pending notification from a dead child can never be delivered against its replacement.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_auto_stop_on_dependency_loss", "label": "Auto-Stop bei Verlust einer Abh\u00e4ngigkeit", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_cleanup_coordination", "label": "Cleanup-Koordination \u00fcber Death Watch", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_exhaustive_restart_hazard", "label": "Fehlender Terminated-Arm unter .exhaustive()", "file_type": "rationale", "rationale": "ts-pattern throws on an unmatched Terminated, which runs through supervision and turns 'this death does not concern me' into a restart loop under the default strategy.", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_death_watch_remote_watch", "label": "Watchen \u00fcber den Cluster hinweg", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/death-watch.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_fundamentals_death_watch_death_watch", "target": "docs_src_content_docs_de_fundamentals_death_watch_terminated", "relation": "references", "confide