{"nodes": [{"id": "docs_src_content_docs_http_middleware_basic_auth_basicauth", "label": "BasicAuth", "file_type": "concept", "rationale": "The Authorization: Basic peer of BearerTokenAuth. Takes either a users map or a custom validate function; a 401 advertises a real WWW-Authenticate: Basic realm challenge.", "source_file": "docs/src/content/docs/http/middleware/basic-auth.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_middleware_basic_auth_constant_time_comparison", "label": "Constant-time credential comparison", "file_type": "rationale", "rationale": "Credentials are compared in constant time so response timing cannot leak a prefix match. Basic credentials are base64 rather than encrypted, so the scheme is only safe over HTTPS (a TLS-terminating proxy counts) and only for a shared operator credential.", "source_file": "docs/src/content/docs/http/middleware/basic-auth.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_http_middleware_basic_auth_constant_time_comparison", "target": "docs_src_content_docs_http_middleware_basic_auth_basicauth", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/middleware/basic-auth.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_middleware_basic_auth_basicauth", "target": "docs_src_content_docs_http_middleware_csrf_csrfprotection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/middleware/basic-auth.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}