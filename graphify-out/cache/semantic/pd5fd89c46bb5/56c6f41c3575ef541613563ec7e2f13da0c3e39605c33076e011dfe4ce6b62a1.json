{"nodes": [{"id": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "label": "Dead-Letter-Panel", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardmaessig wirft nichts eine Exception und nichts landet im Log - genau diese Stille macht den Fehler leicht zu uebersehen, und dieses Panel ist der Ort, an dem er sichtbar wird."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_replays_spalte", "label": "replays-Spalte", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Wert ueber null bedeutet eine Poison Message, die wiederholt wird - keinen frischen Fehler."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_queue_einschalten", "label": "Die Dead-Letter-Queue einschalten", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Queue ist standardmaessig aus: jede unzustellbare Nachricht zu erfassen kostet Speicher, und ein System, das nie eine erzeugt, soll dafuer nicht zahlen."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_store_off_meldet_sich", "label": "store: off meldet sich als nicht verfuegbar", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine leere Tabelle kann nicht sagen, ob nichts kaputt ist oder ob nichts aufgezeichnet wird - das sind gegenteilige Antworten, also bleibt das Panel in der Navigation und nennt die zu aendernde Einstellung."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_filtern_teilbaum", "label": "Filtern nach Empfaengerpfad (Teilbaum, serverseitig)", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gefiltert wird auf dem Server ueber den Ring, den er ohnehin haelt; die Zusammenfassung zaehlt, was der Filter ausgewaehlt hat, nicht was die Seite zeigt."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_payload_sanitizing", "label": "Payload-Bereinigung", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tiefe, Anzahl der Eintraege und Stringlaenge sind gedeckelt; eine zurechtgeschnittene Nachricht sagt truncated, und eine, die die Queue nicht behalten konnte, nennt den Grund statt ein null zu zeigen."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_payload_sind_deine_daten", "label": "Die Payload sind deine Daten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Panel legt offen, was deine Nachrichten transportieren - mit panels.deadLetters: false abschalten, wo das zaehlt."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_replay_bleibt_im_code", "label": "Erneutes Zustellen bleibt bewusst im Code", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Button, der Produktionsnachrichten erneut versendet, ist eine andere Art von Entscheidung als eine Tabelle, die sie anzeigt."}, {"id": "docs_src_content_docs_de_observability_devtools_dead_letters_polling_rationale", "label": "Warum das Panel pollt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Queue ist ein begrenzter Ring, den der Server ohnehin haelt - eine Anfrage pro Sekunde ist billig, und jede Erfassung zu pushen wuerde DevTools auf den Zustellpfad genau der Fehler setzen, die es beobachtet."}], "edges": [{"source": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_queue_einschalten", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_replays_spalte", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_filtern_teilbaum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_payload_sanitizing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_store_off_meldet_sich", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_queue_einschalten", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_payload_sind_deine_daten", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_payload_sanitizing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_replay_bleibt_im_code", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_polling_rationale", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_dead_letters_queue_einschalten", "target": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "