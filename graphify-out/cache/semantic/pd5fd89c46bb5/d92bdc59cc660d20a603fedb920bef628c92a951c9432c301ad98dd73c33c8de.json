{"nodes": [{"id": "docs_src_content_docs_patterns_retry_retry", "label": "retry helper", "file_type": "concept", "rationale": "A pure async function with no actors and no state - the simplest layer in the resilience stack. attempts is total attempts including the initial call, not retries.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_retry_backoff_options", "label": "delayMs, factor and maxDelayMs", "file_type": "concept", "rationale": "Delay on attempt N is delayMs times factor to the N minus 1, bounded by maxDelayMs. The delay is deterministic per attempt - there is no jitter, so wrap a policy when high concurrency might synchronize.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_shouldretry", "label": "shouldRetry", "file_type": "concept", "rationale": "Runs after every failed attempt except the last and returning false short-circuits the loop immediately; use it to separate transient failures from permanent ones that will fail the same way next time.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_onattempt", "label": "onAttempt", "file_type": "concept", "rationale": "Fires after every failed attempt including the final one, for per-attempt counters, tracing spans and an alert on running out of retries.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_sleep_injection", "label": "Injecting sleep to leave the wall clock", "file_type": "rationale", "rationale": "Measuring real gaps is a flake waiting to happen - a 30 ms setTimeout lands anywhere from roughly 19 ms to 200 ms depending on timer quantum and load, wide enough that a capped delay is indistinguishable from an uncapped one.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_idempotency_hazard", "label": "Do not retry non-idempotent operations", "file_type": "rationale", "rationale": "If the first call succeeds but the response is lost in transit, the retry charges the card again; either make the operation idempotent with a request id or do not retry side-effecting calls.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_delay_overflow", "label": "Exponential delay overflow without maxDelayMs", "file_type": "rationale", "rationale": "At attempt 30 with factor 2 and a 100 ms base the delay is roughly 1.6 years; always set maxDelayMs whenever factor exceeds 1.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_retry_no_cancellation", "label": "retry has no built-in cancellation", "file_type": "rationale", "rationale": "It will run every attempt regardless; pass an AbortSignal into the factory and give a shouldRetry that returns false for AbortError to fail fast, since by default an AbortError is retried like any other.", "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_retry_backoff_options", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_shouldretry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_onattempt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_sleep_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_idempotency_hazard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_delay_overflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "target": "docs_src_content_docs_patterns_retry_no_cancellation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_delay_overflow", "target": "docs_src_content_docs_patterns_retry_retry_backoff_options", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_no_cancellation", "target": "docs_src_content_docs_patterns_retry_shouldretry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_idempotency_hazard", "target": "docs_src_content_docs_patterns_retry_retry", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_sleep_injection", "target": "docs_src_content_docs_patterns_backoff_policy_injectable_random", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry_backoff_options", "target": "docs_src_content_docs_patterns_backoff_policy_exponentialbackoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry_backoff_options", "target": "docs_src_content_docs_patterns_backoff_policy_jitter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/retry.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_retry_retry", "