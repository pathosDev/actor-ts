{"nodes": [{"id": "docs_src_content_docs_de_io_sse_sseactor", "label": "SseActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Nur-Lese-Client, der ein langlebiges HTTP-GET oeffnet, das text/event-stream-Wire-Format parst und jedes Event an einen Ziel-Actor weiterleitet."}, {"id": "docs_src_content_docs_de_io_sse_sseoptionstype", "label": "SseOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "requiredOptions ist [url, target]; beide muessen vorhanden sein, sonst schlaegt der Actor beim Start sofort fehl."}, {"id": "docs_src_content_docs_de_io_sse_sseevent", "label": "SseEvent", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_sse_sse_wire_format_parsing", "label": "SSE-Wire-Format-Parsing", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Spezifikation folgend: Ein Block ohne event:-Feld kommt als message an, mehrere data:-Zeilen werden mit \\n verbunden, Kommentarzeilen mit fuehrendem : (Keepalive) werden uebersprungen."}, {"id": "docs_src_content_docs_de_io_sse_sse_read_only", "label": "Nur-Lese \u2014 kein Ausgang", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SSE ist einseitig, also gibt es keine Kommandos (SseCommand = never) und dispatchOutgoing wirft. Zum Senden nimmt man einfaches HTTP oder einen WebSocket-Client."}, {"id": "docs_src_content_docs_de_io_sse_sse_inherited_reconnect_circuit_breaker", "label": "Geerbter Reconnect + Circuit Breaker", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SseActor erweitert BrokerActor, also greift bei Stream-Ende oder Abbruch die Reconnect-Maschinerie der Basisklasse. withReconnect(false) stoppt stattdessen nach dem Stream-Ende \u2014 fuer endliche Feeds oder Tests."}, {"id": "docs_src_content_docs_de_io_sse_sse_hocon_namespace", "label": "HOCON-Namespace actor-ts.io.broker.sse", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "target ist eine Actor-Referenz und kann deshalb nur im Code gesetzt werden, nicht in HOCON."}, {"id": "docs_src_content_docs_de_io_sse_when_sse", "label": "Wann SSE passt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM-Token-Streams, Marktdaten-Ticks, CI-/Build-Logs. Weil es einfach HTTP ist, funktioniert es durch Proxies, Load-Balancer und CDNs, die kein WebSocket verstehen."}], "edges": [{"source": "docs_src_content_docs_de_io_sse_sseactor", "target": "docs_src_content_docs_de_io_sse_sseoptionstype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_sse_sseactor", "target": "docs_src_content_docs_de_io_sse_sseevent", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/sse.mdx", "source_location": null, "weight": 1}