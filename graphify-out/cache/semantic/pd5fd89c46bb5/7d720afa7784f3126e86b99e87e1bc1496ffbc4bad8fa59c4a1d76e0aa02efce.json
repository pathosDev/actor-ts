{"nodes": [{"id": "tests_integration_docker_compose_integration_cluster_node_services", "label": "Five Cluster-Node Services", "file_type": "code", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_docker_compose_integration_node_defaults_anchor", "label": "x-node-defaults YAML Anchor", "file_type": "rationale", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each node overrides only container_name, hostname and NODE_NAME; the anchor keeps the per-node block to ~5 lines instead of duplicating the whole stanza five times."}, {"id": "tests_integration_docker_compose_integration_net_admin_capability", "label": "Per-Container NET_ADMIN Capability", "file_type": "rationale", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each cluster node gets NET_ADMIN so it can install iptables and tc rules inside its OWN namespace \u2014 no host-level privileged mode and no docker-socket access."}, {"id": "tests_integration_docker_compose_integration_seed_of_self_bootstrap", "label": "Seed-of-Self Bootstrap Node", "file_type": "rationale", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empty SEEDS list means be the seed; every other node seeds back to the first, which is what makes the mesh converge from a single well-known address."}, {"id": "tests_integration_docker_compose_integration_controller_service", "label": "Controller Service", "file_type": "code", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_docker_compose_integration_cluster_bridge_network", "label": "Cluster Bridge Network", "file_type": "concept", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_docker_compose_integration_control_ping_healthcheck", "label": "Control-Port Ping Healthcheck", "file_type": "concept", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nodes are considered healthy only once /test/ping answers, which is what other nodes' and the controller's depends_on conditions wait on."}, {"id": "tests_integration_docker_compose_integration_peers_env_shutdown_trace", "label": "PEERS List for Shutdown-Trace Hook", "file_type": "concept", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A comma-separated list of all node hostnames so a shutting-down node can post a marker to a peer that is still alive."}, {"id": "tests_integration_docker_compose_integration_controller_exit_code_as_result", "label": "Controller Exit Code as Test Result", "file_type": "rationale", "source_file": "tests/integration/docker-compose.integration.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`--exit-code-from controller` in the npm script bubbles the controller's status back up, so the compose run itself is the pass/fail signal."}], "edges": [{"source": "tests_integration_docker_compose_integration_node_defaults_anchor", "target": "tests_integration_docker_compose_integration_cluster_node_services", "relation": "