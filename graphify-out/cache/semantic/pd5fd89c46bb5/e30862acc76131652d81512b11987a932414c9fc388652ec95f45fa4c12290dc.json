{"nodes": [{"id": "docs_src_content_docs_de_coordination_overview_lease_api", "label": "Coordination Lease API", "file_type": "concept", "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A distributed lock with TTL giving the single-holder guarantee that membership-only mechanisms cannot: at most one process holds it, with a backend supplying the constraint. Worth the operational cost wherever double execution does real damage."}, {"id": "docs_src_content_docs_de_coordination_overview_leaseoptionstype", "label": "LeaseOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ttlMs 15-30s \u2014 short enough to recover from a crashed holder, long enough to tolerate gossip and renewal delays; renewalIntervalMs about ttl/3 so one failed renew does not lose the lease."}, {"id": "docs_src_content_docs_de_coordination_overview_lease_lifecycle", "label": "Lease lifecycle", "file_type": "concept", "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "not_held -> acquired -> renewing, back to not_held on a failed renew or explicit release. The TTL is what makes a crashed holder recoverable: ownership lapses automatically and other contenders can acquire."}, {"id": "docs_src_content_docs_de_coordination_overview_renewal_failure_loses_lease", "label": "A renewal failure loses the lease immediately", "file_type": "rationale", "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No built-in backend retries renewals \u2014 the first failed renew (a lost race, a 409/404, any transient backend error) fires onLost. acquireRetries applies only to acquire(), never the renewal loop, so treat every onLost as a real ownership change."}, {"id": "docs_src_content_docs_de_coordination_overview_lease_does_not_replace_downing", "label": "A lease does not replace downing", "file_type": "rationale", "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lease holds the singleton/coordinator uniqueness invariant; downing handles which side of a partition survives. Without downing both halves gossip on forever even with a lease. Also, a lease is only as good as its backend's consistency model."}], "edges": [{"source": "docs_src_content_docs_de_coordination_overview_lease_api", "target": "docs_src_content_docs_de_coordination_lease_api_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_coordination_overview_lease_lifecycle", "target": "docs_src_content_docs_de_coordination_overview_leaseoptionstype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_coordination_overview_renewal_failure_loses_lease", "target": "docs_src_content_docs_de_coordination_overview_lease_lifecycle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_coordination_overview_lease_does_not_replace_downing", "target": "docs_src_content_docs_de_coordination_overview_lease_api", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_coordination_overview_lease_api", "target": "docs_src_content_docs_de_coordination_in_memory_lease_inmemorylease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_coordination_overview_lease_api", "target": "docs_src_content_docs_de_cluster_singleton_manager_lease_gated_spawn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/coordination/overview.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}