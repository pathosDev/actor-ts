{"nodes": [{"id": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "label": "Dispatcher interface", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Picking between the microtask and macrotask queues is the dispatcher job, and the choice has real consequences for throughput, fairness and latency."}, {"id": "docs_src_content_docs_fundamentals_dispatchers_microtaskdispatcher", "label": "MicrotaskDispatcher", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest, but can starve I/O and timers under sustained actor load \u2014 right for compute-heavy pipelines with no I/O, and for tests that want deterministic ordering."}, {"id": "docs_src_content_docs_fundamentals_dispatchers_immediatedispatcher", "label": "ImmediateDispatcher (default)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fairness with I/O is the right default for HTTP servers and broker-backed actors, both common in actor-ts applications."}, {"id": "docs_src_content_docs_fundamentals_dispatchers_throughputdispatcher", "label": "ThroughputDispatcher", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only built-in holding a queue of its own \u2014 drained from the front throughput times per tick and holding every actor pending unit, so it is deepest exactly when the system is busiest."}, {"id": "docs_src_content_docs_fundamentals_dispatchers_customdispatcher", "label": "Custom dispatcher (wrap-and-delegate)", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrap-and-delegate keeps the underlying scheduling behavior and adds cross-cutting concerns \u2014 tracing, metering, per-priority isolation. A synchronous dispatcher defeats the actor-model invariants and is not for production."}, {"id": "docs_src_content_docs_fundamentals_dispatchers_peractordispatcher", "label": "Per-actor dispatcher", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_dispatchers_dispatchererror", "label": "DispatcherError", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires for faults supervision structurally cannot see, so the channel is quiet by design \u2014 treat traffic on it as a page, not a counter. console.error stays only as the last resort for a dispatcher used outside an actor system."}, {"id": "docs_src_content_docs_fundamentals_dispatchers_throughputknobs", "label": "Two different throughput knobs", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dispatcher throughput counts queued turns, one per actor; how many messages a single actor handles in its turn is a separate setting. If one busy actor is the bottleneck, that is the knob you want."}], "edges": [{"source": "docs_src_content_docs_fundamentals_dispatchers_microtaskdispatcher", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_dispatchers_immediatedispatcher", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_dispatchers_throughputdispatcher", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_dispatchers_customdispatcher", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_dispatchers_peractordispatcher", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_dispatchers_dispatchererror", "target": "docs_src_content_docs_fundamentals_dispatchers_dispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/dispatchers.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_dispatchers_throughputknobs", "target": "docs_src