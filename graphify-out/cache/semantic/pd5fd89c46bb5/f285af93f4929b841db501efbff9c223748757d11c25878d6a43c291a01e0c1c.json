{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "label": "ReceiveTimeout", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ReceiveTimeout.instance ist ein Singleton, Identitaetsvergleich ist zuverlaessig; wird ueber denselben Pfad wie jede User-Nachricht ausgeliefert, eine gestaute Mailbox verzoegert ihn also."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_setreceivetimeout", "label": "context.setReceiveTimeout(ms)", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feuert wiederholt - nach Zustellung wird neu armiert; setReceiveTimeout(0) entspricht cancelReceiveTimeout(). Restart setzt den Timer zurueck, in preStart oder postRestart neu armieren. become() beruehrt ihn nicht."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_cancelreceivetimeout", "label": "context.cancelReceiveTimeout()", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_idle_detection", "label": "Idle-Detection statt Ticker", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feuert bei Abwesenheit von Traffic, nicht nach festem Schedule; Sub-Sekunden-Timeouts sind meist ein Zeichen, dass context.timers das richtige Werkzeug ist."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_user_messages_only", "label": "Nur User-Nachrichten setzen den Timer zurueck", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Strom von System-Nachrichten (z. B. Terminated vieler Kinder) verhindert den Timeout nicht; ein PoisonPill triggert den normalen Shutdown, es gibt keinen letzten Receive-Timeout davor."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_session_expiry", "label": "Session-Ablauf-Muster", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-User-Session-Actor stoppt sich nach Inaktivitaet selbst; kommt der User zurueck, spawnt ein frischer Actor."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_passivation", "label": "Passivierung sharded Entities", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine untaetige Entitaet signalisiert ihrer Region, sie zu passivieren, was Memory freigibt; eine neue Nachricht spawnt sie aus dem persistierten Zustand erneut."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_watchdog", "label": "Watchdog fuer Downstream-Stille", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erkennt 'das Upstream hat aufgehoert zu senden' ohne eigenen ping - der Timeout ist die Abwesenheit von Traffic."}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_empty_mdc", "label": "ReceiveTimeout traegt keinen diagnostischen Kontext", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laeuft mit leerer MDC, und ein tell aus dem Handler traegt folglich auch nichts: du machst diesen Timer nie selbst scharf - das Framework armiert ihn nach jeder Nachricht neu, es gibt also keine Aufrufstelle, an der du haettest leeren koennen. Untaetigkeit gehoert zu keinem Request."}], "edges": [{"source": "docs_src_content_docs_de_fundamentals_receive_timeout_setreceivetimeout", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_fundamentals_receive_timeout_cancelreceivetimeout", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_setreceivetimeout", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_fundamentals_receive_timeout_idle_detection", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_fundamentals_receive_timeout_user_messages_only", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_setreceivetimeout", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_cont