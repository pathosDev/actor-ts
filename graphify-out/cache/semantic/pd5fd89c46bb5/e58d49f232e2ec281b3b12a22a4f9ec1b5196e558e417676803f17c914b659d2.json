{"nodes": [{"id": "docs_src_content_docs_io_redis_streams_redis_streams", "label": "Redis Streams", "file_type": "document", "source_file": "docs/src/content/docs/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_redis_streams_redisstreamsactor", "label": "RedisStreamsActor", "file_type": "concept", "rationale": "Consumption always goes through a consumer group \u2014 the actor uses XREADGROUP exclusively, with no group-less XREAD broadcast path, and starts only when consumerGroup, streams and target are all set.", "source_file": "docs/src/content/docs/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_redis_streams_consumer_group", "label": "Redis consumer-group work-sharing", "file_type": "concept", "rationale": "Each message goes to exactly one consumer in the group; consumers XACK after processing and N actor instances in the same group share the workload. The right mode for work queues.", "source_file": "docs/src/content/docs/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_redis_streams_pending_entries_list", "label": "Pending Entries List (PEL)", "file_type": "concept", "rationale": "Redis tracks every delivered-but-not-acked entry per consumer. After a crash those entries must be re-claimed manually with XCLAIM from a separate ioredis client or sidecar \u2014 a wrapping actor command does not exist yet.", "source_file": "docs/src/content/docs/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_redis_streams_stream_id_dedup", "label": "Stream id as dedup key", "file_type": "concept", "rationale": "Stream IDs are <millis>-<seq> st