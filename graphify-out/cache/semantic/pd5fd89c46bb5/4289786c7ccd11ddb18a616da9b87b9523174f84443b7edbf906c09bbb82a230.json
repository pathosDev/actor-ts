{"nodes": [{"id": "docs_src_content_docs_de_typed_overview_typed_api", "label": "Typed-API (Behaviors als Werte)", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/overview.mdx", "rationale": "Eine funktionale Fassade auf der untyped-Engine: Zustand als Parameter statt Felder, pure-funktionales Message-Handling, Sentinels als Transition-Entscheidung, cast-freies Child-Spawning. Ein fehlendes Return ist hier ein Typfehler, in der untyped-Form still okay.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_overview_untyped_api", "label": "Untyped-API (Actor-Subklasse)", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/overview.mdx", "rationale": "Die niedrigere, flexiblere API. Sauberer bei erheblichem mutablem Zustand, bei Lifecycle-Hooks (preStart/postStop/preRestart statt Signal-Events) und beim Interop \u2014 die Internas der Cluster-Extensions sind untyped-Klassen, und das leakt gelegentlich an den Naehten.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_overview_choosing_typed_vs_untyped", "label": "Wann typed, wann untyped", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/overview.mdx", "rationale": "Beide laufen auf demselben Dispatcher, derselben Mailbox, demselben Supervisionsbaum \u2014 die Wahl ist Ausdrucksstil, nicht Faehigkeit. Typed fuer State-Machines mit phasenweise verschiedenen Valid-Message-Sets und compiler-gepruefte Transitions; untyped bei grossem mutablem Aggregat oder beim Lernen des Modells.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_overview_mixing_typed_and_untyped", "label": "Typed und untyped mischen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/overview.mdx", "rationale": "Refs sind interoperabel \u2014 beide Formen exponieren ActorRef<T> mit derselben tell-Signatur, sodass typed- und untyped-Actors einander ueber die Grenze hinweg Nachrichten senden koennen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_typed_overview_typed_api", "target": "docs_src_content_docs_de_typed_behaviors_behaviors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_typed_overview_typed_api", "target": "docs_src_content_docs_de_typed_overview_untyped_api", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_typed_overview_choosing_typed_vs_untyped", "target": "docs_src_content_docs_de_typed_overview_typed_api", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_typed_overview_choosing_typed_vs_untyped", "target": "docs_src_content_docs_de_typed_overview_untyped_api", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_typed_overview_mixing_typed_and_untyped", "target": "docs_src_content_docs_de_typed_spawn_typed_context_spawntyped", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_typed_overview_typed_api", "target": "docs_src_content_docs_de_typed_typed_actor_typedactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_typed_overview_untyped_api", "target": "docs_src_content_docs_de_typed_behaviors_receivewithsignal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/typed/overview.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}