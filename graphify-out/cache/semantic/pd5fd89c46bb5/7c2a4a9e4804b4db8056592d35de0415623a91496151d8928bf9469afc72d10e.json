{"nodes": [{"id": "docs_src_content_docs_io_sse_sse", "label": "SSE (Server-Sent Events)", "file_type": "document", "source_file": "docs/src/content/docs/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_sse_sseactor", "label": "SseActor", "file_type": "concept", "rationale": "Uses the global fetch (present on Bun, Node >= 18 and Deno), so there is no extra dependency to install. requiredOptions is ['url','target'] and both must be present or the actor fails fast at startup.", "source_file": "docs/src/content/docs/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_sse_sseevent", "label": "SseEvent parsing rules", "file_type": "concept", "rationale": "A block without an event: field arrives as 'message'; multiple data: lines in one block are joined with a newline; lines beginning with : are keepalive comments and skipped; id is delivered when the server sends one.", "source_file": "docs/src/content/docs/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_sse_read_only", "label": "SSE is read-only", "file_type": "rationale", "rationale": "SSE is unidirectional, so dispatchOutgoing throws, SseCommand is never, and there is no outbound path. Because it is just HTTP it works through proxies, load balancers and CDNs that do not understand WebSocket.", "source_file": "docs/src/content/docs/io/sse.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_io_sse_sse", "target": "docs_src_content_docs_io_sse_sseactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/sse.mdx", "source_location": null, "weight": 1}, {"sourc