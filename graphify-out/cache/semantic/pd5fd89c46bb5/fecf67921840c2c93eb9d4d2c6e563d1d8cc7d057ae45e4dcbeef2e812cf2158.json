{"nodes": [{"id": "tests_integration_readme_real_network_integration_suite", "label": "Real-Network Multi-Node Integration Suite", "file_type": "concept", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The in-memory transport suites give tight feedback loops but never exercise the kernel; a Docker-compose topology of 5 cluster nodes plus a controller is what makes TCP timing, scheduler pressure and real DNS observable."}, {"id": "tests_integration_readme_in_memory_transport_blind_spots", "label": "In-Memory Transport Blind Spots", "file_type": "concept", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synthetic partitions and deterministic ordering cannot surface TCP-layer timing, OS scheduler pressure under real concurrency, kernel-buffer / Nagle interactions, or real-DNS dual-stack behaviour."}, {"id": "tests_integration_readme_noderunner", "label": "NodeRunner Per-Node Entrypoint", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_controller", "label": "Controller Scenario Runner", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_test_control_http_surface", "label": "Test-Control HTTP Surface", "file_type": "concept", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unauthenticated on purpose: it is only reachable from the compose bridge network, so the scenarios need no credential plumbing to install or heal a partition."}, {"id": "tests_integration_readme_management_http_endpoint", "label": "Management HTTP Endpoint", "file_type": "concept", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth-protected with BearerTokenAuth via the MGMT_TOKEN env var, unlike the test-control port."}, {"id": "tests_integration_readme_iptables_symmetric_partition", "label": "Symmetric iptables Partition Injection", "file_type": "rationale", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops are installed in each container's own network namespace and applied in both directions between A and B, so there is no half-open weirdness and a container can only affect its own peers."}, {"id": "tests_integration_readme_tc_netem_latency_injection", "label": "tc netem Latency Injection", "file_type": "rationale", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Latency is injected with `tc qdisc add ... netem delay` rather than simulated in the transport, so the delay is real kernel queueing."}, {"id": "tests_integration_readme_scenario_membership_convergence", "label": "Scenario 01 Membership Convergence", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_scenario_split_brain", "label": "Scenario 02 Split Brain", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_scenario_receptionist_convergence", "label": "Scenario 03 Receptionist Convergence", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_scenario_ddata_latency_storm", "label": "Scenario 04 Distributed Data Latency Storm", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_waitfor", "label": "waitFor Deterministic Deadline Helper", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every wait-until step goes through it because it fails with a deterministic deadline message instead of a flaky 30-second timeout."}, {"id": "tests_integration_readme_controllercontext", "label": "ControllerContext", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_scenario", "label": "Scenario Contract", "file_type": "code", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_readme_integration_ci_workflow", "label": "integration.yml CI Gating", "file_type": "concept", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs only on pull requests targeting main (the release PR) and nightly: the suite is expensive and the fast unit suite catches most regressions, so develop pushes and feature PRs skip it."}, {"id": "tests_integration_readme_unpublished_control_port", "label": "Unpublished Control Port", "file_type": "rationale", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately not published to the host so nothing in the scenarios can reach through it; the same configuration then runs identically in CI and locally, and debugging goes via `docker compose exec`."}, {"id": "tests_integration_readme_tcptransport_cluster_join", "label": "Real TcpTransport Cluster Join", "file_type": "concept", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bound on 0.0.0.0:9000 and identified by the compose hostname, so joins traverse a real socket and real DNS rather than an in-process transport."}, {"id": "tests_integration_readme_jsonlogger_container_logging", "label": "JsonLogger Container Logging", "file_type": "rationale", "source_file": "tests/integration/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen so the docker logs are jq-friendly when a scenario fails in CI."}], "edges": [{"source": "tests_integration_readme_in_memory_transport_blind_spots", "target": "tests_integration_readme_real_network_integration_suite", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/README.md", "source_location": null, "weight": 1.0}, {"source": "tests_integration_readme_real_network_integration_suite", "target": "tests_integration_readme_noderunner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/README.md", "source_location": null, "weight": 1.0}, {"source": "tests_integration_readme_real_network_integration_suite", "target": "tests_integration_readme_controller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/README.md", "source_location": null, "weight": 1.