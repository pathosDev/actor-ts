{"nodes": [{"id": "docs_src_content_docs_persistence_migration_default_adapter_defaultsadapter", "label": "defaultsAdapter", "file_type": "document", "rationale": "The right tool when 'I just added a field' describes the change: each defaults[v] is the set of fields added going from v to v+1, merged in before the stored payload so actual values always win. Only adds missing fields \u2014 no renames, no type changes, and each key must be strictly less than currentVersion.", "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_default_adapter_defaultssnapshotadapter", "label": "defaultsSnapshotAdapter", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_default_adapter_defaultsadapterspec", "label": "DefaultsAdapterSpec", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_default_adapter_constant_defaults_limitation", "label": "Constant defaults are wrong when the value depends on the event", "file_type": "rationale", "rationale": "currency:'USD' is wrong for an account opened in Germany. Defaults are constant per version step, so a per-event value needs migratingAdapter with a context-aware upcaster (or, rarely, a one-off backfill that rewrites the history).", "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_default_adapter_manifest_must_match_on_disk", "label": "Manifest must match on disk", "file_type": "rationale", "rationale": "The manifest in the spec must equal the manifest stored with the events; a mismatch throws MigrationError on read. Typos in defaults field names, by contrast, fail silently because each defaults[v] is a Partial<E>.", "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_migration_default_adapter_defaultsadapter", "target": "docs_src_content_docs_persistence_migration_envelope_format_eventadapter", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_migration_default_adapter_constant_defaults_limitation", "target": "docs_src_content_docs_persistence_migration_default_adapter_defaultsadapter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_migration_default_adapter_manifest_must_match_on_disk", "target": "docs_src_content_docs_persistence_migration_default_adapter_defaultsadapterspec", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/default-adapter.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}