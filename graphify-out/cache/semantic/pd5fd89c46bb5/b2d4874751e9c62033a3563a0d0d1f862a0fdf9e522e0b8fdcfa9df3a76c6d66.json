{"nodes": [{"id": "docs_src_content_docs_cache_redis_rediscache", "label": "RedisCache", "file_type": "concept", "rationale": "The multi-pod default: pods share cache state, MGET/MSET are single round-trips, AOF/RDB survive a restart, and it is the best-supported backend for locking because a key lives on one logical keyspace.", "source_file": "docs/src/content/docs/cache/redis.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_redis_rediscacheoptions", "label": "RedisCacheOptions", "file_type": "concept", "source_file": "docs/src/content/docs/cache/redis.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_redis_ioredis", "label": "ioredis peer dependency", "file_type": "concept", "rationale": "Handles the cluster protocol (MOVED/ASK redirects, slot tracking) and pipelines commands issued in the same JS turn into a single TCP write.", "source_file": "docs/src/content/docs/cache/redis.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_redis_cluster_mode", "label": "Redis Cluster mode", "file_type": "concept", "rationale": "For horizontal scale beyond one server's memory; cross-slot MGETs fan out per slot, so hash-tagging related keys keeps them in one round-trip.", "source_file": "docs/src/content/docs/cache/redis.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cache_redis_keyprefix", "label": "keyPrefix namespacing", "file_type": "rationale", "rationale": "Applied to every key; without it two unrelated apps sharing a Redis collide on the same key names and corrupt each other.", "source_file": "docs/src/content/docs/cache/redis.mdx", "source_location": null, "source_url": null, "captured_at": null,