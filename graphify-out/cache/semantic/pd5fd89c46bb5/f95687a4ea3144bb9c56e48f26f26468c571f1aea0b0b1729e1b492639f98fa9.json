{"nodes": [{"id": "docs_src_content_docs_cluster_cluster_security_cluster_transport_tls", "label": "TLS on the cluster transport", "file_type": "concept", "rationale": "All-or-nothing per cluster - every node uses the same TLS config and mixed plain+TLS does not work; it costs ~5-15 % per byte, imperceptible for typical actor messages. Threat model first: on a trusted single-tenant VLAN plain TCP is fine and TLS only adds cert rotation cost.", "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_security_mutual_tls", "label": "Mutual TLS peer authentication", "file_type": "concept", "rationale": "rejectUnauthorized plus a shared CA makes every connection require a valid cert from both sides - no anonymous joins, no plain-text fallback; it is the mitigation for 'anyone with port access can join'.", "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_security_tcptransport", "label": "TcpTransport", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_security_cert_layout", "label": "CA plus per-node certificate layout", "file_type": "concept", "rationale": "Self-signed is fine for dev and staging; production needs a CA and a rotation plan (cert-manager or equivalent), with a rolling restart for zero-downtime rotation.", "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_security_network_policy", "label": "Kubernetes NetworkPolicy on the cluster port", "file_type": "concept", "rationale": "Restricting port 2552 to app=actor-ts pods combined with mTLS gives two independent layers.", "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_security_reject_unauthorized", "label": "rejectUnauthorized", "file_type": "rationale", "rationale": "Setting it false defeats authentication entirely - any cert is accepted - and is never acceptable in production.", "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_cluster_security_cluster_transport_tls", "target": "docs_src_content_docs_cluster_cluster_security_tcptransport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_security_mutual_tls", "target": "docs_src_content_docs_cluster_cluster_security_cluster_transport_tls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_security_reject_unauthorized", "target": "docs_src_content_docs_cluster_cluster_security_mutual_tls", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-security.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_security_cert_layout", "target": "docs_src_content_docs_cluster_cluster_security_mutual_tls", "relation": 