{"nodes": [{"id": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "label": "Singleton with lease", "file_type": "document", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional split-brain protection: the manager only spawns after acquiring the lease, so two managers both claiming leadership race and only one wins."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "label": "Single-writer lease", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lease backend provides the atomic exactly-one-holder guarantee, beyond gossip eventual consistency."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the pod service account token by default; RBAC must grant Lease CRUD on coordination.k8s.io."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_protection_levels", "label": "Reading the protection level", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No row says \"impossible\", deliberately. Without a lease the hand-over makes \"at most one\" hold whenever the incumbent can be reached and answers; with a lease the arbiter sits outside both halves, and what remains is the lease provider's own guarantee."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_lease_loss_handling", "label": "Lease loss handling", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On this path promptness is the safety property and a drain is not prompt: a singleton with a long mailbox and a slow postStop keeps running for that long after revocation, a window in which another holder may already have started. Treat revocation as the moment the instance is no longer authoritative, not the moment it stops."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_lease_backend_spof", "label": "The lease backend is a SPOF", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A K8s API outage means no renewals, the singleton loses the lease and stops everywhere until the API recovers."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_failover_window_ttl", "label": "Failover window equals the lease TTL", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shorter TTL means faster failover but more renewal traffic; during the gap messages route to a stopped manager and dead-letter unless the proxy buffers."}, {"id": "docs_src_content_docs_cluster_singleton_with_lease_singleton_vs_sharding_lease", "label": "Singleton + lease versus sharding + lease", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Singleton failover is more disruptive because the singleton is the workload; sharding failover affects only new allocations while existing entities keep processing."}], "edges": [{"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_kuberneteslease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_protection_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_lease_loss_handling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_single_writer_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_lease_backend_spof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_failover_window_ttl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_cluster_singleton_with_lease_singleton_vs_sharding_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_with_lease", "target": "docs_src_content_docs_cluster_singleton_manager_clustersingletonmanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_protection_levels", "target": "docs_src_content_docs_cluster_singleton_manager_no_lease_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_singleton_with_lease_singleton_vs_sharding_lease", "target": "docs_src_content_docs_cluster_sharding_overview_coordinator", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_cluster_sharding_rebalance_split_brain_entities", "target": "docs_src_content_docs_cluster_singleton_overview_split_brain_defenses", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/cluster/singleton/with-lease.m