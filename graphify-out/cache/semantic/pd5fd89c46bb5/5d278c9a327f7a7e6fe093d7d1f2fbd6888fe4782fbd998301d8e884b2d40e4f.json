{"nodes": [{"id": "docs_src_content_docs_de_io_amqp_amqpactor", "label": "AmqpActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_amqpoptions", "label": "AmqpOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_amqpqueuebinding", "label": "AmqpQueueBinding", "file_type": "concept", "rationale": "Bindings deklarieren Queue, Exchange-Binding und Consumer-Actor-Target auf einen Schlag; der Actor verdrahtet alles beim Connect (idempotente erneute Deklaration). Runtime-Subscribe/Unsubscribe ist kein v1-Surface \u2014 fuer einen neuen Consumer den Actor mit aktualisierten Bindings neu starten.", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_exchanges_and_routing", "label": "Exchanges und Routing", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_acknowledgment_handshake", "label": "ACK / NACK", "file_type": "concept", "rationale": "Jede AmqpDelivery traegt einen opaken ackToken; man reicht das ganze delivery-Objekt im acknowledgment/negativeAcknowledgment-Tell zurueck. Der Broker haelt die Nachricht unacked, bis der Handler antwortet \u2014 ohne ACK geht ihm irgendwann der Speicher aus.", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_prefetch", "label": "Prefetch", "file_type": "concept", "rationale": "Der Framework-Default ist 1 \u2014 eine einzige ungeackte Nachricht pro Consumer \u2014, obwohl der AMQP-Protokoll-Default 0 (unbegrenzt) ist.", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_no_exchange_declaration", "label": "AmqpActor deklariert keine Exchanges", "file_type": "rationale", "rationale": "Exchanges muessen bereits auf dem Broker existieren (RabbitMQ-Konfiguration, Management-UI, Infrastruktur-Tooling); der Actor deklariert beim Connect nur die in bindings genannten Queues und bindet sie.", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_durability_all_or_nothing", "label": "Durability ist Alles-oder-nichts", "file_type": "rationale", "rationale": "Durable Queues plus durable Exchanges plus persistente Nachrichten \u2014 alle drei noetig, um Neustarts zu ueberleben.", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_amqp_when_amqp", "label": "Wann AMQP", "file_type": "rationale", "rationale": "Work-Queues, Routing/Filterung ueber Topic-Exchanges, Bruecken zu bestehender RabbitMQ-Infrastruktur. Fuer hochvolumiges Streaming skaliert Kafka besser, fuer leichtes Pub/Sub sind NATS oder MQTT schlanker.", "source_file": "docs/src/content/docs/de/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_io_amqp_amqpactor", "target": "docs_src_content_docs_de_io_amqp_amqpoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_sco