{"nodes": [{"id": "_github_workflows_nightly_flakes_nightly_flakes_workflow", "label": "nightly-flakes workflow", "file_type": "document", "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers the two questions a single bun test cannot: are the quarantined suites still broken on hosted runners, and which tests are flaky as opposed to which build was red. Both jobs are continue-on-error on purpose \u2014 a red required check for a known-red measurement trains people to ignore it, so the signal lives in the step summary, the ::warning:: annotation and the uploaded artifact. 04:00 UTC, after the two other nightlies."}, {"id": "_github_workflows_nightly_flakes_quarantined_job", "label": "quarantined suites job (flag off)", "file_type": "concept", "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs exactly the three gated suites with ACTOR_TS_SKIP_FLAKY_MNS deliberately absent; the harness drops it from the child environment by default, so this cannot silently degrade into '3 repeats of 6 skipped tests'. --run-timeout is stated rather than left to the default because the documented symptom is a hang, so the watchdog is what turns tonight into a recorded result instead of a job GitHub killed with nothing to show."}, {"id": "_github_workflows_nightly_flakes_stress_job", "label": "whole-suite stress job", "file_type": "concept", "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loops the whole suite, quarantined suites included, which is the point: excluding them would report a reliable pass rate over exactly the tests known not to be reliable. A test that failed in EVERY repeat is broken rather than flaky and belongs in an issue, not the flake catalog."}, {"id": "_github_workflows_nightly_flakes_fourteen_night_criterion", "label": "Fourteen-consecutive-green-nights exit criterion", "file_type": "rationale", "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fourteen rather than a smaller number because the failure is a property of the runner pool, not the code: two calendar weeks spans weekday and weekend pools. Nights count only while the .bun-version pin is unchanged. The first two nights produced no artifact at all because .stress is a dot-directory and upload-artifact defaults include-hidden-files to false \u2014 so nothing before that fix can be counted, since the runs happened but their evidence was never kept. Nothing accumulates the streak: a human reads the annotations, which is the same failure that made the quarantine permanent in the first place."}], "edges": [{"source": "_github_workflows_nightly_flakes_nightly_flakes_workflow", "target": "_github_workflows_nightly_flakes_quarantined_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_nightly_flakes_workflow", "target": "_github_workflows_nightly_flakes_stress_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_nightly_flakes_workflow", "target": "_github_workflows_nightly_flakes_fourteen_night_criterion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_quarantined_job", "target": "agents_flaky_mns_quarantine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_quarantined_job", "target": "_github_workflows_nightly_flakes_fourteen_night_criterion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_quarantined_job", "target": "agents_test_stress_flake_hunting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_stress_job", "target": "agents_test_stress_flake_hunting", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_fourteen_night_criterion", "target": "_github_workflows_test_coverage_floor_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_fourteen_night_criterion", "target": "agents_coverage_ratchet_policy", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_fourteen_night_criterion", "target": "changelog_bun_version_pin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}, {"source": "_github_workflows_nightly_flakes_fourteen_night_criterion", "target": "agents_bilingual_documentation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml", "source_location": null, "weight": 1}], "hyperedges": [{"id": "worker_thread_quarantine_exit_path", "label": "Worker-thread quarantine and its exit path", "nodes": ["agents_flaky_mns_quarantine", "_github_workflows_test_tests_workflow", "_github_workflows_multi_runtime_multi_runtime_workflow", "_github_workflows_publish_publish_workflow", "_github_workflows_nightly_flakes_quarantined_job", "_github_workflows_nightly_flakes_fourteen_night_criterion", "_github_workflows_benchmarks_benchmarks_job", "agents_coverage_ratchet_policy", "_github_workflows_test_coverage_floor_gate"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": ".github/workflows/nightly-flakes.yml"}]}