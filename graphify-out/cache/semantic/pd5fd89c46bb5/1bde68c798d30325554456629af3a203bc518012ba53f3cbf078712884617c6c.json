{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_page", "label": "Vector Clocks", "file_type": "document", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "label": "VectorClock", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapper-Klasse mit empty, fromData, get, tick, merge (Per-Replica-Maximum), compareTo und toJSON."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "label": "VectorClockData (Record<ReplicaId, number>)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein plain Object; fehlende Replicas werden als 0 behandelt, was Null-Komponenten auf dem Wire weglassbar macht."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_compareto", "label": "compareTo (before / after / equal / concurrent)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_concurrency_detection", "label": "Nebenl\u00e4ufigkeitserkennung", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der dritte Fall \u2014 weder < noch > \u2014 ist das, was 'zwei Replicas haben unabh\u00e4ngig geschrieben' erkennt und den Conflict Resolver ausl\u00f6st."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_fromdata_trusts_input", "label": "fromData vertraut seinem Argument", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es ist der Deserializer und nimmt ein Record aus Zahlen an \u2014 f\u00fcr die eigene Snapshot-Clock in Ordnung, f\u00fcr eine vom Wire nicht; darum pr\u00fcft ReplicatedEventSourcedActor eine Peer-Clock vor dem Merge. Wer fromData selbst auf ungepr\u00fcfte Eingaben anwendet, besitzt diese Pr\u00fcfung."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_partial_order", "label": "Kausalit\u00e4t ist partiell geordnet", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector Clocks geben keine Totalordnung; die Journal-Reihenfolge zweier nebenl\u00e4ufiger Events ist zuf\u00e4llig. Das ist der ganze Punkt \u2014 Clocks verfolgen Kausalit\u00e4t, nicht Wall-Clock-Zeit. F\u00fcr eine Totalordnung mit einem Single-Writer-Lease paaren."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_stable_replica_ids", "label": "Replica-IDs m\u00fcssen f\u00fcr immer stabil sein", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die ID ist Teil der Clock; ein Neustart mit neuer ID sieht wie eine andere Replica aus, w\u00e4hrend alte Clocks die Eintr\u00e4ge der alten ID behalten. Pod-Name + Region o. \u00c4. verwenden."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vc_wire_format", "label": "_vc-Wire-Format", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialisiert als plain JSON-Objekt; die aktuelle Clock des Actors ist privat und ohne \u00f6ffentlichen Getter \u2014 f\u00fcr Diagnostik das _vc-Feld im Journal-/Snapshot-JSON lesen."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_size_grows_with_replicas", "label": "Vector-Clock-Gr\u00f6\u00dfe w\u00e4chst mit der Replica-Anzahl", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes Event tr\u00e4gt die volle vc; bei \u2264 10 Replicas irrelevant, nur bei extremer Skala ein Wire- und Storage-Overhead."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vc_garbage_collection", "label": "Vector-Clock-Garbage-Collection ist au\u00dferhalb des Scopes f\u00fcr v1", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pensionierte Replicas hinterlassen inerte Eintr\u00e4ge, die das Framework nie entfernt, sodass eine Clock mit jeder je gesehenen Replica w\u00e4chst; f\u00fcr ein stabiles Cluster in Ordnung, ein Deployment mit viel Node-Churn wird Kompaktierung wollen \u2014 k\u00fcnftige Arbeit, heute kein unterst\u00fctztes Feature."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclockdata", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_compareto", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_concurrency_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_concurrency_detection", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_fromdata_trusts_input", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_envelope_validation", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/vector-clocks.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_partial_order", "target": "docs_src_content_