{"nodes": [{"id": "docs_src_content_docs_examples_voice_sample_voicesample", "label": "Voice sample (distributed walkie-talkie)", "file_type": "document", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately built to exercise the primitives chat does not: Receptionist lookup, PubSub fan-out and CRDT presence with no database on the hot path."}, {"id": "docs_src_content_docs_examples_voice_sample_voicesessionactor", "label": "VoiceSessionActor", "file_type": "concept", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_examples_voice_sample_voicepresenceactor", "label": "VoicePresenceActor", "file_type": "concept", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_examples_voice_sample_httpingressactor", "label": "HttpIngressActor (voice)", "file_type": "concept", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds in preStart and unbinds in postStop, so singleton failover moves the port to a survivor automatically."}, {"id": "docs_src_content_docs_examples_voice_sample_receptionistptt", "label": "1:1 push-to-talk via the Receptionist", "file_type": "rationale", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target refs are cached for the duration of the press, so there is no registry lookup per audio frame."}, {"id": "docs_src_content_docs_examples_voice_sample_pubsubfanout", "label": "Group and room fan-out via DistributedPubSub", "file_type": "rationale", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A topic fans out to every subscriber including the sender, so receivers drop their own frames with a self-filter on the sender username."}, {"id": "docs_src_content_docs_examples_voice_sample_orsetpresence", "label": "Presence via DistributedData ORSets", "file_type": "rationale", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One global set tracks who is online and one set per room tracks who is in it \u2014 no sharded entity owns room state, it is pure CRDT membership plus a pubsub topic."}, {"id": "docs_src_content_docs_examples_voice_sample_ephemeralbydesign", "label": "Ephemeral by design (no sharding, no persistence)", "file_type": "rationale", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deliberate teaching contrast with the chat sample: the server is a dumb audio relay, so a dropped session simply vanishes from the ORSets and there is nothing to recover."}, {"id": "docs_src_content_docs_examples_voice_sample_smoketest", "label": "voice smoke-test.ts", "file_type": "concept", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brings its own one-node cluster on isolated ports and walks all three modes with a fake payload, so it runs unattended in the example gate; audio playback stays a browser concern."}, {"id": "docs_src_content_docs_examples_voice_sample_realworldadaptation", "label": "Real-world voice adaptation", "file_type": "rationale", "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DistributedPubSub is at-most-once, so a production relay needs jitter buffers and retransmission above it, server-side mixing for large rooms, and WebRTC or an SFU on the media path."}], "edges": [{"source": "docs_src_content_docs_examples_voice_sample_smoketest", "target": "docs_src_content_docs_examples_overview_examplegate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_examples_voice_sample_voicesample", "target": "docs_src_content_docs_examples_voice_sample_voicesessionactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_examples_voice_sample_voicesample", "target": "docs_src_content_docs_examples_voice_sample_voicepresenceactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_examples_voice_sample_voicesample", "target": "docs_src_content_docs_examples_voice_sample_httpingressactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/examples/voice-sample.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_examples_voice_sample_voicesample", "target": "docs_src_content_docs_examples_voice_sample_smoketest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/examples/voice-sa