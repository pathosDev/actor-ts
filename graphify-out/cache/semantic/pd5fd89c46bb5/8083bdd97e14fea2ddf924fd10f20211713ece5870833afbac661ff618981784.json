tion": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_overview_same_origin_sockets", "target": "docs_src_content_docs_operations_security_cluster_security_certificate_binds_node_identity", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/observability/devtools/overview.mdx", "source_location": null, "weight": 1}], "hyperedges": [{"id": "devtools_panel_roster", "label": "The DevTools panel roster over one tap protocol", "nodes": ["docs_src_content_docs_observability_devtools_overview_panels", "docs_src_content_docs_observability_devtools_overview_tap_protocol", "docs_src_content_docs_observability_devtools_configuration_configuration", "docs_src_content_docs_observability_devtools_dead_letters_dead_letters", "docs_src_content_docs_observability_devtools_event_stream_event_stream", "docs_src_content_docs_observability_devtools_send_message_send_message"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/overview.mdx"}]}