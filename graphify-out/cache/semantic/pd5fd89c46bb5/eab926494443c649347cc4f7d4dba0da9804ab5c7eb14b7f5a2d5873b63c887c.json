{"nodes": [{"id": "docs_src_content_docs_de_operations_deployment_process_manager_process_manager_deployment", "label": "Process-Manager-Deployment", "file_type": "document", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuer Deployments ohne Container-Orchestrierung - Bare-Metal, VMs, kleinere Setups - ueberwachen systemd oder PM2 die actor-ts-Prozesse."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_systemd_unit", "label": "systemd-Unit fuer actor-ts", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restart=on-failure mit RestartSec, User/Group als Non-Root, StandardOutput=journal fuer zentrale Einsammlung."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_timeoutstopsec", "label": "TimeoutStopSec und KillSignal=SIGTERM", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TimeoutStopSec dimensioniert das Fenster von SIGTERM bis SIGKILL passend zum Phasen-Budget des Coordinated Shutdown; KillSignal=SIGTERM triggert dessen Hooks."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_cluster_ueber_systemd_hosts", "label": "Cluster ueber systemd-Hosts", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jeder Host kennt via EnvironmentFile die vollstaendige Seed-Liste; fuer dynamische Deployments stattdessen den DNS-Seed-Provider nutzen."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_rolling_restart", "label": "Rolling Restart auf systemd", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Einen Node nach dem anderen stoppen, auf /ready warten, dann weiter - manuell, aber geradlinig; Ansible oder Salt automatisieren die Orchestrierung."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_pm2_ecosystem", "label": "PM2 ecosystem.config.json", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exec_mode fork, instances 1, kill_timeout mit Coordinated Shutdown abgestimmt, max_memory_restart mit Metriken kombiniert, um vor dem Kill zu alerten."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_pm2_cluster_mode_falle", "label": "PM2 Cluster-Mode verwirrt actor-ts-Cluster", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PM2s Cluster-Mode betreibt N node.js-Worker hinter einem TCP-Load-Balancer; jeder wuerde denselben actor-ts-Port binden wollen und jeder versuchen, derselbe Node zu sein."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_restart_backoff", "label": "Restart-Loop ohne Backoff", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restart=on-failure ohne RestartSec startet bei einem Config-Fehler sofort und wiederholt; RestartSec=10s federt ab und laesst Monitoring den Loop fangen."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_logs_journald", "label": "Logs nach journald statt in Dateien", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "systemd-journald uebernimmt die Rotation; direktes File-Logging erfordert logrotate oder die Akzeptanz der Disk-Fuellung."}, {"id": "docs_src_content_docs_de_operations_deployment_process_manager_wann_k8s", "label": "Process Manager vs. Kubernetes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bis 5 VMs stabil und manuell oder Bare-Metal mit Hardware-Affinitaet: systemd/PM2. Dynamisches Skalieren ab 10 VMs oder Multi-Cloud: Kubernetes. Process Manager sind niedrigere Abstraktion - weniger Features, weniger Dependencies."}], "edges": [{"source": "docs_src_content_docs_de_operations_deployment_process_manager_process_manager_deployment", "target": "docs_src_content_docs_de_operations_deployment_process_manager_systemd_unit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_deployment_process_manager_process_manager_deployment", "target": "docs_src_content_docs_de_operations_deployment_process_manager_pm2_ecosystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/deployment/process-manager.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_