{"nodes": [{"id": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "label": "ParallelMultiNodeSpec", "file_type": "concept", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The worker-thread variant: each node runs in its own Worker connected through an in-process broker, so races the single-threaded variant serialises away can surface. Reserved for the ~10% of tests where thread or serialization fidelity matters."}, {"id": "docs_src_content_docs_testing_parallel_multi_node_scenario_module", "label": "Scenario module", "file_type": "concept", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closures cannot cross a worker boundary, so the test's actor-shaped code lives in its own module loaded by URL, exporting setup(context) and a commands map; the harness only ever exchanges JSON-serialisable command/response pairs with it."}, {"id": "docs_src_content_docs_testing_parallel_multi_node_runin_rpc", "label": "runIn RPC", "file_type": "concept", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The test drives worker-side actors by name through runIn(role, command, args) because systemFor/clusterFor cannot hand back objects living in another thread - membership comes back as getMembers/getLeader snapshots instead."}, {"id": "docs_src_content_docs_testing_parallel_multi_node_structured_clone_boundary", "label": "Structured-clone worker boundary", "file_type": "concept", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every message crosses the worker boundary via structured clone, so functions and class instances fail here as they would on a real wire - closer to the wire than in-process, but still more permissive than it."}, {"id": "docs_src_content_docs_testing_parallel_multi_node_worker_startup_cost", "label": "Worker startup cost", "file_type": "concept", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200-500 ms per node (worker spawn plus cluster handshake), roughly 1.5 s for a three-node spec, against sub-100 ms for the whole in-process variant."}, {"id": "docs_src_content_docs_testing_parallel_multi_node_parallel_spec_cleanup", "label": "Always call stop()", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orphaned worker threads leak and can starve later tests; the runner may clean up after a crash, but explicit teardown is what guarantees it."}, {"id": "docs_src_content_docs_testing_parallel_multi_node_run_worker_tests_locally", "label": "Run worker-thread tests locally before trusting them", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every ParallelMultiNodeSpec suite is skipped on CI, so a green check says nothing about it; the suites do run on a local bun test and in Docker."}], "edges": [{"source": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "target": "docs_src_content_docs_testing_multi_node_spec_multinodespec", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "target": "docs_src_content_docs_testing_parallel_multi_node_scenario_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_scenario_module", "target": "docs_src_content_docs_testing_parallel_multi_node_runin_rpc", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_structured_clone_boundary", "target": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_worker_startup_cost", "target": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_parallel_spec_cleanup", "target": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_run_worker_tests_locally", "target": "docs_src_content_docs_testing_diagnosing_flakes_skip_flaky_mns_quarantine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_parallelmultinodespec", "target": "docs_src_content_docs_testing_diagnosing_flakes_fourteen_green_nights", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_structured_clone_boundary", "target": "docs_src_content_docs_serialization_json_serializationerror", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_parallel_spec_cleanup", "target": "docs_src_content_docs_testing_testkit_testkit_shutdown", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_parallel_multi_node_runin_rpc", "target": "examples_chat_readme_chat_websocket_protocol", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/src/content/docs/testing/parallel-multi-node.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}