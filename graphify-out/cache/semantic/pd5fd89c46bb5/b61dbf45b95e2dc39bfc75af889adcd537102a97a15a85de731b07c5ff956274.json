{"nodes": [{"id": "docs_src_content_docs_http_middleware_timeout_requesttimeout", "label": "requestTimeout", "file_type": "concept", "rationale": "Races the handler against a deadline (default 30 s) and returns 503 when the deadline wins, with an overridable onTimeout response.", "source_file": "docs/src/content/docs/http/middleware/timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_middleware_timeout_handler_not_cancelled", "label": "A timeout does not cancel the handler", "file_type": "rationale", "rationale": "The handler keeps running and its late result is discarded. The middleware bounds client-observed latency and how long a response is held open, nothing more - true cancellation requires threading an AbortSignal through your own async work.", "source_file": "docs/src/content/docs/http/middleware/timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_http_middleware_timeout_handler_not_cancelled", "target": "docs_src_content_docs_http_middleware_timeout_requesttimeout", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/middleware/timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_middleware_timeout_requesttimeout", "target": "docs_src_content_docs_http_middleware_rate_limit_ratelimit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/middleware/timeout.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}