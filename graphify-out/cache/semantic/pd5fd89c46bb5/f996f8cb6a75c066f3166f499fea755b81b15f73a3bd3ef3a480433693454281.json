{"nodes": [{"id": "docs_src_content_docs_patterns_backoff_supervisor_backoffsupervisor", "label": "BackoffSupervisor", "file_type": "concept", "rationale": "The default strategy restarts a child up to ten times a minute, which hammers a broken dependency; this wraps one child under a stopping strategy, death-watches it, and reschedules the respawn after the policy delay.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_triggeron", "label": "triggerOn termination trigger", "file_type": "concept", "rationale": "any respawns on every termination, failure only on crashes so a clean stopSelf is honoured as this child is done, stop only on clean stops so crashes propagate up.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_forward_strategy", "label": "forward - stash or drop while the child is dead", "file_type": "concept", "rationale": "Stashing preserves sender refs so an ask issued while the child was down still gets its reply; dropping is right for transient pings where a stale message is worse than a lost one.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_resetcounter", "label": "resetCounter", "file_type": "concept", "rationale": "Without resetting, a child failing after a long stable period gets the same long backoff as after a recent crash; after-min-stable resets once the child has been alive for at least minBackoff.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_drain_grace", "label": "drainGraceMs and forwardDuringGrace", "file_type": "concept", "rationale": "Protects against children that crash in preStart: if the child dies during the grace window the stash is held back for the next incarnation instead of dead-lettering. The default trades a tiny risk of that for lower happy-path latency.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_transient_failures_only", "label": "Backoff is for transient failures only", "file_type": "rationale", "rationale": "A child throwing on every message from a bug crashes identically after every delay; pair the supervisor with a total-attempt cap so bugs surface as supervisor terminations rather than an infinite slow loop.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_no_nesting", "label": "Do not nest backoff supervisors", "file_type": "rationale", "rationale": "Each level multiplies the perceived recovery delay; use one at the layer where transient failures actually happen and plain supervision above it.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_patterns_backoff_supervisor_versus_plain_supervision", "label": "Compared to plain supervision", "file_type": "rationale", "rationale": "OneForOneStrategy caps restarts per window but does not delay between them; the two are complementary and can be combined to back off between restarts yet give up entirely after N attempts.", "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_patterns_backoff_supervisor_backoffsupervisor", "target": "docs_src_content_docs_patterns_backoff_supervisor_triggeron", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_backoff_supervisor_backoffsupervisor", "target": "docs_src_content_docs_patterns_backoff_supervisor_forward_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_backoff_supervisor_backoffsupervisor", "target": "docs_src_content_docs_patterns_backoff_supervisor_resetcounter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_backoff_supervisor_backoffsupervisor", "target": "docs_src_content_docs_patterns_backoff_supervisor_drain_grace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_patterns_backoff_supervisor_backoffsupervisor", "target": "docs_src_content_docs_patterns_backoff_supervisor_transient_failures_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/patterns/backoff-supervisor.mdx", "source_location": null, "weight": 1.0}, {"