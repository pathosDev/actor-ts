{"nodes": [{"id": "docs_src_content_docs_de_persistence_journals_in_memory_journal", "label": "Journal (Vertrag)", "file_type": "concept", "rationale": "append/read/highestSeq/delete/persistenceIds plus optionaler events-Bus und close. Das Interface ist ueber alle Backends dasselbe - der Produktions-Switch von In-Memory auf SQLite ist eine Zeile, ohne Code-Aenderung innerhalb der Actors.", "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_in_memory_inmemoryjournal", "label": "InMemoryJournal", "file_type": "concept", "rationale": "Der Default, wenn ein System ohne konfigurierte Persistenz erstellt wird - intern eine Map<string, PersistentEvent[]>. Daten sterben mit dem Prozess und werden in einem Multi-Process-Deployment nicht geteilt; unbegrenztes Speicherwachstum bis delete aufgerufen wird. Legitim nur fuer Tests, Entwicklung und Wegwerf-Demos.", "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_in_memory_journalentry", "label": "JournalEntry<E>", "file_type": "concept", "rationale": "{ event, tags? } - beim append behaelt jeder Entry seine eigenen tags.", "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_in_memory_journaleventbus", "label": "JournalEventBus", "file_type": "concept", "rationale": "Jedes append publiziert das Event in den In-Process-Bus, sodass Push-basierte Queries in Echtzeit ohne Polling funktionieren. Der Bus ist lokal zum Prozess - Cross-Process-Backends haben ihn nicht und fallen auf Polling zurueck.", "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_in_memory_journalconcurrencyerror", "label": "JournalConcurrencyError", "file_type": "concept", "rationale": "Wird geworfen, wenn der aktuelle Head nicht zum expectedSeq des Callers passt. Jedes Backend uebersetzt seinen eigenen nativen Konflikt-Fehlercode in diesen einen Vertrag.", "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_in_memory_reference_semantics", "label": "Referenz-Semantik des Journals", "file_type": "rationale", "rationale": "InMemoryJournal ist die Referenz-Semantik, der jede andere Journal-Implementierung entsprechen muss: append-only, monotone Sequenznummern, Exactly-once-Delivery an Subscriber, Concurrency-Check auf erwarteter Sequenz.", "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_in_memory_inmemorysnapshotstore", "label": "InMemorySnapshotStore", "file_type": "concept", "rationale": null, "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_persistence_journals_in_memory_inmemoryjournal", "target": "docs_src_content_docs_de_persistence_journals_in_memory_journal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/journals/in-memory.mdx", "source_location": null, "weight": 1.0}, {