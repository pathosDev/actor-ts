{"nodes": [{"id": "docs_src_content_docs_persistence_journals_dynamodb_dynamodbjournal", "label": "DynamoDbJournal", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_dynamodb_dynamodbsnapshotstore", "label": "DynamoDbSnapshotStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_dynamodb_dynamodbdurablestatestore", "label": "DynamoDbDurableStateStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_dynamodb_registerdynamodbplugins", "label": "registerDynamoDbPlugins", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_dynamodb_transactional_atomic_append", "label": "Transactional atomic append", "file_type": "rationale", "rationale": "Every event of an append goes into one TransactWriteItems, each Put carrying ConditionExpression attribute_not_exists(pid), so a racing writer cannot win a partial append \u2014 the batch lands whole or not at all. The head read that precedes it is only an optimization. This is the strongest concurrency guarantee of any backend; the relational stores and MongoDB read-then-write and can leave a mid-batch prefix behind.", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_dynamodb_append_capped_at_100_events", "label": "Append capped at 100 events", "file_type": "rationale", "rationale": "DynamoDB allows at most 100 items per TransactWriteItems. A larger append is refused with a clear error rather than chunked, because chunking would break the atomicity the concurrency model rests on.", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_dynamodb_persistenceids_full_table_scan", "label": "persistenceIds is a full table scan", "file_type": "rationale", "rationale": "DynamoDB can only enumerate partition keys by scanning, so persistenceIds reads the whole events table. The framework keeps it off hot paths \u2014 it is for projection tooling.", "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_journals_dynamodb_dynamodbjournal", "target": "docs_src_content_docs_persistence_overview_journal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_dynamodb_dynamodbsnapshotstore", "target": "docs_src_content_docs_persistence_overview_snapshotstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/dynamodb.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_dynamodb_dynamodbdurablestatestore", "target": "docs_src_content_docs_persistence_overvi