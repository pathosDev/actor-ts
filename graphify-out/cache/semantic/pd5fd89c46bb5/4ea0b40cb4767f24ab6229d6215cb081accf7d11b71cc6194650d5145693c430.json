{"nodes": [{"id": "docs_src_content_docs_cluster_refs_across_nodes_remoteactorref", "label": "RemoteActorRef", "file_type": "concept", "rationale": "Reconstructed by the receiving node from the path-with-host string, so request/response between actors on different nodes works with no extra machinery; a tell to a node that has left drops to dead letters and the sender does not see the failure.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_refs_across_nodes_path_with_host", "label": "Path-with-host address format", "file_type": "concept", "rationale": "The host fragment tells the local runtime which node hosts the actor, so the transport can look up the connection and the receiving node resolves the remaining path segments locally.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_refs_across_nodes_ref_equality", "label": "ActorRef.equals compares path, not node", "file_type": "rationale", "rationale": "A path carries the system name and every member shares one, so two refs to the same path on different nodes compare equal; equals answers 'same actor path?', not 'same actor'. For node identity compare toString() or keep the NodeAddress alongside the ref.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_refs_across_nodes_cluster_transport", "label": "Cluster transport multiplexing", "file_type": "concept", "rationale": "Control traffic (gossip, heartbeats, downing signals) and envelope traffic share one TCP connection per peer pair, multiplexed invisibly; envelopes are batched opportunistically so many tells in quick succession share writes.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_refs_across_nodes_tagged_json_tree", "label": "Tagged JSON tree wire format", "file_type": "rationale", "rationale": "The same format the persistence stores write, so Date, Map, Set, bigint, Uint8Array, RegExp, URL and Error arrive as real instances (#450). Functions and symbols are refused with an error log naming the peer rather than silently stripped, so a callback in a message stops being invisible data loss; class identity is lost and only the tag string travels. A registered custom serializer changes none of this - the cluster wire never consults the registry.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_refs_across_nodes_max_frame_bytes", "label": "Per-frame cap (16 MiB default)", "file_type": "concept", "rationale": "Frames larger than actor-ts.remote.max-frame-bytes fail and the message dead-letters, so large payloads belong on a side channel with a reference passed in the actor message.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_refs_across_nodes_actorselection", "label": "actorSelection / resolveOne", "file_type": "concept", "rationale": "The lookup escape hatch for paths known by convention or arriving in a message; routine cluster work holds refs from the cluster's own machinery instead.", "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_refs_across_nodes_remoteactorref", "target": "docs_src_content_docs_cluster_refs_across_nodes_path_with_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_refs_across_nodes_ref_equality", "target": "docs_src_content_docs_cluster_refs_across_nodes_remoteactorref", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_refs_across_nodes_tagged_json_tree", "target": "docs_src_content_docs_cluster_refs_across_nodes_cluster_transport", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_refs_across_nodes_max_frame_bytes", "target": "docs_src_content_docs_cluster_refs_across_nodes_cluster_transport", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_refs_across_nodes_actorselection", "target": "docs_src_content_docs_cluster_refs_across_nodes_path_with_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_refs_across_nodes_remoteactorref", "target": "docs_src_content_docs_cluster_refs_across_nodes_cluster_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "d