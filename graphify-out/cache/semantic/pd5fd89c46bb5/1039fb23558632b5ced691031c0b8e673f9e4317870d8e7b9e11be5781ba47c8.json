{"nodes": [{"id": "tests_integration_brokers_mssql_docker_compose_mssql_mssql", "label": "SQL Server 2022 service", "file_type": "code", "source_file": "tests/integration/brokers/mssql/docker-compose.mssql.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sqlcmd returns non-zero until the instance finishes recovery, so the healthcheck is a true ready-for-the-runner gate; the 2022 image ships the tool under /opt/mssql-tools18 and needs -C to trust its self-signed cert."}, {"id": "tests_integration_brokers_mssql_docker_compose_mssql_runner", "label": "SQL Server runner service", "file_type": "code", "source_file": "tests/integration/brokers/mssql/docker-compose.mssql.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs the contract against master through the mssql (tedious) driver - the image creates no other database and the stores create their own tables."}, {"id": "tests_integration_brokers_mssql_docker_compose_mssql_2022_latest_pin", "label": "2022-latest rather than a bare latest", "file_type": "rationale", "source_file": "tests/integration/brokers/mssql/docker-compose.mssql.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Microsoft publishes no moving latest tag for this image, and the DDL relies on the 1700-byte nonclustered index-key limit introduced in SQL Server 2016 - the one documented exception to the suite-wide latest policy."}], "edges": [{"source": "tests_integration_brokers_mssql_docker_compose_mssql_runner", "target": "tests_integration_brokers_mssql_docker_compose_mssql_mssql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/mssql/docker-compose.mssql.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_mssql_docker_compose_mssql