{"nodes": [{"id": "docs_src_content_docs_typed_spawn_typed_system_spawntyped", "label": "system.spawnTyped", "file_type": "concept", "source_file": "docs/src/content/docs/typed/spawn-typed.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Puts a Behavior into the runtime from outside an actor and returns a typed ActorRef<T> whose tell the compiler checks."}, {"id": "docs_src_content_docs_typed_spawn_typed_context_spawntyped", "label": "context.spawnTyped", "file_type": "concept", "source_file": "docs/src/content/docs/typed/spawn-typed.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spawns a typed child from an untyped parent; the child is a normal entry in the parent's children list, so supervision and death watch work as usual."}, {"id": "docs_src_content_docs_typed_spawn_typed_typed_context_spawn", "label": "typed context.spawn", "file_type": "concept", "source_file": "docs/src/content/docs/typed/spawn-typed.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The standard way for a typed parent to spawn a typed child - the child's message type is derived from the Behavior, so no cast is needed at spawn time."}, {"id": "docs_src_content_docs_typed_spawn_typed_typedactor_factory", "label": "typedActor() factory helper", "file_type": "concept", "source_file": "docs/src/content/docs/typed/spawn-typed.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The escape hatch for slots that take an actor class or factory - an entry point predating the typed layer, a spawn needing its own ActorOptions, a singleton or sharding entityActor slot. It closes over the Behavior and produces a new TypedActor per factory run."}, {"id": "docs_src_content_docs_typed_spawn_typed_anonymous_spawn_naming", 