{"nodes": [{"id": "docs_src_content_docs_serialization_json_jsonserializer", "label": "JsonSerializer", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default serializer: JSON.stringify/parse over UTF-8 bytes plus a tree walk that round-trips rich types through tags."}, {"id": "docs_src_content_docs_serialization_json_json_type_tags", "label": "JSON type tags", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "__date__, __bytes__, __map__, __set__, __bigint__ and the rest restore real instances rather than bare values - at the cost of a shape a non-actor-ts JSON reader will not recognise."}, {"id": "docs_src_content_docs_serialization_json_literal_tag_escape", "label": "__literal__ tag escape", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User data whose sole key looks like a reserved tag is wrapped on encode so it round-trips as plain data; a tag is only ever interpreted when it is an object's sole own key."}, {"id": "docs_src_content_docs_serialization_json_serializationerror", "label": "SerializationError", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thrown on undefined, functions, symbols, Promise, WeakMap/WeakSet and circular references (naming the key path instead of overflowing the stack) - deliberately stricter than raw JSON.stringify, which drops them silently."}, {"id": "docs_src_content_docs_serialization_json_bidirectional_map_tags", "label": "BidirectionalMap and BidirectionalMultiMap tags", "file_type": "concept", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two framework collections carry tags of their own (#1035, #1037) so they can live in persistent state without an adapter; only the forward direction is written - pairs for one, an adjacency list for the other - and the inverse is rebuilt on decode."}, {"id": "docs_src_content_docs_serialization_json_class_identity_loss", "label": "Class identity is not preserved", "file_type": "rationale", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "toJSON is honoured when present, otherwise a class instance decodes to a plain object: data fields survive, methods and instanceof do not. A custom serializer is the way to keep class-preserving round-trips."}, {"id": "docs_src_content_docs_serialization_json_json_default_rationale", "label": "Why JSON is the default", "file_type": "rationale", "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Universal parsers, a journal you can read with cat, schema flexibility without a compile step, and native parse/stringify fast enough that serialization is rarely the bottleneck."}], "edges": [{"source": "docs_src_content_docs_serialization_json_jsonserializer", "target": "docs_src_content_docs_serialization_overview_serializer_interface", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_jsonserializer", "target": "docs_src_content_docs_serialization_overview_tagged_json_tree", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_jsonserializer", "target": "docs_src_content_docs_serialization_json_json_type_tags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_json_type_tags", "target": "docs_src_content_docs_serialization_json_literal_tag_escape", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_json_type_tags", "target": "docs_src_content_docs_serialization_json_bidirectional_map_tags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_jsonserializer", "target": "docs_src_content_docs_serialization_json_serializationerror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_class_identity_loss", "target": "docs_src_content_docs_serialization_json_jsonserializer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_json_default_rationale", "target": "docs_src_content_docs_serialization_json_jsonserializer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_jsonserializer", "target": "docs_src_content_docs_serialization_cbor_cborserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_serialization_json_jsonserializer", "target": "docs_src_content_docs_serialization_overview_cluster_wire_framing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/serialization/json.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}