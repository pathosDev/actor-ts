{"nodes": [{"id": "docs_src_content_docs_persistence_durable_state_durablestateactor", "label": "DurableStateActor", "file_type": "concept", "rationale": "Persists a single state value per persistenceId, overwritten on each persist - no event log and no replay. Right when history is not useful: feature flags, last-known configs, current cart contents without an audit trail.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_durable_state_versus_persistent_actor", "label": "Durable state versus event sourcing", "file_type": "rationale", "rationale": "Durable state wins on a simple shape, no projections and read-dominated access; reach for PersistentActor when history matters, when state is large and changes are small, or when read-side projections need the event stream.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_persistence_id_validation", "label": "persistenceId rules for durable state", "file_type": "concept", "rationale": "Non-empty, at most 255 characters, no slashes or control characters. The validator checks in the constructor rather than preStart, because an id that can never address a record is worth refusing before the actor is wired to a store.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_optimistic_concurrency", "label": "Revision-checked optimistic concurrency", "file_type": "concept", "rationale": "A second concurrent writer is rejected with DurableStateConcurrencyError. In practice concurrent writes should not happen - one entity per persistenceId addressed via routing or sharding - so seeing them in production usually means a routing bug.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_stateadapter", "label": "StateAdapter for schema evolution", "file_type": "concept", "rationale": "The record is wrapped in a versioned envelope and fromJournal migrates older versions on load, the durable-state counterpart of an event adapter.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_encryption_overrides_ignored", "label": "Encryption overrides only the object-storage store reads", "file_type": "rationale", "rationale": "Nine of the ten durable-state stores accept encryption, compression and integrity overrides and never look at them - on in-memory, SQLite, Postgres, Mongo and DynamoDB the override is dropped silently, with no tamper detection and no error saying so.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_await_persist_before_acknowledging", "label": "Await persist before acknowledging", "file_type": "rationale", "rationale": "Without the await the reply happens before the state is durable, so a crash in between leaves the user believing a change was applied that was not.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_durable_state_build_a_new_state_object", "label": "Build a new state object rather than mutating", "file_type": "rationale", "rationale": "Mutating the loaded reference works accidentally in some stores but the same object may already have been handed out in a reply, and it was mutated before the persist confirmed.", "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_durable_state_durablestateactor", "target": "docs_src_content_docs_persistence_durable_state_durable_state_versus_persistent_actor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_durable_state_durablestateactor", "target": "docs_src_content_docs_persistence_durable_state_persistence_id_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_durable_state_durablestateactor", "target": "docs_src_content_docs_persistence_durable_state_optimistic_concurrency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_durable_state_durablestateactor", "target": "docs_src_content_docs_persistence_durable_state_stateadapter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_durable_state_durablestateactor", "target": "docs_src_content_docs_persi