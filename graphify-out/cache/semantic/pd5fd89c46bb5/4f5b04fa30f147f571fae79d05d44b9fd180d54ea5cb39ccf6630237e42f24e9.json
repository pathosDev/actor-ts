{"nodes": [{"id": "docs_src_content_docs_observability_management_overview_management_overview", "label": "Management overview", "file_type": "document", "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_management_overview_managementroutes", "label": "managementRoutes", "file_type": "concept", "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds a route tree of operational endpoints and returns it - nothing else. The cluster is the second positional argument and may be null to skip the cluster endpoints."}, {"id": "docs_src_content_docs_observability_management_overview_managementroutesoptions", "label": "ManagementRoutesOptions", "file_type": "concept", "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoint toggles and optional middleware. The port and host are not settings: they go to system.http(port, host)."}, {"id": "docs_src_content_docs_observability_management_overview_separate_management_port", "label": "A separate management port", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The management endpoints reveal internal state - cluster member addresses, metric values - so they bind on their own port (8558 by convention), firewalled internally. In Kubernetes this is per-pod: probes hit the port from the kubelet on the same node, and no Service exposes it externally."}, {"id": "docs_src_content_docs_observability_management_overview_k8s_probe_wiring", "label": "Kubernetes probe wiring", "file_type": "concept", "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kubernetes polls readiness to decide whether the pod should receive traffic and liveness to decide whether to restart it."}, {"id": "docs_src_content_docs_observability_management_overview_mounting_management_inline", "label": "Mounting management into an existing server", "file_type": "concept", "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The routes are plain, so they can be concatenated into an existing HTTP tree instead of taking a dedicated port - worth it when you already have a server, or for a single-node app where health checks alone do not justify the extra port. Mounting on the public port re-exposes internal state, so gate it."}], "edges": [{"source": "docs_src_content_docs_observability_management_overview_management_overview", "target": "docs_src_content_docs_observability_management_overview_managementroutes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_management_overview", "target": "docs_src_content_docs_observability_management_overview_managementroutesoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_management_overview", "target": "docs_src_content_docs_observability_management_overview_separate_management_port", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_management_overview", "target": "docs_src_content_docs_observability_management_overview_k8s_probe_wiring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_management_overview", "target": "docs_src_content_docs_observability_management_overview_mounting_management_inline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_managementroutes", "target": "docs_src_content_docs_observability_management_overview_managementroutesoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_separate_management_port", "target": "docs_src_content_docs_observability_management_overview_managementroutes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/management/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_management_overview_mounting_management_inline", "target": "docs_src_content_docs_observability_management_overview_managementroutes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/c