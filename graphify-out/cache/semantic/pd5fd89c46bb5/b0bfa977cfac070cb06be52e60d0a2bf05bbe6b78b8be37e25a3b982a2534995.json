{"nodes": [{"id": "docs_src_content_docs_de_observability_devtools_overview_devtools", "label": "DevTools", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine einbettbare Web-UI fuer ein laufendes ActorSystem - die observer-Idee der BEAM fuer actor-ts: man kann das System sehen."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_attach", "label": "DevTools.attach", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bindet einen eigenen Server, weil der DevTools-Port getrennt vom Anwendungsport gefirewallt werden sollte; im CoordinatedShutdown wird automatisch detached, ein SIGTERM gibt den Port also von selbst frei."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_mount", "label": "DevTools.mount", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gibt die Routen an einen Server, den DevTools nie zu sehen bekommt - host wird auf diesem Weg gar nicht gelesen, also verlangt mount die Absicherung vorab statt zu raten."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_allowungatedmount", "label": "allowUngatedMount", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bestaetigt, dass die Absicherung dieses Baums ausserhalb von DevTools liegt; DevTools schreibt dann eine Log-Zeile, die das festhaelt."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_devtoolsoptions", "label": "DevToolsOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_devtools_overview_panels_schalter", "label": "Schalter pro Panel", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein abgeschaltetes Panel bleibt abgeschaltet - seine Daten verlassen den Prozess nicht, egal was ein Client anfragt. Ueber Time Travel zuerst nachdenken, dann Dead Letters und Event Stream."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_sicherheit", "label": "DevTools-Sicherheitsdefaults", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardmaessig Loopback ohne Auth: richtig fuer einen Laptop, falsch fuer alles andere. Ein routbares Binden muss Absicht sein - attach wirft, ausser man uebergibt auth, ipAllowlist oder allowRemote."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_allowremote", "label": "allowRemote", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_devtools_overview_same_origin_websocket", "label": "Same-Origin-WebSocket-Pruefung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein WebSocket-Handshake unterliegt nicht der Same-Origin-Policy, jede Seite im Browser erreicht also 127.0.0.1; der Tap akzeptiert nur ein Upgrade, dessen Origin auf ihn selbst zeigt. allowedOrigins erweitert die Regel, ersetzt sie nicht; eine Anfrage ganz ohne Origin ist erlaubt, weil CSWSH einen Browser braucht."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_cluster_seite_verbindungsvertrauen", "label": "Die Cluster-Seite vertraut der Verbindung, nicht der Nachricht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Knoten antwortet ueber die Verbindung, auf der die Frage ankam, und der Sammler legt eine Messung unter der Transport-Adresse ab, nie unter der behaupteten; Zeilenzahl und Baumgroesse sind gedeckelt, ein luegender Peer kann also nur ueber seine eigene Zeile luegen. Eine Authentifizierung des Cluster-Ports ist das nicht - das ist mTLS."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_tap_protokoll", "label": "Tap-Protokoll", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alle Panels sprechen ein gemeinsames Protokoll ueber einen einzigen WebSocket, statt dass jedes seine eigene Verbindung oeffnet."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_uebersicht_panel", "label": "Uebersicht: Common / Numbers / Charts", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Uptime ist die des Systems, vom Server gelesen - sie uebersteht einen Reload und eine abgerissene Verbindung; Charts trennen Fuellstand und Rate, damit sie sich nie eine y-Achse teilen."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_kosten", "label": "Kosten: ungenutzt keine", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Extension zu erzeugen tut nichts - kein Port, keine Taps, keine Instrumentierung; alles beginnt bei attach(), und die Datenerfassung eines Panels laeuft nur, solange ein Browser sie abonniert hat."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_metrics_registry", "label": "DevTools schaltet die Metrics-Registry ein", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Durchsatz, Mailbox-Drops und Handler-Latenz zaehlt das Framework selbst, stehen aber gegen die Noop-Registry auf 0; detach() setzt die Noop-Registry zurueck, eine selbst eingeschaltete Registry bleibt in beide Richtungen unangetastet."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_ui_angular_echarts", "label": "Angular-UI mit ECharts als eingebettetes gzip-Bundle", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beide sind reine Build-Zeit-Abhaengigkeiten: kein UI-Framework zur Laufzeit, kein Netzwerkzugriff der ausgelieferten Seite. ECharts wird lazy in einem eigenen Chunk geladen."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_examples_devtools_flag", "label": "--devtools-Flag der Examples", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Anbindung nimmt sich ihren eigenen Port ab --devtools-port (Default 9333), aufsteigend pro Prozess; scheitert DevTools, protokolliert das Example eine Warnung und startet trotzdem - ein Debugger, der nicht binden kann, ist kein Grund, das zu debuggende Programm sterben zu lassen."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_examples_entkoppelt", "label": "Examples ohne DevTools-Verdrahtung (#552)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Example, das von selbst fertig wird, enthaelt keinen Bezug auf DevTools mehr, laesst sich also unveraendert kopieren; sieben banden frueher einen Port und protokollierten eine URL, die tot war, bevor ein Browser sie oeffnen konnte."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_no_node_reachable", "label": "No node reachable-Dialog", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes Panel zeigt weiter, was ihm zuletzt gesagt wurde - genau deshalb saehe eine abgerissene Verbindung sonst aus wie ein gesundes System; das Panel bleibt gedimmt und die Uptime friert ein, statt ueber den Tod des Systems hinaus weiterzuzaehlen."}, {"id": "docs_src_content_docs_de_observability_devtools_overview_ui_dev_loop", "label": "UI-Entwicklungsschleife", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bun run ui:install einmalig, dann build:ui --dev --watch nach devtools-ui/.dev plus dev:devtools, das dieses Verzeichnis via uiDevelopmentRoot ausliefert - Speichern, Neu laden, ohne TypeScript-Build und Server-Neustart."}], "edges": [{"source": "docs_src_content_docs_de_observability_devtools_overview_devtools", "target": "docs_src_content_docs_de_observability_devtools_overview_attach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtools", "target": "docs_src_content_docs_de_observability_devtools_overview_mount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtools", "target": "docs_src_content_docs_de_observability_devtools_overview_devtoolsoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtools", "target": "docs_src_content_docs_de_observability_devtools_overview_tap_protokoll", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtools", "target": "docs_src_content_docs_de_observability_devtools_overview_uebersicht_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtoolsoptions", "target": "docs_src_content_docs_de_observability_devtools_overview_panels_schalter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtoolsoptions", "target": "docs_src_content_docs_de_observability_devtools_overview_allowremote", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_devtoolsoptions", "target": "docs_src_content_docs_de_observability_devtools_overview_allowungatedmount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_sicherheit", "target": "docs_src_content_docs_de_observability_devtools_overview_attach", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_sicherheit", "target": "docs_src_content_docs_de_observability_devtools_overview_mount", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/devtools/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_devtools_overview_allowungatedmount", "target": "docs_src_content_docs_de_observability_devtools_overview_mount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "sour