{"nodes": [{"id": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "label": "ObjectStorageSnapshotStore", "file_type": "document", "rationale": "The snapshot store backed by object storage \u2014 for cluster-wide shared snapshots that any node can load, encrypted snapshots for compliance, and cheap per-GB storage of read-rarely data. Single-node deployments are faster and simpler on SqliteSnapshotStore.", "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstoreoptionstype", "label": "ObjectStorageSnapshotStoreOptionsType", "file_type": "document", "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_snapshot_key_layout", "label": "Snapshot key layout <prefix>/<persistenceId>/seq-<n>", "file_type": "document", "rationale": "The framework lists keys under <prefix>/<persistenceId>/ to find the latest snapshot, which is fast per prefix in S3 \u2014 so avoid putting all entity types under one prefix without per-pid subdirectories.", "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_keepn_pruning", "label": "keepN pruning", "file_type": "document", "rationale": "Pruning is on by default at keepN 3, so each save keeps only the most recent snapshots per persistenceId and per-pid LISTs stay bounded. keepN:0 disables pruning, and then one pid can accumulate 100K snapshots that every loadLatest LIST has to return.", "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_cachedsnapshotstore", "label": "CachedSnapshotStore", "file_type": "document", "rationale": "A read-through decorator for hot-path snapshot loading, turning redundant S3 GETs into sub-microsecond cache hits.", "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_journal_snapshot_independence", "label": "Journal and snapshot store are independent", "file_type": "rationale", "rationale": "They can be mixed freely \u2014 SQLite journal with object-storage snapshots for local event rate plus shared snapshots for sharded entities, Cassandra plus object storage for both shared, or object storage for everything when S3 is the only storage.", "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "target": "docs_src_content_docs_persistence_overview_snapshotstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_keepn_pruning", "target": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_journal_snapshot_independence", "target": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "target": "docs_src_content_docs_persistence_object_storage_overview_objectstoragebackend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstoreoptionstype", "target": "docs_src_content_docs_persistence_object_storage_snapshot_store_backend_keepn_pruning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/snapshot-store-backend.mdx", "source_location": null, "weight": 1.0}], "hyperedge