{"nodes": [{"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "label": "ReplicatedSnapshot", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## What gets serialized", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A normal snapshot blob that carries more than state: the current vector clock, the seenIds dedupe set, the canonical sorted events history, localSeq, journalSeqAtSnapshot, takenBy and takenAt. Carrying the full deduped history lets an out-of-order remote arrival refold without re-reading the whole journal - and makes `events` the heaviest field (a 100k-event actor snapshots 100k envelopes)."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_snapshotvectorclock", "label": "Vector clock inside the snapshot", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no single linear seqNr in replicated ES, so the snapshot must carry the vector clock; it lets a recovering replica skip events that causally precede the snapshot."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_seenids", "label": "seenIds dedupe set", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## What gets serialized", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_replicatedrecoveryflow", "label": "Replicated recovery flow", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## Recovery flow", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load snapshot, then for each journal event: skip when its vc precedes the snapshot's, invoke the resolver when concurrent, otherwise apply via onEvent. The skip case is what makes snapshots bound recovery time."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_sharedsnapshotstore", "label": "Shared snapshot store across replicas", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## Snapshot stores", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical for multi-region replicated ES: each replica recovers faster if it can load the latest snapshot from any replica rather than only its own."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_snapshotmorefrequent", "label": "Bias toward more frequent snapshots", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## When to snapshot", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replicated workloads accumulate events from several replicas at once, the journal grows at N times the per-replica rate, and recovery has to re-run conflict resolution for every not-snapshotted concurrent event."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_vectorclockgrowthretired", "label": "Vector clocks grow with retired replicas", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## Vector clocks grow with retired replicas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retired replicas leave inert components that take space and slow comparisons. VC garbage collection is out of scope for v1 - there is no pruning hook and a snapshot stores the full, unpruned clock - so a node-churn-heavy deployment will eventually want compaction."}, {"id": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_resolverupgradeisschemachange", "label": "Do not share snapshots across replicas with different resolvers", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": "## Don't share snapshots across replicas with different resolvers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A resolver upgrade is a schema change: replica A on resolver-v1 and replica B on resolver-v2 make recovery see inconsistent state. Roll it out via standard migration patterns."}], "edges": [{"source": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_snapshotvectorclock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_seenids", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_persistence_replicated_event_sourcing_snapshotting_replicatedrecoveryflow", "relation": "references", "confidence": "E