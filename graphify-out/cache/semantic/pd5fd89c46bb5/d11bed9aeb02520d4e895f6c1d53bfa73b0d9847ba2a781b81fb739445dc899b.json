 "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_tuning_mailbox_sizing_picking_capacity", "target": "docs_src_content_docs_observability_metrics_stock_metrics_actor_mailbox_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_tuning_mailbox_sizing_mailbox_sizing", "target": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dispatcher_tuning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_tuning_mailbox_sizing_backpressure_layering", "target": "docs_src_content_docs_http_middleware_rate_limit_ratelimit", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_tuning_mailbox_sizing_death_watch_lane", "target": "docs_src_content_docs_io_broker_actor_base_terminated_arm", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_tuning_mailbox_sizing_overflow_policies", "target": "docs_src_content_docs_io_broker_actor_base_outbound_buffer", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_tuning_mailbox_sizing_unbounded_default", "target": "docs_src_content_docs_operations_dead_let