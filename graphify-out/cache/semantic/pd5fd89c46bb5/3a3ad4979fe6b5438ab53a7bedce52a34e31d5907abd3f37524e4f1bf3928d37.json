{"nodes": [{"id": "docs_src_content_docs_de_intro_installation_core_installation", "label": "Core-Installation", "file_type": "concept", "rationale": "Der Kern hat zwei kleine Runtime-Dependencies (ts-pattern, fastify); alles andere ist opt-in ueber Peer-Dependencies.", "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_installation_runtime_requirements", "label": "Runtime-Anforderungen", "file_type": "concept", "rationale": "Bun ab 1.3, Node ab 24.0, Deno ab 2.2 (SQLite braucht 2.2 fuer node:sqlite). Das Framework erkennt automatisch, unter welcher Runtime es laeuft, und waehlt die Backends transparent.", "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_installation_optional_peer_dependencies", "label": "Optionale Peer-Dependencies", "file_type": "rationale", "rationale": "Die Core-Installation klein zu halten heisst, dass ein Chat-Beispiel eine Handvoll MB zieht. Wer Kafka braucht, fuegt kafkajs selbst hinzu; kein Bundle-Bloat fuer ungenutzte Features. Nichts wird automatisch geladen \u2014 die Extension wirft einen klaren Fehler.", "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_installation_typescript_configuration", "label": "TypeScript-Konfiguration", "file_type": "concept", "rationale": "Das Framework verlaesst sich auf noImplicitOverride, um Lifecycle-Method-Typo-Bugs zu fangen (onRecieve statt onReceive).", "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_installation_verify_installation", "label": "Installation verifizieren", "file_type": "concept", "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_installation_missing_peer_dependency_error", "label": "Fehlende Peer-Dependency zur Laufzeit", "file_type": "rationale", "rationale": "Der Versuch, eine Integration ohne ihre Peer-Dep zu nutzen, erzeugt einen klaren Fehler, der das Paket und den Installationsbefehl nennt.", "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_intro_installation_runtime_requirements", "target": "docs_src_content_docs_de_intro_installation_core_installation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_intro_installation_optional_peer_dependencies", "target": "docs_src_content_docs_de_intro_installation_core_installation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_intro_installation_missing_peer_dependency_error", "target": "docs_src_content_docs_de_intro_installation_optional_peer_dependencies", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/intro/installation.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_intro_installation_typescript_configuration", "target": "docs_src_content_docs_de_intro_installation_core_installation", "relati