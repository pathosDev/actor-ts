{"nodes": [{"id": "docs_src_content_docs_typed_overview_typed_vs_untyped", "label": "Typed versus untyped API", "file_type": "concept", "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both layers run on the same dispatcher, mailbox and supervision tree, so the choice is expressive style rather than capability: subclass and mutate, or compose Behavior values and return the next one."}, {"id": "docs_src_content_docs_typed_overview_state_as_parameters", "label": "State as parameters, not fields", "file_type": "concept", "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The typed form threads state through behavior parameters and closures, which removes this-mutation footguns and makes a behavior a testable value - but becomes ceremony once the actor holds a substantial mutable aggregate."}, {"id": "docs_src_content_docs_typed_overview_mixing_typed_and_untyped", "label": "Mixing typed and untyped actors", "file_type": "concept", "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refs are interoperable in both directions with the same tell signature, so the two forms can message each other freely; the seam only shows because most cluster extensions' internals are untyped classes."}], "edges": [{"source": "docs_src_content_docs_typed_overview_typed_vs_untyped", "target": "docs_src_content_docs_typed_behaviors_behaviors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_typed_overview_typed_vs_untyped", "target": "docs_src_content_docs_typed_typed_actor_typedactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_typed_overview_typed_vs_untyped", "target": "docs_src_content_docs_typed_spawn_typed_system_spawntyped", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_typed_overview_state_as_parameters", "target": "docs_src_content_docs_typed_overview_typed_vs_untyped", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_typed_overview_mixing_typed_and_untyped", "target": "docs_src_content_docs_typed_spawn_typed_context_spawntyped", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_typed_overview_typed_vs_untyped", "target": "docs_src_content_docs_typed_behaviors_behavior_sentinels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/typed/overview.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}