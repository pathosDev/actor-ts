{"nodes": [{"id": "docs_src_content_docs_distributed_data_crdt_types_maps_lwwmap", "label": "LWWMap<K, V>", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "rationale": "Per-Key-LWW wie LWWRegister, nur indiziert: nebenlaeufige Writes auf denselben Key loesen per Timestamp auf, Writes auf verschiedene Keys kollidieren nicht. remove ist ebenfalls eine LWW-Operation \u2014 ein juengeres remove schlaegt ein aelteres put, auch von einer anderen Replica.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_maps_ormap", "label": "ORMap<K, C>", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "rationale": "Die Werte sind selbst CRDTs und mergen mit ihrer EIGENEN Merge-Semantik; das Entfernen eines Keys folgt OR-Semantik, sodass nebenlaeufige Re-Adds gewinnen. ORMap von ORSet ist die gaengige Form fuer Map-von-Mengen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_maps_gcountermap", "label": "GCounterMap<K>", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "rationale": "Funktional ORMap<K, GCounter> mit flacherer API (increment/value/pairs). Existiert, weil Per-Key-Counts (Views pro URL, Klicks pro Button, Requests pro Route) haeufig genug sind, um eine eigene typisierte Abkuerzung zu rechtfertigen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_maps_homogeneous_values", "label": "ORMap bevorzugt homogene Werte", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "rationale": "Heterogene Wertetypen sind erlaubt, aber unerwuenscht: das Framework kann die Typen nicht inferieren und man kaempft mit dem Compiler. Mehrere typisierte Maps fuer verschiedene Arten. Zweite Falle: Maps laufen nicht automatisch ab \u2014 jede Replica haelt jeden Key und Gossip traegt den vollen State.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_distributed_data_crdt_types_maps_gcountermap", "target": "docs_src_content_docs_distributed_data_crdt_types_maps_ormap", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_maps_gcountermap", "target": "docs_src_content_docs_distributed_data_crdt_types_counters_gcounter", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_maps_lwwmap", "target": "docs_src_content_docs_distributed_data_crdt_types_registers_lwwregister", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_maps_ormap", "target": "docs_src_content_docs_distributed_data_crdt_types_sets_orset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_maps_homogeneous_values", "target": "docs_src_content_docs_distributed_data_crdt_types_maps_ormap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_registers_clock_skew", "target": "docs_src_content_docs_distributed_data_crdt_types_maps_lwwmap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/maps.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}