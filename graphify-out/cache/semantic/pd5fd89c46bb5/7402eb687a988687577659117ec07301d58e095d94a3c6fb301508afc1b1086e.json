{"nodes": [{"id": "docs_src_content_docs_http_marshalling_marshalling", "label": "Marshalling (request/response halves)", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content-Type drives the request side, Accept drives the response side."}, {"id": "docs_src_content_docs_http_marshalling_entity", "label": "entity<T>(req)", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces Content-Type to the bare media type, picks a serializer or throws 415, decodes the Uint8Array body, and casts. It throws if the body is empty, so do not call it when you expect none."}, {"id": "docs_src_content_docs_http_marshalling_marshal", "label": "marshal(req, value)", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_marshalling_completejson", "label": "completeJson", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_marshalling_jsonserializer", "label": "JsonSerializer", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_marshalling_cborserializer", "label": "CborSerializer", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typically 20-40 % smaller than JSON and carries binary without base64 wrapping \u2014 but JSON stays the better choice for human-debuggable APIs."}, {"id": "docs_src_content_docs_http_marshalling_formurlencodedserializer", "label": "FormUrlEncodedSerializer", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decodes to a flat record of strings \u2014 form encoding carries no types; a repeated field widens to an array, matching how req.query treats a repeated parameter, and nesting is not expressible."}, {"id": "docs_src_content_docs_http_marshalling_serializer_interface", "label": "Serializer interface", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HTTP module media-type-to-serializer map is a private constant, so a custom serializer means branching before calling entity; the cluster wire has no equivalent hook and never consults the SerializationExtension."}, {"id": "docs_src_content_docs_http_marshalling_unsupported_media_type_415", "label": "415 for an undecodable Content-Type", "file_type": "rationale", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text/xml or multipart is a 415 rather than an attempt to parse it as JSON, and the accepted list ships as an Accept response header, which RFC 9110 12.5.1 defines as what to send next time. The match is on the parsed media type, so naming a known type inside a parameter does not select that serializer."}, {"id": "docs_src_content_docs_http_marshalling_structured_syntax_suffix", "label": "Structured-syntax suffixes follow their base type", "file_type": "concept", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "application/vnd.api+json, merge-patch+json and problem+json all decode as JSON, per RFC 6839."}, {"id": "docs_src_content_docs_http_marshalling_missing_content_type_json", "label": "A missing Content-Type still decodes as JSON", "file_type": "rationale", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RFC 9110 leaves the recipient free to guess when the sender states nothing, and HttpClient sets the header only for object bodies, so a string body ships bare \u2014 a narrowing guard that forgets the empty case turns those clients away."}, {"id": "docs_src_content_docs_http_marshalling_trust_based_cast", "label": "entity<T> does not validate", "file_type": "rationale", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cast is trust-based \u2014 TS thinks the value matches, the runtime value is unknown. The framework bundles no validator; zod, valibot or io-ts drop in cleanly on top."}, {"id": "docs_src_content_docs_http_marshalling_streaming_responses", "label": "Streaming responses from a handler", "file_type": "rationale", "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three backends stream a ReadableStream without buffering. Streams are one-shot, so never wrap one in caching middleware; set Content-Length yourself since a backend has nothing to measure on a stream \u2014 and Bun.serve re-frames a stream as chunked regardless."}], "edges": [{"source": "docs_src_content_docs_http_marshalling_marshalling", "target": "docs_src_content_docs_http_marshalling_entity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_marshalling", "target": "docs_src_content_docs_http_marshalling_marshal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_entity", "target": "docs_src_content_docs_http_marshalling_jsonserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_entity", "target": "docs_src_content_docs_http_marshalling_cborserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_entity", "target": "docs_src_content_docs_http_marshalling_formurlencodedserializer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_entity", "target": "docs_src_content_docs_http_marshalling_unsupported_media_type_415", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_unsupported_media_type_415", "target": "docs_src_content_docs_http_marshalling_structured_syntax_suffix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_unsupported_media_type_415", "target": "docs_src_content_docs_http_marshalling_missing_content_type_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_entity", "target": "docs_src_content_docs_http_marshalling_trust_based_cast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_serializer_interface", "target": "docs_src_content_docs_http_marshalling_jsonserializer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_serializer_interface", "target": "docs_src_content_docs_http_marshalling_cborserializer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_marshal", "target": "docs_src_content_docs_http_marshalling_completejson", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_streaming_responses", "target": "docs_src_content_docs_http_static_files_streamthreshold", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_marshalling", "target": "docs_src_content_docs_http_overview_route_dsl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_marshalling_missing_content_type_json", "target": "docs_src_content_docs_http_overview_httpclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/marshalling.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}