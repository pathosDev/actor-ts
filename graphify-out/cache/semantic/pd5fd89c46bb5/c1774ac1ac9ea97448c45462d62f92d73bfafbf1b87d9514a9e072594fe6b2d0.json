{"nodes": [{"id": "docs_src_content_docs_de_runtime_bun_page", "label": "Bun (prim\u00e4re Runtime)", "file_type": "document", "source_file": "docs/src/content/docs/de/runtime/bun.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zuerst getestet, Benchmarks laufen gegen Bun, die Docs nehmen Bun an; ~3-5x schnellerer Cold-Start, eingebautes SQLite und Test-Runner, weniger Peer-Deps."}, {"id": "docs_src_content_docs_de_runtime_bun_bun_sqlite", "label": "bun:sqlite", "file_type": "concept", "source_file": "docs/src/content/docs/de/runtime/bun.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eingebaut \u2014 kein better-sqlite3-Install; das Framework erkennt es automatisch, SqliteJournal braucht kein Treiber-Setup."}, {"id": "docs_src_content_docs_de_runtime_bun_bun_test", "label": "bun:test", "file_type": "concept", "source_file": "docs/src/content/docs/de/runtime/bun.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drop-in-kompatibel mit Jests API; TestKit funktioniert direkt."}, {"id": "docs_src_content_docs_de_runtime_bun_honobackend", "label": "HonoBackend auf Bun", "file_type": "concept", "source_file": "docs/src/content/docs/de/runtime/bun.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die schlankste HTTP-Option, baut auf dem WHATWG-fetch-Adapter auf, den Bun ohnehin anbietet, und tree-shaket zu einem winzigen Bundle; f\u00fcr das breitere Node-\u00d6kosystem bleibt Fastify der Default."}, {"id": "docs_src_content_docs_de_runtime_bun_serverless_limitation", "label": "Kein Bun auf Lambda / Serverless", "file_type": "rationale", "source_file": "docs/src/content/docs/de/runtime/bun.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contr