{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_timerscheduler", "label": "TimerScheduler (context.timers)", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default fuer actor-interne Timer: an die Instanz gebunden, auto-cancel bei Stop UND Restart, feuert per tell an this.self - also serialisiert, supervised und in Actor-Traces sichtbar."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_scheduler", "label": "Scheduler (system.scheduler)", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An das System gebunden, ueberlebt jeden Actor-Stop. Drei legitime Faelle: Arbeit aus der Aussenwelt (SIGTERM-Handler), Arbeit die einen Actor ueberleben muss, und Framework-Code ohne Actor-Kontext."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_manualscheduler", "label": "ManualScheduler", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Echtzeit-Warten in Tests ist flakey, langsam und order-abhaengig; advance(ms) macht Zeit deterministisch. Ein selbst gesetzter onError-Sink wird nie uebernommen und beim Terminieren zurueckgegeben - relevant fuer einen ManualScheduler, den man dem System leiht."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_cancellable", "label": "Cancellable", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cancel() liefert true nur, wenn tatsaechlich ein aktiver Schedule gecancelt wurde."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_schedulererror", "label": "SchedulerError", "file_type": "code", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nur die *Function-Varianten publizieren ihn: ein roher Timer-Callback hat keine Cell und keinen Supervisor. scheduleOnce/scheduleAtFixedRate liefern per tell, ein Throw dort ist Sache des Parents des Targets."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_timer_keys", "label": "Timer sind per String-Key indexiert", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein zweiter Aufruf mit demselben Key ersetzt den Timer - keine doppelten Feuerungen, nuetzlich fuer Reset-on-Activity."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_auto_cancel", "label": "Auto-Cancel bei Stop und Restart", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cancelAll laeuft bei postStop; vor dem Start einer neuen Instanz wird jeder aktive Timer gecancelt, ein neu gestarteter Actor erbt also nie veraltete Timer vom toten."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_empty_mdc_tick", "label": "Ein Tick traegt keinen diagnostischen Kontext", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gilt fuer context.timers und alle vier scheduler-Einstiegspunkte: ohne das nagelte ein setInterval aus dem Request eines Tenants dessen Identifier fuer die Prozesslebensdauer an jeden Tick - und via tell an jeden, den der Tick anschrieb. Braucht ein Tick den Armierungs-Kontext, wird er beim Armieren gesnapshotet und im Handler erneut geoeffnet."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_fixed_rate_semantics", "label": "Fixed-Rate-Semantik (kein Catch-Up, keine Kompression)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verpasste Feuerungen werden weder nachgeholt noch zusammengefasst; Missed-Firing-Detection ist Sache des Actors (Last-Fire-Timestamp). Ein 10-ms-Timer auf einem Handler mit 50 ms Laufzeit erzeugt eine staendig wachsende Mailbox."}, {"id": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_raw_settimeout_escape", "label": "Rohes setTimeout umgeht Supervision", "file_type": "rationale", "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rohe Callbacks laufen ausserhalb der Nachrichtenrunde, Throws werden nicht gefangen, und sie koennen nach dem Stop feuern - mit this.context auf einer zerstoerten Zelle."}], "edges": [{"source": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_timerscheduler", "target": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_timer_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/fundamentals/timers-and-scheduling.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_fundamentals_timers_and_scheduling_timerscheduler", "target": "docs_s