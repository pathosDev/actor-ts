{"nodes": [{"id": "docs_src_content_docs_cluster_joining_and_seeds_join_handshake", "label": "Join handshake", "file_type": "concept", "rationale": "The joiner contacts a seed, is added as joining, propagates through gossip and reaches up once the leader sees it plus convergence.", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_joining_and_seeds_seeds", "label": "Seed list as a bootstrap hint", "file_type": "concept", "rationale": "Seeds are not special after the join - the node learns every other peer via gossip; an empty list means this node bootstraps the cluster itself and auto-promotes to leader.", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_joining_and_seeds_symmetric_seed_deadlock", "label": "A symmetric seed list never cold-starts", "file_type": "rationale", "rationale": "Cluster removes this node's own address from its seed list, so if every node lists every node no node is left with the empty list that selfElection 'immediate' requires: nobody is up, so there is no leader, so nobody is promoted. The retry loop cannot manufacture a first member - the election is what breaks the symmetry.", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_joining_and_seeds_seed_providers", "label": "Seed providers (config, DNS, K8s, aggregate)", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_joining_and_seeds_kubernetesapiseedprovider", "label": "KubernetesApiSeedProvider", "file_type": "concept", "rationale": "Resolves to pod IPs consistently, which is the fix for peers seeing different addresses for the same node.", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_joining_and_seeds_selfup", "label": "SelfUp event", "file_type": "concept", "rationale": "Fires once when this node reaches up - the gate for starting work that requires membership, with MemberUp counted after it when other members are needed.", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_joining_and_seeds_address_identity_mismatch", "label": "Hostname vs IP member-identity mismatch", "file_type": "rationale", "rationale": "Member identity is the address advertised at join, so if peers see different addresses for the same node the cluster forms but each node sees the peer as a stranger.", "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_joining_and_seeds_join_handshake", "target": "docs_src_content_docs_cluster_joining_and_seeds_seeds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/joining-and-seeds.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_joining_and_seeds_symmetric_seed_deadlock", "target": "docs_src_content_docs_cluster_joining_and_seeds_seeds", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/joinin