{"nodes": [{"id": "docs_src_content_docs_operations_tuning_failure_detector_failure_detector_tuning", "label": "Failure detector tuning", "file_type": "document", "rationale": "Operational tuning guide for the three thresholds; defaults are LAN-focused and cross-region clusters need them raised.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_heartbeatintervalms", "label": "heartbeatIntervalMs", "file_type": "concept", "rationale": "Defaults to 500 ms. Bandwidth scales linearly with frequency across N peers, so going from 500 ms to 2 s drops heartbeat traffic fourfold.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_unreachableafterms", "label": "unreachableAfterMs", "file_type": "concept", "rationale": "Defaults to 2000 ms. Too tight for the network jitter and brief GC pauses cross the threshold, producing false-positive unreachable flapping.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_downafterms", "label": "downAfterMs", "file_type": "concept", "rationale": "Defaults to 5000 ms. P99 time spent unreachable should sit well below it, otherwise legitimate flaps trigger downing.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_threshold_ratio_rule", "label": "Threshold ratio minimums", "file_type": "rationale", "rationale": "unreachableAfter at least three heartbeats tolerates two consecutive misses before flagging; downAfter at least twice unreachable keeps a node unreachable for a while before declaring it down. The defaults follow the rule.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_cross_region_bias_to_stability", "label": "Cross-region bias toward stability", "file_type": "rationale", "rationale": "Defaults assume sub-millisecond LAN RTT; a 100 ms WAN with normal jitter exceeds the 2 s threshold routinely, so a 30 second window catches real failures while tolerating jitter.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_symmetric_thresholds", "label": "Same thresholds on every node", "file_type": "rationale", "rationale": "Nodes with different thresholds disagree about who is unreachable; also do not tune during an outage, since hot-changing thresholds masks the root cause and often creates new ones.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_failure_detector_measure_before_tuning", "label": "Measure before tuning", "file_type": "rationale", "rationale": "Histogram-track duration in the unreachable state; a week of observing in production is more useful than guessing at values up front.", "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_operations_tuning_failure_detector_failure_detector_tuning", "target": "docs_src_content_docs_operations_tuning_failure_detector_heartbeatintervalms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_failure_detector_failure_detector_tuning", "target": "docs_src_content_docs_operations_tuning_failure_detector_unreachableafterms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_failure_detector_failure_detector_tuning", "target": "docs_src_content_docs_operations_tuning_failure_detector_downafterms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_failure_detector_failure_detector_tuning", "target": "docs_src_content_docs_operations_tuning_failure_detector_threshold_ratio_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_failure_detector_failure_detector_tuning", "target": "docs_src_content_docs_operations_tuning_failure_detector_cross_region_bias_to_stability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/failure-detector.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operatio