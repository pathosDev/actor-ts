{"nodes": [{"id": "docs_src_content_docs_de_observability_tracing_actor_tracing_actor_receive_span", "label": "actor.receive-Span", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": "Auto-instrumentierte Spans", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Einer pro an onReceive gelieferter Nachricht, mit actor.path und actor.message.type. Bei einem Fehler zeichnet der Span die Exception auf und setzt Error-Status - es gibt kein error.message-Attribut. Anwendungs-Spans erscheinen als Kinder dieses Spans."}, {"id": "docs_src_content_docs_de_observability_tracing_actor_tracing_causal_chaining", "label": "Kausale Verkettung ueber tell und W3C-traceparent", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": "Kausale Verkettung", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tell snapshottet den aktiven Span-Kontext auf den Envelope (tracer.injectContext); beim Empfangen laeuft tracer.withActiveSpan, damit onReceive die Kette sieht. Ueber Cluster-Nodes reitet derselbe traceparent auf dem Wire-Envelope - ein Trace pro logischem Request, auch ueber 4-5 Actor-Hops."}, {"id": "docs_src_content_docs_de_observability_tracing_actor_tracing_pipeto_span_gap", "label": "pipeTo propagiert den aktiven Span nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": "pipeTo propagiert den aktiven Span nicht", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bekannte Limitation: das onReceive des Targets sieht den aktiven Span des Aufrufers nicht. Workaround ist ein manuelles tracer.injectContext() vor dem Pipen."}, {"id": "docs_src_content_docs_de_observability_tracing_actor_tracing_mdc_trace_ids", "label": "Trace-IDs im MDC", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": "MDC-Integration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Framework mergt traceId/spanId NICHT automatisch in den LogContext - Log-Zeilen tragen die IDs des aktiven Spans nicht von Haus aus. Wer von einem langsamen Trace zu den passenden Log-Zeilen springen will, kopiert sie selbst vom aktiven Span in den MDC."}], "edges": [{"source": "docs_src_content_docs_de_observability_tracing_actor_tracing_actor_receive_span", "target": "docs_src_content_docs_de_observability_tracing_actor_tracing_causal_chaining", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_actor_tracing_causal_chaining", "target": "docs_src_content_docs_de_observability_tracing_tracer_api_tracecarrier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_actor_tracing_pipeto_span_gap", "target": "docs_src_content_docs_de_observability_tracing_actor_tracing_causal_chaining", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/tracing/actor-tracing.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_tracing_actor_tracing_mdc_trace_ids", "target": "docs_src_content_docs_de_observability_tracing_actor_tracing_actor_receive_span", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observabili