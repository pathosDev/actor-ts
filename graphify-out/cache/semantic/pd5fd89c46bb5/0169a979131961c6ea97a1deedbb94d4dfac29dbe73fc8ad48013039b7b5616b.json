{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_page", "label": "Single-Writer-Lease", "file_type": "document", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Mittelweg: genau eine Replica h\u00e4lt das Lease und schreibt, andere lesen; f\u00e4llt der Halter aus, erwirbt eine andere. Verwandelt Replicated ES in ein failover-f\u00e4higes Single-Writer-System."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_hook", "label": "lease()-Override", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default gibt null zur\u00fcck (kein Lease); der Actor versucht im preStart zu erwerben, wird bei Erfolg Writer und startet sonst read-only."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_inmemorylease", "label": "InMemoryLease", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "label": "isLeaseHolder / onLeaseLost", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Write-Gate ist der gecachte isLeaseHolder-Getter (lokal, Sub-Mikrosekunde); persist wirft f\u00fcr Nicht-Holder ebenfalls als Absicherung."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lastwriterwinsresolver", "label": "LastWriterWinsResolver", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_gates_persist_only", "label": "Das Lease gattert persist, nicht eintreffende Envelopes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein lokales Write-Gate: der Remote-Empfangspfad zieht es nie zurate, ein Peer-Event wird validiert, dedupliziert und gefaltet \u2014 Holder oder nicht. Single-Writer-Modus ist ein Konsistenz-Upgrade, keine Autorisierungsgrenze; 'nur die Events dieses Nodes z\u00e4hlen' ist Cluster-Zugangskontrolle."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_resolver_still_required", "label": "Der Conflict Resolver bleibt Pflicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Im Failover-Fenster k\u00f6nnen alter und neuer Writer kurz gleichzeitig schreiben, und eine Partition zwischen Lease-Backend und Replica l\u00e4sst eine Replica weiterschreiben, obwohl eine andere erworben hat. Das Lease senkt die Konflikt-Frequenz auf nahe null, eliminiert sie nicht."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_failover_window", "label": "Failover-Fenster = Lease-TTL", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typischerweise 15-30 s; k\u00fcrzere TTL hei\u00dft schnelleres Failover, aber mehr Renewal-Traffic (Renewal alle ttl/3)."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_backend_spof", "label": "Das Lease-Backend wird zum SPOF im Write-Pfad", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend down hei\u00dft keine Replica kann erwerben, also keine Writes; f\u00fcr Multi-Region Active-Active ein regions-repliziertes Lease-Backend verwenden."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_readonly_proxy_pattern", "label": "Read-only-Replicas und der Proxy-Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Read-only-Replica spielt das Journal ab und bedient Reads, lehnt Writes aber ab; f\u00fcr transparentes Routing beobachtet ein Proxy-Actor den Lease-Besitz und leitet Writes an den aktuellen Writer."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_hook", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_kuberneteslease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_hook", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_inmemorylease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_hook", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_isleaseholder", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lease_hook", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_lastwriterwinsresolver", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_gates_persist_only", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_envelope_validation", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_gates_persist_only", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_authorship_unauthenticated", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_resolver_still_required", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_failover_window", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_single_writer_lease_resolver_still_required", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/single-writer-lease.mdx", "source_location": null, "weight": 1.0}, {"sou