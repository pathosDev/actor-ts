{"nodes": [{"id": "docs_src_content_docs_de_cluster_refs_across_nodes_remoteactorref", "label": "RemoteActorRef", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ActorRef field serialises as the path-with-host string; the receiving node reconstructs a RemoteActorRef pointing back at the origin, which is what makes cross-node request/response work with no extra machinery."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_path_with_host_format", "label": "Path-with-host format", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "actor-ts://my-app@10.0.0.5:2552/user/... \u2014 the host fragment tells the local runtime which node hosts the actor, so a tell can look up the transport connection before serialising."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_actorref_equals_compares_path_only", "label": "ActorRef.equals compares path only", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A path carries the system name, not the node address, and all cluster members share one system name \u2014 so two refs to the same path on different nodes compare equal. equals answers 'same actor path?', not 'same actor'; for node identity compare toString() or keep the NodeAddress alongside the ref."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_actorselection_resolveone", "label": "ActorSelection.resolveOne", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lookup escape hatch \u2014 for a location known by convention or a path arriving inside a message; routine cluster work holds refs from the cluster's own machinery instead."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_tagged_json_tree_wire_format", "label": "Tagged JSON-tree wire format", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same format the persistence stores write, so Date/Map/Set/bigint/Uint8Array/RegExp/URL/Error survive intact (#450). The pluggable Serializer is still never consulted on the wire, so CBOR is not selectable there."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_functions_and_symbols_rejected", "label": "Functions and symbols rejected on the wire", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frame is rejected with an error log naming the peer rather than silently truncated, so a callback in a message stops being invisible data loss. Class identity is still lost \u2014 only the constructor-name tag travels."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_max_frame_bytes_cap", "label": "maxFrameBytes cap", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 MiB default via actor-ts.remote.max-frame-bytes or ClusterOptions.withMaxFrameBytes; larger frames fail and the message lands in dead letters, so big payloads belong on a side channel with a reference in the actor message."}, {"id": "docs_src_content_docs_de_cluster_refs_across_nodes_terminated_addressterminated", "label": "Terminated.addressTerminated", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinguishes 'actor stopped' from 'node lost' \u2014 the per-actor way to notice a vanished remote, complementing MemberRemoved/MemberUnreachable subscriptions."}], "edges": [{"source": "docs_src_content_docs_de_cluster_refs_across_nodes_remoteactorref", "target": "docs_src_content_docs_de_cluster_refs_across_nodes_path_with_host_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_refs_across_nodes_actorref_equals_compares_path_only", "target": "docs_src_content_docs_de_cluster_refs_across_nodes_path_with_host_format", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_refs_across_nodes_actorselection_resolveone", "target": "docs_src_content_docs_de_cluster_refs_across_nodes_remoteactorref", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_refs_across_nodes_remoteactorref", "target": "docs_src_content_docs_de_cluster_refs_across_nodes_tagged_json_tree_wire_format", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/refs-across-nodes.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_refs_a