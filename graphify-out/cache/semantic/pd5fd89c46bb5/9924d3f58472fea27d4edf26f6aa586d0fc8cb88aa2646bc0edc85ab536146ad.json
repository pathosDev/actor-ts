{"nodes": [{"id": "docs_src_content_docs_cluster_cluster_router_clusterrouter", "label": "ClusterRouter", "file_type": "concept", "rationale": "Its routees are other nodes' actors at a well-known path, derived from cluster up-members, so adding or removing a node changes the routee set with no restart; stopping the router leaves the routees running.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_clusterrouteroptions", "label": "ClusterRouterOptions", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_routing_strategies", "label": "The five cluster routing strategies", "file_type": "concept", "rationale": "round-robin, random, consistent-hashing, smallest-mailbox and broadcast; the first four are 1-of-N routing, broadcast is fan-out and repeats the local Router.broadcast reply-to trap.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_consistent_hashing", "label": "Consistent-hashing routing (rendezvous)", "file_type": "concept", "rationale": "Pins messages with the same extractKey to the same node so per-key state stays put; topology changes shuffle a fraction of keys, but skewed keys produce hot spots exactly as in any hash-based scheme.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_smallest_mailbox", "label": "Smallest-mailbox routing with cached depths", "file_type": "rationale", "rationale": "It never asks on the routing path - a query per message would park the router's mailbox behind a network round-trip - so depths are cached and refreshed on a background tick. The picture lags by one interval, which is a worse decision but never a wrong one; an unanswered node is skipped rather than assumed idle, and a cold cache degrades to round-robin.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_clustermailboxdepthagent", "label": "ClusterMailboxDepthAgent", "file_type": "concept", "rationale": "A framework agent per node reads queue depth from inside the runtime so the routee never learns it is being measured; a node hosting routees but no router must start it itself, and forgetting simply means that node never reports.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_routee_discovery", "label": "Routee discovery from up-members", "file_type": "concept", "rationale": "Rebuilt on MemberUp and MemberRemoved and ordered deterministically by address so round-robin counters stay sane across rebuilds.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_empty_routee_set", "label": "An empty routee set drops to dead letters", "file_type": "rationale", "rationale": "The framework does not queue while waiting for routees - that would silently grow without bound; gate request handling on a MemberUp counter instead.", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_router_role_filtering", "label": "Role filtering of routees", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_cluster_router_clusterrouter", "target": "docs_src_content_docs_cluster_cluster_router_clusterrouteroptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_router_clusterrouter", "target": "docs_src_content_docs_cluster_cluster_router_routing_strategies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_router_routing_strategies", "target": "docs_src_content_docs_cluster_cluster_router_consistent_hashing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_router_routing_strategies", "target": "docs_src_content_docs_cluster_cluster_router_smallest_mailbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_router_smallest_mailbox", "target": "docs_src_content_docs_cluster_cluster_router_clustermailboxdepthagent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fil