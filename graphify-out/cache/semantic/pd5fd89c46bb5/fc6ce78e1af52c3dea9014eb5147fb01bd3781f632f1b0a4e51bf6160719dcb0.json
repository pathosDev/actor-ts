{"nodes": [{"id": "tests_integration_brokers_dynamodb_docker_compose_dynamodb_dynamodb", "label": "DynamoDB Local service", "file_type": "code", "source_file": "tests/integration/brokers/dynamodb/docker-compose.dynamodb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AWS's own local emulator, the image the AWS docs recommend for tests. Run with -inMemory -sharedDb: the suite creates its own tables on first use, and a fresh instance per run is exactly what makes it reproducible."}, {"id": "tests_integration_brokers_dynamodb_docker_compose_dynamodb_runner", "label": "DynamoDB runner service", "file_type": "code", "source_file": "tests/integration/brokers/dynamodb/docker-compose.dynamodb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DYNAMODB_ENDPOINT http://dynamodb:8000; dynamodb-local ignores credentials but the SDK refuses to sign without them, so any non-empty pair will do."}, {"id": "tests_integration_brokers_dynamodb_docker_compose_dynamodb_service_started_gate", "label": "service_started gate (bare JRE image)", "file_type": "rationale", "source_file": "tests/integration/brokers/dynamodb/docker-compose.dynamodb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No service_healthy gate: the image is a bare JRE with no shell utilities to probe with. The runner waits on the port itself via waitForPort and the SDK retries its first call."}], "edges": [{"source": "tests_integration_brokers_dynamodb_docker_compose_dynamodb_runner", "target": "tests_integration_brokers_dynamodb_docker_compose_dynamodb_dynamodb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/dynamodb/docker-compose.dynamodb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_dyna