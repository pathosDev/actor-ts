{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "label": "ReplicatedSnapshot", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traegt mehr als State + Clock: seenIds (Dedupe-Set), die kanonische sortierte events-Historie, localSeq, journalSeqAtSnapshot, takenBy und takenAt. Die volle Historie ist dabei, damit ein out-of-order eintreffendes Remote-Event neu falten kann, ohne das gesamte Journal erneut zu lesen - events ist das schwerste Feld, 100k Events snapshotten 100k Envelopes."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_vectorclock_in_snapshot", "label": "Vector Clock im Snapshot", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt keine einzelne lineare seqNr; die vc laesst die wiederherstellende Replica Events ueberspringen, die dem Snapshot kausal vorausgehen - genau das macht Snapshots hier zur Recovery-Zeit-Schranke."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_seenids_dedupe_set", "label": "seenIds-Dedupe-Set (replica, seqAtReplica)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_snapshot_more_often", "label": "Bias in Richtung haeufigerer Snapshots", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replizierte Workloads akkumulieren Events von N Replicas gleichzeitig, das Journal waechst schneller, und die Recovery muss Conflict Resolution fuer jedes nicht gesnappshottete nebenlaeufige Event erneut ausfuehren."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_shared_snapshot_store", "label": "Geteilter Snapshot-Store ueber Replicas", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Replica stellt schneller wieder her, wenn sie den neuesten Snapshot von JEDER Replica laden kann, nicht nur von ihrem eigenen - ObjectStorageSnapshotStore ist dafuer die Form."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_vector_clock_gc_out_of_scope", "label": "Vector-Clock-Garbage-Collection ist ausserhalb des Scopes fuer v1", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt keinen Pruning-Hook und ein Snapshot speichert die vollstaendige, ungeprunte Clock. VC-Eintraege wachsen mit der Menge aller je gesehenen Replicas - in Ordnung fuer einen stabilen Cluster, ein Problem bei hoher Node-Fluktuation."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_vector_clock_divergence_is_fine", "label": "Vector-Clock-Divergenz zwischen Replica-Snapshots ist in Ordnung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verschiedene Replicas snapshotten an verschiedenen Punkten ihrer kausalen Historie; Recovery von jedem Snapshot holt ueber Journal-Replay + Resolver auf."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_resolver_upgrades_are_schema_changes", "label": "Resolver-Upgrades sind Schema-Aenderungen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots nicht ueber Replicas mit unterschiedlichen Resolvern teilen - sonst sieht die Recovery inkonsistenten State. Ueber Standard-Migrationsmuster ausrollen."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_vectorclock_in_snapshot", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_seenids_dedupe_set", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_snapshot_more_often", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src