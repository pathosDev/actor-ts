{"nodes": [{"id": "docs_src_content_docs_cluster_singleton_manager_clustersingletonmanager", "label": "ClusterSingletonManager", "file_type": "code", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_singletonmanagerpath", "label": "singletonManagerPath", "file_type": "code", "rationale": "The manager must live at a well-known path so the proxy can find it on whichever node currently hosts; misnaming is silent breakage.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_startsingletonoptions", "label": "StartSingletonOptions", "file_type": "code", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_singletonkey", "label": "SingletonKey", "file_type": "code", "rationale": "A role declared only through withRole is invisible to a node that merely calls ref, so the role belongs on the key where every node reads the same one.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_host_selection", "label": "Host is the first address-ordered up-member", "file_type": "rationale", "rationale": "Without a role the host is the leader; with one it is the first up-member carrying that role, so the singleton is never hosted nowhere. Every node reads the same address-ordered list, so all of them pick the same node.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_unreachability_not_a_trigger", "label": "Unreachability is deliberately not a trigger", "file_type": "rationale", "rationale": "Every event in the trigger set states a membership fact the cluster converges on; unreachability is one node's opinion that the subject cannot hear. Reconciling on it would promote a challenger while the incumbent keeps its child, giving two live singletons with nothing to resolve it. Bounded dead-lettering is the smaller cost.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_lease_gated_spawn", "label": "Lease-gated spawn path", "file_type": "rationale", "rationale": "The lease adds an async gate driven by internal events rather than inline awaits, so concurrent cluster events cannot interleave with an in-flight acquire.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_restartontermination", "label": "restartOnTermination", "file_type": "concept", "rationale": "Re-spawning after an unexpected child death (with a one-second backoff so a crash-looping singleton is not a hot loop) avoids a silent cluster-wide outage; turning it off releases the lease and latches this node out of rotation, because 'I am host and have no child' cannot otherwise tell a terminal stop from never having started.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_dead_letters_when_no_host", "label": "Messages sent while no node is hosting", "file_type": "rationale", "rationale": "A message arriving at a non-hosting manager goes to system.deadLetters with one latched warning, so the loss is visible in metrics, DevTools and eventStream instead of only in a log line.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_acquireretryintervalms", "label": "acquireRetryIntervalMs (singleton)", "file_type": "concept", "rationale": "0 does not disable retries \u2014 there is no disable switch; the 5s default applies only to an unset value, so a non-positive value is rejected up front with an OptionsError.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_singleton_manager_restart_semantics", "label": "Manager restart semantics", "file_type": "rationale", "rationale": "On restart subscriptions are re-established, the host is recomputed, lease acquisition is retried, and the restartOnTermination opt-out latch is cleared because it lives on the manager instance.", "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_singleton_manager_clustersingletonmanager", "target": "docs_src_content_docs_cluster_singleton_manager_startsingletonoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/singleton/manager.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_singleton_manager_clustersingletonmanager", "target": "docs_src_