{"nodes": [{"id": "docs_src_content_docs_de_migration_overview_migration_guides_index", "label": "Migration-Guides \u2014 Index", "file_type": "concept", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Guide pro Quell-Framework: Konzept-Mapping, Before/After-Code, was fehlt oder anders ist, plus Verweise auf die relevantesten Seiten."}, {"id": "docs_src_content_docs_de_migration_overview_portable_actor_concepts", "label": "Was aus jedem Actor-Framework uebertragbar ist", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actors als Einheiten aus State + Verhalten, Mailboxes als Queues pro Actor, Supervision mit Direktiven, Death Watch und Event Sourcing sind ueberall dieselben Kernideen."}, {"id": "docs_src_content_docs_de_migration_overview_typescript_specific_differences", "label": "TypeScript-spezifische Unterschiede", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keine Fibers und keine JVM \u2014 JavaScript ist pro Prozess single-threaded und nutzt Microtask-/Macrotask-Queues; kein natives Akka-Typed; ts-pattern statt nativer Match-Ausdruecke."}, {"id": "docs_src_content_docs_de_migration_overview_smaller_surface_area", "label": "Kleinere Oberflaeche", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keine Streams, FSM mit anderer API-Form, weniger eingebaute Patterns \u2014 der Fokus liegt auf den 80 % der Features."}, {"id": "docs_src_content_docs_de_migration_overview_different_defaults", "label": "Andere Defaults", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun ist die primaere Runtime (Node unterstuetzt, Deno Best-Effort), JSON ist der Default-Serializer, und K8s ist das angenommene Deployment-Ziel mit First-Class-Integration fuer Seeds, Lease und Management-Endpunkte."}, {"id": "docs_src_content_docs_de_migration_overview_concept_cheat_sheet", "label": "Konzept-Spickzettel", "file_type": "concept", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zeilenweise Uebersetzung zwischen Akka JVM/Pekko, Orleans, Akka.NET und actor-ts fuer Actor, Identitaet, tell/ask, Supervision, Sharding, Singleton, Event Sourcing, Lease und TestKit."}, {"id": "docs_src_content_docs_de_migration_overview_migration_is_incremental", "label": "Migration ist selten ein One-Shot", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kleines Actor-System neben bestehendem Code, dann ein zustandsbehaftetes Konzept, dann Clustering/Persistenz nach Bedarf. Man muss nicht alles umschreiben, um zu profitieren."}], "edges": [{"source": "docs_src_content_docs_de_migration_overview_migration_guides_index", "target": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_overview_migration_guides_index", "target": "docs_src_content_docs_de_migration_from_pekk