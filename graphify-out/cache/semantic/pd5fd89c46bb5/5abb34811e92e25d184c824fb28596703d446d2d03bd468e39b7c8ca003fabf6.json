{"nodes": [{"id": "docs_src_content_docs_runtime_compatibility_matrix_compatibility_matrix", "label": "Runtime compatibility matrix", "file_type": "document", "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The definitive per-feature support reference, meant to be checked before adopting a subsystem: the marker says whether a feature is CI-tested on that runtime, not merely whether it imports."}, {"id": "docs_src_content_docs_runtime_compatibility_matrix_support_level_markers", "label": "Support-level markers", "file_type": "rationale", "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tick means supported and tested in CI, a warning means it works but is not actively CI'd and has seen no production hours on that runtime, a cross means unsupported. The warning marker exists so an adopter can tell 'untested' apart from 'broken'; most Deno-specific issues behind it are expected to be simple fixes."}, {"id": "docs_src_content_docs_runtime_compatibility_matrix_engine_version_pinning", "label": "Engine version pinning", "file_type": "rationale", "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin both bun and node in package.json engines when code may run on either, so dev and prod cannot silently drift onto different runtimes."}, {"id": "docs_src_content_docs_runtime_compatibility_matrix_recommended_runtime_targets", "label": "Recommended runtime targets", "file_type": "concept", "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun for new projects, Node 24+ for Node shops and Lambda/serverless, Deno only for Deno-first organizations, and one runtime per cluster for mixed estates."}], "edges": [{"source": "docs_src_content_docs_runtime_compatibility_matrix_compatibility_matrix", "target": "docs_src_content_docs_runtime_overview_runtime_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_compatibility_matrix_compatibility_matrix", "target": "docs_src_content_docs_runtime_deno_deno_support", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_compatibility_matrix_compatibility_matrix", "target": "docs_src_content_docs_runtime_node_node_support", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_compatibility_matrix_compatibility_matrix", "target": "docs_src_content_docs_runtime_deno_deno_sqlite_gap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_compatibility_matrix_support_level_markers", "target": "docs_src_content_docs_runtime_compatibility_matrix_compatibility_matrix", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/compatibility-matrix.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_compatibility_matrix_engine_version_pi