{"nodes": [{"id": "docs_src_content_docs_distributed_data_replication_gossipreplication", "label": "Gossip replication", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local writes are immediate; gossip is only for propagation. Writes converge eventually, usually within one or two gossip rounds."}, {"id": "docs_src_content_docs_distributed_data_replication_gossipinterval", "label": "gossipIntervalMs", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 1 s default balances propagation speed against gossip-bandwidth cost: lower converges faster and chats more, higher is cheaper and slower. Settable from application.conf so a deployment can tune it without a rebuild."}, {"id": "docs_src_content_docs_distributed_data_replication_fullstategossip", "label": "Full-state gossip (no deltas)", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately simple \u2014 no digest, no delta \u2014 cheap to implement and good enough for the small-to-medium stores DistributedData targets. The cost is that gossip volume is proportional to total state size, not to update rate."}, {"id": "docs_src_content_docs_distributed_data_replication_randompeerselection", "label": "Random-peer-per-tick selection", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Round-robin gossip would be more predictable but creates synchronized waves; random-peer-per-tick disperses load and typically converges in O(log N) rounds, faster still because gossip is multi-hop."}, {"id": "docs_src_content_docs_distributed_data_replication_subscribe", "label": "dd.subscribe \u2014 merge notification", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subscribers fire synchronously after every merge that changes the local value, so idempotent updates do not fire. Subscriptions are local: they observe the local replica, not the cluster-wide value."}, {"id": "docs_src_content_docs_distributed_data_replication_tombstoneretention", "label": "CRDT tombstones are never collected", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tombstones are kept permanently so a stale gossip cannot resurrect a removed key; accumulation is the practical cost to watch over a long-lived store with heavy churn."}, {"id": "docs_src_content_docs_distributed_data_replication_memberremovednoop", "label": "MemberRemoved needs no per-peer cleanup", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gossip holds no version vector and no per-peer receipt history \u2014 each tick picks a random peer from the current up-members, so a departed node simply stops being a target and a rejoining one needs no special handling."}, {"id": "docs_src_content_docs_distributed_data_replication_antientropyscaling", "label": "Anti-entropy gossip scaling", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All-to-all over time scales O(N) per node per round, so very large clusters may want a larger gossip interval or a different topology."}, {"id": "docs_src_content_docs_distributed_data_replication_partitiontolerance", "label": "Gossip does not bridge partitions", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "By design: CRDTs guarantee eventual convergence, not real-time delivery, so read flows should be written to work with stale data during a partition."}, {"id": "docs_src_content_docs_distributed_data_replication_slowpropagationdiagnosis", "label": "Diagnosing slow propagation", "file_type": "document", "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_distributed_data_replication_gossipreplication", "target": "docs_src_content_docs_distributed_data_replication_gossipinterval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_gossipreplication", "target": "docs_src_content_docs_distributed_data_replication_fullstategossip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_gossipreplication", "target": "docs_src_content_docs_distributed_data_replication_randompeerselection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_gossipreplication", "target": "docs_src_content_docs_distributed_data_replication_subscribe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_fullstategossip", "target": "docs_src_content_docs_distributed_data_replication_gossipinterval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_memberremovednoop", "target": "docs_src_content_docs_distributed_data_replication_tombstoneretention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_memberremovednoop", "target": "docs_src_content_docs_distributed_data_replication_randompeerselection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_antientropyscaling", "target": "docs_src_content_docs_distributed_data_replication_gossipinterval", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/distributed-data/replication.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_distributed_data_replication_partitiontolerance", "target": "docs_src_content_docs_distributed_data