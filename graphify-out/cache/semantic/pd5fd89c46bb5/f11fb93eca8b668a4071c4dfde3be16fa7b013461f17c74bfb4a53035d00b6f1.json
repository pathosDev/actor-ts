{"nodes": [{"id": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_cockroachdb", "label": "CockroachDB service", "file_type": "code", "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "start-single-node --insecure: a throwaway test instance, and insecure mode is what lets the runner connect with sslmode=disable. The healthcheck runs a real SELECT 1 because the SQL layer accepts connections only after the node finishes initializing - a stronger gate than an open port."}, {"id": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_runner", "label": "CockroachDB runner service", "file_type": "code", "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PG_URL postgres://root@cockroachdb:26257/defaultdb?sslmode=disable with WIRE_LABEL cockroachdb; defaultdb and root exist out of the box in insecure mode."}, {"id": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_sqlstate_23505_backstop", "label": "SQLSTATE 23505 concurrency backstop", "file_type": "rationale", "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No new backend - the existing Postgres stores run against CockroachDB. The point is to certify the wire-compatibility claim rather than assert it, and in particular that the journal's optimistic-concurrency backstop still fires, since it matches on SQLSTATE 23505 rather than on message text."}], "edges": [{"source": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_runner", "target": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_cockroachdb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_sqlstate_23505_backstop", "target": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_runner", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_runner", "target": "src_persistence_journals_postgresjournal_postgresjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_sqlstate_23505_backstop", "target": "src_persistence_relational_postgresdialect_postgresdialect", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_cockroachdb_docker_compose_cockroachdb_cockroachdb", "target": "tests_integration_brokers_s3_docker_compose_s3_latest_tag_policy", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "tests/integration/brokers/cockroachdb/docker-compose.cockroachdb.yml", "source_location": null, "weight": 1.0}], "hyperedges": []}