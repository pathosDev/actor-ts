{"nodes": [{"id": "docs_src_content_docs_migration_from_orleans_from_orleans", "label": "From Microsoft Orleans", "file_type": "document", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_grain_to_sharded_entity", "label": "Grain to sharded-entity mapping", "file_type": "concept", "rationale": "Orleans grains are virtual \u2014 addressed by ID, auto-spawned on first message, auto-deactivated when idle; sharded entities are the closest analog. Method calls become message kinds plus handlers, Task<T> returns become explicit replyTo refs, and IGrainWithStringKey is implicit in extractEntityId.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_passivation", "label": "Passivation on idle", "file_type": "concept", "rationale": "Unlike an Orleans grain a sharded entity does NOT deactivate on its own \u2014 there is no default idle window, so it stays resident until passivationIdleMs (or something else) passivates it.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_activation_lifecycle", "label": "OnActivateAsync / OnDeactivateAsync mapping", "file_type": "concept", "rationale": "preStart and postStop map directly onto Orleans's activation and deactivation lifecycle methods.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_reminders", "label": "Orleans reminders have no direct equivalent", "file_type": "rationale", "rationale": "Reminders are durable timers; actor-ts timers do NOT survive restart, so a true durable reminder means persisting the schedule and re-arming it in onRecoveryComplete.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_streams", "label": "Orleans Streams map to DistributedPubSub", "file_type": "concept", "rationale": "Cluster-wide topic-based fan-out with no grain involvement replaces Orleans's push-based stream provider.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_cross_grain_transactions", "label": "Cross-grain transactions are not built in", "file_type": "rationale", "rationale": "Orleans has distributed transactions across grains; actor-ts does not, so the equivalent is a saga (PersistentFSM) with explicit compensation steps, or a two-phase-commit pattern.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_orleans_kubernetes_discovery", "label": "Kubernetes silo hosting to KubernetesApiSeedProvider", "file_type": "concept", "rationale": "UseKubernetesHosting becomes a KubernetesApiSeedProvider lookup feeding ClusterOptions seeds \u2014 a different API shape for the same idea of pod discovery leading to a cluster join.", "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_grain_to_sharded_entity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_passivation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_activation_lifecycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_reminders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_streams", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_cross_grain_transactions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-orleans.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_orleans_from_orleans", "target": "docs_src_content_docs_migration_from_orleans_kube