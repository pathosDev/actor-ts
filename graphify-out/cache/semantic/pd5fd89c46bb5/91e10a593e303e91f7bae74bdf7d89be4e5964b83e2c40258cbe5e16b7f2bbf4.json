{"nodes": [{"id": "docs_src_content_docs_persistence_journals_wire_compatible_cockroachdb_support", "label": "CockroachDB support", "file_type": "document", "rationale": "No CockroachJournal exists \u2014 PostgresJournal is pointed at the other server. Certified by test:integration:cockroachdb running the same contract as the Postgres suite.", "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_wire_compatible_yugabytedb_support", "label": "YugabyteDB (YSQL) support", "file_type": "document", "rationale": "Served by the unmodified Postgres stores; YSQL listens on 5433 rather than 5432, and the image takes noticeably longer to become ready (the runner waits up to three minutes).", "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_wire_compatible_sqlstate_matching_not_message_text", "label": "Match SQLSTATE, never message text", "file_type": "rationale", "rationale": "YugabyteDB is known to reword some Postgres error messages, so a text-matching concurrency backstop would have failed silently there \u2014 a real conflict surfacing as a generic error, the worst possible failure mode.", "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_wire_compatible_serialization_failure_head_recheck", "label": "Serialization-failure head re-check", "file_type": "rationale", "rationale": "Both engines run at SERIALIZABLE and abort the loser before it reaches the primary key, reporting 40001 where PostgreSQL reports 23505. An abort proves only that the engine picked a victim, not that anyone else wrote \u2014 so the stores re-read the head and report a conflict only if it actually moved, otherwise a lock-wait timeout would be relabelled as someone else's append and spin the caller against a head that never changes.", "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_wire_compatible_only_certified_surface", "label": "Only the certified surface is certified", "file_type": "rationale", "rationale": "The suites cover the persistence stores only \u2014 not the PersistenceQuery tag path, nor anything outside persistence. Neon, Timescale, AlloyDB and Aurora very likely work for the same reasons, but 'likely' is the word this page exists to remove, so they are not listed.", "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_journals_wire_compatible_cockroachdb_support", "target": "docs_src_content_docs_persistence_journals_postgres_postgresjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_wire_compatible_yugabytedb_support", "target": "docs_src_content_docs_persistence_journals_postgres_postgresjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_wire_compatible_serialization_failure_head_recheck", "target": "docs_src_content_docs_persistence_journals_postgres_sqlstate_23505_backstop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_wire_compatible_sqlstate_matching_not_message_text", "target": "docs_src_content_docs_persistence_journals_wire_compatible_yugabytedb_support", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_wire_compatible_serialization_failure_head_recheck", "target": "docs_src_content_docs_persistence_journals_wire_compatible_cockroachdb_support", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_journals_wire_compatible_only_certified_surface", "target": "docs_src_content_docs_persistence_journals_wire_compatible_cockroachdb_support", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}