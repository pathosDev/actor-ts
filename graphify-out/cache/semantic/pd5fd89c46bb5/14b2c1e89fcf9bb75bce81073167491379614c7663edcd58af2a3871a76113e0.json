{"nodes": [{"id": "docs_src_content_docs_de_observability_overview_four_pillars", "label": "Vier Saeulen der Observability", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": "Observability - Ueberblick", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs, Metriken, Tracing, Management. Logging laeuft immer; die anderen drei sind Extensions und laufen nicht, bis man danach greift - eine App, die sie ignoriert, hat keinen Overhead durch ungenutzte Metrik-Puffer oder nicht gestartete Trace-Exporter."}, {"id": "docs_src_content_docs_de_observability_overview_multisinklogger", "label": "MultiSinkLogger (withLogSinks)", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": "Logs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records werden einmal gebaut, an jeden Sink aufgefaechert dessen Level passt, ueber eine begrenzte Queue zugestellt und beim Terminieren geflusht. Ein kaputtes Ziel reisst weder die anderen Sinks noch die Anwendung mit."}, {"id": "docs_src_content_docs_de_observability_overview_otlp_first", "label": "Fang mit OTLP an", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": "Welcher Sink?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Endpunktformat erreicht Loki 3+, Parseable, SigNoz, Datadog, Axiom, Honeycomb, New Relic und jeden OTel-Collector - ein plattformspezifischer Sink lohnt sich nur dort, wo OTLP nicht hinkommt oder etwas verliert (Graylog nur gRPC, Sentrys Gruppierung ist das Produkt). journald und das Windows Event Log fehlen bewusst: beide erreicht man mit NDJSON nach stdout, was der Console-Sink schon tut."}, {"id": "docs_src_content_docs_de_observability_overview_managementroutes", "label": "managementRoutes", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": "Management-Endpunkte", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Startet einen kleinen HTTP-Server getrennt vom App-Server mit /health, /ready, /cluster/members, /cluster/shards und optional /metrics."}, {"id": "docs_src_content_docs_de_observability_overview_wiring_order", "label": "Was zuerst verdrahten", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": "Was zuerst verdrahten", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs an einen dauerhaften Ort zuerst (am schnellsten eingerichtet und das Erste, wonach nach einem Vorfall gefragt wird), dann Metriken, dann Health Checks, Tracing zuletzt - es ist aufwendiger (Exporter, Sampling, Kosten) und bringt abnehmenden Grenznutzen fuer einfache Apps."}], "edges": [{"source": "docs_src_content_docs_de_observability_overview_four_pillars", "target": "docs_src_content_docs_de_observability_overview_multisinklogger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_overview_four_pillars", "target": "docs_src_content_docs_de_observability_metrics_core_metrics_metricsextension", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_observability_overview_four_pillars", "target": "docs_src_content_docs_de_observability_tracing_tracer_api_tracer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/observability/overview.mdx", "source_lo