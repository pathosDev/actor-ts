{"nodes": [{"id": "docs_src_content_docs_io_nats_nats", "label": "NATS", "file_type": "document", "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_nats_natsactor", "label": "NatsActor", "file_type": "concept", "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_nats_subscriptions_and_reconnects", "label": "NATS subscriptions across reconnects", "file_type": "concept", "rationale": "Configured subscriptions and the runtime subscribe command feed the SAME desired set held by the BrokerActor base, so every subscription is re-established on the new connection, one sent while disconnected applies on the next connect, unsubscribe removes a subject for good, and re-subscribing a live subject swaps its target so exactly one actor receives it. This is about the subscription, not the messages \u2014 core NATS has no durability.", "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_nats_subjects", "label": "NATS subjects and wildcards", "file_type": "concept", "rationale": "Dot-delimited, case-sensitive subjects; * matches exactly one token and > one or more, and > can only appear as the last token.", "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_nats_request_reply", "label": "NATS request/reply over a reply subject", "file_type": "concept", "rationale": "There is no dedicated request command \u2014 you compose it from publish/subscribe and the replyTo field. You manage reply subjects yourself, which under 10K+ concurrent requests means many temporary subjects and subscriptions to unsubscribe as replies land.", "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_nats_core_nats_no_durability", "label": "Core NATS has no durability", "file_type": "rationale", "rationale": "Core NATS does not queue messages for offline subscribers \u2014 a disconnected subscriber loses in-flight messages. For durable delivery, use JetStream.", "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_io_nats_nats", "target": "docs_src_content_docs_io_nats_natsactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_nats_nats", "target": "docs_src_content_docs_io_nats_subscriptions_and_reconnects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_nats_nats", "target": "docs_src_content_docs_io_nats_subjects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_nats_nats", "target": "docs_src_content_docs_io_nats_request_reply", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/nats.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_nats_nats", "target": "docs_src_content_docs_io_nats_core_nats_no_durability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "sou