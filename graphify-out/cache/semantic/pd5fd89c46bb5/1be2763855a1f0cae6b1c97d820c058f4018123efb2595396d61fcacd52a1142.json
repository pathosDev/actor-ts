{"nodes": [{"id": "docs_src_content_docs_cluster_transports_transport_interface", "label": "Transport interface", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small surface (bootstrap, send, receive, disconnect) so cluster behaviour is identical regardless of which implementation is plugged in; the cluster plugs in a handler and gets inbound wire messages with their sender address."}, {"id": "docs_src_content_docs_cluster_transports_tcptransport", "label": "TcpTransport", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The production transport and the only one that serialises at all, so exercising the real framing round-trip over a tagged JSON tree needs it over loopback; it listens, connects on demand and auto-reconnects on the next send after a drop."}, {"id": "docs_src_content_docs_cluster_transports_inmemorytransport", "label": "InMemoryTransport", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A process-global registry keyed by NodeAddress routes messages directly to the recipient's handler: no sockets, no bytes. It simulates neither network failure, nor latency, nor serialization, and its peers() reports every registered transport regardless of connection state."}, {"id": "docs_src_content_docs_cluster_transports_tcpbackend", "label": "TcpBackend per-runtime adapter", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TcpTransport never talks to the OS directly: bunTcpBackend, nodeTcpBackend and denoTcpBackend are selected by getTcpBackend() so the same transport works on every runtime."}, {"id": "docs_src_content_docs_cluster_transports_frame_size_cap", "label": "Per-frame size cap", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 16 MiB, rejecting larger frames to prevent a DoS via a faked length prefix; raising it does not improve general throughput, it only admits individually large messages, and large data belongs in a side channel with references passed instead."}, {"id": "docs_src_content_docs_cluster_transports_optional_tls", "label": "Optional TLS on the cluster wire", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All-or-nothing per cluster; plain TCP is unauthenticated by default, which is fine inside a private network and not on any internet-facing link."}, {"id": "docs_src_content_docs_cluster_transports_multiplexing", "label": "Single-connection multiplexing", "file_type": "rationale", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gossip, heartbeats, application envelopes and subsystem traffic share one TCP stream with no priority routing, so bulk traffic and failure detection compete; explicit isolation would need a custom transport with per-channel framing."}, {"id": "docs_src_content_docs_cluster_transports_messagechanneltransport", "label": "MessageChannelTransport", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worker-thread clusters in a single OS process (the worker-mesh pattern); it hands the envelope to postMessage rather than serialising it itself."}, {"id": "docs_src_content_docs_cluster_transports_peers_readiness", "label": "peers() cluster-transport readiness check", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A node with members it still expects and no connection to any of them is cut off, so /ready answers 503 and a load balancer stops routing to it; a test written against InMemoryTransport cannot observe that check failing."}], "edges": [{"source": "docs_src_content_docs_cluster_transports_tcptransport", "target": "docs_src_content_docs_cluster_transports_transport_interface", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_inmemorytransport", "target": "docs_src_content_docs_cluster_transports_transport_interface", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_messagechanneltransport", "target": "docs_src_content_docs_cluster_transports_transport_interface", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_tcptransport", "target": "docs_src_content_docs_cluster_transports_tcpbackend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_tcptransport", "target": "docs_src_content_docs_cluster_transports_frame_size_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_tcptransport", "target": "docs_src_content_docs_cluster_transports_optional_tls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_tcptransport", "target": "docs_src_content_docs_cluster_transports_multiplexing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_transport_interface", "target": "docs_src_content_docs_cluster_transports_peers_readiness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_inmemorytransport", "target": "docs_src_content_docs_cluster_transports_peers_readiness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_transports_multiplexing", "target": "docs_src_content_docs_cluster_transports_frame_size_cap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/transports.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_conte