{"nodes": [{"id": "devtools_ui_index_devtools_document", "label": "DevTools host document", "file_type": "document", "source_file": "devtools-ui/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devtools_ui_index_relative_asset_references", "label": "Relative asset references and baseHref './'", "file_type": "rationale", "source_file": "devtools-ui/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same document has to work at the server root (DevTools.attach) and under a mount prefix (DevTools.mount('/devtools')); the default base pins to the server root and would break the mounted case, so the build asserts both that the base is not root-anchored and that no asset reference is (#483)."}, {"id": "devtools_ui_index_base_tag_comment_hazard", "label": "No literal base tag inside the comment", "file_type": "rationale", "source_file": "devtools-ui/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The builder reads the whole document, comments included, so a base element spelled out in prose is found and used instead of the injected one; that is how the wrong value shipped once already."}, {"id": "devtools_ui_index_devtools_root", "label": "devtools-root element", "file_type": "concept", "source_file": "devtools-ui/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "devtools_ui_index_devtools_document", "target": "devtools_ui_index_devtools_root", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "devtools-ui/index.html", "source_location": null, "weight": 1.0}, {"source": "devtools_ui_index_devtools_document", "target": "devtools_ui_index_relative_asset_references", "relation": "references", "confidence": "E