{"nodes": [{"id": "readme_actor_ts", "label": "actor-ts framework", "file_type": "document", "rationale": "Batteries-included actor-model runtime for TypeScript on Bun, Node and Deno; explicitly a pre-1.0, AI-assisted hobby project that is not battle-tested, so it is documented as unsuitable for production data.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_actors", "label": "Actors (mailbox, lifecycle, supervision)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cluster", "label": "Cluster (gossip, failure detection, split-brain resolvers)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cluster_sharding", "label": "Cluster sharding", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cluster_singleton", "label": "Cluster singleton", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_distributed_data", "label": "Distributed Data (nine CRDTs)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_persistence", "label": "Persistence (PersistentActor, DurableState, projections)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_object_storage", "label": "Object storage (S3 / MinIO / R2 / filesystem)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_http", "label": "HTTP directive routing DSL", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_websocket", "label": "Typed WebSocket routes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_message_brokers", "label": "Message brokers (BrokerActor)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_caching", "label": "Pluggable Cache", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_typed_options", "label": "Typed options with fail-fast validation", "file_type": "rationale", "rationale": "One fluent XOptions builder (or plain object) per configurable thing, validated once on the merged settings, so a bad port, timeout or URL throws OptionsError at startup rather than deep in a later code path.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_utility_primitives", "label": "Utility primitives (Option, Try, Either, BidirectionalMap)", "file_type": "concept", "rationale": "BidirectionalMap and BidirectionalMultiMap survive a snapshot as real instances, so no user-written adapter is needed; the random-id helpers take an exists predicate so 'redraw until free' is the call itself.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dead_letters", "label": "Dead letters and dead-letter queue", "file_type": "concept", "rationale": "Every undeliverable message is published on the event stream; the opt-in queue is bounded or journal-backed and capped on replay so a poison message cannot be retried into an ever-growing queue.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_observability", "label": "Observability (Prometheus, OTel, management endpoints)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_multi_sink_logging", "label": "Multi-sink logging", "file_type": "concept", "rationale": "One record fans out to several destinations, each with its own minimum level, bounded queues and a flush on shutdown; every platform integration is dependency-free and a transform hook redacts once, before fan-out.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_devtools", "label": "DevTools embedded web UI", "file_type": "concept", "rationale": "Vanilla TypeScript bundled into the package - no UI framework, no CDN; loopback-only and unauthenticated by default, and it refuses a routable bind without a gate.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_testkit", "label": "TestKit (TestProbe, ManualScheduler, MultiNodeSpec)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ask_pattern", "label": "Ask pattern (request / response)", "file_type": "concept", "rationale": "The framework spawns a one-shot reply actor and wires it as both replyTo and context.sender, so a typed reply with a timeout needs no protocol of its own.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_runtime_abstractions", "label": "src/runtime portability abstractions", "file_type": "rationale", "rationale": "Runtime-specific backends (TCP sockets, worker threads, SQLite, HTTP serve) live behind small abstractions that auto-detect at startup, so the same file runs unchanged under bun, node and deno.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ts_pattern_messages", "label": "Discriminated-union messages with ts-pattern", "file_type": "concept", "rationale": "match().exhaustive() turns a missing variant arm into a compile error; command dispatch delegates every arm to an onXxx handler while a fold that computes a value stays inline.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_skip_flaky_mns", "label": "ACTOR_TS_SKIP_FLAKY_MNS", "file_type": "rationale", "rationale": "Bun on GitHub's hosted runners cannot respawn functional worker threads after the first worker test, so LeaseMajority, ParallelPubSub and ParallelMultiNodeSpec are skipped in CI and re-run nightly with the flag off.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_examples_chat", "label": "examples/chat sample application", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_examples_voice", "label": "examples/voice sample application", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_displayname", "label": "Actor.displayName()", "file_type": "concept", "rationale": "A label, not an address: it joins the log line and the DevTools tree beside the path, never in place of it, so metrics, tracing and every wire identifier stay on the path.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shardkey", "label": "ShardKey entity identity declaration", "file_type": "concept", "rationale": "The actor class declares its own shard identity, so neither the type name nor the entity-id extractor is repeated at the call site.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_actor_ts", "target": "readme_actors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_actor_ts", "target": "readme_cluster", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_actor_ts", "target": "readme_persistence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_actor_ts", "target": "readme_http", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_actor_ts", "target": "readme_caching", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_actor_ts", "target": "readme_devtools", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_