{"nodes": [{"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_unbounded_default", "label": "Unbounded ist der ehrliche Default", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Actor-Framework kann nicht wissen, welche Nachricht entbehrlich ist - eine zu begrenzen ist die Entscheidung, Nachrichten zu verlieren, und die faellt dort, wo jemand sagen kann, welche verzichtbar sind."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_historie_v010_v015", "label": "v0.10 bis v0.15: pauschal 10 000 mit drop-head", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein zurueckfallender Actor verlor still seine aelteste Nachricht - fuer einen Sensorwert richtig, fuer ein Terminated, eine Delivery-Bestaetigung oder ein WebSocket-close falsch; alle drei liefen durch dieselbe Queue und aus jedem wurde ein gemeldeter Defekt. Die Obergrenze, die der Handel erkaufte, gab es ohnehin nicht: nur die User-Queue war begrenzt."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_backlog_warnung", "label": "Backlog-Warnung ab 10 000, erneut bei jeder Verdopplung", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laeuft immer, ohne Metrik-Stack; mit Metriken meldet actor_mailbox_size ab derselben Marke - der Fehlermodus einer unbegrenzten Queue kuendigt sich also lange vorher an."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_boundedmailbox", "label": "BoundedMailbox", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drei Muster rechtfertigen einen Bound: vorab bekannter Producer/Consumer-Mismatch (reject), telemetrieartige Actors mit veraltenden Daten (drop-head) und kritische Actors nahe an Limits (drop-new)."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_overflow_policies", "label": "Overflow-Policies: reject / drop-head / drop-new", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waehlen nach der richtigen Antwort auf Overflow - Sender soll retryen: reject; veraltete Daten sind falsch: drop-head; eingereihte Arbeit ist wertvoll: drop-new. Es gibt kein Bestes."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_kapazitaet_waehlen", "label": "Kapazitaet waehlen", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drei Faktoren: Worst-Case-Burst-Groesse, Speicher pro Nachricht (capacity x bytes) und Latenzbudget (capacity / drain_rate). Kapazitaeten unter der natuerlichen Burst-Groesse schaden, weil reject bei normalem Traffic feuert - bei ~10x der Steady-State-Ankunftsrate starten."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_prioritymailbox", "label": "PriorityMailbox", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Niedrigere Zahlen sind hoehere Prioritaet, System-Nachrichten uebertrumpfen immer; fuer gemischte Dringlichkeit wie HTTP-Antworten gegen Batch-Jobs."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_drop_lowest_priority", "label": "drop-lowest-priority", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "drop-head fehlt mit Absicht, denn der Kopf einer Priority-Queue ist die Nachricht, die man als wichtigste bezeichnet hat; drop-lowest-priority wirft vom anderen Ende ab - die dringende Schicht ueberlebt, die Bulk-Schicht zahlt."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_prioritaet_und_bound", "label": "Prioritaet und ein Bound zugleich", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "withMailbox und withMailboxCapacity lassen sich nicht kombinieren, die Capacity liegt also auf PriorityMailboxOptions; eine Nachricht, deren priorityFor nicht auswertbar ist, wird zuletzt rangiert und damit als erste abgeworfen - ein defekter Callback zeigt sich als steigendes drop-new, nicht als Fehler (onPriorityError verdrahten)."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_terminated_spur", "label": "Terminated laeuft auf einer Spur, die keine Policy abwerfen kann", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Schranke kostet den Actor seinen Backlog, nie die Tode, auf die er wartet; ebenso das Kommando, das den Actor einer WebSocket-Verbindung spawnt - ein begrenzter Hub kann also keinen Socket mehr stranden lassen, dessen Handshake schon fertig war."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_tiefe_kein_durchsatzproblem", "label": "Tiefe ist kein Durchsatzproblem", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beide Queues sind Ring-Buffer - die naechste Nachricht zu entnehmen rueckt einen Index vor, eine Queue von einer Million kostet pro Nachricht dasselbe wie eine von zehn. Was eine tiefe Queue kostet, ist Speicher und Latenz, und keiner der beiden Gruende wird durch eine schnellere Queue behoben."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_backpressure_design", "label": "Die Mailbox ist eine Ebene der Backpressure-Story", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ende-zu-Ende braucht Bounded Mailbox plus Sender-Retry-Logik plus Upstream-Rate-Limiting; die Mailbox erzwingt die lokale Grenze, der Rest ist Protokoll-Design."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_pauschales_begrenzen_falle", "label": "Pauschales Begrenzen jedes Actors", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pauschal angewandt trifft der Bound Actors, die niemand beurteilt hat - einen Delivery-Producer, einen WebSocket-Hub - und der verworfene Envelope ist eine Kontrollnachricht. Genau das soll der unbounded Default verhindern."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_langsame_handler", "label": "Mailbox-Sizing fixt keine langsamen Handler", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein Bound verhindert einen Actor, dessen Handler zu langsam ist - erst die Handler-Latenz fixen, dann die Mailbox bounden."}, {"id": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_metriken_lesen", "label": "Die Mailbox-Metriken lesen", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wait ist das fruehere Signal und das, auf das alarmiert wird; depth ist die Verteilung, aus der eine Kapazitaet abgeleitet wird (p99 misst den Ausschlag, auf den eine capacity wettet); size traegt den path und sagt wer; dropped_total ist pro Klasse."}], "edges": [{"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_historie_v010_v015", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_unbounded_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_backlog_warnung", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_unbounded_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_terminated_spur", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_historie_v010_v015", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_tiefe_kein_durchsatzproblem", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_unbounded_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_boundedmailbox", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_overflow_policies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_kapazitaet_waehlen", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_boundedmailbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_prioritymailbox", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_drop_lowest_priority", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_prioritaet_und_bound", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_prioritymailbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_drop_lowest_priority", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_overflow_policies", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_backpressure_design", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_overflow_policies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_pauschales_begrenzen_falle", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_unbounded_default", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_pauschales_begrenzen_falle", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_terminated_spur", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_langsame_handler", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_kapazitaet_waehlen", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_metriken_lesen", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_kapazitaet_waehlen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_metriken_lesen", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_actor_mailbox_size", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_metriken_lesen", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_actor_mailbox_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_metriken_lesen", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_actor_mailbox_wait_seconds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_metriken_lesen", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_actor_mailbox_dropped_total", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_backlog_warnung", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_meldeschwelle_10000", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_overflow_policies", "target": "docs_src_content_docs_de_operations_tuning_dispatcher_tuning_per_actor_throughput", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_langsame_handler", "target": "docs_src_content_docs_de_operations_tuning_dispatcher_tuning_messen_wait_vs_handler", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_terminated_spur", "target": "docs_src_content_docs_de_io_broker_actor_base_terminated_arm", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/de/operations/tuning/mailbox-sizing.mdx", "source_location": null, "weight": 1}], "hyperedges": []}