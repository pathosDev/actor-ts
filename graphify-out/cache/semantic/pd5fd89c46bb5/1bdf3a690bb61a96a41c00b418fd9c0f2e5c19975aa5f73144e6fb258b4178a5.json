{"nodes": [{"id": "docs_src_content_docs_persistence_journals_in_memory_inmemoryjournal", "label": "InMemoryJournal", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_in_memory_inmemorysnapshotstore", "label": "InMemorySnapshotStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_in_memory_journal_contract", "label": "Journal contract (append/read/highestSeq/delete/persistenceIds)", "file_type": "document", "source_file": "docs/src/content/docs/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_in_memory_journaleventbus", "label": "JournalEventBus", "file_type": "document", "rationale": "Only in-process journals publish it; every append publishes the event so push-based queries work in real time without polling. Cross-process backends have no bus, so live subscribers fall back to polling.", "source_file": "docs/src/content/docs/persistence/journals/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_journals_in_memory_reference_semantics", "label": "Reference semantics for every journal", "file_type": "rationale", "rationale": "InMemoryJournal is the reference implementation every other journal must match \u2014 append-only, monotonic sequence numbers, exact-once delivery to subscribers, concurrency check on the expected sequence. Swapping to a real journal is one line because the Journal interface is unchanged."