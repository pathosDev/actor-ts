{"nodes": [{"id": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "label": "From vanilla TypeScript", "file_type": "document", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_vanilla_ts_pattern_shared_mutable_state", "label": "Pattern 1 \u2014 shared mutable state with concurrent writers", "file_type": "concept", "rationale": "Any await releases the loop, so between persistToDB and Map.set another call for the same id can pass the has() check. An actor processes commands one at a time, so the second command sees the first one's state and skips \u2014 no locks, no in-flight sets.", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_vanilla_ts_pattern_eventemitter", "label": "Pattern 2 \u2014 EventEmitter and handlers", "file_type": "concept", "rationale": "EventEmitter gives no supervision, fiddly listener typing, and no path to cluster distribution; typed messages to listener actors make events type-safe and put error handling in the supervisor strategy instead of listener-on-error gymnastics.", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_vanilla_ts_pattern_background_loop", "label": "Pattern 3 \u2014 background loop with mutable state", "file_type": "concept", "rationale": "A setInterval object mixes state and scheduled work: reads race mid-update, a throwing ping silently breaks the catch-less loop, and there is no clean way to reset it. As an actor, tick runs serialized with get-status, the timer auto-cancels on stop, and a fresh preStart re-arms it after a supervised restart.", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_vanilla_ts_pattern_saga", "label": "Pattern 4 \u2014 saga / multi-step coordination", "file_type": "concept", "rationale": "Nested try/catch buries compensations and cannot answer what happens when the refund itself fails. Event-sourcing each step before the next lets a crash mid-saga recover by replay, and persisting compensation state makes partial-compensation crashes recover too. Worth it when the saga spans seconds to minutes, compensations touch real money or inventory, or you would otherwise reach for a workflow engine.", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_vanilla_ts_what_you_give_up", "label": "What vanilla-TS migrants give up", "file_type": "rationale", "rationale": "Async stack traces lose the caller's context (mitigate with LogContext MDC and a propagated requestId); reading state from outside an actor costs a message round-trip, so high-volume reads want a read-side projection; and ORMs, SDKs and validation libraries are all Promise-based, so boundary code often reads better vanilla. Actors are most valuable for the stateful CORE of the domain.", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_vanilla_ts_staged_adoption", "label": "Staged adoption strategy", "file_type": "concept", "rationale": "Start with one stateful concept as a PersistentActor, convert setInterval work to context.timers, add cross-process distribution when single-process is not enough, then add event-sourcing for workflows needing recovery. Each step is independently valuable and you can stop at any of them.", "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_migration_from_vanilla_ts_pattern_shared_mutable_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_migration_from_vanilla_ts_pattern_eventemitter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_migration_from_vanilla_ts_pattern_background_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_migration_from_vanilla_ts_pattern_saga", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_migration_from_vanilla_ts_what_you_give_up", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_migration_from_vanilla_ts_staged_adoption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_intro_quickstart_quickstart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_from_vanilla_ts", "target": "docs_src_content_docs_intro_why_actors_why_actors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_what_you_give_up", "target": "docs_src_content_docs_migration_from_vanilla_ts_staged_adoption", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_vanilla_ts_pattern_saga", "target": "docs_src_content_docs_migration_from_akka_jvm_persistentactor_translation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/migration/from-vanilla-ts.mdx", "source_location": null, "weight": 1}], "hyperedges": []}