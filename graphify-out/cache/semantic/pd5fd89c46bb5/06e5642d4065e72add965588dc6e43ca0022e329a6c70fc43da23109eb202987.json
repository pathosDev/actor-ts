{"nodes": [{"id": "docs_src_content_docs_fundamentals_receive_timeout_receive_timeout", "label": "Receive timeout", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires on the absence of traffic rather than on a schedule; it re-arms after delivery, so an actor that ignores it keeps receiving one every ms until cancelled."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "label": "context.setReceiveTimeout(ms)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_cancelreceivetimeout", "label": "context.cancelReceiveTimeout()", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_receivetimeout_instance", "label": "ReceiveTimeout.instance singleton", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A singleton, so identity comparison is reliable; it is delivered through the ordinary user-message path, which means a backed-up mailbox delays it and restart resets the timer."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_session_expiry", "label": "Session-expiry pattern", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_passivation", "label": "Receive-timeout-driven passivation", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_watchdog", "label": "Watchdog for downstream silence", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_user_messages_only", "label": "Only user messages reset the timer", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System messages do not count, so an actor receiving a stream of Terminated from many watched children still times out; become() does not affect the window either, so re-arm explicitly for phase-specific durations."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_no_diagnostic_context", "label": "ReceiveTimeout carries no diagnostic context", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The handler runs with the MDC empty rather than under the last real message context, and a tell from it carries nothing either. You never arm this timer yourself \u2014 the framework re-arms it after every message \u2014 so there is no call site at which the context could have been cleared. Idleness belongs to no request."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_not_a_ticker", "label": "Receive timeout is not a heartbeat ticker", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It fires when the inbox is silent, not on a fixed schedule; sub-second timeouts are usually a sign the wrong tool was picked, because a busy mailbox means the window rarely elapses."}], "edges": [{"source": "docs_src_content_docs_fundamentals_receive_timeout_receive_timeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_cancelreceivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_receive_timeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_receivetimeout_instance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_receive_timeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_user_messages_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_receive_timeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_session_expiry", "relation":