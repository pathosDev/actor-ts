{"nodes": [{"id": "docs_src_content_docs_de_operations_tuning_gossip_cadence_gossipintervalms", "label": "gossipIntervalMs", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/tuning/gossip-cadence.mdx", "source_location": "Gossip-Kadenz", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alle gossipIntervalMs waehlt jedes Mitglied einen zufaelligen erreichbaren Peer und tauscht seine Membership-Sicht aus. Default 1 s; senken fuer latenz-sensitiven Failover in kleinen Clustern, anheben bei 20+ Nodes (Gossip-Volumen waechst clusterweit O(N^2)) oder bandbreiten-beschraenkten WAN-Links."}, {"id": "docs_src_content_docs_de_operations_tuning_gossip_cadence_gossip_timing_interactions", "label": "Wechselwirkung der Gossip-Kadenz mit anderen Timings", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/gossip-cadence.mdx", "source_location": "Wechselwirkung mit anderen Timings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein langsameres Intervall verlangsamt alles mit: Konvergenz nach join direkt, Unreachable-Detection indirekt (Gossip traegt Last-Seen-Zeiten), Sharding-Rebalance, DistributedPubSub-Topic-Propagation und die Receptionist-Registry."}, {"id": "docs_src_content_docs_de_operations_tuning_gossip_cadence_asymmetric_gossip_values", "label": "Asymmetrische Gossip-Werte ueber Nodes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/tuning/gossip-cadence.mdx", "source_location": "Asymmetrische Werte ueber Nodes hinweg", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jeder Node nutzt sein eigenes Intervall zum SENDEN, empfaengt aber in der Kadenz, in der die Peers senden - asymmetrische Werte erzeugen verwirrendes Konvergenzverhalten."}], "edges": [{"source": "docs_src_content_docs_de_operations_tuning_gossip_cadence_gossipintervalms", "target": "doc