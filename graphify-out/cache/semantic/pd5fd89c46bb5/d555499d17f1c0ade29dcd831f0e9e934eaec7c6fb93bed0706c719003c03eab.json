{"nodes": [{"id": "docs_src_content_docs_intro_installation_installation", "label": "Installation", "file_type": "document", "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_installation_runtime_requirements", "label": "Runtime requirements (Bun 1.3 / Node 24 / Deno 2.2)", "file_type": "concept", "rationale": "Node 24 is the floor because Node 20 reached end-of-life in April 2026 and the framework relies on natively-shipped WebSocket, zstd, WebCrypto and fetch; Deno 2.2 is required only because node:sqlite lands there.", "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_installation_optional_peer_dependencies", "label": "Optional peer dependencies", "file_type": "rationale", "rationale": "Keeping the core install to two runtime deps means a chat sample pulls a handful of MB; a Kafka user adds kafkajs themselves, an S3 user adds @aws-sdk/client-s3. No bundle bloat for features you do not use. Nothing is auto-loaded \u2014 the extension throws a clear 'missing peer dep' error instead.", "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_installation_noimplicitoverride", "label": "noImplicitOverride requirement", "file_type": "rationale", "rationale": "The framework relies on noImplicitOverride to catch lifecycle-method-typo bugs \u2014 writing onRecieve instead of onReceive compiles silently without it.", "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_installation_hono_node_ws_floor", "label": "@hono/node-ws >= 1.2.0 floor", "file_type": "rationale", "rationale": "The floor is real: the transport frame cap is written onto the ws server only 1.2.0 and newer expose, so older versions are refused rather than served uncapped.", "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_intro_installation_installation", "target": "docs_src_content_docs_intro_installation_runtime_requirements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_installation_installation", "target": "docs_src_content_docs_intro_installation_optional_peer_dependencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_installation_installation", "target": "docs_src_content_docs_intro_installation_noimplicitoverride", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_installation_installation", "target": "docs_src_content_docs_intro_installation_hono_node_ws_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/installation.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_installation_installation", "target": "docs_src_content_docs_intro_quickstart_quickstart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/installation.mdx", "