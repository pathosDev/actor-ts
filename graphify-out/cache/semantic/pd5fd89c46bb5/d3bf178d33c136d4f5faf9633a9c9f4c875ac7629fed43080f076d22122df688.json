{"nodes": [{"id": "docs_src_content_docs_operations_security_tls_everywhere_tls_everywhere", "label": "TLS everywhere", "file_type": "document", "rationale": "A catalog of every network surface with its own TLS knobs - cluster transport, HTTP, management endpoint, broker actors, persistence backends - and what certificate material each needs.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_cluster_transport_tls", "label": "Cluster transport TLS configuration", "file_type": "concept", "rationale": "TcpTransport takes cert, key, ca and rejectUnauthorized for mutually-authenticated TLS between nodes; defence in depth applies even on internal networks.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_cert_material_not_path", "label": "TLS fields take material, never a path", "file_type": "rationale", "rationale": "Nothing in the transport touches the filesystem and none of Bun, Node or Deno accepts a filename in these fields, so the example reads the files itself.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_http_server_tls", "label": "HTTP server TLS", "file_type": "concept", "rationale": "HTTPS at the application layer via the Fastify backend https option; often terminated at the load balancer instead, so pick by your infrastructure shape.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_management_endpoint_tls", "label": "Management endpoint TLS", "file_type": "concept", "rationale": "The management server is internal-only by default, but TLS still protects against lateral movement in a compromised network and is required by some compliance regimes regardless of topology.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_broker_tls_catalog", "label": "Broker actor TLS knobs", "file_type": "concept", "rationale": "Each broker exposes its own shape: Kafka withSsl plus SASL, MQTT via mqtts, AMQP via amqps, NATS mTLS through the driver, Redis Streams via rediss, gRPC credentials, WebSocket via wss.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_persistence_backend_tls", "label": "Persistence backend TLS", "file_type": "concept", "rationale": "SQLite is local-file so TLS does not apply; Cassandra mTLS is configured on the driver client passed via withClient; cloud object storage always uses TLS with no extra configuration.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_cert_provisioning", "label": "Certificate provisioning patterns", "file_type": "concept", "rationale": "cert-manager auto-renews before expiry in Kubernetes, Vault Agent pulls certs into the pod filesystem as a sidecar, and non-K8s environments fall back to scheduled cron pulls plus restarts.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_security_tls_everywhere_per_component_certificates", "label": "Separate certificates per component", "file_type": "rationale", "rationale": "One wildcard cert for everything combines the blast radius; different certs for cluster, HTTP and brokers keep a compromised cert contained.", "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_operations_security_tls_everywhere_tls_everywhere", "target": "docs_src_content_docs_operations_security_tls_everywhere_cluster_transport_tls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_security_tls_everywhere_tls_everywhere", "target": "docs_src_content_docs_operations_security_tls_everywhere_cert_material_not_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_security_tls_everywhere_tls_everywhere", "target": "docs_src_content_docs_operations_security_tls_everywhere_http_server_tls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/security/tls-everywhere.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_security_tls_everywhere_tls_everywhere", "target": "docs_src_content_docs_operations_security_tls_everywhere_manage