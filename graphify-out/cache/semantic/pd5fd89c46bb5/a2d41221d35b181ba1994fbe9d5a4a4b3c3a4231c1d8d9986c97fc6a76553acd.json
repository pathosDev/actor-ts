{"nodes": [{"id": "docs_src_content_docs_de_testing_testkit_testkit", "label": "TestKit", "file_type": "concept", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Duenner Convenience-Wrapper um ActorSystem mit Test-Defaults. Rohes ActorSystem.create funktioniert genauso und liest sich bei komplexen Setups (eigener Logger, mehrere Systeme, spezifische Extensions) manchmal klarer.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_testkitoptions", "label": "TestKitOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "extends ActorSystemOptionsType mit quiet (Default true). withQuiet(false) plus LogLevel gibt Konsolen-Logs zum Debuggen eines fehlschlagenden Tests.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_createtestprobe", "label": "tk.createTestProbe(options?)", "file_type": "concept", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Gibt eine auf das System dieses Kits gescopte Probe zurueck, damit das System nicht durch jeden Probe-Konstruktor gefaedelt werden muss.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_within", "label": "tk.within(durationMs, callback)", "file_type": "concept", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Weiche Deadline: der Callback laeuft auch bei Ueberziehen zu Ende und wirft nur im Nachhinein \u2014 fuer SLA-artige Assertions, ohne vom Per-Test-Timeout des Runners abzuhaengen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_shutdown", "label": "tk.shutdown()", "file_type": "concept", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Immer im Fixture-Teardown aufrufen \u2014 ohne ihn leakt der Test-Prozess ein lebendes System, das die Event-Loop am Leben haelt; manche Runner erkennen das und lassen die Suite fehlschlagen, andere haengen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_withmanualscheduler", "label": "TestKit.withManualScheduler()", "file_type": "concept", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Gibt Kit und ManualScheduler zurueck, damit der Test virtuelle Zeit voranbringen kann.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_quiet_default", "label": "Leises Logging als Default (NoopLogger)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Log-Aufrufe sind No-Ops, was die Test-Ausgabe sauber haelt; einschalten nur zum Debuggen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_testing_testkit_fixture_patterns", "label": "Fixture-Muster (per-Test vs geteilt)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/testing/testkit.mdx", "rationale": "Ein frisches Kit pro Test kostet etwas Zeit, ist die Isolation aber wert; ein geteiltes Fixture ist schneller und nur sicher, wenn Tests keine geteilten Actor mutieren. Eindeutige System-Namen vermeiden Cluster-Identitaets-Konflikte.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_testing_testkit_testkit", "target": "docs_src_content_docs_de_testing_testkit_testkitoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_sc