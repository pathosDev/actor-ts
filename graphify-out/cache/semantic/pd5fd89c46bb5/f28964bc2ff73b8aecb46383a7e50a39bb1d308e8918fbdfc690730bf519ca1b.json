{"nodes": [{"id": "docs_src_content_docs_de_migration_from_pekko_pekko_akka_equivalence", "label": "Pekko entspricht Akka 2.6", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pekko ist der Apache-Fork, der die Akka-2.6-API unter Apache-2.0 haelt; fuer Migrationszwecke gilt alles aus dem from-akka-jvm-Guide."}, {"id": "docs_src_content_docs_de_migration_from_pekko_pekko_package_rename", "label": "Paketnamen akka.* -> org.apache.pekko.*", "file_type": "concept", "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die eine nennenswerte Aenderung gegenueber Akka 2.6; ansonsten ist die API identisch."}, {"id": "docs_src_content_docs_de_migration_from_pekko_license_compatibility", "label": "Lizenz-Kompatibilitaet", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pekko ist Apache 2.0 und actor-ts ebenfalls permissiv lizenziert \u2014 keine Lizenzkonflikte bei der Migration."}, {"id": "docs_src_content_docs_de_migration_from_pekko_pekko_streams_not_ported", "label": "Pekko Streams sind nicht portiert", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wie Akka Streams: nicht portiert. Promise-basierte Patterns oder eine separate Library treten an ihre Stelle."}, {"id": "docs_src_content_docs_de_migration_from_pekko_persistencequery_asynciterable", "label": "PersistenceQuery als AsyncIterable", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dieselbe konzeptionelle Form wie Pekko Persistence Query (Live- und Snapshot-Queries nach PersistenceId oder Tag), aber als AsyncIterable statt als Stream."}, {"id": "docs_src_content_docs_de_migration_from_pekko_do_not_migrate_if_pekko_works", "label": "Wenn Pekko funktioniert, nicht migrieren", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Use-Case ist ein TypeScript-First-Stack, Container-First-Deployment mit Sub-Sekunden-Start oder der Wunsch, die JVM operativ zu vermeiden. Trifft keiner zu, ist Pekko auf der JVM eine solide Wahl."}], "edges": [{"source": "docs_src_content_docs_de_migration_from_pekko_pekko_akka_equivalence", "target": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_from_pekko_pekko_akka_equivalence", "target": "docs_src_content_docs_de_migration_from_pekko_pekko_package_rename", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_from_pekko_license_compatibility", "target": "docs_src_content_docs_de_migration_from_pekko_pekko_akka_equivalence", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/from-pekko.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_from_pekko_pekko_streams_not_por