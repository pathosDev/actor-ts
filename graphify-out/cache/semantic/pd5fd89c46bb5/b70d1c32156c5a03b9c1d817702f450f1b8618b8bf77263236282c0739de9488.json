{"nodes": [{"id": "docs_src_content_docs_de_typed_typed_actor_typedactor", "label": "TypedActor<T>", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime-Host, der einen Behavior-Wert interpretiert; Actor-Subklasse mit gleicher Mailbox/Dispatcher/Supervisionsbaum. Nicht direkt instanziieren \u2014 jeder Restart braucht eine frische Instanz, die nur die Spawn-Helfer erzeugen."}, {"id": "docs_src_content_docs_de_typed_typed_actor_behavior", "label": "Behavior<T>", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_resolution_loop", "label": "Resolution-Loop (Behavior-Aufl\u00f6sung)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Komponierte Behaviors werden Schicht f\u00fcr Schicht ausgepackt; jeder Wrapper hat seinen Seiteneffekt genau einmal und verschwindet, die finale Form ist ein einfacher receive-Wert."}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_same", "label": "Behaviors.same", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_stopped", "label": "Behaviors.stopped", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_unhandled", "label": "Behaviors.unhandled", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_supervise", "label": "Behaviors.supervise(...).onFailure", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_setup", "label": "Behaviors.setup", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_withtimers", "label": "Behaviors.withTimers", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_behaviors_receivewithsignal", "label": "Behaviors.receiveWithSignal", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_supervise_scope_stack", "label": "Supervise-Geltungsbereiche als Stack", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Lauf \u00fcber zwei supervise-Wrapper h\u00e4lt zwei Bereiche fest; Fehler werden von innen nach au\u00dfen angeboten, Directive.Escalate r\u00fcckt einen Bereich nach au\u00dfen, damit ein \u00e4u\u00dferer Wrapper nicht stillschweigend verdr\u00e4ngt wird."}, {"id": "docs_src_content_docs_de_typed_typed_actor_signal_handler_binding", "label": "Signal-Handler ist an sein receive gebunden", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Signal-Handler \u00fcberlebt keinen \u00dcbergang: ein receive ohne onSignal meldet ihn ab. Nur die Sentinels lassen ihn unber\u00fchrt, damit ein Behavior mit stopped antworten und sein post-stop dennoch sehen kann."}, {"id": "docs_src_content_docs_de_typed_typed_actor_wrapper_cycle_bound", "label": "Wrapper-Zyklus-Grenze (64 Hops)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Resolver wirft nach 64 Hops, statt bei einem sich selbst zur\u00fcckgebenden setup ewig zu drehen \u2014 die Fehlkonfiguration wird laut sichtbar."}, {"id": "docs_src_content_docs_de_typed_typed_actor_spawntyped", "label": "system.spawnTyped / context.spawnTyped / typedActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_typed_typed_actor_initial_behavior_pitfalls", "label": "Initial-Behavior-Fallstricke", "file_type": "rationale", "source_file": "docs/src/content/docs/de/typed/typed-actor.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Behaviors.same als Initial wird wie Behaviors.empty behandelt (stilles No-Op, deutet auf einen Logik-Bug); Behaviors.stopped als Initial stoppt den Actor bereits in preStart."}], "edges": [{"source": "docs_src_content_docs_de_typed_typed_actor_typedactor", "target": "docs_