{"nodes": [{"id": "docs_src_content_docs_distributed_data_crdt_types_counters_gcounter", "label": "GCounter", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "rationale": "Grow-only: State ist eine Map<ReplicaId, number>, Merge nimmt das Per-Key-Maximum, der Wert ist die Summe. Negative Deltas werfen \u2014 bei nebenlaeufigem +3 und -3 auf verschiedenen Replicas ginge eines verloren, die Mathematik traegt das nicht. Kleiner in der Wire-Kodierung und sicherer als PNCounter.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_counters_pncounter", "label": "PNCounter", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "rationale": "Intern zwei GCounter (positiv und negativ), der Wert ist die Differenz. Replica-IDs werden fuer Inkremente und Dekremente getrennt gefuehrt, und der Wert kann negativ werden. Fuer alles, was in beide Richtungen geht \u2014 Warenkorb, verfuegbarer Bestand, Saldo.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_counters_selfreplicaid", "label": "dd.selfReplicaId()", "file_type": "concept", "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "rationale": "Die stabile ID dieser Replica \u2014 an jedes increment/decrement uebergeben.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_counters_stable_replica_id", "label": "Stabile Replica-ID ist Pflicht", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "rationale": "Replica-IDs muessen pro Node/Prozess ueber die gesamte Cluster-Lebenszeit stabil sein \u2014 sonst traegt jedes Increment zu einer NEUEN Replica bei und der Counter waechst linear mit der Zahl der Operationen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_counters_high_throughput_caveat", "label": "Sehr hohe Counter-Raten gehoeren nicht durch DD", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "rationale": "Jedes Increment geht durch den DistributedData-Replicator und Gossip traegt den Merge zu den Peers; bei sehr hohem Durchsatz besser lokale atomare Counter mit periodischem Flush nach DD.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_distributed_data_crdt_types_counters_gcounter", "target": "docs_src_content_docs_distributed_data_crdt_types_counters_pncounter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_counters_pncounter", "target": "docs_src_content_docs_distributed_data_crdt_types_counters_gcounter", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_counters_stable_replica_id", "target": "docs_src_content_docs_distributed_data_crdt_types_counters_selfreplicaid", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/counters.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_counters_gcounter", 