{"nodes": [{"id": "docs_src_content_docs_de_http_middleware_csrf_csrfprotection", "label": "csrfProtection()", "file_type": "concept", "rationale": "Stateless double submit: safe methods mint or refresh the token, unsafe methods must present a matching cookie and header; it also runs the origin check, making it the belt-and-braces option.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_csrfoptions", "label": "CsrfOptions", "file_type": "concept", "rationale": "An incompatible withCookie is rejected while building the middleware \u2014 an OptionsError, not a 500 per request.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_double_submit", "label": "Double-Submit-Verfahren", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_host_cookie_prefix", "label": "__Host--Cookie-Pr\u00e4fix", "file_type": "rationale", "rationale": "This is the part that prevents cookie planting: a browser accepts such a cookie only with Secure, Path=/ and no Domain, pinning it to exactly this host so a sibling subdomain cannot write it.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_hmac_token", "label": "HMAC-signiertes Token", "file_type": "rationale", "rationale": "It rejects tokens this server never issued, binding a token to the server secret and nothing else \u2014 a token issued for one client verifies for any other, so it is not what stops cookie planting.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_origin_referer_gate", "label": "Origin/Referer-Gate", "file_type": "concept", "rationale": "Compares full origins \u2014 scheme, host and port \u2014 on both arms, and always rejects an opaque Origin: null such as one from a sandboxed iframe.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_requiresameorigin", "label": "requireSameOrigin()", "file_type": "concept", "rationale": "The lightweight alternative for modern browsers only; it has no cookie to infer the scheme from, so a plain-HTTP site must set expectedScheme explicitly.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_expectedscheme", "label": "expectedScheme", "file_type": "rationale", "rationale": "A request names its host in the Host header but never its scheme \u2014 TLS may terminate at the proxy and a forwarded scheme header is client-set \u2014 so this supplies the missing half; dropping the Secure cookie attribute switches the default to http.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_csrf_cookie_not_httponly", "label": "Warum das CSRF-Cookie nicht HttpOnly ist", "file_type": "rationale", "rationale": "Double submit requires same-origin JavaScript to read the cookie and echo it into the header; the token authenticates nothing by itself, and any XSS able to read it defeats every CSRF scheme anyway.", "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_middleware_csrf_csrfprotection", "target": "docs_src_content_docs_de_http_middleware_csrf_csrfoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_csrfprotection", "target": "docs_src_content_docs_de_http_middleware_csrf_double_submit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_double_submit", "target": "docs_src_content_docs_de_http_middleware_csrf_hmac_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_double_submit", "target": "docs_src_content_docs_de_http_middleware_csrf_host_cookie_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_double_submit", "target": "docs_src_content_docs_de_http_middleware_csrf_cookie_not_httponly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_csrfprotection", "target": "docs_src_content_docs_de_http_middleware_csrf_origin_referer_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_requiresameorigin", "target": "docs_src_content_docs_de_http_middleware_csrf_origin_referer_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_expectedscheme", "target": "docs_src_content_docs_de_http_middleware_csrf_origin_referer_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_expectedscheme", "target": "docs_src_content_docs_de_http_middleware_csrf_host_cookie_prefix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_csrf_csrfprotection", "target": "docs_src_content_docs_de_http_middleware_cors_cors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "csrf_defence_in_three_parts", "label": "CSRF-Abwehr in drei getrennten Teilen", "nodes": ["docs_src_content_docs_de_http_middleware_csrf_double_submit", "docs_src_content_docs_de_http_middleware_csrf_hmac_token", "docs_src_content_docs_de_http_middleware_csrf_host_cookie_prefix", "docs_src_content_docs_de_http_middleware_csrf_origin_referer_gate"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/csrf.mdx"}]}