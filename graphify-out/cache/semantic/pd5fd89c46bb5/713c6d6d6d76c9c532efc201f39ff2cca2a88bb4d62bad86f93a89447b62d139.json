{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "label": "ReceiveTimeout", "file_type": "concept", "rationale": "Fires on the absence of traffic, re-arms after each delivery, and is a singleton so identity comparison is reliable; a busy mailbox can delay it because it travels the ordinary user-message path.", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_setreceivetimeout", "label": "context.setReceiveTimeout / cancelReceiveTimeout", "file_type": "concept", "rationale": "Only user messages reset the clock, become() does not touch it, and a restart clears it \u2014 so re-arm in preStart or postRestart.", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_session_expiry", "label": "Session-Ablauf", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_passivation", "label": "Passivierung in sharded Entities", "file_type": "concept", "rationale": "An idle entity signals its region to passivate it, freeing memory; a later message for the same entity id respawns it from persisted state.", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_watchdog", "label": "Watchdog f\u00fcr Downstream-Stille", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_receive_timeout_timeout_vs_ticker", "label": "Receive-Timeout ist kein Heartbeat-Ticker", "file_type": "rationale", "rationale": "It fires when the inbox is silent, not on a fixed schedule; sub-second windows mostly signal the wrong tool, since user traffic outpaces the window.", "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_setreceivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_receive_timeout_session_expiry", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_receive_timeout_passivation", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_receive_timeout_watchdog", "target": "docs_src_content_docs_de_fundamentals_receive_timeout_receivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs