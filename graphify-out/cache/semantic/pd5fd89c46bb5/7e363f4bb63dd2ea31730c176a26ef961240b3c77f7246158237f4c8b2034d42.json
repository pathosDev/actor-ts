{"nodes": [{"id": "docs_src_content_docs_de_io_redis_streams_redisstreamsactor", "label": "RedisStreamsActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die richtige Form, wenn Redis ohnehin im Stack steckt und leichtgewichtiges Streaming gebraucht wird, ohne Kafka oder NATS auszurollen."}, {"id": "docs_src_content_docs_de_io_redis_streams_redisstreamsoptionstype", "label": "RedisStreamsOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_redis_streams_consumer_group_consumption", "label": "Konsum ausschliesslich per Consumer Group", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Actor nutzt nur XREADGROUP; es gibt keinen gruppenlosen XREAD-Broadcast-Pfad. Der Consumer startet erst, wenn consumerGroup, streams und target alle gesetzt sind \u2014 Work-Sharing mit ACK-Semantik ist damit der einzige Modus."}, {"id": "docs_src_content_docs_de_io_redis_streams_redisstreamentry", "label": "RedisStreamEntry", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stream-IDs sind <millis>-<seq>-Strings; die id taugt als Dedup-Key fuer idempotente Verarbeitung, selbst wenn Redis erneut zustellt."}, {"id": "docs_src_content_docs_de_io_redis_streams_pending_entries_list", "label": "Pending Entries List (PEL)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ungeackte Eintraege bleiben pro Consumer in der PEL. Re-Claim laeuft heute manuell per XCLAIM ausserhalb des Actor-Surface; ein Consumer, der mitten in der Verarbeitung crasht, laesst den Eintrag stehen, statt ihn zu verlieren."}, {"id": "docs_src_content_docs_de_io_redis_streams_ioredis_peer_dependency", "label": "ioredis als Peer-Dependency", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ioredis ist der zugrunde liegende Client; Versionen 5+ sind getestet."}, {"id": "docs_src_content_docs_de_io_redis_streams_stream_length_unbounded", "label": "Stream-Laenge standardmaessig unbegrenzt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jedes XADD laesst den Stream wachsen und alte Eintraege bleiben fuer immer. MAXLEN ~ N beim XADD oder periodisches XTRIM deckelt das, sonst waechst der Stream linear mit der Publish-Rate."}, {"id": "docs_src_content_docs_de_io_redis_streams_no_partition_concept", "label": "Kein Partitionskonzept wie Kafka", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis Streams sind lineare Logs ohne Partitionierung innerhalb eines Streams. Reihenfolge pro Key braucht mehrere Streams (einen pro Key-Praefix) und Routing beim Publishen."}, {"id": "docs_src_content_docs_de_io_redis_streams_redis_durability_config", "label": "Durability haengt an der Redis-Config", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AOF / RDB / beides / keines wird auf Redis-Ebene entschieden; ohne sie verliert ein Neustart alles. Der Actor kann das nicht garantieren."}, {"id": "docs_src_content_docs_de_io_redis_streams_when_redis_streams", "label": "Wann Redis Streams passen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bestehende Redis-Infrastruktur, Sub-Millisekunden-Latenz und kleinere Workloads. Nicht fuer Langzeit-Retention oder massive Parallelitaet \u2014 Redis ist single-threaded und wird zum Bottleneck."}], "edges": [{"source": "docs_src_content_docs_de_io_redis_streams_redisstreamsactor", "target": "docs_src_content_docs_de_io_redis_streams_redisstreamsoptionstype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_redis_streams_redisstreamsactor", "target": "docs_src_content_docs_de_io_redis_streams_consumer_group_consumption", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_redis_streams_redisstreamsactor", "target": "docs_src_content_docs_de_io_redis_streams_redisstreamentry", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/redis-streams.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_redis_streams_redisstreamsactor", "target": "docs_src_content_docs_de_io_redis_streams_ioredis_peer_dependency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file":