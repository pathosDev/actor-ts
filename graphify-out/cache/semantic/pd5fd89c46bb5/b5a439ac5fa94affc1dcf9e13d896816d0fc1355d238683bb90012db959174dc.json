{"nodes": [{"id": "docs_src_content_docs_persistence_migration_migrating_adapter_migratingadapter", "label": "migratingAdapter", "file_type": "document", "rationale": "Handles non-additive migrations \u2014 renames, restructures, computed fields, multi-step evolution \u2014 by running whichever upcasters apply to a given persisted version. currentVersion and manifest live on the chain; the adapter's options control only the write version.", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_migrating_adapter_migrationchain", "label": "MigrationChain", "file_type": "document", "rationale": "Built with MigrationChain.for<E>(manifest, currentVersion) and .add(step); steps must move forward and intermediate shapes need not match any historical event \u2014 they are stepping stones the chain walks from the stored version's cursor to currentVersion.", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_migrating_adapter_migrationstep", "label": "MigrationStep", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_migrating_adapter_migratingsnapshotadapter", "label": "migratingSnapshotAdapter", "file_type": "document", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_migrating_adapter_downcasters_and_writeversion", "label": "Downcasters and writeVersion", "file_type": "rationale", "rationale": "During a rolling deploy, v2 nodes must keep emitting v1 events while v1 readers are still in the cluster. writeVersion must be <= currentVersion and the chain needs downcasters covering every step on the path currentVersion to writeVersion, or toJournal throws.", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_migrating_adapter_chain_gap_migrationerror", "label": "Chain gap raises MigrationError", "file_type": "rationale", "rationale": "No upcaster registered for the cursor before currentVersion is reached throws a MigrationError naming the missing fromVersion \u2014 which is why skipping a version (1 to 3 with no 2 to 3 step) breaks as soon as a v2 payload exists. A step that throws surfaces through onRecoveryFailure and stops the actor unless the hook rethrows into supervision.", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_migration_migrating_adapter_upcasters_must_be_pure", "label": "Upcasters must be pure", "file_type": "rationale", "rationale": "They run on every recovery for every affected event, so side effects duplicate per recovery and slow replay. Existing steps are load-bearing and must never be modified while events they handle are still in the journal.", "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_migration_migrating_adapter_migratingadapter", "target": "docs_src_content_docs_persistence_migration_envelope_format_eventadapter", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_migration_migrating_adapter_downcasters_and_writeversion", "target": "docs_src_content_docs_persistence_migration_migrating_adapter_migratingadapter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_migration_migrating_adapter_chain_gap_migrationerror", "target": "docs_src_content_docs_persistence_migration_migrating_adapter_migrationchain", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_migration_migrating_adapter_upcasters_must_be_pure", "target": "docs_src_content_docs_persistence_migration_migrating_adapter_migrationstep", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/migration/migrating-adapter.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}