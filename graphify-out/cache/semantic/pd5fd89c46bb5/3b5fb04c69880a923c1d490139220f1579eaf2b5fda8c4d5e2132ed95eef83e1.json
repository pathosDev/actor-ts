{"nodes": [{"id": "tests_integration_brokers_s3_docker_compose_s3_minio_service", "label": "MinIO Service", "file_type": "code", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single node, single drive \u2014 no HA, this is a test instance."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_s3_runner_service", "label": "S3 Runner Service", "file_type": "code", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bucket creation is an init step inside the runner rather than a compose hook, so cleanup stays co-located with the test."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_minio_over_localstack_choice", "label": "MinIO Chosen Over LocalStack", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Boots in ~1-2s vs LocalStack's 10-15s so CI minutes stay tight, its S3 implementation is the closest to AWS spec with fewer own-quirks than R2 / B2, and the images are stable and tagged. LocalStack stays an optional secondary target."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_minio_kms_secret_key", "label": "Built-In KMS for SSE-AES256", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MinIO since ~2025-mid refuses server-side-encryption PUTs \u2014 even plain AES256 \u2014 unless a KMS backend is configured; older releases accepted SSE without one, and pinning :latest is what surfaced that policy change. The same key string every run lets re-runs read back previously-encrypted objects."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_force_path_style_addressing", "label": "Force Path-Style S3 Addressing", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Virtual-host-style addressing would require DNS for bucket.minio, which would have to be wired up separately."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_minio_health_live_healthcheck", "label": "MinIO health/live Healthcheck", "file_type": "concept", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_brokers_s3_docker_compose_s3_belts_and_braces_readiness", "label": "Belts-and-Braces Readiness", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runner keeps its own waitForPort in addition to the compose healthcheck, for runtimes where compose healthcheck propagation is not reliable (Bun on Windows plus Docker Desktop)."}], "edges": [{"source": "tests_integration_brokers_s3_docker_compose_s3_s3_runner_service", "target": "tests_integration_brokers_s3_docker_compose_s3_minio_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_minio_over_localstack_choice", "target": "tests_integration_brokers_s3_docker_compose_s3_minio_service", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", 