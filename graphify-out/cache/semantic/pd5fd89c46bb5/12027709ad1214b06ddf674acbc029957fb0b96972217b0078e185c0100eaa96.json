{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_poison_pill_and_kill_poisonpill", "label": "PoisonPill", "file_type": "concept", "rationale": "A user message, so it queues behind everything already told \u2014 the drain-then-stop guarantee means an actor mid-work does not lose it.", "source_file": "docs/src/content/docs/de/fundamentals/poison-pill-and-kill.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_poison_pill_and_kill_kill", "label": "Kill", "file_type": "rationale", "rationale": "The escape hatch for making a non-failing actor trigger its supervisor strategy from outside without touching its code; under the default restart strategy it does not actually stop the actor.", "source_file": "docs/src/content/docs/de/fundamentals/poison-pill-and-kill.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_poison_pill_and_kill_actorkillederror", "label": "ActorKilledError", "file_type": "concept", "rationale": "Distinct error type matters when a supervisor uses decideBy to dispatch on error class.", "source_file": "docs/src/content/docs/de/fundamentals/poison-pill-and-kill.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_poison_pill_and_kill_ref_stop", "label": "ref.stop()", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/poison-pill-and-kill.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_poison_pill_and_kill_gracefulstop", "label": "gracefulStop(ref, timeoutMs)", "file_type": "rationale", "rationale": "Returns a boolean rather than rejecting because a timeout is a result, not an error; the budget is mandatory be