{"nodes": [{"id": "docs_src_content_docs_cluster_sharding_with_lease_single_writer_lease", "label": "Sharding single-writer lease", "file_type": "concept", "rationale": "During a partition with a buggy downing config both halves may think they are leader; the lease backend's atomic CAS makes exactly one coordinator authoritative beyond gossip.", "source_file": "docs/src/content/docs/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_with_lease_startshardingoptions", "label": "StartShardingOptions", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_with_lease_kuberneteslease", "label": "KubernetesLease", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_with_lease_coordinator_uniqueness", "label": "Coordinator-uniqueness guarantee", "file_type": "rationale", "rationale": "The lease gates only coordinator state writes \u2014 allocations, rebalance decisions, handoffs \u2014 never entity hosting or the message path, so the worst case during a partition is slightly stale shard assignments.", "source_file": "docs/src/content/docs/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_with_lease_acquireretryintervalms", "label": "acquireRetryIntervalMs (sharding)", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/sharding/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author"