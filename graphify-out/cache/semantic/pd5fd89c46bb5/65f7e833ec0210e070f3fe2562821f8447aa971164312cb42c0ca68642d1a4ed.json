{"nodes": [{"id": "benchmarks_comparison_results_measured_results", "label": "Framework comparison: measured results", "file_type": "document", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated from results/ and never hand-edited: hand edits are lost on the next run, and a hand-edited benchmark table is worth nothing anyway."}, {"id": "benchmarks_comparison_results_environment_table", "label": "Per-arm environment table", "file_type": "concept", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per arm because arms are not required to have been measured together, and a row taken three months earlier on other hardware should be visible as exactly that rather than averaged in silently."}, {"id": "benchmarks_comparison_results_scenario_spawn", "label": "spawn scenario", "file_type": "concept", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One operation is the full lifecycle: spawn, confirmed start, stop, confirmed stop. Typed JVM arms drive the batch through a guardian because only an actor may spawn actors."}, {"id": "benchmarks_comparison_results_scenario_tell_throughput", "label": "tell-throughput scenario", "file_type": "concept", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fire-and-forget messages into one actor, read back as how many it handled; measured at batch=1k and batch=10k."}, {"id": "benchmarks_comparison_results_scenario_ask_round_trip", "label": "ask-round-trip scenario", "file_type": "concept", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sequential depth-1 request/response: a latency measurement, so the percentiles are the point and throughput is derived."}, {"id": "benchmarks_comparison_results_scenario_ping_pong", "label": "ping-pong scenario", "file_type": "concept", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two actors volleying, i.e. the scheduler with nothing else in the way; Orleans substitutes a driven chain of awaited grain calls as the closest deadlock-free analogue."}, {"id": "benchmarks_comparison_results_known_gaps", "label": "Known gaps in the comparison", "file_type": "rationale", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated because a comparison that only lists what it measured reads as a comparison of everything: no sharding row (an open regression, #529), no persistence row (#1177), no stored baselines or regression gate (#528)."}, {"id": "benchmarks_comparison_results_noise_shape", "label": "Shape of the round-to-round noise", "file_type": "rationale", "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These are ratios, not absolutes: treat the last digit as fiction and read a gap smaller than the published spread as \"about the same\"."}], "edges": [{"source": "benchmarks_comparison_results_measured_results", "target": "benchmarks_comparison_readme_completion_verified", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "benchmarks/comparison/RESULTS.md", "source_location": null, "weight": 1.0}, {"source": "benchmarks_comparison_results_measured_results", "target": "benchmarks_comp