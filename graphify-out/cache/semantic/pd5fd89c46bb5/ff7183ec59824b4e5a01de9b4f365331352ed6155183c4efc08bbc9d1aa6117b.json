{"nodes": [{"id": "docs_src_content_docs_cluster_weakly_up_weakly_up", "label": "Weakly-up member state", "file_type": "concept", "rationale": "A transient state between joining and up that breaks the deadlock where a joiner on a partitioned side waits forever for a leader it cannot see.", "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_weakly_up_weaklyupafterms", "label": "weaklyUpAfterMs", "file_type": "concept", "rationale": "Default 0 (disabled); 3-10s is typical \u2014 high enough that joining to up stays the common path, low enough that a stalled join recovers. Settable from HOCON with the usual explicit-options-first precedence.", "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_weakly_up_memberweaklyup", "label": "MemberWeaklyUp event", "file_type": "code", "rationale": "A non-zero rate in steady state means partitions are happening, or the threshold is set too low for the network.", "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_weakly_up_passive_participation", "label": "Passive participation works, active responsibilities do not", "file_type": "rationale", "rationale": "A weakly-up member can receive tells and subscribe to events but cannot be a cluster-router routee, host sharding entities, or win a singleton election \u2014 it may be on the minority side of a partition, and letting it host would risk dual leadership.", "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_weakly_up_upmembers_strictness", "label": "upMembers() excludes weakly-up", "file_type": "rationale", "rationale": "Code branching on 'are at least 3 members up' can pass on one side of a partition and fail on the other, so the states counted as live must be decided explicitly.", "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_weakly_up_threshold_ordering", "label": "Keep weaklyUpAfterMs above unreachableAfterMs", "file_type": "rationale", "rationale": "Below the failure detector's threshold, members get promoted during routine gossip round-trip delays and demoted again when the leader's answer arrives \u2014 thrashing.", "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_weakly_up_weakly_up", "target": "docs_src_content_docs_cluster_weakly_up_weaklyupafterms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_weakly_up_weakly_up", "target": "docs_src_content_docs_cluster_weakly_up_memberweaklyup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_weakly_up_passive_participation", "target": "docs_src_content_docs_cluster_weakly_up_weakly_up", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/weakly-up.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_weakly_up_upmembers