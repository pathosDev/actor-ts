{"nodes": [{"id": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_lease", "label": "Singleton lease", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The manager spawns only after acquiring; two managers claiming leadership race for the lease and one wins. Use it where double execution does real damage \u2014 charging a customer twice, publishing an event twice."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_onlost_handling", "label": "Lease-loss handling in the manager", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revocation stops the singleton immediately with no graceful drain; postStop runs and acquire is retried periodically. So a backend hiccup that briefly revokes restarts the singleton \u2014 the same effect as a short actor restart."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_failover_window", "label": "Failover window equals the lease TTL", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A crashed holder's lease stays valid until TTL expiry, so nothing hosts and messages dead-letter for that window; shorter TTL means faster failover and more renewal traffic (typical 15-30s). Mitigate with a lower TTL, sender-side proxy buffering (capped by withBufferSize), or a different architecture \u2014 singletons are inherently serial at failover."}, {"id": "docs_src_content_docs_de_cluster_singleton_with_lease_comparison_with_sharding", "label": "Singleton lease vs. sharding lease", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Singleton failover is more disruptive because the singleton IS the workload; sharding failover only queues new allocations while existing entities keep processing."}], "edges": [{"source": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_lease", "target": "docs_src_content_docs_de_cluster_singleton_manager_clustersingletonmanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_singleton_with_lease_onlost_handling", "target": "docs_src_content_docs_de_coordination_lease_api_onlost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_singleton_with_lease_failover_window", "target": "docs_src_content_docs_de_cluster_singleton_overview_buffersize", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_singleton_with_lease_comparison_with_sharding", "target": "docs_src_content_docs_de_cluster_sharding_with_lease_coordinator_lease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_singleton_with_lease_singleton_lease", "target": "docs_src_content_docs_de_coordination_kubernetes_lease_kuberneteslease", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/singleton/with-lease.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}