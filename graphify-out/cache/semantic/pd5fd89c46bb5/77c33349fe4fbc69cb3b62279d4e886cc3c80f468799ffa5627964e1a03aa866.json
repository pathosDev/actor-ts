{"nodes": [{"id": "docs_src_content_docs_operations_deployment_process_manager_process_manager_deployment", "label": "Process manager deployment", "file_type": "document", "rationale": "For bare-metal and VM fleets where container orchestration is overkill; a lower abstraction with fewer features but fewer dependencies.", "source_file": "docs/src/content/docs/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_process_manager_systemd_unit", "label": "systemd unit for actor-ts", "file_type": "concept", "rationale": "TimeoutStopSec is sized to the coordinated-shutdown phase budget, KillSignal SIGTERM triggers the shutdown hooks, and journald handles log rotation.", "source_file": "docs/src/content/docs/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_process_manager_pm2_ecosystem", "label": "PM2 ecosystem configuration", "file_type": "concept", "rationale": "kill_timeout matches coordinated shutdown; max_memory_restart pairs with metrics so an alert precedes the kill.", "source_file": "docs/src/content/docs/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_process_manager_pm2_cluster_mode_pitfall", "label": "PM2 cluster mode conflicts with the actor cluster", "file_type": "rationale", "rationale": "PM2 cluster mode runs N workers behind a TCP balancer and each would bind the same actor-ts port; always use exec_mode fork with one instance.", "source_file": "docs/src/content/docs/operations/deployment/process-manager.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id