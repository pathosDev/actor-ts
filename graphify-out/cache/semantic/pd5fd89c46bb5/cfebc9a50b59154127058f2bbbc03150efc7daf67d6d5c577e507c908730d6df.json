{"nodes": [{"id": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentities", "label": "rememberEntities", "file_type": "rationale", "rationale": "Sharded entities are lazy by default; remembering their IDs makes failover restore the whole working set eagerly, which matters when an entity must be alive without an incoming message (scheduled work, external subscriptions).", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentitiesstore", "label": "RememberEntitiesStore", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_journalrememberentitiesstore", "label": "JournalRememberEntitiesStore", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_redisrememberentitiesstore", "label": "RedisRememberEntitiesStore", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_rememberevent", "label": "RememberEvent", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_startshardingoptions", "label": "StartShardingOptions", "file_type": "code", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_two_store_split", "label": "Two-store split (journal vs remember store)", "file_type": "rationale", "rationale": "Only entity identities go to the remember store; entity state stays in the journal. The split is intentional because the remember store has different access patterns \u2014 small, frequent writes on start/stop \u2014 and benefits from being separable.", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_passivation_registry_interaction", "label": "Passivation and the entity registry", "file_type": "rationale", "rationale": "passivationIdleMs defaults to 5 minutes, so an idle entity is stopped and dropped from the registry \u2014 'remembered' then means 'recently active'. Set passivationIdleMs to 0 for it to mean 'known to exist'.", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_cold_start_storm", "label": "Cold-start storm", "file_type": "rationale", "rationale": "Remembered entities are spawned eagerly after coordinator initialization, so a very large entity set is a thundering herd of simultaneous journal replays; mitigate by sharding-by-id and cheap preStart.", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_sharding_remember_entities_shard_death_recovery", "label": "Recovery after an unexpected shard death", "file_type": "rationale", "rationale": "A shard dying outside a rebalance keeps its region's ownership; the coordinator re-sends what it remembers so entities return without waiting for traffic, and nothing is recorded as stopped because the entities were never meant to go.", "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentities", "target": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentitiesstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_sharding_remember_entities_journalrememberentitiesstore", "target": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentitiesstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_sharding_remember_entities_redisrememberentitiesstore", "target": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentitiesstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_sharding_remember_entities_rememberentitiesstore", "target": "docs_src_content_docs_cluster_sharding_remember_entities_rememberevent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/