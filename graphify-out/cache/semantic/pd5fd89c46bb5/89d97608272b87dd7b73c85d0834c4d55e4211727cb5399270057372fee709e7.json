{"nodes": [{"id": "docs_src_content_docs_de_http_error_handling_error_layers", "label": "Drei Fehlerschichten und ihre Pr\u00e4zedenz", "file_type": "concept", "rationale": "Innermost handleErrors first, then the server-wide withErrorHandler, then the framework default; a handler that throws hands the new error to the next layer out.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_httperror", "label": "HttpError", "file_type": "concept", "rationale": "Maps to its status plus an {error, ...extra} JSON body and can carry response headers such as WWW-Authenticate.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_reject", "label": "reject(status, message, extra?)", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_handleerrors", "label": "handleErrors(handler, child)", "file_type": "concept", "rationale": "Sees the original throw before any default mapping and may decline with null so an outer handler takes over; nests outside-in like withMiddleware, so wrapping an auth middleware also catches its 401.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_fallback", "label": "fallback(handler)", "file_type": "rationale", "rationale": "Wired to each backend's not-found hook, so it must sit at the root of the route tree \u2014 a fallback under path() is a compile-time error, and there is at most one per server.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_witherrorhandler", "label": "withErrorHandler", "file_type": "concept", "rationale": "The last resort for throws that escaped every handleErrors, plus backend-internal failures such as body parsing.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_generic_500_redaction", "label": "Redaktion des generischen 500", "file_type": "rationale", "rationale": "A thrown message routinely carries file paths, SQL fragments, connection strings or a stack, and a 500 is by definition a case nobody wrote a message for; the redaction only works because the framework logs every escaping throw at error level and passes the error value through.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_requestidof", "label": "requestIdOf(request)", "file_type": "rationale", "rationale": "Applies the same shape check the framework uses, which is what stops a client-controlled string from forging a log entry through an embedded newline.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_error_handling_404_not_405", "label": "404 statt 405", "file_type": "concept", "rationale": "A known path with the wrong verb goes through the not-found path; real 405s with per-path method introspection are a separate future feature.", "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_error_handling_error_layers", "target": "docs_src_content_docs_de_http_error_handling_handleerrors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_error_handling_error_layers", "target": "docs_src_content_docs_de_http_error_handling_witherrorhandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_error_handling_error_layers", "target": "docs_src_content_docs_de_http_error_handling_httperror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_error_handling_reject", "target": "docs_src_content_docs_de_http_error_handling_httperror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_error_handling_generic_500_redaction", "target": "docs_src_content_docs_de_http_error_handling_witherrorhandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/error-handling.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_error_handling_generic_500_redaction", "target": "docs_src_content_docs_de_http_error_handling_httperror", "relation": "referen