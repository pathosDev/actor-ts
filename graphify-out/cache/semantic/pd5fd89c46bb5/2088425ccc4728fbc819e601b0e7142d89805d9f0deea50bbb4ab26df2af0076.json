{"nodes": [{"id": "docs_src_content_docs_fundamentals_logging_logger", "label": "Logger interface", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calls below the configured level emit nothing, but arguments are ordinary function arguments and are evaluated first."}, {"id": "docs_src_content_docs_fundamentals_logging_displayname", "label": "displayName in log records", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A label for humans, never an identity \u2014 metric labels, tracing attributes, dead letters and every cluster-wire identifier keep using the path, so a display name is free to be ambiguous, shared, or to change mid-flight."}, {"id": "docs_src_content_docs_fundamentals_logging_jsonlogger", "label": "JsonLogger", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One newline-terminated JSON object per record for aggregation pipelines. Errors serialise to name/message/stack instead of \"{}\", and circular references, BigInt and functions are sanitised so a log call never throws."}, {"id": "docs_src_content_docs_fundamentals_logging_otellogger", "label": "otelLogger (OTLP-Logs bridge)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@opentelemetry/api-logs is an optional peer the framework never imports \u2014 you bring your existing namespace import."}, {"id": "docs_src_content_docs_fundamentals_logging_withfields", "label": "withFields (static structured fields)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bind it in preStart rather than a field initializer \u2014 context is not available until the actor is attached, so an initializer would throw at construction."}, {"id": "docs_src_content_docs_fundamentals_logging_logcontext", "label": "LogContext (MDC)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values are string, number or boolean only, enforced by the type: across cluster hops the context serializes to JSON and arbitrary objects do not round-trip safely. get() returns the live readonly context; snapshot() is the one to keep or mutate."}, {"id": "docs_src_content_docs_fundamentals_logging_mdcpropagation", "label": "MDC propagation across tell", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runtime snapshots the current context onto the envelope and the receiver runs onReceive under it, so one correlationId flows through every actor and node reached from the entry point."}, {"id": "docs_src_content_docs_fundamentals_logging_runfresh", "label": "LogContext.runFresh", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The inverse of with(): it deliberately starts from empty, which fails safe \u2014 a field nobody set cannot leak \u2014 and is easier to reason about than remembering which keys to strip."}, {"id": "docs_src_content_docs_fundamentals_logging_runeach", "label": "LogContext.runEach", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns Promise<void> deliberately: handing back results would read like Promise.all and invite use as a concurrency helper, when the ordering and one-scope-per-item guarantee are the product. An error propagates immediately because swallowing it would be a supervision decision."}, {"id": "docs_src_content_docs_fundamentals_logging_multisink", "label": "Multi-sink logging", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_logging_deferredworktenantisolation", "label": "Deferred work and tenant isolation", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AsyncLocalStorage binds a store when the resource is created, so deferred work inherits the context of whichever turn started it. When that work serves a different principal, one tenant identifiers travel with another tenant messages \u2014 a data leak, not just a confusing log line."}, {"id": "docs_src_content_docs_fundamentals_logging_levelguard", "label": "Level guard for expensive payloads", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The level check happens after the arguments are evaluated, so an expensive snapshot runs and is thrown away unless you guard it."}], "edges": [{"source": "docs_src_content_docs_fundamentals_logging_logger", "target": "docs_src_content_docs_fundamentals_actor_paths_actorpath", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_logger", "target": "docs_src_content_docs_fundamentals_logging_withfields", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_logger", "target": "docs_src_content_docs_fundamentals_logging_displayname", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_jsonlogger", "target": "docs_src_content_docs_fundamentals_logging_logger", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_otellogger", "target": "docs_src_content_docs_fundamentals_logging_logger", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_jsonlogger", "target": "docs_src_content_docs_fundamentals_logging_displayname", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_logcontext", "target": "docs_src_content_docs_fundamentals_logging_mdcpropagation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_logcontext", "target": "docs_src_content_docs_fundamentals_logging_runfresh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_logcontext", "target": "docs_src_content_docs_fundamentals_logging_runeach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_withfields", "target": "docs_src_content_docs_fundamentals_logging_logcontext", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_deferredworktenantisolation", "target": "docs_src_content_docs_fundamentals_logging_runfresh", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_deferredworktenantisolation", "target": "docs_src_content_docs_fundamentals_logging_runeach", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_logging_mdcpropagation", "target": "docs_src_content_docs_fundamentals_logging_deferredworktenantisolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/logging.mdx", "sou