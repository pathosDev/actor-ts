{"nodes": [{"id": "docs_src_content_docs_testing_manual_scheduler_manualscheduler", "label": "ManualScheduler", "file_type": "concept", "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Scheduler whose time only moves when the test calls advance, so timer-driven tests run in microseconds of wall clock and deterministically."}, {"id": "docs_src_content_docs_testing_manual_scheduler_virtual_time_advance", "label": "advance and advanceToNext", "file_type": "concept", "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tasks maturing in the advanced window fire in scheduled order (ties by insertion) before advance returns, and tasks they re-arm join the same window if their time falls inside it; advanceToNext skips an idle gap and is a no-op when nothing is scheduled."}, {"id": "docs_src_content_docs_testing_manual_scheduler_why_virtual_time", "label": "Why virtual time beats a wall-clock tolerance", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timers fire early as well as late - a 30 ms setTimeout measured as low as 18.7 ms on Bun/Windows and as high as 201 ms under CPU load - so no wall-clock bound is both tight enough to mean something and loose enough to hold, and a more precise clock does not help because the timer is early, not the measurement."}, {"id": "docs_src_content_docs_testing_manual_scheduler_date_now_not_virtualized", "label": "Date.now is not virtualized", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ManualScheduler virtualizes the actor system's scheduler only, so an actor that stamps timestamps still reads the real clock; inject a clock and pass () => scheduler.now() in tests."}, {"id": "docs_src_content_docs_testing_manual_scheduler_no_real_timers_with_manual_scheduler", "label": "Don't mix real timers with ManualScheduler", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A raw setTimeout runs on the real clock the manual scheduler knows nothing about, so everything time-based in a test should go through context.timers or system.scheduler."}], "edges": [{"source": "docs_src_content_docs_testing_manual_scheduler_manualscheduler", "target": "docs_src_content_docs_testing_manual_scheduler_virtual_time_advance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_manual_scheduler_why_virtual_time", "target": "docs_src_content_docs_testing_manual_scheduler_manualscheduler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_manual_scheduler_date_now_not_virtualized", "target": "docs_src_content_docs_testing_manual_scheduler_manualscheduler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_manual_scheduler_no_real_timers_with_manual_scheduler", "target": "docs_src_content_docs_testing_manual_scheduler_manualscheduler", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_manual_scheduler_manualscheduler", "target": "docs_src_content_docs_testing_testkit_testkit_withmanualscheduler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_manual_scheduler_why_virtual_time", "target": "docs_src_content_docs_testing_diagnosing_flakes_bun_timer_quantum", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_manual_scheduler_virtual_time_advance", "target": "docs_src_content_docs_testing_diagnosing_flakes_dispatcher_hop_between_wait_and_assert", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/testing/manual-scheduler.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}