c_gesture_unlock", "target": "examples_voice_static_plain_index_startmicmeterloop", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "examples/voice/static/plain/index.html", "source_location": null, "weight": 1.0}, {"source": "examples_voice_static_plain_index_mic_gesture_unlock", "target": "examples_voice_static_plain_index_startincoming", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "examples/voice/static/plain/index.html", "source_location": null, "weight": 1.0}, {"source": "examples_voice_static_plain_index_mic_gesture_unlock", "target": "examples_voice_static_plain_index_phase_machine", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "examples/voice/static/plain/index.html", "source_location": null, "weight": 1.0}, {"source": "examples_voice_static_plain_index_phase_machine", "target": "examples_voice_static_plain_index_enterapp", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "examples/voice/static/plain/index.html", "source_location": null, "weight": 1.0}, {"source": "examples_voice_static_plain_index_phase_machine", "target": "examples_voice_static_plain_index_state", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "examples/voice/static/plain/index.html", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "voice_per_sender_playback_pipeline", "label": "Per-sender MediaSource playback pipeline", "nodes": ["examples_voice_static_plain_index_decodeincoming", "examples_voice_static_plain_index_startincoming", "examples_voice_static_plain_index_feedincoming", "examples_voice_static_plain_index_drainqueue", "examples_voice_static_plain_index_endincoming", "examples_voice_frontend_plain_readme_binary_frame_envelope", "examples_voice_static_plain_index_fresh_mediarecorder_per_press"], "rela