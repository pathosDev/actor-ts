{"nodes": [{"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "label": "CassandraSnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The multi-node snapshot companion to CassandraJournal, shared across cluster nodes. Sharded entities move between nodes, so their snapshot store has to be shared too; a Cassandra journal paired with SQLite snapshots loses the snapshot the moment an entity moves and replays from sequence zero."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstoreoptions", "label": "CassandraSnapshotStoreOptions", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The connection fields are the same set the journal takes; snapshotsTable and keepN are the snapshot-specific ones."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrakeepn", "label": "keepN prunes on save, not on a timer", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Pitfalls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pruning runs inside save, keeping the newest keepN per pid (default 3). A pid that never snapshots again keeps whatever it had - there is no background sweep - so keepN <= 0 only belongs where an external retention policy owns cleanup."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotschema", "label": "snapshots CQL table clustered sequence_nr DESC", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descending clustering makes loadLatest a single-row LIMIT 1 read with no scan; loadBefore(seq) just adds a sequence_nr < ? bound. The framework creates the table, not the keyspace (unless autoCreateKeyspace)."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cqlidentifiervalidation", "label": "CQL identifier validation", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Schema", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "keyspace and snapshotsTable are interpolated as identifiers because identifiers cannot be bound, so both are validated against /^[A-Za-z_][A-Za-z0-9_]*$/ - including inside the CREATE KEYSPACE autoCreateKeyspace issues. Data-center names are CQL string values instead, so they keep the hyphens an Ec2Snitch name carries and are quote-escaped. Everything else travels as bind parameters."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasharedclient", "label": "withClient(...) to share the journal's connection", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passing a pre-built driver client avoids opening a second connection pool."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandranocompression", "label": "No compression or client-side encryption", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Pitfalls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike the object-storage stores, the payload is stored as serialized text and any PersistenceOptions for compression or encryption are silently ignored - use the object-storage snapshot store when you need either."}], "edges": [{"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstoreoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrakeepn", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotschema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cqlidentifiervalidation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasharedclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandranocompression", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## When to use it", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshots_snapshots", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "## Where to next", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cassandra_cassandrasnapshotstore", "target": "docs_src_content_docs_persistence_snapshots_snapshotstore", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cassandra.mdx", "source_location": "intro", "weight": 1.0}], "hyperedges": []}