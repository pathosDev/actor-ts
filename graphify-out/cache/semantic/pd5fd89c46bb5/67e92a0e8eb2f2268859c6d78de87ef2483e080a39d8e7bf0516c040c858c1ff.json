{"nodes": [{"id": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "label": "ConsumerController", "file_type": "document", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Empf\u00e4nger-Seite: dedupliziert, ruft einen User-Handler und ACKt automatisch, sobald der Handler resolved."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_dedup_triple", "label": "Dedup pro (producerId, incarnation, seq)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Inkarnation h\u00e4lt einen neu gestarteten Producer aus dem Dedup-Fenster heraus: er verwendet seine Sequenznummern wieder, seine Inkarnation aber nicht."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_out_of_order", "label": "Out-of-order-Behandlung (contiguous + above)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein contiguous-High-Watermark plus eine Menge bereits ausgelieferter Seqs dar\u00fcber; keine feste Buffer-Gr\u00f6\u00dfe und keine stillen Drops."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_handler_throws_no_ack", "label": "Handler wirft, also kein ACK", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Werfen verhindert das ACK und der resendTimeoutMs-Timer des Producers feuert \u2014 das ist der einzige NACK-Mechanismus, es gibt keine explizite NACK-Nachricht."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_multiple_producers", "label": "Mehrere Producer", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Eintrag pro producerId h\u00e4lt fest, welche Inkarnation die Z\u00e4hler beschreiben, zum Preis eines m\u00f6glichen weiteren Duplikats: ein nachlaufendes Delivery der ausscheidenden Inkarnation setzt das Fenster erneut zur\u00fcck."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_envelope_validation", "label": "Envelope-Validierung, bewusst nicht konfigurierbar", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Grenzen existieren, um Wire-Input zu begrenzen, und ein Limit, das der Sender anheben k\u00f6nnte, ist kein Limit."}, {"id": "docs_src_content_docs_de_delivery_consumer_controller_cluster_aware", "label": "Cluster-aware Zustellung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platziere den Consumer nah an den Daten seines Handlers; Cross-cluster-Delivery f\u00fcgt pro ACK eine Round-Trip hinzu."}], "edges": [{"source": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "target": "docs_src_content_docs_de_delivery_consumer_controller_dedup_triple", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/delivery/consumer-controller.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_delivery_consumer_controller_consumercontroller", "target": "docs_src_content_docs_de_del