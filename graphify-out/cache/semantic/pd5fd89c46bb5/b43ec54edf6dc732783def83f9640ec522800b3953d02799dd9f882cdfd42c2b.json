RACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_durable_state_stateadapter", "target": "docs_src_content_docs_de_persistence_migration_envelope_format_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_durable_state_stateadapter", "target": "docs_src_content_docs_de_persistence_migration_overview_schema_evolution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_durable_state_optimistic_concurrency", "target": "docs_src_content_docs_de_persistence_journals_in_memory_journalconcurrencyerror", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/persistence/durable-state.mdx", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "durable_state_store_backends", "label": "DurableStateStore-Backends fuer DurableStateActor", "nodes": ["docs_src_content_docs_de_persistence_durable_state_durablestateactor", "docs_src_content_docs_de_persistence_journals_sqlite_sqlitedurablestatestore", "docs_src_content_docs_de_persistence_journals_libsql_libsqldurablestatestore", "docs_src_content_docs_de_persistence_journals_cloudflare_d1_d1durablestatestore", "docs_src_content_docs_de_persistence_journals_postgres_postgresdurablestatestore", "docs_src_content_docs_de_persistence_journals_mariadb_mariadbdurablestatestore", "docs_src_content_docs_de_persistence_journals_mssql_mssqldurablestatestore", "docs_src_content_docs_de_persistence_journals_mongodb_mongodurablest