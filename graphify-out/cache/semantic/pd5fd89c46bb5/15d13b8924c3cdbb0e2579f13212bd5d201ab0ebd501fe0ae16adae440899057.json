{"nodes": [{"id": "docs_src_content_docs_fundamentals_messages_discriminatedunion", "label": "Discriminated-union message convention", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buys compile-time exhaustiveness, type narrowing inside handlers, and wire-format stability \u2014 the wire carries no type identity of its own, so the discriminant has to travel inside the payload."}, {"id": "docs_src_content_docs_fundamentals_messages_kinddiscriminant", "label": "The kind discriminant", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kind, lowercase, kebab-case for multi-word \u2014 the single project-wide convention."}, {"id": "docs_src_content_docs_fundamentals_messages_immutability", "label": "Message immutability rules", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same message can be processed twice on restart or reliable re-delivery, and a cross-process send serializes at send time so the receiver gets a copy \u2014 an asymmetry where the local case sees mutation and the remote case does not."}, {"id": "docs_src_content_docs_fundamentals_messages_replytoref", "label": "reply-to ref idiom", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More verbose than a method call, but requests and replies decouple in time, the reply can come from a different actor than the one asked, and the same code works locally and cross-cluster."}, {"id": "docs_src_content_docs_fundamentals_messages_replytypegenerics", "label": "Reply-type generics", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a discriminated union for the reply too, so the caller can match on the reply kind; ActorRef<unknown> swallows the reply type and is a smell."}, {"id": "docs_src_content_docs_fundamentals_messages_commandeventsplit", "label": "Command vs Event split", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events are the durable record replayed on restart while commands are the transient request that produced them, so past-tense event names and imperative command names keep the line clear."}, {"id": "docs_src_content_docs_fundamentals_messages_nofunctionsinmessages", "label": "No functions or methods in messages", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No process boundary carries function pointers: the cluster wire drops the frame with an error log, the WebSocket bridge drops it silently, and a worker thread throws DataCloneError. It works in-process and breaks the moment the actor moves node."}], "edges": [{"source": "docs_src_content_docs_fundamentals_messages_replytoref", "target": "docs_src_content_docs_fundamentals_ask_pattern_ask", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_discriminatedunion", "target": "docs_src_content_docs_fundamentals_messages_kinddiscriminant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_discriminatedunion", "target": "docs_src_content_docs_fundamentals_messages_immutability", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_replytoref", "target": "docs_src_content_docs_fundamentals_messages_replytypegenerics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_immutability", "target": "docs_src_content_docs_fundamentals_messages_nofunctionsinmessages", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_commandeventsplit", "target": "docs_src_content_docs_fundamentals_messages_discriminatedunion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_discriminatedunion", "target": "docs_src_content_docs_fundamentals_pattern_matching_matchexhaustive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_replytoref", "target": "docs_src_content_docs_fundamentals_actor_senderoption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_messages_discriminatedunion", "target": "docs_src_content_docs_fundamentals_actor_actor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/messages.mdx", "source_location": null, "weight": 1}], "hyperedges": []}