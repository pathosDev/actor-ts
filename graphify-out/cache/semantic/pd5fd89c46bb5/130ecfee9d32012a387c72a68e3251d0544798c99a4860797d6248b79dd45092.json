": "docs_src_content_docs_de_operations_dead_letters_deadletter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_operations_troubleshooting_shutdown_dropped_messages", "target": "docs_src_content_docs_de_operations_deployment_kubernetes_termination_grace_period", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/de/operations/troubleshooting.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}