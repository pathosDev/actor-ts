{"nodes": [{"id": "docs_src_content_docs_io_overview_io_overview", "label": "I/O overview", "file_type": "document", "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_overview_broker_actor_pattern", "label": "Broker actor pattern", "file_type": "concept", "rationale": "Each protocol is wrapped in an actor that hides it behind a uniform contract \u2014 connect on preStart, publish events to subscribers, buffer outgoing messages while disconnected, reconnect with backoff, surface lifecycle events on the event stream.", "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_overview_available_brokers", "label": "Available broker catalogue", "file_type": "concept", "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_overview_subscriber_fan_out", "label": "Target-ref subscriber fan-out", "file_type": "concept", "rationale": "Different broker actors have different subscription semantics (a single topic for MQTT, a consumer-group plus topic list for Kafka) but the pattern is consistent: point the actor at a target ref via withTarget and receive the protocol's inbound messages as actor messages.", "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_overview_settings_precedence", "label": "Broker settings precedence", "file_type": "concept", "rationale": "Constructor argument > HOCON under a protocol-specific key > built-in defaults, so system-wide defaults live in application.conf and per-instance overrides in the constructor.", "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_overview_not_a_broker_actor", "label": "What is NOT a broker actor", "file_type": "rationale", "rationale": "One-shot HTTP requests belong in a plain fetch() inside onReceive \u2014 broker actors are for connections that span many messages. HTTP servers are a separate module with their own route DSL and three backends, because a server does not fit the one-connection-many-messages shape.", "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_io_overview_io_overview", "target": "docs_src_content_docs_io_overview_broker_actor_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_overview_io_overview", "target": "docs_src_content_docs_io_overview_available_brokers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_overview_io_overview", "target": "docs_src_content_docs_io_overview_subscriber_fan_out", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_overview_io_overview", "target": "docs_src_content_docs_io_overview_settings_precedence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_overview