{"nodes": [{"id": "devtools_ui_src_panels_actors_actorspanelcomponent_actors_panel", "label": "Actors panel", "file_type": "concept", "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devtools_ui_src_panels_actors_actorspanelcomponent_supervision_tree", "label": "Live supervision tree", "file_type": "concept", "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth counts messages waiting in the mailbox; a row shows the actor's own name when it has one, else the path segment, with the full path always on the row title."}, {"id": "devtools_ui_src_panels_actors_actorspanelcomponent_stale_group", "label": "Stale node group dimming", "file_type": "rationale", "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A node that stopped answering left a snapshot behind: its actors are not running and nobody knows what they are, so the group is dimmed and its state dots go neutral rather than reporting the green they had when the last tree arrived."}, {"id": "devtools_ui_src_panels_actors_actorspanelcomponent_track_by_path", "label": "Tracking tree rows by actor path", "file_type": "rationale", "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Angular forbids the outer loop variable in the inner track expression, and paths only collide ACROSS nodes, which is exactly why there is one tree model per node."}, {"id": "devtools_ui_src_panels_actors_actorspanelcomponent_stopped_retention", "label": "Stopped-actor retention window", "file_type": "concept", "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stopped actors are kept for a retention window and badged with how long ago they stopped, so a short-lived actor is still visible after the fact."}], "edges": [{"source": "devtools_ui_src_panels_actors_actorspanelcomponent_actors_panel", "target": "devtools_ui_src_panels_actors_actorspanelcomponent_supervision_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "weight": 1.0}, {"source": "devtools_ui_src_panels_actors_actorspanelcomponent_supervision_tree", "target": "devtools_ui_src_panels_actors_actorspanelcomponent_stale_group", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "weight": 1.0}, {"source": "devtools_ui_src_panels_actors_actorspanelcomponent_supervision_tree", "target": "devtools_ui_src_panels_actors_actorspanelcomponent_track_by_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "weight": 1.0}, {"source": "devtools_ui_src_panels_actors_actorspanelcomponent_actors_panel", "target": "devtools_ui_src_panels_actors_actorspanelcomponent_stopped_retention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "devtools-ui/src/panels/actors/ActorsPanelComponent.html", "source_location": null, "weight": 1.0}], "hyperedges": []}