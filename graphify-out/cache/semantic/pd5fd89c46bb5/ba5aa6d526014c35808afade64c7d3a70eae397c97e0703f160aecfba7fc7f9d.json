{"nodes": [{"id": "docs_src_content_docs_de_intro_learning_path_lernpfad", "label": "Lernpfad durch die Dokumentation", "file_type": "rationale", "source_file": "docs/src/content/docs/de/intro/learning-path.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Doku hat ~200 Seiten, groesstenteils Referenz; drei Lesereihenfolgen mappen sie je nach Ziel, statt eine lineare Reihenfolge zu erzwingen."}, {"id": "docs_src_content_docs_de_intro_learning_path_pfad_1_code_schreiben", "label": "Pfad 1 - Einfach Code schreiben", "file_type": "rationale", "source_file": "docs/src/content/docs/de/intro/learning-path.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sechs Seiten (Quickstart, Actor, Messages, Pattern Matching, ActorSystem, Ask Pattern) reichen, um in 30 Minuten produktiv zu sein; alles andere wird bei Bedarf gelesen."}, {"id": "docs_src_content_docs_de_intro_learning_path_pfad_2_modell_verstehen", "label": "Pfad 2 - Zuerst das Modell verstehen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/intro/learning-path.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuer Leser, die das konzeptionelle Bild vor dem Code wollen: Warum Actors, ActorSystem, Actor, Mailboxes+Dispatchers, Supervision+Death Watch, Coordinated Shutdown."}, {"id": "docs_src_content_docs_de_intro_learning_path_pfad_3_framework_migration", "label": "Pfad 3 - Von einem anderen Framework", "file_type": "rationale", "source_file": "docs/src/content/docs/de/intro/learning-path.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migration Overview zuerst, dann der spezifische Guide, dann Quickstart zur Bestaetigung; das zugrunde liegende Modell traegt sich von jedem Actor-Framework herueber."}, {"id