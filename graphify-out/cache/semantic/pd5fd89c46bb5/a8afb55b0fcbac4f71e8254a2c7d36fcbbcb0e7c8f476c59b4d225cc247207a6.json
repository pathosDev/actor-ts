{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_page", "label": "Replicated Snapshots", "file_type": "document", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "label": "ReplicatedSnapshot", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tr\u00e4gt state, vc, seenIds, die kanonische events-Historie, localSeq, journalSeqAtSnapshot, takenBy und takenAt \u2014 nicht nur State + Clock, damit ein out-of-order eintreffendes Remote-Event neu falten kann, ohne das gesamte Journal erneut zu lesen. Es ist ein normaler Snapshot-Blob, den bestehende Stores ohne \u00c4nderung handhaben."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_seenids", "label": "seenIds (Dedupe-Set)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Eintrag pro jemals beobachtetem Event, geschl\u00fcsselt \u00fcber dessen eventId; dass es gesnapshottet wird, ist der Grund, warum die Deduplizierung einen Restart \u00fcbersteht \u2014 und war vor der Entropie-Umstellung der Grund, warum eine gef\u00e4lschte Identit\u00e4t ein echtes Event dauerhaft unterdr\u00fcckte. Alte Snapshots tragen ${replica}#${seqAtReplica}-Keys; beide Formen koexistieren harmlos, weil nur auf Gleichheit verglichen wird."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_events_field", "label": "events \u2014 das schwerste Snapshot-Feld", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Actor mit 100k Events snapshottet 100k Envelopes auf die Festplatte."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_recovery_flow", "label": "Recovery-Flow mit Vector-Clock-Skip", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events, deren vc kausal vor der Snapshot-vc liegt, werden \u00fcbersprungen; nebenl\u00e4ufige rufen den Resolver. Der Skip-Fall ist das, was Snapshots die Recovery-Zeit begrenzen l\u00e4sst."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_snapshot_more_often", "label": "H\u00e4ufiger snapshotten als bei Single-Writer-ES", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replizierte Workloads akkumulieren Events von N Replicas gleichzeitig, und die Recovery muss die Conflict Resolution f\u00fcr jedes nicht gesnapshottete nebenl\u00e4ufige Event erneut ausf\u00fchren."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_shared_snapshot_store", "label": "Geteilter Snapshot-Store \u00fcber Replicas", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Replica stellt schneller wieder her, wenn sie den neuesten Snapshot von jeder Replica laden kann, nicht nur ihren eigenen; SqliteSnapshotStore ist f\u00fcr Replicated ES selten sinnvoll."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_vc_growth_retired_replicas", "label": "Vector Clocks wachsen mit pensionierten Replicas", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Snapshot speichert die vollst\u00e4ndige, ungeprunte Clock; VC-Garbage-Collection ist au\u00dferhalb des Umfangs f\u00fcr v1, es gibt keinen Pruning-Hook. In Ordnung f\u00fcr ein stabiles Cluster, ein Problem bei aggressiver Replica-Rotation."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_resolver_upgrades_are_schema_changes", "label": "Resolver-Upgrades sind Schema-\u00c4nderungen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots nicht \u00fcber Replicas mit unterschiedlichen Resolvern teilen \u2014 sonst sieht die Recovery inkonsistenten State; \u00fcber Standard-Migrationsmuster ausrollen."}], "edges": [{"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_seenids", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_events_field", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_vector_clocks_vectorclock", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_recovery_flow", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_replicatedsnapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_recovery_flow", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_snapshot_more_often", "target": "docs_src_content_docs_de_persistence_replicated_event_sourcing_snapshotting_recovery_flow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/snapshotting.mdx", "source_loc