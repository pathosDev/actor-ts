{"nodes": [{"id": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", "label": "Akka-(JVM)-Konzept-Mapping", "file_type": "concept", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "actor-ts ist der engste spirituelle Cousin von Akka im TypeScript-Umfeld; die meisten Konzepte mappen 1:1 und viele APIs sind identisch benannt."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_explicit_message_types", "label": "Explizite Nachrichten-Typen statt Any", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TypeScript braucht eine deklarierte Command-Union \u2014 Akkas Any laesst sich nicht uebersetzen. Ohne native Pattern-Matching-Syntax uebernimmt ts-pattern die Rolle."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_replyto_instead_of_sender", "label": "replyTo-Ref statt sender()", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sender() wird zu einer expliziten replyTo-Ref in der Nachricht (oder zu this.sender als Option) \u2014 typsicher und klar ueber den Vertrag."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_shard_id_derivation", "label": "extractShardId wird abgeleitet", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statt einer zweiten Funktion leitet actor-ts die Shard-Id aus extractEntityId + numShards ab (shardId = hash(entityId) % numShards); ClusterShardingSettings stehen inline als Optionen von start()."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_single_onevent_fold", "label": "Ein einziges onEvent statt receiveCommand/receiveRecover", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derselbe Fold laeuft beim Persistieren und bei der Recovery, und State wird zum expliziten Typ-Parameter statt zu einer zustandsbehafteten Variable."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_singleton_static_key", "label": "Singleton-Identitaet als Static", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Actor deklariert seine SingletonKey-Identitaet als Static und start gibt direkt den Proxy-ActorRef zurueck statt eines Handles zum Auspacken. Ein terminationMessage-Aequivalent gibt es nicht \u2014 ein Node, der die Rotation verlaesst, stoppt sein Kind ueber den normalen postStop-Pfad."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_akka_streams_not_available", "label": "Akka Streams sind nicht portiert", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keine Portierung; Promise-basierte Patterns oder eine separate Streams-Library treten an ihre Stelle. Auch PersistenceQuery existiert nur als AsyncIterable statt als reaktiver Stream."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_incremental_migration_akka", "label": "Migrations-Ansatz fuer eine bestehende Akka-App", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nicht alles auf einmal umschreiben: actor-ts in einem neuen Service vorlagern, einen Bounded Context nach dem anderen migrieren, Persistenz vorsichtig re-exportieren (Jackson-JSON-Events lassen sich mit einem EventAdapter lesen)."}, {"id": "docs_src_content_docs_de_migration_from_akka_jvm_what_is_better_ts", "label": "Was gegenueber der JVM besser ist", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nachrichten-Typen werden an der Compile-Grenze geprueft, Bun startet sub-100 ms statt 1+ Sekunde, keine JVM zum Ausliefern und ein einfacheres operationelles Modell."}], "edges": [{"source": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", "target": "docs_src_content_docs_de_migration_from_akka_jvm_explicit_message_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", "target": "docs_src_content_docs_de_migration_from_akka_jvm_replyto_instead_of_sender", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", "target": "docs_src_content_docs_de_migration_from_akka_jvm_shard_id_derivation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_from_akka_jvm_akka_concept_mapping", 