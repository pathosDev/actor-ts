{"nodes": [{"id": "docs_src_content_docs_cluster_cluster_client_clusterclient", "label": "ClusterClient", "file_type": "concept", "rationale": "Lets a non-member process tell and ask cluster-internal actors via receptionist contact points, with no gossip or membership; the escape hatch for external services, bridges and cross-cluster federation.", "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_client_clusterclientoptions", "label": "ClusterClientOptions", "file_type": "concept", "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_client_clusterclientreceptionist", "label": "ClusterClientReceptionist", "file_type": "concept", "rationale": "A per-system extension that resolves each envelope's target path against the local actor tree - there is no service registry to populate.", "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_client_connection_bound_reply", "label": "Replies follow the connection, not the payload", "file_type": "rationale", "rationale": "The envelope has no sender field at all: routing on one let any connected party choose the address this node replied to and opened a connection to. Deleting the field rather than checking it leaves nothing to get wrong next time. It is not authentication - only peer certificates make the claimed address true.", "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_cluster_client_failure_redaction", "label": "Redacted ask failure with correlation id", "file_type": "rationale", "rationale": "A failing actor's text is the same class of string as an HTTP 500's - file paths, SQL fragments, a stack - and a contact point is reachable from outside the cluster's boundary, so the client gets a fixed sentence and an id while the reason stays in the node's log. A path-not-found deliberately omits the node's own address.", "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_cluster_client_clusterclient", "target": "docs_src_content_docs_cluster_cluster_client_clusterclientoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_client_clusterclient", "target": "docs_src_content_docs_cluster_cluster_client_clusterclientreceptionist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_client_connection_bound_reply", "target": "docs_src_content_docs_cluster_cluster_client_clusterclientreceptionist", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_cluster_client_failure_redaction", "target": "docs_src_content_docs_cluster_cluster_client_clusterclientreceptionist", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/cluster-client.mdx", "source_location": null, "