{"nodes": [{"id": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "label": "SqliteSnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mit SqliteJournal gepaart das Standard-Single-Node-Produktions-Setup: durable, null Dependency auf Bun, Peer-Dep auf Node."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_sqlitesnapshotstoreoptions", "label": "SqliteSnapshotStoreOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt hier keine wal-Option; stattdessen bietet der Snapshot-Store keepN."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_busytimeoutms", "label": "busyTimeoutMs (Framework-Default 1000)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Treiber liefern unterschiedliche Defaults mit (0 ms bei bun:sqlite und node:sqlite, 5000 ms bei better-sqlite3), und das Warten ist synchron, blockiert also die Event-Loop - deshalb setzt das Framework einen eigenen Default."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_snapshots_table_schema", "label": "snapshots-Tabelle, PRIMARY KEY (persistence_id, sequence_nr)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gleiches Pattern wie das Journal; loadLatest liest die hoechste sequence_nr fuer die persistence_id."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_two_files_keep_operations_simple", "label": "Journal und Snapshot-Store als unabhaengige Dateien", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sie koennen auch in dieselbe Datei mit verschiedenen Tabellennamen - aber zwei Dateien halten Operationen einfacher: unabhaengiges Backup, unabhaengiges Vacuum."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_sqlite_snapshots_need_node_affinity", "label": "SQLite-Snapshots brauchen Knoten-Affinitaet", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bei Cassandra-Journal geht SQLite fuer Snapshots nur, wenn jede Entity immer auf demselben Node wiederhergestellt wird; fuer Sharded Entities muss auch der Snapshot-Store geteilt sein."}], "edges": [{"source": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "target": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_sqlitesnapshotstoreoptions", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_sqlitesnapshotstoreoptions", "target": "docs_src_content_docs_de_persistence_snapshot_stores_sqlite_busytimeoutms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/sqlite.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_store