{"nodes": [{"id": "docs_src_content_docs_fundamentals_actor_paths_actorpath", "label": "ActorPath", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An immutable value: child() returns a new path rather than mutating. The path identifies an actor uniquely within its system the way a filesystem path identifies a file."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_actorselection", "label": "ActorSelection", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A description of where to look rather than a handle; resolveOne retries every 10 ms until the deadline, which is what makes it useful when the caller races the actor spawn."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_anonymousnaming", "label": "$anonymous name synthesis", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A per-parent counter keeps spawn order legible while twelve random hex characters keep the path unguessable from outside \u2014 which matters because a path is an address."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_namevalidation", "label": "Actor name validation rules", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names are unique among siblings, must be a single path segment, and must not start with $. A separator or traversal segment would produce a path indistinguishable from a different actor including across the wire; the $ prefix is reserved so a hand-picked name cannot stand in for a framework-generated one."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_pathuid", "label": "ActorPath uid (incarnation marker)", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinguishes successive incarnations at the same path so messages aimed at the old one never land in the new one."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_toplevelpaths", "label": "Special top-level paths", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/temp is the odd one out \u2014 nothing under it is an actor. Ask synthesises a reply ref with a /temp path only because a reply crossing the cluster wire is addressed by path."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_systempaths", "label": "Inside /system", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group levels are real actors that hold grouping and supervision policy, groups are created on first use, and the layout is not a stable contract \u2014 match on it in a log query, never in application routing."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_clusterpaths", "label": "Cluster paths (host:port fragment)", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fragment tells the runtime which node an actor lives on; a bare path is local to the resolving system and the transport routes transparently either way."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_pathinjection", "label": "Path string-concat injection hazard", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An interpolated segment containing a slash or .. makes the parser walk into an unintended subtree \u2014 validate the segment or use refs."}, {"id": "docs_src_content_docs_fundamentals_actor_paths_refoverpath", "label": "Prefer refs over path lookup", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constructor injection is type-safe, does not depend on path-naming conventions and survives renames trivially; selection returns untyped refs."}], "edges": [{"source": "docs_src_content_docs_fundamentals_actor_paths_actorselection", "target": "docs_src_content_docs_fundamentals_actor_paths_actorpath", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_actor_paths_actorpath", "target": "docs_src_content_docs_fundamentals_actor_paths_pathuid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_actor_paths_anonymousnaming", "target": "docs_src_content_docs_fundamentals_actor_paths_namevalidation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/actor-paths.mdx", "source_location": null, "weight": 1}, {"source":