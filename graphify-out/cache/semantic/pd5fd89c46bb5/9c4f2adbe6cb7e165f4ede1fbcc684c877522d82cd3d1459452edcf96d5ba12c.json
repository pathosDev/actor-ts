{"nodes": [{"id": "src_persistence_object_storage_s3objectstoragebackend_s3objectstoragebackend", "label": "S3ObjectStorageBackend", "file_type": "code", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_integration_brokers_s3_docker_compose_s3_minio", "label": "MinIO service", "file_type": "code", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single node, single drive - no HA, this is a test. MINIO_ROOT_USER / MINIO_ROOT_PASSWORD are the runner's credentials; bucket creation is an init step inside the runner so cleanups stay co-located with the test rather than split across compose hooks."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_runner", "label": "S3 runner service", "file_type": "code", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S3_ENDPOINT http://minio:9000 - MinIO is reachable by service name, not localhost - with forcePathStyle because virtual-host style would need DNS for bucket.minio wired up separately. The runner keeps its own waitForPort as belts-and-braces for runtimes where compose healthcheck propagation is unreliable (Bun on Windows + Docker Desktop)."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_minio_over_localstack", "label": "MinIO over LocalStack", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MinIO boots in ~1-2s versus LocalStack's 10-15s so CI minutes stay tight, its S3 implementation is closest to the AWS spec (fewer quirks than R2/B2), and the images are stable and tagged. LocalStack S3 stays an optional secondary target that can be layered on later (#297)."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_minio_kms_secret_key", "label": "Built-in test KMS for SSE-AES256", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MinIO since ~mid-2025 refuses server-side-encryption PUTs - even plain AES256 - unless a KMS backend is configured; older releases accepted SSE without one, and pinning latest is what surfaced the policy change. The key is <keyname>:<32-byte base64 secret>, the same string every run so re-runs can read back previously-encrypted objects."}, {"id": "tests_integration_brokers_s3_docker_compose_s3_latest_tag_policy", "label": "Deliberate :latest image policy", "file_type": "rationale", "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated verbatim in nearly every suite: integration tests want upstream regressions to surface as soon as they ship, NOT whenever someone remembers to bump a pin. Production users pin a specific version themselves. The cost is that an upstream policy change (MinIO's KMS requirement for SSE) lands as a failing suite - which is the point."}], "edges": [{"source": "tests_integration_brokers_s3_docker_compose_s3_runner", "target": "tests_integration_brokers_s3_docker_compose_s3_minio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_runner", "target": "src_persistence_object_storage_s3objectstoragebackend_s3objectstoragebackend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_runner", "target": "tests_integration_brokers_lib_waitforport_waitforport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_minio_over_localstack", "target": "tests_integration_brokers_s3_docker_compose_s3_minio", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_minio_kms_secret_key", "target": "tests_integration_brokers_s3_docker_compose_s3_minio", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_latest_tag_policy", "target": "tests_integration_brokers_s3_docker_compose_s3_minio_kms_secret_key", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_minio_kms_secret_key", "target": "tests_integration_brokers_readme_operational_shape", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_s3_docker_compose_s3_minio_over_localstack", "target": "tests_integration_brokers_k8s_docker_compose_k8s_k3s_over_kind", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "tests/integration/brokers/s3/docker-compose.s3.yml", "source_location": null, "weight": 1.0}], "hyperedges": []}