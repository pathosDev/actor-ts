{"nodes": [{"id": "docs_src_content_docs_runtime_bun_bunruntime", "label": "Bun runtime", "file_type": "concept", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "actor-ts's primary runtime: tested first, benchmarked against, and assumed by the docs. Fast startup (~3-5x Node cold start, sub-100 ms), built-in SQLite and test runner, native HTTP/WebSocket, and fewer peer deps because Bun replaces ws, better-sqlite3 and others."}, {"id": "docs_src_content_docs_runtime_bun_bunsqlite", "label": "bun:sqlite built-in driver", "file_type": "concept", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## SQLite on Bun", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-detected by the framework, so SqliteJournal and the SQLite stores need no driver setup and no better-sqlite3 install on Bun."}, {"id": "docs_src_content_docs_runtime_bun_buntestrunner", "label": "bun:test with TestKit", "file_type": "concept", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## Running tests", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun's runner is drop-in compatible with Jest's describe/it/expect API and TestKit works directly against it."}, {"id": "docs_src_content_docs_runtime_bun_honobackendonbun", "label": "HonoBackend on Bun", "file_type": "rationale", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## TCP + HTTP", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The lightest HTTP backend on Bun because Hono builds on the WHATWG fetch adapter Bun already exposes; it is fast there and tree-shakes to a tiny bundle. For the broader Node ecosystem - Fastify plugins and middleware - stick with the default Fastify backend."}, {"id": "docs_src_content_docs_runtime_bun_bunperformance", "label": "Performance on Bun", "file_type": "concept", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## Performance on Bun", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rough single-process numbers: ~10M tell/sec on MicrotaskDispatcher, ~150K req/sec for trivial HTTP routes, ~50K SQLite event appends/sec, and a consistent startup-time win."}, {"id": "docs_src_content_docs_runtime_bun_bunlimitations", "label": "Bun-specific limitations", "file_type": "rationale", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## Bun-specific limitations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun strives for Node compatibility but is not bug-compatible - native bindings against the Node ABI and some streams-API edge cases misbehave. And cloud functions / Lambda typically require Node, so serverless targets should use Node."}, {"id": "docs_src_content_docs_runtime_bun_optionalprotocolpeers", "label": "Per-protocol optional peer installs", "file_type": "concept", "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## Creating a project", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kafkajs, mqtt, amqplib, nats, ioredis and the grpc packages are added only when the matching broker actor is used; most peer deps are skipped otherwise."}], "edges": [{"source": "docs_src_content_docs_runtime_bun_bunruntime", "target": "docs_src_content_docs_runtime_bun_bunsqlite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunruntime", "target": "docs_src_content_docs_runtime_bun_buntestrunner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunruntime", "target": "docs_src_content_docs_runtime_bun_honobackendonbun", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunruntime", "target": "docs_src_content_docs_runtime_bun_bunperformance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunruntime", "target": "docs_src_content_docs_runtime_bun_bunlimitations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunruntime", "target": "docs_src_content_docs_runtime_bun_optionalprotocolpeers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunsqlite", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## SQLite on Bun", "weight": 1.0}, {"source": "docs_src_content_docs_runtime_bun_bunperformance", "target": "docs_src_content_docs_reference_faq_permessageoverhead", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/runtime/bun.mdx", "source_location": "## Performance on Bun", "weight": 1.0}, {"source": "docs_src_