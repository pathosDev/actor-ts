{"nodes": [{"id": "docs_src_content_docs_de_observability_management_http_endpoints_health", "label": "GET /health", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Liveness; 503 mit status DOWN, wenn ein Liveness-Check fehlschlaegt."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_ready", "label": "GET /ready", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Readiness; das checks-Array enthaelt jeden Readiness-Check auf der Registry - die Framework-Checks cluster-membership und cluster-transport plus alles selbst Registrierte."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_clusterready", "label": "clusterReady", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Ergebnis von cluster-membership selbst, aus dem checks-Array zurueckgelesen statt separat berechnet: false bis der lokale Node Up erreicht, true wenn es gar keinen Cluster gibt."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_members", "label": "GET /cluster/members", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_leader", "label": "GET /cluster/leader", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "leader ist null, bevor ein Leader gewaehlt wurde; isSelf sagt, ob der lokale Node der Leader ist."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_shards", "label": "GET /cluster/shards?type=<name>", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "404, solange dieser Node keine Region oder Proxy fuer den Typ gestartet hat."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_shardmap_quelle", "label": "Die Antwort kommt aus ClusterSharding.shardMap", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frueher las der Endpunkt den DistributedData-Snapshot des Coordinators, wodurch eine 200 in Standardkonfiguration unerreichbar war: nichts startet diese Extension, und der Snapshot wird nur mit coordinatorStateStore geschrieben. Jetzt braucht es nur, dass der antwortende Node an dem Typ teilnimmt."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_version_zaehlt_broadcasts", "label": "version zaehlt Broadcasts, keine Shard-Zuweisungen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Erhoehung pro Publish, und ein Publish fasst einen Schwung Verschiebungen zusammen; takenAt und leader stempelt der antwortende Node, zwei Nodes koennen dieselbe version mit verschiedenen Zeitstempeln melden. Eine 200 mit leerem shardHome ist normal."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_metrics", "label": "GET /metrics", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in via enableMetricsEndpoint; Prometheus-Textformat."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_leave", "label": "POST /cluster/leave", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in; 202 mit dem Klartext-Wort leaving, der Leave ist Fire-and-forget. Der Node laeuft durch leaving/exiting/removed und kann im selben Prozess nicht rejoinen."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_down", "label": "POST /cluster/down", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in; 202 mit { downed } oder 404, wenn die Adresse unbekannt oder terminal ist. Destruktiv und irreversibel - hinter Auth und Audit-Logs gaten."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_eigene_routen", "label": "Eigene Routen via concat", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_response_format", "label": "Response-Format und Status-Codes", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads geben JSON, /metrics text/plain, /cluster/leave den Klartext-Body leaving; Fehler sind Klartext-Bodies statt strukturierter Objekte."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_auth_ipallowlist", "label": "auth + ipAllowlist auf managementRoutes (#312)", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die privilegierten Endpunkte akzeptieren standardmaessig anonyme Requests - nur sicher auf einem netzwerkisolierten Bind oder hinter einem Reverse-Proxy."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_policy_trennung", "label": "Policy-Trennung von auth und ipAllowlist", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auth wrappt nur die privilegierte Teilmenge, weil K8s-Probes nicht leicht einen Authorization-Header mitschicken koennen (authProtectHealth: true, wenn sie es koennen); ipAllowlist wrappt jeden Endpunkt, denn Netzwerk-Level-Isolation ist unabhaengig davon, wer authentifiziert ist."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_topologie_offenlegung", "label": "Read-only-Endpunkte legen interne Topologie offen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Member-Adressen, Rollen, Leader und Shard-Map - den Management-Server als sensibel behandeln, an ein internes Interface binden und mit ipAllowlist/auth schuetzen."}, {"id": "docs_src_content_docs_de_observability_management_http_endpoints_trustedproxies", "label": "trustedProxies in IpAllowlist", "file_type": "concept", "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ohne die Angabe liest der Default den Socket-Peer, und der ist hinter einem Proxy der Proxy."}], "edges": [{"source": "docs_src_content_docs_de_observability_management_http_endpoints_ready", "target": "docs_src_content_docs_de_observability_management_http_endpoints_clusterready", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_management_http_endpoints_shardmap_quelle", "target": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_shards", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_management_http_endpoints_version_zaehlt_broadcasts", "target": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_shards", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-endpoints.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_observability_management_http_endpoints_auth_ipallowlist", "target": "docs_src_content_docs_de_observability_management_http_endpoints_cluster_down", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/observability/management/http-end