{"nodes": [{"id": "docs_src_content_docs_http_html_xss_escapehtml", "label": "escapeHtml", "file_type": "concept", "rationale": "Escapes & < > \" ' and the backtick. Covers HTML element content and quoted attribute values only - not a script block, CSS, or a URL, which need their own encoding.", "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_html_xss_html_template", "label": "html tagged template", "file_type": "concept", "rationale": "Escapes every interpolation by default so building an HTML response is safe without thinking about it. SafeHtml values interpolate verbatim so fragments nest, arrays render item-by-item, null/undefined become empty, everything else is coerced and escaped.", "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_html_xss_safehtml", "label": "SafeHtml", "file_type": "concept", "rationale": "A brand marking already-safe HTML, which the template then interpolates verbatim instead of escaping.", "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_html_xss_rawhtml", "label": "rawHtml", "file_type": "rationale", "rationale": "Inserts its argument verbatim, so it trusts the caller absolutely: passing untrusted input reintroduces exactly the XSS the template prevents. Escaping neutralises markup but does not make attacker-authored HTML safe to render - sanitise with a dedicated library (sanitize-html, DOMPurify) before wrapping.", "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_html_xss_completehtml", "label": "completeHtml", "file_type": "concept", "rationale": "Sends SafeHtml as text/html; charset=utf-8 with X-Content-Type-Options: nosniff.", "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_http_html_xss_html_template", "target": "docs_src_content_docs_http_html_xss_escapehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_html_xss_html_template", "target": "docs_src_content_docs_http_html_xss_safehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_html_xss_rawhtml", "target": "docs_src_content_docs_http_html_xss_safehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_html_xss_completehtml", "target": "docs_src_content_docs_http_html_xss_safehtml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_html_xss_completehtml", "target": "docs_src_content_docs_http_middleware_security_headers_securityheaders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_http_html_xss_escapehtml", "target": "docs_src_content_docs_http_static_files_getfrombrowseabledirectory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/http/html-xss.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}