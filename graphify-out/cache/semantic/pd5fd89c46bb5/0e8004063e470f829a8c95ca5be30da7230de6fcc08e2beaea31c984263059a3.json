{"nodes": [{"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dispatcher_tuning", "label": "Dispatcher tuning", "file_type": "document", "rationale": "The dispatcher decides when actor messages run on the JavaScript event loop; the default is right for most apps, and this page covers when it is not.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_immediatedispatcher", "label": "ImmediateDispatcher", "file_type": "concept", "rationale": "The default: schedules via setImmediate and yields between each message so I/O callbacks interleave naturally, giving good HTTP latency at slightly higher per-message overhead.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_microtaskdispatcher", "label": "MicrotaskDispatcher", "file_type": "concept", "rationale": "About 50x faster scheduling by bypassing the event loop, but a CPU-tight actor on microtasks starves I/O; use only for compute-only workers that never await I/O.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_throughputdispatcher", "label": "ThroughputDispatcher", "file_type": "concept", "rationale": "Drains N queued turns per tick across every actor sharing it - turns, not messages, since an actor may only have one turn queued at a time. It earns its keep when a group of actors shares it.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dedicated_dispatcher_never_batches", "label": "A dedicated ThroughputDispatcher never batches", "file_type": "rationale", "rationale": "A dispatcher queue holds one turn per actor and an actor may only have one queued, so a dispatcher dedicated to a single actor never has a second unit to drain and its batch is always exactly 1.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_per_actor_throughput", "label": "Per-actor throughput budget", "file_type": "concept", "rationale": "withThroughput beats HOCON beats the built-in default of 16. The trade-off is fairness: budget times handler time is the delay every timer, socket read and other actor can see. A batch always ends early on an empty mailbox, stop, suspend or an exhausted throttle bucket.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_scheduling_round_trip_cost", "label": "Scheduling round trip dominates the message path", "file_type": "rationale", "rationale": "About 2.4 microseconds against a raw mailbox operation of tens of nanoseconds, which is why per-actor throughput is the setting with the largest effect and a faster queue moves the number far less than it feels like it should.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_tuning_dispatcher_tuning_wait_versus_handler_metrics", "label": "Mailbox wait versus handler latency", "file_type": "concept", "rationale": "High wait with low handler means dispatcher tuning helps; high handler means no dispatcher setting makes it faster and raising the budget makes latency worse for everything sharing the runtime.", "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dispatcher_tuning", "target": "docs_src_content_docs_operations_tuning_dispatcher_tuning_immediatedispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dispatcher_tuning", "target": "docs_src_content_docs_operations_tuning_dispatcher_tuning_microtaskdispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dispatcher_tuning", "target": "docs_src_content_docs_operations_tuning_dispatcher_tuning_throughputdispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dispatcher_tuning", "target": "docs_src_content_docs_operations_tuning_dispatcher_tuning_dedicated_dispatcher_never_batches", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/tuning/dispatcher-tuning.mdx", "source_location": null, "weight": 1.0}, {"source