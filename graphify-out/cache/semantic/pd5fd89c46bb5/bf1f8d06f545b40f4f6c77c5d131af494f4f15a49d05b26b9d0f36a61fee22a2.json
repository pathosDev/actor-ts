{"nodes": [{"id": "docs_src_content_docs_migration_from_akka_net_from_akka_net", "label": "From Akka.NET", "file_type": "document", "source_file": "docs/src/content/docs/migration/from-akka-net.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_net_concept_mapping", "label": "Akka.NET to actor-ts concept mapping", "file_type": "concept", "rationale": "There is no ReceiveActor base with Receive<T> registrations \u2014 one onReceive plus a pattern match is the idiom, message types are explicit rather than Receive<object>, and lambda-style behavior definition is not TypeScript-friendly.", "source_file": "docs/src/content/docs/migration/from-akka-net.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_net_sender_reply", "label": "Sender / reply translation", "file_type": "concept", "rationale": "Two options replace Sender.Tell: an explicit replyTo ref in the message, or this.sender as an Option. Prefer the explicit replyTo \u2014 it is type-safe and clear about the contract.", "source_file": "docs/src/content/docs/migration/from-akka-net.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_net_hocon_key_prefixes", "label": "HOCON root key difference", "file_type": "concept", "rationale": "Both frameworks use HOCON with the same format and conventions; only the root key and specific leaves differ \u2014 akka { cluster { seed-nodes ... } } versus actor-ts { cluster { gossip-interval ... } }.", "source_file": "docs/src/content/docs/migration/from-akka-net.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_net_what_you_give_up", "label": "What Akka.