{"nodes": [{"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_page", "label": "Wire-kompatible Datenbanken", "file_type": "document", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournal", "label": "PostgresJournal", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt kein CockroachJournal und kein YugabyteJournal \u2014 dasselbe Postgres-Backend steuert beide, weil sie das PostgreSQL-Wire-Protokoll sprechen."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournaloptions", "label": "PostgresJournalOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_cockroachdb", "label": "CockroachDB", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_yugabytedb", "label": "YugabyteDB (YSQL)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "YSQL liegt auf Port 5433 statt 5432; das Image initialisiert beim ersten Start seine System-Kataloge und braucht bis zu drei Minuten."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_journalconcurrencyerror", "label": "JournalConcurrencyError", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_sqlstate_classification", "label": "SQLSTATE-basierte Fehlerklassifikation", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Optimistic-Concurrency-Backstop matcht auf SQLSTATE, nie auf Meldungstext, weil YugabyteDB Postgres-Fehlermeldungen umformuliert (yugabyte-db#9294) \u2014 eine textbasierte Implementierung w\u00e4re still gescheitert und ein echter Konflikt k\u00e4me als generischer Fehler an."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_serialization_failure_40001", "label": "Serialisierungsfehler 40001 statt Unique-Verletzung 23505", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beide Engines fahren SERIALIZABLE und brechen die verlierende Transaktion ab, bevor sie den Primary Key erreicht \u2014 auf den Code zu matchen war notwendig, aber nicht ausreichend."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_head_reread", "label": "Head-Neulesen als Konfliktbeweis", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Contention-Abort beweist nur, dass die Engine ein Opfer gew\u00e4hlt hat, nicht dass jemand anderes geschrieben hat \u2014 sonst w\u00fcrde ein Lock-Wait-Timeout als fremder Append umgedeutet und der Caller liefe in eine Retry-Schleife gegen einen Head, der sich nie \u00e4ndert."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_shared_contract_suite", "label": "Geteilte Postgres-Contract-Suite", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beide Suiten fahren denselben Contract wie Postgres (Append, Ranged Reads, High-Water-Mark, Tags, keepN-Pruning, Durable-State-CAS, konkurrierende Appends), damit ein Upstream-Auseinanderlaufen einen CI-Job rot f\u00e4rbt statt in Produktion aufzutauchen."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_registerpostgresplugins", "label": "registerPostgresPlugins", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_distributed_write_latency", "label": "Verteilte Write-Latenz (Raft-Round-Trip)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchrone Konsens-Replikation macht aus einem lokalen fsync einen Raft-Round-Trip \u2014 aggressiver snapshotten und das Actor-System in derselben Region halten."}, {"id": "docs_src_content_docs_de_persistence_journals_wire_compatible_certified_surface_only", "label": "Zertifiziert ist nur die zertifizierte Oberfl\u00e4che", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Tag-Pfad von PersistenceQuery und alles au\u00dferhalb von Persistence sind nicht abgedeckt; Neon, Timescale, AlloyDB und Aurora funktionieren wahrscheinlich, stehen aber nicht in der Tabelle, weil 'wahrscheinlich' genau das Wort ist, das die Seite beseitigen soll."}], "edges": [{"source": "docs_src_content_docs_de_persistence_journals_wire_compatible_cockroachdb", "target": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_journals_wire_compatible_yugabytedb", "target": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournal", "target": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournaloptions", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_journals_wire_compatible_postgresjournal", "target": "docs_src_content_docs_de_persistence_journals_wire_compatible_registerpostgresplugins", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/journals/wire-compatible.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persiste