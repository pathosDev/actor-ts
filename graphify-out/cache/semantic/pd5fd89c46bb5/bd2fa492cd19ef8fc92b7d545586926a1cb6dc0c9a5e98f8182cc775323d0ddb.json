{"nodes": [{"id": "docs_src_content_docs_http_backends_fastify_fastifybackend", "label": "FastifyBackend (default)", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_backends_fastify_bodylimit", "label": "bodyLimit", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one option the framework fills in: unset it is 1 MiB, the same cap Express and Hono apply, so which requests are accepted does not change with the backend."}, {"id": "docs_src_content_docs_http_backends_fastify_trustproxy", "label": "trustProxy (trusted-subnet form)", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_backends_fastify_trustproxy_true_antipattern", "label": "trustProxy: true resolves to the client-controlled entry", "file_type": "rationale", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "true trusts every hop so proxy-addr never truncates and req.ip becomes the leftmost X-Forwarded-For entry; a numeric hop count only compares indexes and never addresses, so it believes the header on a request that passed no proxy."}, {"id": "docs_src_content_docs_http_backends_fastify_raw_fastify_access", "label": "withPlugin / raw fastify instance", "file_type": "rationale", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For plugins the DSL does not expose \u2014 JWT/OAuth, swagger validation, CORS, compression. Register route-owning plugins before binding actor-ts routes if the paths overlap."}, {"id": "docs_src_content_docs_http_backends_fastify_tls", "label": "Fastify TLS and mTLS options", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_http_backends_fastify_backend_lifecycle", "label": "Backend lifecycle (close drains in-flight)", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastify.close waits for in-flight requests before resolving, which pairs with coordinated shutdown service-unbind phase."}, {"id": "docs_src_content_docs_http_backends_fastify_hard_dependency", "label": "Fastify is a hard dependency", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It installs with the framework, unlike the Express and Hono backends, which are optional peer dependencies installed on demand."}, {"id": "docs_src_content_docs_http_backends_fastify_performance", "label": "Fastify throughput (150K-200K req/sec on Bun)", "file_type": "concept", "source_file": "docs/src/content/docs/http/backends/fastify.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastify is one of the fastest Node HTTP frameworks, so the framework actor-routing overhead is the next bottleneck for hot routes. Disable Fastify own logger \u2014 it duplicates actor-ts logging."}], "edges": [{"source": "docs_src_content_docs_http_backends_fastify_fastifybackend", "target": "do