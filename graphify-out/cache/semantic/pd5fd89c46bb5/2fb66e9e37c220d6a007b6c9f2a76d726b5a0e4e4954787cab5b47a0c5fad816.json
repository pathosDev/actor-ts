{"nodes": [{"id": "docs_src_content_docs_observability_devtools_dead_letters_dead_letters", "label": "DevTools dead-letters panel (page)", "file_type": "document", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_devtools_dead_letters_dead_letter_queue", "label": "The system dead-letter queue behind the panel", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A message becomes a dead letter when the recipient was stopped, never existed, or the path was wrong; nothing throws and nothing logs by default."}, {"id": "docs_src_content_docs_observability_devtools_dead_letters_store_setting", "label": "store setting: off, memory, persistent", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default because capturing every undelivered message costs memory. With store off the panel stays in the navigation and reports itself unavailable naming the setting, because an empty table cannot tell you whether nothing is broken or nothing is being recorded \u2014 opposite answers."}, {"id": "docs_src_content_docs_observability_devtools_dead_letters_filtering_by_recipient_subtree", "label": "Filtering by recipient subtree", "file_type": "concept", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtering happens on the server over the ring it already holds, and the summary counts what the filter selected rather than what the page shows."}, {"id": "docs_src_content_docs_observability_devtools_dead_letters_payload_sanitisation", "label": "Payload sanitisation and exposure", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth, entry count and string length are capped; a message cut to fit says truncated and one the queue could not keep says why, rather than showing a null that reads like an empty message. The panel exposes whatever your messages carry."}, {"id": "docs_src_content_docs_observability_devtools_dead_letters_replaying", "label": "Replaying stays in code, not in a button", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A button that re-sends production messages is a different kind of decision from a table that shows them. replay removes the entry before redelivering and remembers the message, so a second failure comes back as the same entry with a higher replayCount rather than a fresh one."}, {"id": "docs_src_content_docs_observability_devtools_dead_letters_why_it_polls", "label": "Why the panel polls", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The queue is a bounded ring the server already keeps, so a request is cheap \u2014 and pushing every capture would put DevTools on the delivery path of the very failures it is watching."}], "edges": [{"source": "docs_src_content_docs_observability_devtools_dead_letters_dead_letters", "target": "docs_src_content_docs_observability_devtools_dead_letters_dead_letter_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_dead_letters_dead_letter_queue", "target": "docs_src_content_docs_observability_devtools_dead_letters_store_setting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_dead_letters_dead_letters", "target": "docs_src_content_docs_observability_devtools_dead_letters_replaying", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_dead_letters_dead_letters", "target": "docs_src_content_docs_observability_devtools_dead_letters_payload_sanitisation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_dead_letters_dead_letters", "target": "docs_src_content_docs_observability_devtools_dead_letters_filtering_by_recipient_subtree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_devtools_dead_letters_why_it_polls", "target": "docs_src_content_docs_observability_devtools_dead_letters_dead_letter_queue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/devtools/dead-letters.mdx", "source_location": nu