{"nodes": [{"id": "docs_src_content_docs_fundamentals_pattern_matching_matchexhaustive", "label": "match().exhaustive() idiom", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The build catches an omitted variant, so a silently-dropped message never ships. Default to exhaustive; otherwise disables the check and is for when \"ignore the rest\" is genuinely the right semantic."}, {"id": "docs_src_content_docs_fundamentals_pattern_matching_armdelegationrule", "label": "Every match arm delegates to an onXxx handler", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hard house rule \u2014 even a one-liner delegates \u2014 so the matcher stays a scannable dispatch table and the logic lives in named handlers; the narrowing survives the hand-off through the variant-typed parameter."}, {"id": "docs_src_content_docs_fundamentals_pattern_matching_kindconvention", "label": "kind naming convention", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "type would collide with the TypeScript keyword and tag is less self-explanatory; kind is the common TS-land idiom, and it pays off in exhaustiveness checking, wire dispatch and editor auto-complete."}, {"id": "docs_src_content_docs_fundamentals_pattern_matching_otherwise", "label": ".otherwise versus .exhaustive", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_pattern_matching_patternbuilder", "label": "ts-pattern P pattern builder", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_pattern_matching_noinstanceofacrosswire", "label": "instanceof does not survive serialization", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Class identity is lost across the wire \u2014 the receiver reconstitutes a plain object \u2014 which is exactly why the framework standardizes on a kind string."}], "edges": [{"source": "docs_src_content_docs_fundamentals_pattern_matching_noinstanceofacrosswire", "target": "docs_src_content_docs_fundamentals_event_stream_classchannel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_pattern_matching_matchexhaustive", "target": "docs_src_content_docs_fundamentals_pattern_matching_armdelegationrule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_pattern_matching_matchexhaustive", "target": "docs_src_content_docs_fundamentals_pattern_matching_otherwise", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/pattern-matching.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_pattern_matching_matchexhaustive", "target": "docs_src_content_docs_fundam