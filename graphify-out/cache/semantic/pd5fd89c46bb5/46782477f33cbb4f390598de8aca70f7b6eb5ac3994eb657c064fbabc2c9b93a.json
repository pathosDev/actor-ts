{"nodes": [{"id": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "label": "DistributedDataOptions.withDurableStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nimmt direkt einen DurableStateStore, keinen Wrapper. Bei preStart laedt die Replika ihre persistierte Sicht, bevor sie Gossip beitritt; nach jedem update, Gossip-Merge und delete wird neu gespeichert. Durability ist pro Replika, jedes Cluster-Mitglied besitzt einen Datensatz."}, {"id": "docs_src_content_docs_de_distributed_data_durable_storage_durabledistributeddatastore", "label": "DurableDistributedDataStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Wrapper, den withDurableStore baut: positionaler Konstruktor ueber einem DurableStateStore plus Replika-ID, mit load/save/clear. Direkt nur fuer Tooling oder Tests anfassen."}, {"id": "docs_src_content_docs_de_distributed_data_durable_storage_durablestatestore", "label": "DurableStateStore-Backends fuer DistributedData", "file_type": "concept", "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "InMemory, Postgres, MariaDB und Object Storage werden unveraendert wiederverwendet - es gibt nichts DD-Spezifisches zu konfigurieren. Per-Node-lokal gibt partitions-tolerante Recovery, ein Shared Backend ueberlebt einen zerstoerten Node, kostet aber einen Start-Roundtrip und macht den Store zur geteilten Abhaengigkeit."}, {"id": "docs_src_content_docs_de_distributed_data_durable_storage_full_view_rewrite_tradeoff", "label": "Full-State-Rewrite pro Mutation", "file_type": "rationale", "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Es gibt keine Key-Whitelist: die gesamte lokale Sicht wird als ein Datensatz pro Replika unter ddata|<replicaId> geschrieben, jeder Wert ueber toJSON des CRDT. Damit schreibt jede Mutation den ganzen Datensatz neu - billig fuer kleinen heissen State, teuer bei grosser Sicht unter hoher Mutationsrate. Echt-fluechtiger State (Presence) gehoert gar nicht in den Store; fuer grossen State mit feingranularen Updates ist ein PersistentActor mit winzigen Appends die Alternative."}], "edges": [{"source": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "target": "docs_src_content_docs_de_distributed_data_durable_storage_durablestatestore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "target": "docs_src_content_docs_de_distributed_data_durable_storage_durabledistributeddatastore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_durabledistributeddatastore", "target": "docs_src_content_docs_de_distributed_data_durable_storage_durablestatestore", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_full_view_rewrite_tradeoff", "target": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "target": "docs_src_content_docs_de_distributed_data_overview_distributeddata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_withdurablestore", "target": "docs_src_content_docs_de_distributed_data_replication_gossip_replication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_durabledistributeddatastore", "target": "docs_src_content_docs_de_distributed_data_crdt_types_counters_gcounter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_full_view_rewrite_tradeoff", "target": "docs_src_content_docs_de_distributed_data_replication_full_state_gossip", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/distributed-data/durable-storage.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_distributed_data_durable_storage_full_view_rewrite_tradeoff", "target": "docs_src_content_docs_de_distributed_data_crdt_types_sets_orset", "relation": "references", "confidence": "EXTRACTED", "c