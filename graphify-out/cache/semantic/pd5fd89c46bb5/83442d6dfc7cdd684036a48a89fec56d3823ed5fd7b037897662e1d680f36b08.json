{"nodes": [{"id": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionconfig", "label": "EncryptionConfig (none / sse-s3 / sse-kms / client-aes256-gcm)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_client_side_aes_gcm", "label": "Client-Side-AES-GCM-Verschluesselung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deckt Bedrohungen ab, die Server-Side nicht kann: Account-Kompromittierung beim Lesen, Cloud-Provider-Kompromittierung, Audits, die 'wir halten die Schluessel' verlangen. Kostet CPU pro Op und Schluesselverwaltungs-Overhead - die meisten Apps sollten beides schichten."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_masterkeyring", "label": "MasterKeyRing (active + retired)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das version-Byte jedes Eintrags wird im Body-Manifest mitgefuehrt, damit die Entschluesselung den passenden Schluessel waehlen kann - das Fundament der Online-Rotation."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_hkdf_info_context_binding", "label": "HKDF-`info`-Kontextbindung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pflicht und bewusst ohne Default: ein gemeinsamer Default haette zwei Deployments mit demselben Master-Key byte-identische Subkeys pro persistenceId ableiten lassen - ein aus einem Prod-Dump wiederhergestelltes Staging haette Produktions-Blobs lesen koennen, ohne dass die Konfiguration das erwaehnt. info steht NICHT auf dem Wire, eine Aenderung macht jeden bestehenden Blob unlesbar bis ein Sweep ihn neu schreibt."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_body_integrity_hmac", "label": "Body-Integritaet (HMAC-SHA256)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verschluesselung ist keine Integritaet: ein unverschluesselter Body ist schlichtes JSON, und dazu gehoert beim DurableState-Store das revision-Feld, auf dem der Compare-and-Swap-Check aufsetzt. Der Integritaetsschluessel ist bewusst vom Encryption-Master-Key getrennt, denn die Bedrohung ist Manipulation, nicht Offenlegung."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_tag_is_mandatory_on_read", "label": "Ein konfiguriertes Tag ist beim Lesen verbindlich", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Bit, das 'dieser Body hat ein Tag' festhaelt, liegt im Body - wer ihn ueberschreiben kann, kann es loeschen und die 16 Tag-Bytes abschneiden. Hiesse ein fehlendes Tag 'Pruefung ueberspringen', schuetzte die Pruefung niemanden."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_allowuntaggedbodies", "label": "withAllowUntaggedBodies (Migrationsfenster)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solange gesetzt, wird ein Body ohne Tag von jedem akzeptiert - der Downgrade-Weg steht so lange offen wie das Fenster, also nach dem Rewrite wieder entfernen."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_storage_key_context_binding", "label": "Einen Body an seinen Storage-Key binden (AAD)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Tag beantwortet nur 'hat der Schluesselinhaber diese Bytes erzeugt?', nicht 'fuer dieses Objekt?'. integrityKey ist ein flaches Deployment-Geheimnis ohne Ableitung pro persistenceId, und HKDF salzt zwar mit der persistenceId, trennt aber nicht zwei Objekte einer pid - ein Snapshot liess sich also auf eine andere Sequenznummer desselben Actors einspielen. Der Key geht jetzt in AES-GCMs AAD bzw. laengenpraefigiert in die HMAC-Eingabe."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_requirecontextbinding", "label": "withRequireContextBinding", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ohne diese Forderung bleibt ein einziger echter Body von vor der Bindung ein Replay-Token fuer jeden Key im Bucket, denn das 'gebunden'-Bit ist ein Manifest-Byte wie jedes andere."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_rollback_protection", "label": "Rollback-Schutz (Durable State)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Replay ist fuer jeden Authentifikator unsichtbar: derselbe Body am selben Key, nur aelter, vom legitimen Schreiber erzeugt, mit echtem Tag. Es gibt nichts zu erkennen ausser dass dieser Prozess bereits eine hoehere Revision gesehen hat - die Untergrenze ist deshalb prozesslokal und ein Neustart vergisst sie."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionbyprefix", "label": "encryptionByPrefix (Per-persistenceId-Resolver)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_key_sources", "label": "Schluesselquellen (Env-Var, KMS-on-Load, Vault)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Env-Vars sind fuer alles sichtbar, das die Prozess-Umgebung lesen kann. KMS-on-Load ist besser: nur KMS-Zugriff ist noetig, um Schluessel wiederherzustellen."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_gradual_enablement", "label": "Verschluesselung schrittweise aktivieren", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Framework erkennt pro Payload ueber das Body-Manifest, ob das Encrypted-Flag gesetzt ist - alte Plaintext-Reads funktionieren weiter, waehrend neue Writes verschluesseln und ein Hintergrund-Sweep den Rest migriert."}, {"id": "docs_src_content_docs_de_persistence_object_storage_encryption_integrity_rotation_gap", "label": "Integritaet und Master-Key-Rotation greifen noch nicht ineinander (#739)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reEncryptObjectStorage uebergibt keinen Integritaetsschluessel, kann getaggte Bodies also nicht lesen. Eine anstehende Rotation abschliessen, bevor Integritaet auf einem Bucket aktiviert wird."}], "edges": [{"source": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionconfig", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_masterkeyring", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionconfig", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_hkdf_info_context_binding", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_client_side_aes_gcm", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionconfig", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_body_integrity_hmac", "target": "docs_src_content_docs_de_persistence_object_storage_encryption_tag_is_mandatory_on_read", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_