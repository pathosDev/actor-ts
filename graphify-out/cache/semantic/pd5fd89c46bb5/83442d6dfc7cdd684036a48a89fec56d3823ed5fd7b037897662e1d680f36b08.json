}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_integrity_rotation_gap", "target": "docs_src_content_docs_de_persistence_object_storage_key_rotation_reencryptobjectstorage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_encryptionconfig", "target": "docs_src_content_docs_de_persistence_object_storage_per_actor_policies_encryption_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_body_integrity_hmac", "target": "docs_src_content_docs_de_persistence_object_storage_snapshot_store_backend_objectstoragesnapshotstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_masterkeyring", "target": "docs_src_content_docs_de_persistence_migration_schema_registry_compatibility_checks", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_object_storage_encryption_rollback_protection", "target": "docs_src_content_docs_de_persistence_persistent_actor_concurrency_loss_stops_the_actor", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/de/persistence/object-storage/encryption.mdx", 