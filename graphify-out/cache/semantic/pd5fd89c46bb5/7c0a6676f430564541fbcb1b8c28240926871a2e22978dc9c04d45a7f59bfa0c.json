{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_event_stream_eventstream", "label": "Event-Stream", "file_type": "concept", "rationale": "Loose coupling for cross-cutting concerns: the publisher knows no subscriber and no subscriber knows the publisher.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_eventchannel", "label": "EventChannel", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_eventkey", "label": "EventKey", "file_type": "rationale", "rationale": "Gives a plain kind-tagged type the call shape a class gets for free, keeps the predicate typed, and makes the kind string checkable \u2014 a bare string silently never matches when misspelled.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_kind_channel", "label": "Kind-Channel", "file_type": "rationale", "rationale": "A kind channel matches exactly one kind \u2014 kinds have no base, so there is no way to say 'every billing.* event'; the empty string is rejected outright because it reads like 'everything'.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_class_channel", "label": "Klassen-Channel (instanceof, Subklassen-Zustellung)", "file_type": "concept", "rationale": "Class channels match via instanceof so subclass instances reach base-class subscribers, which makes hierarchical event taxonomies cheap; everything the framework itself publishes is a class.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_predicate_filtering", "label": "Predicate-Filterung", "file_type": "rationale", "rationale": "Bus-side filtering beats filtering in each subscriber for high-frequency channels; predicate-carrying subscriptions do not dedupe because predicate functions have no identity contract.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_deadletter", "label": "DeadLetter (Event)", "file_type": "concept", "rationale": "Publishing is all that happens to it \u2014 nothing logs or retains it, so without a subscriber a dead letter is simply gone.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_subscriber_release_on_stop", "label": "Gestoppte Subscriber werden freigegeben", "file_type": "concept", "rationale": "The recipient set is fixed when publish is called, so an unsubscribe during delivery takes effect from the next event and the in-flight one lands in /deadLetters.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_event_stream_currentclusterstate_exclusion", "label": "CurrentClusterState erreicht den Bus nie", "file_type": "rationale", "rationale": "It tells one subscriber where it starts, which is news to nobody else, so it goes only to the listener that asked via cluster.subscribe with replayMode snapshot.", "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_fundamentals_event_stream_eventstream", "target": "docs_src_content_docs_de_fundamentals_event_stream_eventchannel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_eventchannel", "target": "docs_src_content_docs_de_fundamentals_event_stream_eventkey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_eventchannel", "target": "docs_src_content_docs_de_fundamentals_event_stream_kind_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_eventchannel", "target": "docs_src_content_docs_de_fundamentals_event_stream_class_channel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_predicate_filtering", "target": "docs_src_content_docs_de_fundamentals_event_stream_eventkey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_deadletter", "target": "docs_src_content_docs_de_fundamentals_event_stream_eventstream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_subscriber_release_on_stop", "target": "docs_src_content_docs_de_fundamentals_event_stream_deadletter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_currentclusterstate_exclusion", "target": "docs_src_content_docs_de_fundamentals_event_stream_eventstream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_eventstream", "target": "docs_src_content_docs_de_fundamentals_dispatchers_dispatchererror", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_kind_channel", "target": "docs_src_content_docs_de_fundamentals_messages_kind_discriminant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/fundamentals/event-stream.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_fundamentals_event_stream_eventstream", "target": "docs_src_content_docs_de_fundamentals_messages_message", "relation": "references", "confidence"