{"nodes": [{"id": "docs_src_content_docs_migration_overview_migration_guides", "label": "Migration guides overview", "file_type": "document", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_conceptual_cheatsheet", "label": "Actor-framework conceptual cheatsheet", "file_type": "concept", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_from_akka_jvm", "label": "from-akka-jvm migration guide", "file_type": "document", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_from_pekko", "label": "from-pekko migration guide", "file_type": "document", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_from_orleans", "label": "from-orleans migration guide", "file_type": "document", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_from_akka_net", "label": "from-akka-net migration guide", "file_type": "document", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_from_vanilla_ts", "label": "from-vanilla-ts migration guide", "file_type": "document", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_what_carries_over", "label": "What carries over from any actor framework", "file_type": "concept", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_overview_incremental_migration", "label": "Incremental migration", "file_type": "rationale", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migration is rarely one-shot: run a small actor system alongside existing code, migrate one stateful concept (a registry, a job-runner) while HTTP handlers still call it like a service, then add clustering and persistence as you go. You do not have to rewrite everything to benefit."}, {"id": "docs_src_content_docs_migration_overview_typescript_specific_differences", "label": "TypeScript-specific differences", "file_type": "rationale", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No fibers and no JVM: JavaScript is single-threaded per process, so scheduling rides the microtask and macrotask queues. The typed Behaviors API is Akka-Typed-inspired but not identical, and ts-pattern stands in for the native match expressions TypeScript lacks."}, {"id": "docs_src_content_docs_migration_overview_smaller_surface", "label": "Smaller surface than Akka", "file_type": "rationale", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Akka Streams is not ported (use Promise-based patterns or a separate library), FSM exists but with a different API shape, and the framework deliberately targets the 80 percent of features rather than parity."}, {"id": "docs_src_content_docs_migration_overview_different_defaults", "label": "Different defaults", "file_type": "rationale", "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bun is the primary runtime with Node supported and Deno best-effort, JSON is the default serializer with CBOR and custom available, and Kubernetes is the assumed deployment target - which is why seed discovery, lease and management endpoints are first-class."}], "edges": [{"source": "docs_src_content_docs_migration_overview_migration_guides", "target": "docs_src_content_docs_migration_overview_conceptual_cheatsheet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_overview_migration_guides", "target": "docs_src_content_docs_migration_overview_from_akka_jvm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_overview_migration_guides", "target": "docs_src_content_docs_migration_overview_from_pekko", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_overview_migration_guides", "target": "docs_src_content_docs_migration_overview_from_orleans", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/overview.mdx", "source_location": null, "weight":