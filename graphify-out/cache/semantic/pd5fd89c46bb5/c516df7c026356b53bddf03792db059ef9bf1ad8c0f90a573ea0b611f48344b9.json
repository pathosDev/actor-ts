{"nodes": [{"id": "docs_src_content_docs_testing_multi_node_spec_multinodespec", "label": "MultiNodeSpec", "file_type": "concept", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs N real ActorSystems as cluster nodes inside one test process over an in-process transport - real cluster semantics (gossip, failure detection, sharding rebalance) without Docker or ports."}, {"id": "docs_src_content_docs_testing_multi_node_spec_multinodespecoptions", "label": "MultiNodeSpecOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "roles, seedRoles, addresses, failureDetector, gossipIntervalMs (100 ms vs 1 s in production), awaitTimeoutMs, logLevel and a per-role downing provider."}, {"id": "docs_src_content_docs_testing_multi_node_spec_roles_seeds_addresses", "label": "Roles, seeds and addresses", "file_type": "concept", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each role string is both the node's identity and its ActorSystem name and must be unique (the constructor throws otherwise); the first role is the sole seed by default and ports are auto-allocated on 127.0.0.1 unless pinned."}, {"id": "docs_src_content_docs_testing_multi_node_spec_crash_and_leave", "label": "crash() and leave()", "file_type": "concept", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "crash yanks a node's transport out abruptly so peers must detect it through the failure detector and then down it; leave performs a graceful cluster exit."}, {"id": "docs_src_content_docs_testing_multi_node_spec_multinode_await_helpers", "label": "awaitMembers / awaitMemberStatus / awaitLeader", "file_type": "concept", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polling helpers that replace fragile setTimeout sleeps: they return as soon as the cluster condition holds, or throw after awaitTimeoutMs."}, {"id": "docs_src_content_docs_testing_multi_node_spec_no_serialization_in_multinodespec", "label": "MultiNodeSpec does not exercise serialization", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Messages pass between nodes by reference in-process, so serialization-dependent bugs never surface; ParallelMultiNodeSpec only half-closes the gap because structured clone accepts payloads the wire refuses."}, {"id": "docs_src_content_docs_testing_multi_node_spec_no_thread_isolation", "label": "No thread isolation", "file_type": "rationale", "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All nodes share the test process's event loop and heap, so a genuine OOM on one node takes the test with it; the worker-thread variant exists for that."}], "edges": [{"source": "docs_src_content_docs_testing_multi_node_spec_multinodespec", "target": "docs_src_content_docs_testing_multi_node_spec_multinodespecoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/testing/multi-node-spec.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_testing_multi_node_spec_multinodespec", "target": "docs_src_conten