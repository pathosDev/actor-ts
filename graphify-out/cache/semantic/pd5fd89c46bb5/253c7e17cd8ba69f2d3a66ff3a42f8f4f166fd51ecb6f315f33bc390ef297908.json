{"nodes": [{"id": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "label": "InMemorySnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots in a Map<persistenceId, Snapshot[]> in process memory - the default when nothing is configured, ideal for tests, never for production (a restart loses every snapshot, so recovery falls back to full replay and defeats the point). Its behavior is the reference semantics every other snapshot store must match."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_in_memory_snapshotstoreoperations", "label": "save / loadLatest / loadBefore / delete", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": "## What it does", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The four SnapshotStore operations, with each persistenceId mapping to an array ordered by sequence number."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorykeepndefault", "label": "Unset keepN keeps every snapshot", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": "## Retention", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one place this store deliberately differs from the family, where every persistent store defaults to keepN 3. This is the store you get when nothing is configured, so a default bound would change what every unconfigured application retains without anyone asking for it - opt in explicitly instead."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_in_memory_replaceatsamesequence", "label": "Re-saving at an existing sequence replaces", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": "## Retention", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rather than appending a second snapshot, matching the relational stores' (persistence_id, sequence_nr) primary key."}], "edges": [{"source": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_in_memory_snapshotstoreoperations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorykeepndefault", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_in_memory_replaceatsamesequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "target": "docs_src_content_docs_persistence_snapshots_snapshotstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/in-memory.mdx", "source_location": "## What it does", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemor