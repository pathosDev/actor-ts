{"nodes": [{"id": "docs_src_content_docs_persistence_object_storage_overview_objectstoragebackend", "label": "ObjectStorageBackend", "file_type": "document", "rationale": "A deliberately small surface \u2014 put / get / delete / list plus CAS options \u2014 so it fits AWS S3, MinIO, R2, B2, Wasabi and anything else S3-compatible.", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_overview_filesystemobjectstoragebackend", "label": "FilesystemObjectStorageBackend", "file_type": "document", "rationale": "Objects as files under a root directory \u2014 the same code path as production with no network, no S3 cost and no MinIO container, for tests, local dev and small single-node deployments.", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_overview_s3objectstoragebackend", "label": "S3ObjectStorageBackend", "file_type": "document", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_overview_objectstoragedurablestatestore", "label": "ObjectStorageDurableStateStore", "file_type": "document", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_overview_cas_ifmatch", "label": "CAS via ifMatch / ifNoneMatch", "file_type": "rationale", "rationale": "ifMatch gives compare-and-set writes (a differing ETag fails with ObjectStorageConcurrencyError) and ifNoneMatch:'*' is create-only, which is how ObjectStorageDurableStateStore detects concurrent writers without separate coordination. Some older S3-compatible stores ignore these headers, so the backends throw clearly rather than silently proceeding \u2014 test CAS against your provider first.", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_overview_object_key_layout", "label": "Object key layout", "file_type": "document", "rationale": "state/<persistenceId> for durable state and snapshots/<persistenceId>/seq-<n> for snapshots. The framework manages the layout; distributing keys across prefixes also helps with AWS S3's per-prefix request limits.", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_persistence_object_storage_overview_when_to_use_object_storage", "label": "When object storage is the right backend", "file_type": "rationale", "rationale": "Cloud-native stacks, shared persistence across cluster nodes without running Cassandra, KMS server-side encryption, and unbounded capacity. It sits between SQLite (simpler for single node) and Cassandra (faster for high-throughput multi-node): 20-50 ms per put versus sub-millisecond on the filesystem backend.", "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_persistence_object_storage_overview_objectstoragedurablestatestore", "target": "docs_src_content_docs_persistence_overview_durablestatestore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_overview_filesystemobjectstoragebackend", "target": "docs_src_content_docs_persistence_object_storage_overview_objectstoragebackend", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_overview_s3objectstoragebackend", "target": "docs_src_content_docs_persistence_object_storage_overview_objectstoragebackend", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_overview_cas_ifmatch", "target": "docs_src_content_docs_persistence_object_storage_overview_objectstoragedurablestatestore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_overview_when_to_use_object_storage", "target": "docs_src_content_docs_persistence_object_storage_overview_objectstoragebackend", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/object-storage/overview.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_object_storage_overview_objectstoragedurablestatestore", "target": "docs_src_content_docs_persistence_object_storage_overview_objectstoragebackend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs