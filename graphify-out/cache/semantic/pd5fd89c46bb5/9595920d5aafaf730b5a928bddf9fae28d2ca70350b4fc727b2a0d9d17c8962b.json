{"nodes": [{"id": "docs_src_content_docs_observability_tracing_recording_tracer_recording_tracer", "label": "Recording tracer", "file_type": "document", "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_observability_tracing_recording_tracer_recordingtracer", "label": "RecordingTracer", "file_type": "concept", "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The test counterpart to otelTracer: instead of exporting spans it stores them in memory for tests to assert on."}, {"id": "docs_src_content_docs_observability_tracing_recording_tracer_recordedspan", "label": "RecordedSpan", "file_type": "concept", "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name, kind, context, parent, start and end times, attributes, status, status message and recorded exceptions - enough to verify causality chains as well as attributes."}, {"id": "docs_src_content_docs_observability_tracing_recording_tracer_recorded_snapshot", "label": "RecordingTracer.recorded", "file_type": "concept", "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A snapshot of every span that ended - a span is captured only when end is called, so one that was started but never ended never shows up."}, {"id": "docs_src_content_docs_observability_tracing_recording_tracer_tracer_reset", "label": "RecordingTracer.reset", "file_type": "concept", "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a reset between tests, recorded spans accumulate across them."}, {"id": "docs_src_content_docs_observability_tracing_recording_tracer_test_only_tracer", "label": "Test-only by design", "file_type": "rationale", "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memory grows unbounded because every span is kept forever, so this is never a production tracer. It also does not serialize context cross-wire: it works in single-process multi-node tests where every node shares the process, but cross-process tracing tests need a real OTel pipeline."}], "edges": [{"source": "docs_src_content_docs_observability_tracing_recording_tracer_recording_tracer", "target": "docs_src_content_docs_observability_tracing_recording_tracer_recordingtracer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_tracing_recording_tracer_recording_tracer", "target": "docs_src_content_docs_observability_tracing_recording_tracer_recordedspan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_observability_tracing_recording_tracer_recording_tracer", "target": "docs_src_content_docs_observability_tracing_recording_tracer_recorded_snapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/observability/tracing/recording-tracer.mdx", "source_location": null, "weight": 1}, {"source": "d