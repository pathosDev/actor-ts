{"nodes": [{"id": "docs_src_content_docs_de_io_udp_udpsocketactor", "label": "UdpSocketActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Umschliesst einen UDP-Socket \u2014 verbindungslos, keine ACKs, keine Retries, paketorientiert. Fuer den Fall, dass Best-Effort-Zustellung reicht und Latenz wichtiger ist als Zuverlaessigkeit."}, {"id": "docs_src_content_docs_de_io_udp_udpsocketoptionstype", "label": "UdpSocketOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "target ist das einzige Pflichtfeld \u2014 ohne es haetten eingehende Datagramme kein Ziel."}, {"id": "docs_src_content_docs_de_io_udp_udpdatagram", "label": "UdpDatagram", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traegt payload plus die Absenderadresse (remoteHost / remotePort); beim Senden traegt das Datagramm sein eigenes Ziel, weil UDP verbindungslos ist."}, {"id": "docs_src_content_docs_de_io_udp_bind_address_security", "label": "Bind-Adresse 0.0.0.0", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Default lauscht auf allen Interfaces. Auf einem multi-homed oder internet-exponierten Host gehoert eine konkrete interne Adresse gesetzt, damit der Socket nicht aus nicht-vertrauenswuerdigen Netzen erreichbar ist (security audit BRK-5)."}, {"id": "docs_src_content_docs_de_io_udp_packet_is_one_logical_message", "label": "Ein Paket ist eine logische Nachricht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UDP erhaelt Paketgrenzen, anders als TCPs Byte-Stream \u2014 ein eingehendes Datagramm wird deshalb auf genau ein UdpDatagram abgebildet, ohne Framing."}, {"id": "docs_src_content_docs_de_io_udp_send_only_mode", "label": "Nur-Senden-Betrieb", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "target bleibt Pflicht, aber ohne withBindPort bindet der Socket an einen ephemeren Port \u2014 ein reiner Sender fuer einseitige Telemetrie wie statsd oder syslog."}, {"id": "docs_src_content_docs_de_io_udp_no_delivery_guarantee", "label": "Keine Zustellgarantie", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UDP ist Fire-and-Forget: das Framework sendet, ob das Netz zustellt, ist nicht wissbar. Wer es wissen muss, baut Acknowledgment ins Protokoll ein oder nimmt TCP."}, {"id": "docs_src_content_docs_de_io_udp_mtu_fragmentation", "label": "MTU liegt typischerweise um 1500 Bytes", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pakete ueber der Pfad-MTU fragmentieren auf der IP-Schicht, und Verlust eines Fragments verliert das ganze Paket. Payloads <= 1400 Bytes halten heisst, das zu vermeiden."}, {"id": "docs_src_content_docs_de_io_udp_when_udp", "label": "Wann UDP", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Telemetrie, LAN-Service-Discovery, hochfrequente Low-Stakes-Daten. Nicht fuer alles, was Zustellgarantie, Reihenfolge oder Payloads ueber der MTU braucht."}], "edges": [{"source": "docs_src_content_docs_de_io_udp_udpsocketactor", "target": "docs_src_content_docs_de_io_udp_udpsocketoptionstype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_udpsocketactor", "target": "docs_src_content_docs_de_io_udp_udpdatagram", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_bind_address_security", "target": "docs_src_content_docs_de_io_udp_udpsocketoptionstype", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_packet_is_one_logical_message", "target": "docs_src_content_docs_de_io_udp_udpdatagram", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_send_only_mode", "target": "docs_src_content_docs_de_io_udp_udpsocketactor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_no_delivery_guarantee", "target": "docs_src_content_docs_de_io_udp_udpsocketactor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_mtu_fragmentation", "target": "docs_src_content_docs_de_io_udp_udpsocketactor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_when_udp", "target": "docs_src_content_docs_de_io_udp_udpsocketactor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_udpsocketactor", "target": "docs_src_content_docs_de_io_overview_brokeractor", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_udpsocketactor", "target": "docs_src_content_docs_de_io_tcp_tcpsocketactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_udp_packet_is_one_logical_message", "target": "docs_src_content_docs_de_io_tcp_tcp_gives_bytes_not_messages", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/udp.mdx", "source_location": null, "weight": 1}], "hyperedges": []}