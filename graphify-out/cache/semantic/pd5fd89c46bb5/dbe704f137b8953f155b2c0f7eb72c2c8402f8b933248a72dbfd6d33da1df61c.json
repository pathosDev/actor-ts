{"nodes": [{"id": "docs_src_content_docs_coordination_overview_lease", "label": "Lease API", "file_type": "concept", "rationale": "A distributed lock with a TTL giving the single-holder guarantee that membership-only mechanisms cannot provide, for singletons and sharding coordinators.", "source_file": "docs/src/content/docs/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_coordination_overview_leaseoptionstype", "label": "LeaseOptionsType", "file_type": "code", "rationale": "ttlMs 15-30s is short enough to recover from a crashed holder and long enough to tolerate gossip and renewal delays; renewalIntervalMs around ttl/3 means one failed renew does not lose the lease.", "source_file": "docs/src/content/docs/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_coordination_overview_lease_lifecycle", "label": "Lease lifecycle", "file_type": "concept", "rationale": "not-held to acquired to renewing and back; the TTL is critical because a holder that crashes without release loses the lease automatically when it expires.", "source_file": "docs/src/content/docs/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_coordination_overview_single_holder_guarantee", "label": "Single-holder guarantee", "file_type": "rationale", "rationale": "At most one holder at a time \u2014 but only as good as the backend's consistency; K8s leases ride the strongly consistent etcd store, in-memory leases give nothing across processes.", "source_file": "docs/src/content/docs/coordination/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_coordination_overview_paranoid_safe"