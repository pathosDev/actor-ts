{"nodes": [{"id": "docs_src_content_docs_de_fundamentals_dispatchers_dispatcher", "label": "Dispatcher", "file_type": "concept", "rationale": "Chooses between the microtask and macrotask queue, which is a real throughput/fairness/latency trade-off in a single-threaded runtime.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_microtaskdispatcher", "label": "MicrotaskDispatcher", "file_type": "concept", "rationale": "Fastest and lowest overhead, but can starve I/O and timers under sustained actor load; also preferred in tests that need deterministic ordering.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_immediatedispatcher", "label": "ImmediateDispatcher (Default)", "file_type": "rationale", "rationale": "Default because fairness with I/O is the right trade for HTTP servers and broker-backed actors, both common in actor-ts applications.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_throughputdispatcher", "label": "ThroughputDispatcher", "file_type": "concept", "rationale": "The only built-in that keeps its own queue; it is a RingBuffer for the same reason a mailbox is, because it is deepest exactly when the system is busiest.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_dispatcher_interface", "label": "Dispatcher-Interface", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_dispatchererror", "label": "DispatcherError", "file_type": "rationale", "rationale": "An alarm, not a metric: it fires only for failures supervision structurally cannot see, so the channel is quiet by nature and traffic on it means something below the actors is broken.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_per_actor_dispatcher", "label": "Per-Actor-Dispatcher", "file_type": "concept", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_tracingdispatcher", "label": "TracingDispatcher (Wrap-and-Delegate)", "file_type": "concept", "rationale": "Wrap-and-delegate keeps the underlying scheduling behaviour and only adds a cross-cutting concern such as tracing or metering.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_fundamentals_dispatchers_sync_dispatcher_antipattern", "label": "Synchroner Dispatcher (Antipattern)", "file_type": "rationale", "rationale": "Synchronous execution breaks the actor-model invariants: tell stops being fire-and-forget and the receiver's await blocks the caller's stack.", "source_file": "docs/src/content/docs/de/fundamentals/dispatchers.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc