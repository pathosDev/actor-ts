{"nodes": [{"id": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "label": "CachedSnapshotStore (Decorator)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nur einsetzen, wenn der zugrunde liegende Store messbare Read-Latenz hat - fuer lokale SQLite-Snapshots fuegt der Cache Overhead ohne Nutzen hinzu. Der zugrunde liegende Store ist das erste Konstruktor-Argument, keine Option."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstoreoptions", "label": "CachedSnapshotStoreOptionsType (cache / ttlMs / keyPrefix)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "keyPrefix (Default 'snap:') verhindert Kollisionen in geteilten Caches."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cache_backend", "label": "Backing-Cache (In-Memory / Redis / Memcached)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auf Redis oder Memcached gestuetzt liest jeder Knoten aus demselben Cache, ein auf einem Knoten geladener Snapshot ist auf allen anderen ein Treffer; in-memory behaelt jeder Knoten seine eigene Kopie."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_write_through_with_invalidate", "label": "save = Write-Through mit Invalidierung, kein Write-Back", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Im Cluster koennen zwei Knoten beim Save konkurrieren; ein lokaler Write-Back wuerde einen veralteten Eintrag hinterlassen. Der naechste Read fuellt neu, und die TTL ist das Sicherheitsnetz, falls ein Knoten zwischen Write und Invalidierung abstuerzt."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_loadbefore_not_cached", "label": "loadBefore wird nicht gecacht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zu viele moegliche seq-Werte, und selten genutzt - nur bei Recovery."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cache_assumes_sole_writer", "label": "Der Cache nimmt an, er sei der einzige Writer", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schreibt etwas anderes in den zugrunde liegenden Store (manuelles SQL-Update, Batch-Backfill), liefert er veraltete Daten - dann TTL setzen oder manuell invalidieren."}], "edges": [{"source": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstoreoptions", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstoreoptions", "target": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cache_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_write_through_with_invalidate", "target": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_loadbefore_not_cached", "target": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cache_assumes_sole_writer", "target": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_cache_backend", "target": "docs_src_content_docs_de_persistence_snapshot_stores_cached_snapshot_store_write_through_with_invalidate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/co