{"nodes": [{"id": "tests_integration_brokers_libsql_docker_compose_libsql_libsql", "label": "sqld (libSQL server) service", "file_type": "code", "source_file": "tests/integration/brokers/libsql/docker-compose.libsql.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standalone primary - no replication, which is all the contract needs; HTTP listener on 0.0.0.0:8080. This is the libSQL server Turso runs."}, {"id": "tests_integration_brokers_libsql_docker_compose_libsql_runner", "label": "libSQL runner service", "file_type": "code", "source_file": "tests/integration/brokers/libsql/docker-compose.libsql.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIBSQL_URL http://libsql:8080 - http:// rather than libsql:// so @libsql/client uses plain HTTP instead of trying to upgrade to a WebSocket first."}, {"id": "tests_integration_brokers_libsql_docker_compose_libsql_distroless_no_healthcheck", "label": "No compose healthcheck (distroless sqld image)", "file_type": "rationale", "source_file": "tests/integration/brokers/libsql/docker-compose.libsql.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sqld image is distroless-ish and ships neither a shell nor curl, so a compose healthcheck has nothing to run. The runner waits on the port itself via waitForPort, then retries its first statement."}], "edges": [{"source": "tests_integration_brokers_libsql_docker_compose_libsql_runner", "target": "tests_integration_brokers_libsql_docker_compose_libsql_libsql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tests/integration/brokers/libsql/docker-compose.libsql.yml", "source_location": null, "weight": 1.0}, {"source": "tests_integration_brokers_libsql_docker_compose_libsql_distroless_no_healthcheck", "target": "tests_inte