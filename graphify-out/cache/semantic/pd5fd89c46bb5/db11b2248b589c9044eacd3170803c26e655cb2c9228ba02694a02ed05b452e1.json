", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_migration_overview_inkrementelle_migration", "label": "Migration ist selten ein One-Shot", "file_type": "rationale", "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vier Schritte: kleines Actor-System daneben, ein zustandsbehaftetes Konzept migrieren, Clustering/Persistenz nach Bedarf, dann mehr - man muss nicht alles umschreiben, um zu profitieren."}], "edges": [{"source": "docs_src_content_docs_de_migration_overview_migration_guides", "target": "docs_src_content_docs_de_migration_overview_from_akka_jvm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_overview_migration_guides", "target": "docs_src_content_docs_de_migration_overview_from_pekko", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_overview_migration_guides", "target": "docs_src_content_docs_de_migration_overview_from_orleans", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_migration_overview_migration_guides", "target": "docs_src_content_docs_de_migration_overview_from_akka_net", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/migration/overview.mdx", "source_location": null, "we