{"nodes": [{"id": "examples_chat_readme_chat_sample", "label": "Chat sample (multi-frontend clustered chat)", "file_type": "document", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demonstrates the framework as a real distributed system \u2014 clustered backend, persisted history, live cross-node broadcast \u2014 paired with six frontends on one WebSocket protocol so their feel can be compared side by side."}, {"id": "examples_chat_readme_chatroomactor", "label": "ChatRoomActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One sharded PersistentActor per room; recovery replays from the latest snapshot (every 100 events) plus the tail, so a 10k-message room cold-starts in O(100 events) regardless of total history."}, {"id": "examples_chat_readme_chatroomdirectoryactor", "label": "ChatRoomDirectoryActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps a DistributedData ORSet so user-created rooms converge across nodes; every node spawns its own instance and the DEFAULT_ROOMS seed is idempotent (#98)."}, {"id": "examples_chat_readme_directmessagechannelactor", "label": "DirectMessageChannelActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DMs are modelled as virtual @username rooms so no new protocol frames are needed; routing keys on the canonical pair-id and each user subscribes once at login to chat.dm.user.<self>, removing per-channel subscription bookkeeping from the client (#100)."}, {"id": "examples_chat_readme_usersessionactor", "label": "UserSessionActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_onlineusersactor", "label": "OnlineUsersActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_readreceiptsactor", "label": "ReadReceiptsActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes read pointers via a DD LWWMap with a monotonic guard so a stale write cannot roll a user pointer backwards; for DMs the entry is keyed on the canonical pair-id so both participants share one view (#103 slice 2)."}, {"id": "examples_chat_readme_httpingressactor", "label": "HttpIngressActor", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ClusterSingleton owning the public :8080 bind so users keep one URL and there are no per-node ports to remember; a survivor re-binds automatically when the holder dies."}, {"id": "examples_chat_readme_clustersharding", "label": "ClusterSharding (entityId = roomName)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_clustersingleton", "label": "ClusterSingleton", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_distributedpubsub", "label": "DistributedPubSub (chat.room.<name> topics)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One topic per room gives cross-node fan-out with no routing code in the middle \u2014 a message posted on node 1 reaches a client on node 3 directly."}, {"id": "examples_chat_readme_distributeddata", "label": "DistributedData (ORSet / LWWMap)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_sqlitejournal", "label": "SqliteJournal", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_sqlitesnapshotstore", "label": "SqliteSnapshotStore", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_hashallocationstrategy", "label": "HashAllocationStrategy", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_fastifybackend_withplugin", "label": "FastifyBackend.withPlugin", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HTTP layer goes through the framework directive DSL: @fastify/static and @fastify/websocket are wired in exclusively via withPlugin, so there is no manual Fastify setup in the sample."}, {"id": "examples_chat_readme_websocket_protocol", "label": "Chat WebSocket protocol (shared/protocol.ts)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All client traffic is WebSocket-based with no REST: login, room list, history, presence and chat messages all flow through one /ws endpoint."}, {"id": "examples_chat_readme_port_autodiscovery", "label": "Cluster port auto-discovery", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each node walks the cluster-port range from 2551, claims the first free port and treats every occupied port below it as a seed, so three identical commands form a cluster without flags. Explicit --port/--seeds remain for cross-machine deployments where a same-host port scan cannot work."}, {"id": "examples_chat_readme_singleton_failover", "label": "HTTP singleton failover", "file_type": "rationale", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A self-contained fallback that needs no external infrastructure; real zero-downtime active/active would put a load balancer in front. In-flight WebSocket frames are lost during the brief outage but persisted history survives."}, {"id": "examples_chat_readme_smoke_test", "label": "chat smoke-test.ts", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-node by design: isolating the protocol round-trip from the cluster lazy shard-allocation timing keeps it deterministic. --spawn-backend uses ports outside the auto-discovery window so a self-spawned run neither joins nor collides with an existing cluster."}, {"id": "examples_chat_readme_failover_test", "label": "chat failover-test.ts", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately excluded from the CI example gate: two of its three backends were observed outliving a clean exit and holding their cluster ports, which poisons whatever runs next."}, {"id": "examples_chat_readme_examples_manifest_gate", "label": "test:examples CI gate", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs smoke-test.ts --spawn-backend with every other runnable example on each push touching src/ or examples/, so a framework change that breaks the chat protocol round-trip is a red check rather than a later discovery."}, {"id": "examples_chat_readme_sessionstore", "label": "backend/auth/sessionStore.ts (HMAC-signed tokens)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT-style HMAC-SHA256 tokens binding { username, issuedAt, exp }; lookupToken self-validates without a DD lookup and the DD LWWMap chat.session-revocations stores only explicitly revoked tokens. TTL 24 h, secret from CHAT_TOKEN_SECRET with a warned fallback."}, {"id": "examples_chat_readme_password_hashing", "label": "backend/auth/password.ts (scrypt hash/verify)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwords stored as <salt>:<hash> scrypt digests and verified with crypto.scryptSync + crypto.timingSafeEqual (#99, Option A)."}, {"id": "examples_chat_readme_credentials", "label": "backend/auth/credentials.ts (validateCredentials)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scans every user and verifies against a real hash even on a username miss, so response timing does not leak account enumeration."}, {"id": "examples_chat_readme_reconnect_resume", "label": "Reconnect-resume frame", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On socket close the frontend retries with the stored token via the resume frame, so a singleton failover reauthenticates the client without a fresh login."}, {"id": "examples_chat_readme_test_users", "label": "TEST_USERS (shared/users.ts)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain-text demo passwords are intentional and printed under each login form; swapping in a real user store is a one-function change because validateCredentials already verifies against an opaque <salt>:<hash> string."}, {"id": "examples_chat_readme_default_rooms", "label": "DEFAULT_ROOMS (shared/rooms.ts)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_canonicalpairid", "label": "canonicalPairId", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orders the two usernames so canonicalPairId(alice, bob) === canonicalPairId(bob, alice), giving a DM channel and its DD entry one stable key for both participants."}, {"id": "examples_chat_readme_typing_indicators", "label": "Typing indicators (ephemeral PubSub)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demonstrates ephemeral PubSub: a typing frame fans out over the room existing topic with no persistence and no actor in between; the server filters self-echoes, the client debounces to 1/2 s and auto-clears after 3 s (#103 slice 1)."}, {"id": "examples_chat_readme_read_receipts", "label": "Read receipts (DD LWWMap read-up-to)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_chat_readme_emoji_support", "label": "Emoji support (server-agnostic)", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure text \u2014 the server is agnostic, so each frontend can wire any picker on top without server changes."}, {"id": "examples_chat_readme_tls_wss", "label": "TLS / WSS", "file_type": "concept", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontends auto-promote ws: to wss: from location.protocol, so one cert/key pair flips the whole stack to TLS with no client-side change; production is expected to terminate TLS at a reverse proxy, with --tls-cert/--tls-key for setups where the Bun process owns the public listener."}, {"id": "examples_chat_readme_production_hardening", "label": "Production hardening (pointed at, not shipped)", "file_type": "rationale", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSRF/origin checks, login rate-limiting, a strong shared token secret and a real user store are config-driven through existing middleware slots rather than deeper code changes, so they are documented instead of duplicated in demo code."}, {"id": "examples_chat_readme_gitignored_build_output", "label": "Gitignored frontend build output (#559)", "file_type": "rationale", "source_file": "examples/chat/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "static/angular|next|react|svelte are build artefacts and are not committed, so those routes 404 until npm ci && npm run build has run; plain/ and lit/ stay committed because a file nothing generates is source."}], "edges": [{"source": "examples_chat_readme_chat_sample", "target": "examples_chat_readme_chatroomactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/chat/README.md", "source_location": null, "weight": 1}, {"source": "examples_chat_readme_chat_sample", "target": "examples_chat_readme_httpingressactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/chat/README.md", "source_location": null, "weight": 1}, {"source": "examples_chat_readme_chat_sample", "target": "examples_chat_readme_websocket_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/chat/README.md", "source_location": null, "weight": 1}, {"source": "examples_chat_readme_chat_sample", "target": "examples_chat_readme_port_autodiscovery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/chat/README.md", "source_location": null, "weight": 1}, {"source": "examples_chat_readme_chat_sample", "target": "examples_chat_readme_fastifybackend_withplugin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/chat/README.md", "source_location": null, "weight": 1}, {"source": "examples_chat_readme_chatroomactor", "target": "examples_chat_readme_clustersharding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/chat/README.md", "source_location"