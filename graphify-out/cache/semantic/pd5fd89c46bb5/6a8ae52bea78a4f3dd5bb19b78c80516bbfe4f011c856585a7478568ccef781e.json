rget": "docs_src_content_docs_observability_metrics_core_metrics_cardinality_cap", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/observability/logging/multi-sink.mdx", "source_location": null, "weight": 1}], "hyperedges": [{"id": "log_sink_delivery_pipeline", "label": "The log-sink delivery pipeline", "nodes": ["docs_src_content_docs_observability_logging_multi_sink_multisinklogger", "docs_src_content_docs_observability_logging_multi_sink_logsink", "docs_src_content_docs_observability_logging_multi_sink_batchingsink", "docs_src_content_docs_observability_logging_multi_sink_sinkdeliveryerror", "docs_src_content_docs_observability_logging_multi_sink_bounded_delivery_queue", "docs_src_content_docs_observability_logging_file_sink_filesink", "docs_src_content_docs_observability_logging_integrations_otlphttpsink", "docs_src_content_docs_observability_logging_integrations_gelfsink", "docs_src_content_docs_observability_logging_integrations_lokisink"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/observability/logging/multi-sink.mdx"}]}