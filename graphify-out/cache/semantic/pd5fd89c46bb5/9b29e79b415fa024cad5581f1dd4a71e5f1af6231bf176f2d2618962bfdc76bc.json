{"nodes": [{"id": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "label": "Docker Compose deployment", "file_type": "document", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_deployment_docker_compose_compose_seed_list", "label": "Static seed list in Compose", "file_type": "concept", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each node seed list includes itself and all peers, and Compose DNS resolves the service names to container IPs. Scaling to a fourth node requires updating env vars on every container, so dynamic-size local clusters want the DNS seed provider instead."}, {"id": "docs_src_content_docs_operations_deployment_docker_compose_configseedprovider", "label": "ConfigSeedProvider", "file_type": "concept", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the seed list out of the environment and resolves it into addresses the cluster options take."}, {"id": "docs_src_content_docs_operations_deployment_docker_compose_compose_shared_persistence", "label": "Shared Cassandra persistence", "file_type": "rationale", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single container backs all three nodes, and sharing the journal is what lets sharded entities migrate between nodes naturally - per-node SQLite would strand them, since each node only knows its own file."}, {"id": "docs_src_content_docs_operations_deployment_docker_compose_compose_not_for_production", "label": "Compose is not a production orchestrator", "file_type": "rationale", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is single-machine and lacks cross-host scheduling, coordinated rolling updates, health-based replacement (it restarts on crash but does not evict from a load balancer during deployment) and cluster autoscaling."}, {"id": "docs_src_content_docs_operations_deployment_docker_compose_compose_observing", "label": "Observing a Compose cluster", "file_type": "concept", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curl any node published management port for membership or metrics, tail the container logs, and add Prometheus and Grafana containers pointed at all three management ports for multi-node debugging."}, {"id": "docs_src_content_docs_operations_deployment_docker_compose_compose_restart_policy", "label": "Compose restart policy", "file_type": "concept", "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compose auto-restarts crashed containers; on restart the node rejoins via the seed list while the other two keep running, and the recovering one catches up via gossip."}], "edges": [{"source": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_operations_deployment_docker_compose_compose_seed_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_operations_deployment_docker_compose_configseedprovider", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_operations_deployment_docker_compose_compose_shared_persistence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_operations_deployment_docker_compose_compose_not_for_production", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_operations_deployment_docker_compose_compose_observing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_operations_deployment_docker_compose_docker_compose_deployment", "target": "docs_src_content_docs_operations_deployment_docker_compose_compose_restart_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/operations/deployment/docker-compose.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_con