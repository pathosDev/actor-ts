{"nodes": [{"id": "docs_src_content_docs_intro_what_is_actor_ts_what_is_actor_ts", "label": "What is actor-ts?", "file_type": "document", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_what_is_actor_ts_actor_model", "label": "The actor model", "file_type": "concept", "rationale": "Because there is no shared state and exactly one message in flight per actor, the model gives serializability for free \u2014 no locks, no careful sequencing, no race reasoning inside an actor.", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_what_is_actor_ts_location_transparency", "label": "Location transparency", "file_type": "concept", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_what_is_actor_ts_supervision_trees", "label": "Supervision trees", "file_type": "concept", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_what_is_actor_ts_batteries_included", "label": "Batteries-included scope", "file_type": "rationale", "rationale": "Most TS actor libraries stop at the basic actor abstraction, which is the easy part. The hard parts forty years of production experience established are the operational pieces around the actor \u2014 clustering, sharding, persistence, distributed data, integrations, observability \u2014 so actor-ts ships them all in one package.", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_what_is_actor_ts_runtime_peers", "label": "Bun, Node and Deno as first-class peers", "file_type": "rationale", "rationale": "Bun is the primary development target (fastest cold start, bun:sqlite, native WebSocket server, native test runner); Node is the production reality on the 24+ floor; Deno is best-effort via the npm: specifier. Internal abstractions live behind small src/runtime/* modules that auto-detect at startup.", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_intro_what_is_actor_ts_ai_assisted_caveat", "label": "AI-assisted hobby project caveat", "file_type": "rationale", "rationale": "Large parts were written with AI pair-programming and have not been battle-tested in production. Coverage is good (~2657 tests, ~91 % line) but the surface area is enormous, so it is pre-1.0 and not for real money, users or data; some corners may be more 'looks right' than 'verified right'.", "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_intro_what_is_actor_ts_what_is_actor_ts", "target": "docs_src_content_docs_intro_what_is_actor_ts_actor_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_intro_what_is_actor_ts_what_is_actor_ts", "target": "docs_src_content_docs_intro_what_is_actor_ts_location_transparency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 