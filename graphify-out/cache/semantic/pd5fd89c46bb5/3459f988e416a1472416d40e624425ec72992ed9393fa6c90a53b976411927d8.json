{"nodes": [{"id": "examples_voice_readme_voice_sample", "label": "Voice sample (walkie-talkie / group / rooms)", "file_type": "document", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three voice modes over one WebSocket per client on a 3-node cluster, chosen to exercise three primitives the chat sample does not: Receptionist lookup, PubSub megaphone fan-out and DD-ORSet room membership."}, {"id": "examples_voice_readme_dumb_relay", "label": "Server as dumb audio relay", "file_type": "rationale", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No WebRTC, no SFU, no transcoding \u2014 deliberately flowing audio frames through actors so the PubSub fan-out, Receptionist lookup and DD-ORSet presence are visibly the load-bearing parts."}, {"id": "examples_voice_readme_voicesessionactor", "label": "VoiceSessionActor", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One per WebSocket: text frames are the control plane, binary frames are routed per currentTarget."}, {"id": "examples_voice_readme_voicepresenceactor", "label": "VoicePresenceActor", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_voice_readme_receptionist", "label": "Receptionist (voice-user:<name> lookup)", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gossip latency is about a second, so a 1:1 PTT press within 1-2 s of the target login may fail; a retry on PTT-down handles it."}, {"id": "examples_voice_readme_distributedpubsub", "label": "DistributedPubSub (voice.group / voice.room topics)", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At-most-once delivery, so lost frames cause audible pops; production voice would want adaptive jitter buffers and retry layers above it."}, {"id": "examples_voice_readme_distributeddata_orset", "label": "DistributedData ORSet room presence", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_voice_readme_push_to_talk", "label": "1:1 push-to-talk mode", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_voice_readme_group_megaphone", "label": "1:N group megaphone mode", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_voice_readme_room_mode", "label": "N:N room (Teams-style) mode", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rooms are pure CRDT presence plus a PubSub topic \u2014 entering a room subscribes you to its audio topic but you do not speak until a voice-target frame arrives, so membership and talking are independent."}, {"id": "examples_voice_readme_voice_protocol", "label": "Voice wire protocol (shared/protocol.ts)", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON discriminated unions for the control plane with auth identical to chat; audio chunks are binary WS frames rather than a ServerMessage variant."}, {"id": "examples_voice_readme_framecodec", "label": "frameCodec.ts binary frame envelope", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbound is raw Opus with no header because the server knows the sender from session context; outbound prefixes [u8 nameLen][utf-8 username] so a receiver can demultiplex concurrent speakers instead of interleaving them into one stream."}, {"id": "examples_voice_readme_mediarecorder_capture", "label": "MediaRecorder capture (Opus, 100 ms timeslice)", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each PTT press starts a fresh MediaRecorder so the first chunk carries the WebM init segment, lining up with the fresh MediaSource the receiver creates per voice-incoming-start."}, {"id": "examples_voice_readme_mediasource_playback", "label": "Per-sender MediaSource playback", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The right primitive for streamed Opus, but its quirks (init-segment-once, updating gates, endOfStream) make the pipeline fiddly, and N concurrent speakers cost N MediaSources so RAM scales linearly \u2014 a polished app might move to WebCodecs plus a ring buffer."}, {"id": "examples_voice_readme_latency", "label": "End-to-end latency (100-300 ms)", "file_type": "rationale", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dominant cost is the 100 ms timeslice; pushing it to 20-40 ms tightens latency at the price of CPU on both ends."}, {"id": "examples_voice_readme_groups", "label": "shared/groups.ts static group membership", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "examples_voice_readme_smoke_test", "label": "voice smoke-test.ts", "file_type": "concept", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brings its own one-node cluster on isolated ports so it runs unattended in test:examples; walks all three modes with a fake 32-byte payload and verifies the relay path including the room-mode self-filter, but deliberately not audio playback, which is a browser concern."}, {"id": "examples_voice_readme_no_echo_cancellation", "label": "No cross-speaker echo cancellation", "file_type": "rationale", "source_file": "examples/voice/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser AEC works only against locally-rendered audio, so a room of unmuted participants on one speaker will feed back; headphones are the mitigation."}], "edges": [{"source": "examples_voice_readme_voice_sample", "target": "examples_voice_readme_dumb_relay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/voice/README.md", "source_location": null, "weight": 1}, {"source": "examples_voice_readme_voice_sample", "target": "examples_voice_readme_voicesessionactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "examples/voice/README.md", "source_location": null, "weight": 1}, {"source": "examples_voice_readme_voice_sample", "target": "examples_voice_readme_voicepresenceactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "sour