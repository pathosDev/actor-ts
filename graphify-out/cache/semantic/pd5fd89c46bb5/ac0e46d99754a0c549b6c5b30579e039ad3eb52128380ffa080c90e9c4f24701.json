{"nodes": [{"id": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "label": "ProducerController", "file_type": "concept", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigns sequence numbers, holds messages until acked, retransmits on timeout. Strictly 1:1 with one ConsumerController \u2014 fan-out means several producers, and routing-based fan-out needs a custom router on top."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_windowsize", "label": "windowSize", "file_type": "concept", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beyond N unacked in-flight messages further sends are queued \u2014 the caller's tell still succeeds, so there is no signal back that queuing happened: a reliable-delivery.send is fire-and-forget and the producer never answers it. Real backpressure means pacing sends by the confirm callbacks."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_resendtimeout", "label": "resendTimeout", "file_type": "concept", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retransmission repeats on this interval with the SAME seq until the ACK arrives or the producer stops; the consumer dedups on the seq."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_producerid", "label": "producerId", "file_type": "concept", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-generated when omitted, but a persisted producer wants a stable string so recovery matches the consumer's dedup state across restarts."}, {"id": "docs_src_content_docs_de_delivery_producer_controller_in_memory_buffer", "label": "In-memory in-flight buffer", "file_type": "rationale", "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The buffer lives on the producer's host, so a crash loses unacked messages and a restart resumes at seq 1 with no resume. Wrapping the producer in a PersistentActor pattern \u2014 persist outgoing before sending, replay unacked on restart \u2014 is what makes a stream durable."}], "edges": [{"source": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "target": "docs_src_content_docs_de_delivery_producer_controller_windowsize", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "target": "docs_src_content_docs_de_delivery_producer_controller_resendtimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "target": "docs_src_content_docs_de_delivery_producer_controller_producerid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_producer_controller_in_memory_buffer", "target": "docs_src_content_docs_de_delivery_producer_controller_producercontroller", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_producer_controller_windowsize", "target": "docs_src_content_docs_de_delivery_ack_semantics_confirmation_callback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_delivery_producer_controller_producerid", "target": "docs_src_content_docs_de_delivery_consumer_controller_per_producer_dedup", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/delivery/producer-controller.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}