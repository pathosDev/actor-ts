{"nodes": [{"id": "security_security_policy", "label": "actor-ts security policy", "file_type": "document", "rationale": "The framework opens sockets, parses wire frames, deserializes untrusted payloads and persists state, so bugs in any of that are treated as security bugs.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_supported_versions", "label": "Supported versions (latest 0.x.y only)", "file_type": "rationale", "rationale": "Pre-1.0 with no maintenance branches: fixes land on develop and ship in the next release, nothing is backported.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_private_vulnerability_reporting", "label": "Private vulnerability reporting", "file_type": "concept", "rationale": "GitHub's private advisory draft is the channel that produces a CVE; if the button is missing, an empty placeholder issue with no reproduction discloses nothing while a private channel is arranged.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_out_of_scope_defaults", "label": "Out of scope - documented insecure defaults", "file_type": "rationale", "rationale": "The framework ships insecure-by-default transports on purpose with the secure configuration documented next to them, so a cluster run on a hostile network without TLS is documented behaviour, not a vulnerability.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_in_scope", "label": "In scope - everything the mitigations promise", "file_type": "rationale", "rationale": "A documented mitigation that does not deliver what it says is a vulnerability, and one that has happened here before; also anything reachable from untrusted input on a socket, missing bounds, crypto mistakes and cross-entity persistence access.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_codeql", "label": "CodeQL scanning gate", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_bun_audit", "label": "bun audit gate over bun.lock", "file_type": "rationale", "rationale": "GitHub's dependency graph records the unresolved ranges from package.json rather than the shipped closure, which is why bun audit reads the lockfile and dependency-review-action is deliberately not used.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_workflow_hygiene", "label": "SHA-pinned actions (WorkflowHygiene test)", "file_type": "concept", "rationale": "Catches a mutable action tag being repointed under a job that holds a publishing credential.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_npm_provenance", "label": "npm provenance publishing", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_cyclonedx_sbom", "label": "CycloneDX SBOM on every release", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_accepted_advisories", "label": "Accepted advisories table", "file_type": "concept", "rationale": "Advisories already present when the gate was introduced are suppressed by ID so the gate could land green rather than land red and be ignored; #779 is the dependency refresh that removes them.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_securitypolicy_test", "label": "SecurityPolicy.test.ts parity assertion", "file_type": "concept", "rationale": "Asserts the SECURITY.md table and the lint:audit ignore list stay identical, so an advisory cannot be silenced without appearing here and an entry cannot linger after the suppression is dropped.", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "security_security_policy", "target": "security_supported_versions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_private_vulnerability_reporting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_out_of_scope_defaults", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_in_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_codeql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_bun_audit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "we