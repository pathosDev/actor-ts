{"nodes": [{"id": "docs_src_content_docs_de_intro_what_is_actor_ts_mental_model", "label": "Mentales Modell des Actor-Modells", "file_type": "rationale", "rationale": "Kein geteilter Speicher und genau eine Nachricht pro Actor in Bearbeitung \u2014 das Modell gibt Serialisierbarkeit umsonst. Alles andere (Sharding, Persistenz, verteilte Daten, Membership, Pub-Sub) ist auf diesem einen Primitiv aufgebaut.", "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_what_is_actor_ts_why_typescript_port", "label": "Warum ein TypeScript-Port", "file_type": "rationale", "rationale": "Das Modell ist produktionserprobt (Erlang/BEAM, Akka/Pekko, Orleans), aber das Actor-Toolkit fuer TS war duenn \u2014 man schrieb eigene Primitiven oder akzeptierte 'alles ueber ein Spielzeug hinaus braucht die JVM'. Der Port stuetzt sich auf das Typsystem, wo JVM-Ports sich auf Traits stuetzten.", "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_what_is_actor_ts_batteries_included", "label": "Batteries-included", "file_type": "rationale", "rationale": "Die meisten TS-Actor-Libraries hoeren bei der Actor-Abstraktion auf \u2014 dem einfachen Teil. Die harten Teile sind die operativen Stuecke rundherum: Clustering, Sharding, Persistenz, verteilte Daten, Integrationen, Observability.", "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_what_is_actor_ts_location_transparency", "label": "Location Transparency", "file_type": "concept", "rationale": "Ein ActorRef weiss nicht und kuemmert sich nicht darum, ob der Actor im selben Prozess, einem anderen Prozess oder einem anderen Rechenzentrum lebt.", "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_what_is_actor_ts_runtime_parity", "label": "Runtimes als erstklassige Peers", "file_type": "rationale", "rationale": "Bun ist das primaere Entwicklungsziel, Node die produktive Realitaet, Deno Best-Effort. Interne Abstraktionen leben hinter kleinen src/runtime-Modulen, die beim Start automatisch erkennen.", "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_intro_what_is_actor_ts_ai_assisted_caveat", "label": "AI-unterstuetztes Hobbyprojekt", "file_type": "rationale", "rationale": "Grosse Teile wurden mit AI-Pair-Programming geschrieben und sind nicht produktionserprobt; die Testabdeckung ist gut, die Oberflaeche enorm. Bekannte Limitierungen werden auf der jeweiligen Docs-Seite genannt statt ueberspielt.", "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_intro_what_is_actor_ts_mental_model", "target": "docs_src_content_docs_de_intro_glossary_actor", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 0.95}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_mental_model", "target": "docs_src_content_docs_de_intro_what_is_actor_ts_location_transparency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_why_typescript_port", "target": "docs_src_content_docs_de_intro_what_is_actor_ts_mental_model", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_batteries_included", "target": "docs_src_content_docs_de_intro_what_is_actor_ts_mental_model", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_batteries_included", "target": "docs_src_content_docs_de_index_integrations", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 0.85}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_location_transparency", "target": "docs_src_content_docs_de_intro_glossary_actorref", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 0.95}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_runtime_parity", "target": "docs_src_content_docs_de_http_overview_httpserverbackend", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/intro/what-is-actor-ts.mdx", "source_location": null, "weight": 0.85}, {"source": "docs_src_content_docs_de_intro_what_is_actor_ts_ai_assisted_caveat", "target": "docs_src_content_docs_de_index_pre_1_0_status", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content