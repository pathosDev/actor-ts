{"nodes": [{"id": "docs_src_content_docs_io_amqp_amqp", "label": "AMQP (RabbitMQ)", "file_type": "document", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_amqp_amqpactor", "label": "AmqpActor", "file_type": "concept", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_amqp_amqpoptionstype", "label": "AmqpOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_amqp_amqpqueuebinding", "label": "AmqpQueueBinding", "file_type": "concept", "rationale": "Bindings declare the queue, the exchange binding AND the consumer-actor target in one go, wired up idempotently on connect; runtime subscribe/unsubscribe is deliberately not a v1 surface, so a new consumer means restarting the actor with updated bindings.", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_amqp_exchanges_and_routing", "label": "Exchanges and routing", "file_type": "concept", "rationale": "AmqpActor does not declare exchanges \u2014 they must already exist on the broker. On connect it only asserts the queues named in bindings and binds them, so publishing routes through an existing exchange by name.", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_amqp_acknowledgment_handshake", "label": "AMQP acknowledgment / negativeAcknowledgment handshake", "file_type": "concept", "rationale": "Every AmqpDelivery carries an opaque ackToken identifying the broker-side message; the broker holds it unacked until the handler answers, so a crashed consumer gets re-delivery on the next connection. requeue:false routes to a dead-letter queue when retry will not help.", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_io_amqp_prefetch", "label": "AMQP prefetch", "file_type": "concept", "rationale": "The raw AMQP protocol default is 0 (unlimited), but the actor sets prefetch to 1 unless overridden \u2014 raise it to 10-50 to keep the consumer busy without overwhelming it.", "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_io_amqp_amqp", "target": "docs_src_content_docs_io_amqp_amqpactor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_amqp_amqp", "target": "docs_src_content_docs_io_amqp_amqpoptionstype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_amqp_amqp", "target": "docs_src_content_docs_io_amqp_amqpqueuebinding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_io_amqp_amqp", "target": "docs_src_content_docs_io_amqp_exchanges_and_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/io/amqp.mdx", "source_location": null, "weight": 1}, {"source": "docs_s