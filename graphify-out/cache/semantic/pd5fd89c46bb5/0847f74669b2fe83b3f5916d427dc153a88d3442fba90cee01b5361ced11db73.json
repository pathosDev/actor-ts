{"nodes": [{"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicatedeventsourcedactor", "label": "ReplicatedEventSourcedActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nichts wird in den Konstruktor gereicht - die Basisklasse liest den Cluster vom ActorSystem. Das Journal muss ueber Replicas geteilt sein."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_vectorclock", "label": "VectorClock (Konflikterkennung)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_conflictresolver", "label": "ConflictResolver", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_replicaid", "label": "replicaId", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/replicated-event-sourcing/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default ist die Cluster-Adresse dieses Nodes; nur ueberschreiben, wenn die Id eine Adressaenderung ueberleben muss. Zwei Replicas, die sich jemals eine Id teilen, deduplizieren sich gegenseitig die Events weg - der Default ist also der sichere."}, {"id": "docs_src_content_docs_de_persistence_replicated_event_sourcing_overview_single_writer_lease", "label": "Single-Writer-Lease (optional)", "file_ty