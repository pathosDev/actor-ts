{"nodes": [{"id": "docs_src_content_docs_de_io_nats_natsactor", "label": "NatsActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_natsoptions", "label": "NatsOptionsType", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_subscriptions_and_reconnects", "label": "Subscriptions und Reconnects", "file_type": "concept", "rationale": "Konfigurierte und zur Laufzeit ergaenzte Subscriptions speisen dieselbe gewuenschte Menge der Basisklasse: jede wird nach einem Reconnect neu gesetzt, ein subscribe waehrend einer Trennung landet beim naechsten Connect, ein unsubscribe entfernt das Subject endgueltig, und ein erneutes subscribe tauscht das Target (die vorherige wird zuerst abgebaut, es empfaengt also genau ein Actor).", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_subjects", "label": "Subjects (NATS-Topics)", "file_type": "concept", "rationale": "Mit Punkten getrennt und case-sensitive; per Konvention kleinbuchstabig.", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_wildcards", "label": "NATS-Wildcards", "file_type": "concept", "rationale": "* trifft genau ein Token, > ein oder mehr und darf nur als letztes Token vorkommen.", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_request_reply", "label": "Request / Reply ueber ein Reply-Subject", "file_type": "concept", "rationale": "Es gibt kein dediziertes request-Command \u2014 man setzt es aus publish, subscribe und dem replyTo-Feld zusammen und verwaltet die Reply-Subjects selbst; bei 10K+ gleichzeitigen Requests sind das viele temporaere Subjects, also nach der Antwort unsubscriben.", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_no_durability", "label": "Core-NATS hat keine Durability", "file_type": "rationale", "rationale": "Core-NATS queued keine Nachrichten fuer offline Subscriber \u2014 alles, was waehrend einer Trennung publiziert wurde, ist verloren. Die Reconnect-Garantie betrifft die Subscription, nicht die Nachrichten.", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_io_nats_when_nats", "label": "Wann NATS", "file_type": "rationale", "rationale": "Hochvolumiges Pub/Sub ohne Kafkas operative Komplexitaet, Microservice-Request/Reply und leichtgewichtige Event-Verteilung. Kafka schlaegt JetStream weiterhin bei massiver Skalierung; JetStream ist der Sweet Spot zwischen Core-NATS und Kafka.", "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_io_broker_actor_base_desired_subscriptions", "target": "docs_src_content_docs_de_io_nats_subscriptions_and_reconnects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/io/nats.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_io_nats_natsactor", "target": "docs_src_content_docs_de_io_nats_natsop