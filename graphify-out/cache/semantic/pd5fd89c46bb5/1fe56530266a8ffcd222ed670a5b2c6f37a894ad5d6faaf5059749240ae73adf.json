{"nodes": [{"id": "docs_src_content_docs_de_io_email_bridge_emailbridgeactor", "label": "EmailBridgeActor", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Ops-/Alerting-Bridge, die sonst in jedem Projekt von Hand gebaut wird: ein Postfach als Nachrichtenquelle, SMTP als Senke."}, {"id": "docs_src_content_docs_de_io_email_bridge_emailbridgeoptions", "label": "EmailBridgeOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Haelfte fuer sich ist eine gueltige Bridge; gar keine Haelfte, eine imap-Haelfte ohne target und ein target ohne imap-Haelfte werden beim Start abgelehnt, weil sie sich erfolgreich verbinden und danach nichts tun."}, {"id": "docs_src_content_docs_de_io_email_bridge_at_least_once_imap_flags", "label": "At-least-once, quittiert ueber IMAP-Flags", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verarbeitet ist eine Tatsache auf dem Server (\\Seen bzw. Abwesenheit aus dem Postfach) statt Buchfuehrung im Speicher - genau deshalb sieht ein abgestuerzter Consumer die Nachricht wieder, statt sie zu verlieren."}, {"id": "docs_src_content_docs_de_io_email_bridge_acktoken", "label": "ackToken / acknowledgment / negativeAcknowledgment", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "negativeAcknowledgment mit drop: true quittiert ohne Verarbeitung - der Notausgang fuer eine Nachricht, die jedes Mal scheitert."}, {"id": "docs_src_content_docs_de_io_email_bridge_onprocessed_modi", "label": "onProcessed-Modi: markSeen und move", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "markSeen setzt \\Seen und braucht ein eigens vorgesehenes Postfach, weil ein zweiter Leser die Bridge Nachrichten ueberspringen laesst; move verschiebt nach moveToMailbox, das beim Verbinden angelegt wird."}, {"id": "docs_src_content_docs_de_io_email_bridge_move_ziel_validator", "label": "moveToMailbox muss sich vom beobachteten Postfach unterscheiden", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mails in genau das Postfach zu verschieben, aus dem sie gelesen werden, stellt sie endlos erneut zu - und jeder einzelne IMAP-Befehl in dieser Schleife ist erfolgreich, der Validator erzwingt es deshalb."}, {"id": "docs_src_content_docs_de_io_email_bridge_idle_polling_reconnect", "label": "IDLE, Polling und Reconnect", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Eingangsschleife wartet auf IDLE-Ankuendigung, IDLE-Ende oder pollIntervalMs; Polling ist ein vollwertiger Modus, kein eingeschraenkter, und pollIntervalMs begrenzt zugleich, wie lange eine abgelehnte Nachricht auf erneute Zustellung wartet."}, {"id": "docs_src_content_docs_de_io_email_bridge_ein_actor_ein_postfach", "label": "Ein Actor, ein Postfach", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine IMAP-Verbindung kann IDLE nur auf dem ausgewaehlten Postfach ausfuehren - zwei Postfaecher bedeuten zwei Actors."}, {"id": "docs_src_content_docs_de_io_email_bridge_smtp_pool", "label": "Gepoolter nodemailer-Transport", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pool: true haelt TLS-Verbindungen ueber Nachrichten hinweg warm; bei ausgefallenem Transport wird im gemeinsamen Ausgangspuffer gehalten."}, {"id": "docs_src_content_docs_de_io_email_bridge_zurueckgewiesene_nachricht", "label": "Zurueckgewiesene Nachricht wird verworfen, nicht erneut versucht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine 5xx/4xx-Antwort zurueckzustellen wuerde die vergiftete Nachricht an den Anfang des Puffers setzen und einen funktionierenden Pool abreissen; bei Verbindungsfehlern ist es umgekehrt."}, {"id": "docs_src_content_docs_de_io_email_bridge_emailtemplate", "label": "EmailTemplate", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bewusst logikfrei (keine Schleifen, keine Bedingungen); setValue mit unbekanntem Namen wirft und render wirft bei ungesetztem Platzhalter, weil beide Fehler sonst erst in einer bereits versendeten Mail auffielen."}, {"id": "docs_src_content_docs_de_io_email_bridge_safehtml_rawhtml", "label": "SafeHtml / rawHtml / html-Tagged-Template", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Werte werden standardmaessig HTML-escaped; rawHtml ist der einzige Ausweg und macht das an der Aufrufstelle sichtbar. Fuer Markup als Literal im Code ist das Tagged Template html das bessere Werkzeug."}, {"id": "docs_src_content_docs_de_io_email_bridge_hocon_namespace", "label": "actor-ts.io.broker.email-bridge", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "target hat kein Blatt - eine ActorRef kann nur aus dem Code kommen."}, {"id": "docs_src_content_docs_de_io_email_bridge_gruppen_ersetzen_nicht_mischen", "label": "Die Bloecke imap und smtp ersetzen, sie mischen nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optionen werden nur eine Ebene tief zusammengefuehrt, eine im Code uebergebene Gruppe ersetzt die konfigurierte also vollstaendig."}, {"id": "docs_src_content_docs_de_io_email_bridge_peer_dependencies", "label": "imapflow + nodemailer als optionale Peers", "file_type": "concept", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beide werden beim ersten Verbinden lazy geladen - importiert wird nur die konfigurierte Haelfte, eine reine Sende-Bridge zieht imapflow also nie herein."}, {"id": "docs_src_content_docs_de_io_email_bridge_wann_email_bridge_passt", "label": "Wann die E-Mail-Bridge passt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alarmierung nach aussen, Mail als Eingangswarteschlange, Anbindung eines Systems, das nur Mail spricht. Fuer hohes Volumen oder knappe Latenz ist ein echter Broker richtig: IMAP-Polling bewegt sich im Sekundenbereich und ein Postfach ist keine Queue."}], "edges": [{"source": "docs_src_content_docs_de_io_email_bridge_emailbridgeactor", "target": "docs_src_content_docs_de_io_broker_actor_base_brokeractor", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_email_bridge_emailbridgeactor", "target": "docs_src_content_docs_de_io_email_bridge_emailbridgeoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_email_bridge_emailbridgeactor", "target": "docs_src_content_docs_de_io_email_bridge_at_least_once_imap_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_email_bridge_acktoken", "target": "docs_src_content_docs_de_io_email_bridge_at_least_once_imap_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_email_bridge_onprocessed_modi", "target": "docs_src_content_docs_de_io_email_bridge_at_least_once_imap_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_io_email_bridge_move_ziel_validator", "target": "docs_src_content_docs_de_io_email_bridge_onprocessed_modi", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/io/email-bridge.mdx", "source_location": null, "weig