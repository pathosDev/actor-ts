{"nodes": [{"id": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentities", "label": "rememberEntities", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns lazy entity recovery eager. The rule: enable it when 'do I need this entity alive without a recent message?' is a yes \u2014 scheduled background work, external subscriptions, full working set restored at failover. Costs two writes per entity lifecycle, real overhead for high-churn workloads."}, {"id": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentitiesstore", "label": "RememberEntitiesStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small append/load/clear interface, useful when the entity registry wants a different backing store from the rest of persistence (Redis for low-latency set lookups while the journal sits on Cassandra)."}, {"id": "docs_src_content_docs_de_cluster_sharding_remember_entities_two_store_split", "label": "Two-store split (journal vs remember store)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only identities are persisted, never state. Deliberate: the remember store has different access patterns (small frequent writes as entities start and stop) and benefits from being separable. The two share no transaction, so an orphaned entry or a missing journal is possible \u2014 harmless in practice."}, {"id": "docs_src_content_docs_de_cluster_sharding_remember_entities_passivation_forgets", "label": "Passivation removes remembered entities", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "passivationIdleMs defaults to 5 minutes, so rememberEntities with nothing else configured stops an idle entity AND drops it from the registry \u2014 usually not what someone enabling remembering wants. Decide deliberately: keep the default if 'remembered' means 'recently active', set 0 if it means 'known to exist'. ShardedDaemonProcess forces 0 for exactly this reason."}, {"id": "docs_src_content_docs_de_cluster_sharding_remember_entities_cold_start_stampede", "label": "Cold-start stampede", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remembered entities spawn eagerly after coordinator init, so a very large set means N journals replaying and N preStarts at once; mitigate by sharding across regions and keeping preStart cheap (snapshot-led recovery)."}, {"id": "docs_src_content_docs_de_cluster_sharding_remember_entities_unexpected_shard_death", "label": "Recovery after unexpected shard death", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shard dying outside a rebalance (past its supervision budget) leaves ownership with the region, which re-asks the coordinator what it remembers so the entities return without waiting for traffic. Nothing is recorded as stopped \u2014 those entities were never meant to leave. Shard passivation does not touch the registry at all."}], "edges": [{"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentities", "target": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentitiesstore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_two_store_split", "target": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentitiesstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_passivation_forgets", "target": "docs_src_content_docs_de_cluster_sharding_overview_passivation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_passivation_forgets", "target": "docs_src_content_docs_de_cluster_sharding_sharded_daemon_process_shardeddaemonprocess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_cold_start_stampede", "target": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentities", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_unexpected_shard_death", "target": "docs_src_content_docs_de_cluster_sharding_overview_shard_actor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_rememberentities", "target": "docs_src_content_docs_de_cluster_sharding_allocation_strategy_allocationstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_sharding_remember_entities_two_store_split", "target": "docs_src_content_docs_de_delivery_ack_semantics_persist_before_resolve", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/src/content/docs/de/cluster/sharding/remember-entities.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}