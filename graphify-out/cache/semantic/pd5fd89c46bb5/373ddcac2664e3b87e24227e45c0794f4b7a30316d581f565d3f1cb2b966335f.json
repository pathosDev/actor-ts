{"nodes": [{"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_upgrade_strategies", "label": "Upgrade strategies", "file_type": "document", "rationale": "Two kinds of upgrade with two patterns; mixing them naively breaks production because old nodes cannot read new schemas or the reverse.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_code_only_upgrade", "label": "Code-only upgrade", "file_type": "concept", "rationale": "A new binary against the same schemas; gossip, sharding rebalance and coordinated shutdown handle the choreography for zero downtime, given at least two replicas and health checks that gate readiness.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_schema_breaking_upgrade", "label": "Schema-breaking upgrade", "file_type": "concept", "rationale": "Triggered by event shapes in a journal, state shapes in a durable-state store, message shapes exchanged during the rolling window, or configuration keys moving between versions.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_additive_change_first", "label": "Make the change additive first", "file_type": "rationale", "rationale": "Merging the additive step into the final one removes the window where old and new coexist, which a rolling update guarantees will happen; multi-step is safer.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_inter_actor_message_evolution", "label": "Evolving inter-actor messages", "file_type": "concept", "rationale": "During a rolling deployment old nodes send old messages to new nodes and the reverse; add the field as optional, default it in new code, and only make it required in a later deployment.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_config_key_renames", "label": "Configuration key renames do not auto-migrate", "file_type": "rationale", "rationale": "Either read both names until you can require the new one, or run scripts that rewrite application.conf; easier still is to avoid renaming keys, and when you must, deprecate with a startup warning for one release.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_rollback_strategy", "label": "Rollback strategy per upgrade kind", "file_type": "concept", "rationale": "Code-only rolls back cleanly; an additive schema change rolls back safely because the previous code reads the new shapes; a non-additive change needs feature flags keeping the old path reachable. Practise rollback in staging.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_operations_upgrades_upgrade_strategies_planned_downtime", "label": "Planned downtime as the last resort", "file_type": "concept", "rationale": "Some breaks - a different storage backend, a fundamental restructuring - make an online migration genuinely impossible; then announce a window, shut the cluster down, migrate offline and smoke-test before user traffic.", "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_operations_upgrades_upgrade_strategies_upgrade_strategies", "target": "docs_src_content_docs_operations_upgrades_upgrade_strategies_code_only_upgrade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_upgrades_upgrade_strategies_upgrade_strategies", "target": "docs_src_content_docs_operations_upgrades_upgrade_strategies_schema_breaking_upgrade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_upgrades_upgrade_strategies_upgrade_strategies", "target": "docs_src_content_docs_operations_upgrades_upgrade_strategies_additive_change_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_operations_upgrades_upgrade_strategies_upgrade_strategies", "target": "docs_src_content_docs_operations_upgrades_upgrade_strategies_inter_actor_message_evolution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/operations/upgrades/upgrade-strategies.mdx", "source_location": null, "weight": 1