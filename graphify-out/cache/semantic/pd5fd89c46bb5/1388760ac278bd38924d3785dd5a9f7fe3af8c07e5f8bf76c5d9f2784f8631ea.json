{"nodes": [{"id": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "label": "InMemorySnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Default, wenn kein Snapshot-Store konfiguriert ist - null Setup, ideal fuer Tests, nie in Produktion: Daten sterben mit dem Prozess, und die Recovery faellt jedes Mal auf vollstaendigen Replay zurueck."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_reference_semantics", "label": "Referenz-Semantik fuer save / loadLatest / loadBefore / delete", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jeder andere Snapshot-Store muss dieses Verhalten erfuellen (modulo Persistenz-, Verschluesselungs- und Kompressions-Spezifika) - der Source ist der Vertrag fuer eigene Implementierungen."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_keepn_default_divergence", "label": "Ohne Angabe behaelt er jeden Snapshot", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die eine Stelle, an der dieser Store bewusst von der Familie abweicht, in der jeder persistente Store keepN: 3 als Default hat. Weil das der Store ist, den man ohne Konfiguration bekommt, wuerde ein Default-Limit aendern, was jede unkonfigurierte Anwendung aufbewahrt, ohne dass jemand danach gefragt hat."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_resave_replaces_same_sequence", "label": "Erneutes Speichern unter derselben Sequenznummer ersetzt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passend zum Primaerschluessel (persistence_id, sequence_nr) der relationalen Stores."}, {"id": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_unbounded_growth_in_long_runs", "label": "Unbegrenztes Wachstum in langen Testlaeufen", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Benchmark mit 1M Snapshots laesst die Map linear wachsen - keepN setzen, delete selbst aufrufen oder den SQLite-Store mit :memory: verwenden."}], "edges": [{"source": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_reference_semantics", "target": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_keepn_default_divergence", "target": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/snapshot-stores/in-memory.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_resave_replaces_same_sequence", "target": "docs_src_content_docs_de_persistence_snapshot_stores_in_memory_reference_semantics", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/