{"nodes": [{"id": "docs_src_content_docs_de_http_middleware_response_cache_cached", "label": "cached", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_response_cache_responsecacheoptions", "label": "ResponseCacheOptions", "file_type": "concept", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_response_cache_cache_key_composition", "label": "Cache-Key-Zusammensetzung", "file_type": "rationale", "rationale": "req.path ist nur der Pfadname; ein Endpunkt, dessen Response von einem Query-Parameter abhaengt, muss diesen selbst in den Key falten, sonst teilen sich alle Seiten einen Eintrag und Seite 2 bekommt Seite 1 ausgeliefert.", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_response_cache_cache_invalidation", "label": "Cache-Invalidierung", "file_type": "rationale", "rationale": "cached invalidiert nicht automatisch bei Writes; die Veraltung ist durch ttlMs begrenzt. Fuer staerkere Konsistenz entweder Sub-Sekunden-TTLs oder ein manuelles cache.delete auf dem mit keyPrefix versehenen Key.", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_response_cache_single_flight_stampede_protection", "label": "Per-Process-Single-Flight", "file_type": "rationale", "rationale": "Bei einem Miss laeuft der Handler einmal pro Prozess und die uebrigen gleichzeitigen Requests fuer denselben Key warten auf dieses eine Ergebnis. Nicht cluster-weit: mit N Pods kann der Handler bis zu N-mal gleichzeitig laufen. Stale-While-Revalidate ist nicht eingebaut.", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_response_cache_authenticated_response_leak", "label": "Gecachte authentifizierte Responses lecken", "file_type": "rationale", "rationale": "Ohne den User im Key liefert GET /api/users/me allen Nutzern die Response des ersten. Entweder einen User-Hash in den Key aufnehmen oder Per-User-Endpunkte gar nicht umhuellen.", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_http_middleware_response_cache_shared_cache_eviction_hazard", "label": "Eigene Cache-Instanz fuer den Response-Cache", "file_type": "rationale", "rationale": "key(request) leitet sich fast immer aus etwas Client-Kontrolliertem ab; hier ist die LRU-Schranke genau das, was den Response-Cache am unbegrenzten Wachsen hindert. In einer mit rateLimit oder idempotent geteilten Instanz nimmt dieselbe Flut Rate-Limit-Zaehler und Idempotency-Records mit.", "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_http_middleware_response_cache_cached", "target": "docs_src_content_docs_de_http_middleware_response_cache_responsecacheoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_response_cache_cache_key_composition", "target": "docs_src_content_docs_de_http_middleware_response_cache_cached", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_response_cache_cache_invalidation", "target": "docs_src_content_docs_de_http_middleware_response_cache_cached", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_response_cache_single_flight_stampede_protection", "target": "docs_src_content_docs_de_http_middleware_response_cache_cached", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_response_cache_authenticated_response_leak", "target": "docs_src_content_docs_de_http_middleware_response_cache_cache_key_composition", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_response_cache_shared_cache_eviction_hazard", "target": "docs_src_content_docs_de_http_middleware_response_cache_cached", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/http/middleware/response-cache.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_http_middleware_response_cache_cached", "target": "docs_src_content_docs_de_http_overview_http_module"