{"nodes": [{"id": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "label": "From Akka (JVM)", "file_type": "document", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_jvm_concept_mapping", "label": "Akka to actor-ts concept mapping", "file_type": "concept", "rationale": "Most concepts map 1:1 and many APIs are named identically; the differences are that TypeScript needs explicit message types where Akka used Any, sender() becomes an explicit replyTo ref or this.sender, and Scala pattern matching becomes ts-pattern.", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_jvm_sharding_translation", "label": "Akka sharding translation", "file_type": "concept", "rationale": "extractShardId is DERIVED from extractEntityId + numShards (shardId = hash(entityId) % numShards), so there is no separate function, and ClusterShardingSettings becomes inline start() options.", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_jvm_persistentactor_translation", "label": "Akka PersistentActor translation", "file_type": "concept", "rationale": "One onEvent replaces the split receiveCommand / receiveRecover and runs at both persist and recovery; the persist callback takes the new state rather than the event; and Akka's stateful var becomes an explicit State type parameter.", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_jvm_singleton_translation", "label": "Akka Cluster Singleton translation", "file_type": "concept", "rationale": "Same model with less ceremony: the actor declares its own identity as a static SingletonKey and start returns the proxy ActorRef directly rather than a handle to unwrap. There is no terminationMessage equivalent \u2014 a node leaving rotation stops its child through the normal postStop path.", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_jvm_akka_streams_missing", "label": "Akka Streams is not ported", "file_type": "rationale", "rationale": "No Akka Streams port \u2014 use Promise-based patterns or a separate streams library. Akka HTTP's typed route DSL and Persistence Query's reactive Stream API also have only simpler analogues (a plain route DSL, PersistenceQuery as AsyncIterable).", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_migration_from_akka_jvm_migration_approach", "label": "Incremental Akka migration approach", "file_type": "concept", "rationale": "Do not rewrite everything at once: run actor-ts in a new service fronting the Akka system over HTTP/gRPC, migrate one bounded context at a time, and re-export persistence carefully \u2014 Jackson-written JSON events read into actor-ts with an EventAdapter.", "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_migration_from_akka_jvm_concept_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_migration_from_akka_jvm_sharding_translation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_migration_from_akka_jvm_persistentactor_translation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_migration_from_akka_jvm_singleton_translation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_migration_from_akka_jvm_akka_streams_missing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_migration_from_akka_jvm_migration_approach", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/migration/from-akka-jvm.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_migration_from_akka_jvm_from_akka_jvm", "target": "docs_src_content_docs_intro_quickstart_quickstart", "relation": "references", "confidence": "EXTRACTED", 