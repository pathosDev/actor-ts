{"nodes": [{"id": "docs_src_content_docs_de_routing_router_factories", "label": "Router-Factories", "file_type": "concept", "rationale": "Fuenf One-Shot-Factories (roundRobin, random, broadcast, smallestMailbox, custom) geben eine ActorFactory<TMessage | Broadcast<TMessage>> zurueck, die wie jeder andere Actor gespawnt wird; der Typ-Parameter des Routees fliesst durch.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_routing_router_routeractor", "label": "RouterActor", "file_type": "concept", "rationale": "Zur Spawn-Zeit erstellt die Runtime eine RouterActor-Instanz am angegebenen Pfad, spawnt in preStart size Kinder namens routee-1..N und watcht jedes.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_routing_router_broadcast_wrapper", "label": "Broadcast<T>-Wrapper", "file_type": "concept", "rationale": "Wickelt eine Payload; der Router packt sie aus, ignoriert die Strategie und sendet die innere Nachricht an JEDEN Routee \u2014 fuer gelegentliche Fan-Out-Nachrichten, die nicht ins Routine-Routing passen.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_routing_router_size_zero", "label": "size = 0 ist ein Bug", "file_type": "rationale", "rationale": "Ein Pool mit null Routees gibt ein leeres Iterable zurueck, jedes tell wird still verworfen \u2014 kein Dead-Letter-Routing. Das Framework validiert size > 0 nicht; die Verantwortung liegt beim Aufrufer.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_routing_router_original_sender", "label": "Original-Sender bleibt erhalten", "file_type": "rationale", "rationale": "this.sender innerhalb des Routees ist der urspruengliche Aufrufer, nicht der Router \u2014 Design, denn der Routee soll von einem nicht gerouteten Actor nicht zu unterscheiden sein.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_routing_router_broadcast_replyto", "label": "Broadcast-Router plus Reply-to-Ref", "file_type": "concept", "rationale": "Die Broadcast-Strategie faechert die ROHE Nachricht aus, inklusive jeder Reply-to-Ref darin: jeder Routee antwortet, der Aufrufer sieht N Responses. Manchmal gewollt (replizierte Reads mit Quorum), meist ein Bug.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_routing_router_gestoppter_routee_bleibt", "label": "Ein gestoppter Routee bleibt im Pool", "file_type": "concept", "rationale": "Der Router entfernt eine tote Ref nie: Round-Robin teilt ihr weiterhin etwa jede N-te Nachricht zu, die bis zum Neustart des ganzen Routers in Dead Letters landet. Fuer selbstheilende Pools den Routee in eine bei Stop restartende Strategie oder den ganzen Pool in einen BackoffSupervisor wickeln.", "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_routing_router_factories", "target": "docs_src_content_docs_de_routing_router_routeractor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_factories", "target": "docs_src_content_docs_de_routing_router_broadcast_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_broadcast_wrapper", "target": "docs_src_content_docs_de_reference_glossary_broadcast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_broadcast_wrapper", "target": "docs_src_content_docs_de_routing_router_broadcast_replyto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_factories", "target": "docs_src_content_docs_de_routing_strategies_routingstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_factories", "target": "docs_src_content_docs_de_routing_scatter_gather_scattergatherfirstcompleted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_size_zero", "target": "docs_src_content_docs_de_routing_strategies_routingstrategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/routing/router.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_routing_router_gestoppter_routee_bleibt", "target": 