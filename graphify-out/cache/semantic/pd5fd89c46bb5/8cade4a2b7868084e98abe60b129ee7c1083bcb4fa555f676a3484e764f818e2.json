{"nodes": [{"id": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcher", "label": "eventDispatcher", "file_type": "concept", "rationale": "Typisierter Builder fuer PersistentActor.onEvent. Der Dispatcher ist ein reiner Wert - isoliert unit-testbar ohne Actor-Instanz.", "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcherbuilder", "label": "EventDispatcherBuilder<S, E, Handled>", "file_type": "concept", "rationale": "Der Typ-Parameter Handled verfolgt, welche Event-Arten bereits registriert sind; build() type-checkt nur, wenn jede Variante von E['kind'] abgedeckt ist.", "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcherincomplete", "label": "EventDispatcherIncomplete", "file_type": "concept", "rationale": "Der nicht-aufrufbare Rueckgabetyp bei unvollstaendiger Abdeckung. Das __unhandled-Phantom-Feld traegt die fehlende Art, damit die Fehlermeldung sie nennt und der Fix mechanisch wird.", "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_event_dispatcher_compile_time_exhaustiveness", "label": "Erschoepfungspruefung zur Compile-Zeit", "file_type": "rationale", "rationale": "Ein plain switch faellt fuer unbekannte Arten zu return state durch - das Event wird still ignoriert und das Replay produziert falschen State. assertNever wuerde es fangen, ist aber manuell und leicht zu vergessen; ts-patterns .exhaustive() ist ein Laufzeit-Check. eventDispatcher macht den Check ausschliesslich zur Compile-Zeit.", "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_event_dispatcher_pure_onevent", "label": "onEvent ist rein", "file_type": "rationale", "rationale": "onEvent laeuft bei jeder Recovery; Seiteneffekte darin duplizieren pro Neustart. Sie gehoeren in den persist-Callback in onCommand.", "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcher", "target": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcherbuilder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcherbuilder", "target": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcherincomplete", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_event_dispatcher_compile_time_exhaustiveness", "target": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcher", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/event-dispatcher.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_event_dispatcher_pure_onevent", "target": "docs_src_content_docs_de_persistence_event_dispatcher_eventdispatcher", "relation": "rationale_for", "conf