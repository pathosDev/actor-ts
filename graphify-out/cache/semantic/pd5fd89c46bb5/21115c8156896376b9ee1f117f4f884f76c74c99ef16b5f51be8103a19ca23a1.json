{"nodes": [{"id": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_decision_tree", "label": "CRDT-Entscheidungsbaum", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "rationale": "Der falsche Typ produziert korrekte Merges falscher Werte. Die Entscheidung frueh fixieren: ein spaeterer Typwechsel BRAUCHT eine Migration, weil das Wire-Format je Typ unterschiedlich und gespeicherte Daten nicht kompatibel sind.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_designing_data_common_shapes", "label": "Gaengige Datenformen", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "rationale": "Presence als ORSet (zweiter Tab gewinnt gegen das Disconnect des ersten), Klicks pro Seite als GCounterMap, Praeferenzen als LWWMap (feingranular: ORMap ueber LWWMap pro Feld), Warenkorb als ORMap<UserId, ORSet<ItemId>>, aktive Sessions als PNCounter. Ein taeglich zuruecksetzender Zaehler ist KEIN CRDT-Fall \u2014 GCounter weiterlaufen lassen und den Tagesstart in einem LWWRegister abziehen.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_limits", "label": "Was CRDTs nicht tun", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "rationale": "CRDTs sind PRO KEY atomar \u2014 Cross-Key-Transaktionen brauchen ein anderes Werkzeug (event-sourced Actor mit Saga, DB mit Multi-Row-Transaktionen). Geordnete Listen (RGA, LSEQ) liefert actor-ts nicht; fuer ein geordnetes Append-only-Log ist das Journal eines PersistentActor die Ordnung. Strikte Serialisierbarkeit gibt kein CRDT. Und die Serialisierung hat keine erstklassige Versionierung, Schema-Aenderungen sind eine manuelle Rolling-Uebung.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_designing_data_when_not_distributeddata", "label": "Wann DistributedData gar nicht passt", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "rationale": "Hohe Key-Kardinalitaet (10M Sessions x N Nodes) gehoert ins Sharding; grosse Werte gehoeren extern mit repliziertem Pointer; haeufige Writes aus EINER Quelle zahlen Gossip-Kosten ohne Nutzen (lokaler PersistentActor); Isolationslevel gibt es nicht.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_distributed_data_crdt_types_designing_data_composition_patterns", "label": "Kompositions-Muster", "file_type": "rationale", "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "rationale": "Pro Blatt das CRDT nach seiner Semantik waehlen und unter ORMap schachteln (der flexibelste Container). Bei homogenen Strukturen lesen sich mehrere Top-Level-Maps oft klarer \u2014 Trade-off: Komposition gibt atomare Per-Tenant-Operationen, getrennte Maps geben einfachere Typen, aber Inkonsistenz zwischen den Maps ist moeglich.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_decision_tree", "target": "docs_src_content_docs_distributed_data_crdt_types_counters_gcounter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_decision_tree", "target": "docs_src_content_docs_distributed_data_crdt_types_sets_orset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_decision_tree", "target": "docs_src_content_docs_distributed_data_crdt_types_registers_lwwregister", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_decision_tree", "target": "docs_src_content_docs_distributed_data_crdt_types_maps_ormap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_common_shapes", "target": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_decision_tree", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_composition_patterns", "target": "docs_src_content_docs_distributed_data_crdt_types_maps_ormap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_crdt_limits", "target": "docs_src_content_docs_distributed_data_overview_crdt", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_distributed_data_crdt_types_designing_data_when_not_distributeddata", "target": "docs_src_content_docs_distributed_data_overview_distributeddata", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/distributed-data/crdt-types/designing-data.mdx", "source_location": null, "weight": 1.0}], "hyperedges": []}