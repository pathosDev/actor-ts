{"nodes": [{"id": "docs_src_content_docs_fundamentals_receive_timeout_receivetimeout", "label": "ReceiveTimeout", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires when the inbox is silent, not on a fixed schedule \u2014 a singleton delivered through the normal user path, so identity comparison is reliable and a backed-up mailbox can delay it."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "label": "context.setReceiveTimeout", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every user message resets the timer and the timeout re-arms after each delivery, so an actor that ignores it keeps receiving one every interval; 0 is equivalent to cancelling. A restart clears it."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_sessionexpiry", "label": "Session expiry pattern", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_passivation", "label": "Receive-timeout-driven passivation", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An idle entity signals its region to passivate it, freeing memory; a new message for the same entity id re-spawns it from persisted state."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_watchdog", "label": "Downstream-silence watchdog", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The receive timeout is the absence of traffic \u2014 it fires precisely when there is nothing else to react to."}, {"id": "docs_src_content_docs_fundamentals_receive_timeout_usermessageonlyreset", "label": "Only user messages reset the timer", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stream of system messages does not keep the actor looking busy, and a quiet actor receiving a PoisonPill gets no last receive timeout before stopping."}], "edges": [{"source": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "target": "docs_src_content_docs_fundamentals_become_and_stash_become", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_receivetimeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_sessionexpiry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/receive-timeout.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_receive_timeout_setreceivetimeout", "target": "docs_src_content_docs_fundamentals_receive_timeout_passivation", "rela