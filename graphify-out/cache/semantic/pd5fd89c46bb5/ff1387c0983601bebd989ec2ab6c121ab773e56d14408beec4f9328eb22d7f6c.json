{"nodes": [{"id": "docs_src_content_docs_de_operations_dead_letters_dead_letter", "label": "Dead Letter", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Nachricht, die das System nicht zustellen konnte - ein tell an eine gestoppte Ref, eine ins Leere laufende Selection, ein unhandled, ein Singleton ohne Host. Nichts ist aus Versehen verloren gegangen."}, {"id": "docs_src_content_docs_de_operations_dead_letters_standardverhalten", "label": "Standardverhalten: nur auf dem Event-Stream veroeffentlicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Framework loggt Dead Letters nicht; DeadLetterRef haelt keinen Logger, und wenn niemand den Stream abonniert, ist das Letter weg - fuer einen Entwicklungslauf in Ordnung, als Antwort auf was-haben-wir-waehrend-des-Vorfalls-verworfen schlecht."}, {"id": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "label": "system.deadLetterQueue", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existiert immer und bewahrt standardmaessig nichts auf; jedes Letter nennt seinen Empfaenger - den Actor, den die Nachricht nicht erreicht hat, nicht das Dead-Letter-Buero."}, {"id": "docs_src_content_docs_de_operations_dead_letters_store_modi", "label": "Vier Stores: off / metrics / memory / persistent", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Achse - wie viel vom Letter aufbewahrt wird; nur persistent uebersteht einen Neustart."}, {"id": "docs_src_content_docs_de_operations_dead_letters_store_metrics_rationale", "label": "Warum es den Store metrics gibt", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Payload aufzubewahren ist eine andere Entscheidung, als eine Rate zu beobachten: ein Ring haelt eine starke Referenz auf jede unzustellbare Nachricht - eine Datenschutzfrage, sobald eine Payload etwas ueber eine Person aussagt; ein Counter nicht. Mit einem winzigen Ring laesst sich das nicht annaehern, weil max-entries positiv sein muss."}, {"id": "docs_src_content_docs_de_operations_dead_letters_deadletterqueueoptions", "label": "DeadLetterQueueOptions / withDeadLetters", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der einzige Weg, die Queue zu konfigurieren, die das System benutzt: es gibt einen Sink-Slot, und den besitzt das System. Vorrang feldweise - explizite Options schlagen HOCON schlagen Defaults."}, {"id": "docs_src_content_docs_de_operations_dead_letters_keys_entscheiden_was_aufbewahrt_wird", "label": "Jeder Key unter actor-ts.dead-letters entscheidet, was aufbewahrt wird", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kuenftige Logging- und Rate-Limiting-Stellschrauben werden auf dem Publish-Pfad gelesen und sitzen bewusst hinter dem Erfassen - eine Unterdrueckungseinstellung kann diese Aufzeichnung also nie still unvollstaendig machen."}, {"id": "docs_src_content_docs_de_operations_dead_letters_list", "label": "deadLetterQueue.list", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Liefert Eintraege neueste zuerst; alles wird awaited, weil eine persistent-Queue noch das Log eines vorherigen Laufs zurueckliest. recipient trifft einen Pfad oder seinen Teilbaum."}, {"id": "docs_src_content_docs_de_operations_dead_letters_replay", "label": "deadLetterQueue.replay", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loest den Empfaengerpfad neu auf, statt eine zum Fehlerzeitpunkt festgehaltene Ref wiederzuverwenden - der ganze Sinn ist, dass der Actor inzwischen unter derselben Adresse als neue Instanz zurueck ist. Jeder Ausgang hat einen Namen, damit nichts still scheitert."}, {"id": "docs_src_content_docs_de_operations_dead_letters_alternativer_empfaenger", "label": "Replay an einen anderen Empfaenger", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nur das Ziel aendert sich, der Sender bleibt der aufgezeichnete; der aufgezeichnete Pfad wird gar nicht aufgeloest, weil eine Umleitung genau dann am nuetzlichsten ist, wenn die urspruengliche Adresse endgueltig weg ist."}, {"id": "docs_src_content_docs_de_operations_dead_letters_maxreplays_quarantaene", "label": "max-replays und Quarantaene", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine erneut zugestellte Nachricht, die wieder im Dead Letter landet, kommt als derselbe Eintrag mit hoeherem replayCount zurueck - sonst fuegte jeder Versuch einen Eintrag hinzu, waehrend jeder wie ein erster aussaehe. Die Schranke gilt pro Letter, nicht pro Empfaenger, sonst gaebe abwechselndes Zustellen an zwei Pfade die unbegrenzte Schleife zurueck."}, {"id": "docs_src_content_docs_de_operations_dead_letters_degraded_payload", "label": "degraded payload", "file_type": "concept", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Tagged-JSON-Encoder verweigert Funktionen, Symbols, Promise, Weak-Collections und Zyklen, statt sie still zu beschaedigen - eine persistent-Queue bewahrt die Herkunft auf, statt das Letter zu verlieren; erneut zustellen laesst sich so ein Eintrag nicht."}, {"id": "docs_src_content_docs_de_operations_dead_letters_dauerhaftigkeit", "label": "Dauerhaftigkeit ueber ein geordnetes Herunterfahren", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Stream wird aus dem Systemnamen abgeleitet; Schreibvorgaenge werden beim Eintreffen ausgeloest und beim Herunterfahren zweimal abgeschlossen, weil das Herunterfahren selbst noch Dead Letters erzeugt. Ein harter Kill verliert den ganzen Rueckstau, weil tell synchron ist und Appends abschicken-und-vergessen in eine serialisierte Kette gehen."}, {"id": "docs_src_content_docs_de_operations_dead_letters_kein_transaktionaler_outbox", "label": "Die Queue ist eine Diagnoseaufzeichnung, kein transaktionaler Outbox", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Muss ein Letter einen unkontrollierten Stopp ueberleben, gehoert der Journal-Schreibvorgang auf den Sendepfad - ein anderer Entwurf."}, {"id": "docs_src_content_docs_de_operations_dead_letters_was_die_queue_nicht_sieht", "label": "Was die Queue nicht sieht: Mailbox-Drops", "file_type": "rationale", "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Drop-Meldung einer Bounded- oder Priority-Mailbox traegt einen Grund und niemals den Envelope, es gibt also nichts zu erfassen - der Ueberlauf taucht nur in actor_mailbox_dropped_total auf."}], "edges": [{"source": "docs_src_content_docs_de_operations_dead_letters_standardverhalten", "target": "docs_src_content_docs_de_operations_dead_letters_dead_letter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "target": "docs_src_content_docs_de_operations_dead_letters_dead_letter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "target": "docs_src_content_docs_de_operations_dead_letters_store_modi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_store_metrics_rationale", "target": "docs_src_content_docs_de_operations_dead_letters_store_modi", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_deadletterqueueoptions", "target": "docs_src_content_docs_de_operations_dead_letters_store_modi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_keys_entscheiden_was_aufbewahrt_wird", "target": "docs_src_content_docs_de_operations_dead_letters_deadletterqueueoptions", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_list", "target": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_replay", "target": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_alternativer_empfaenger", "target": "docs_src_content_docs_de_operations_dead_letters_replay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_maxreplays_quarantaene", "target": "docs_src_content_docs_de_operations_dead_letters_replay", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_degraded_payload", "target": "docs_src_content_docs_de_operations_dead_letters_list", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_degraded_payload", "target": "docs_src_content_docs_de_operations_dead_letters_dauerhaftigkeit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_kein_transaktionaler_outbox", "target": "docs_src_content_docs_de_operations_dead_letters_dauerhaftigkeit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_was_die_queue_nicht_sieht", "target": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_was_die_queue_nicht_sieht", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_actor_mailbox_dropped_total", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_was_die_queue_nicht_sieht", "target": "docs_src_content_docs_de_operations_tuning_mailbox_sizing_overflow_policies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "target": "docs_src_content_docs_de_observability_metrics_stock_metrics_actor_dead_letters_total", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_deadletterqueue", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_dauerhaftigkeit", "target": "docs_src_content_docs_de_operations_troubleshooting_shutdown_verwarf_nachrichten", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_de_operations_dead_letters_store_metrics_rationale", "target": "docs_src_content_docs_de_observability_devtools_dead_letters_payload_sind_deine_daten", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/content/docs/de/operations/dead-letters.mdx", "source_location": null, "weight": 1}], "hyperedges": []}