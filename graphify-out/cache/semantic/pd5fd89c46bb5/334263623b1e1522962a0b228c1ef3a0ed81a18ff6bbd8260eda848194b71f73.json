{"nodes": [{"id": "docs_src_content_docs_de_persistence_persistence_query_persistencequery", "label": "PersistenceQuery (Read-Side-API)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zwei Varianten: current* liest einmal in ein materialisiertes Array, events* ist ein Live-Stream, der pollt bis der Konsument stoppt."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_inmemoryquery", "label": "InMemoryQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Referenzimplementierung, nicht die Nur-fuer-In-Memory-Variante: funktioniert gegen jedes Journal. Was fehlt, ist der Index - currentEventsByTag listet jede pid auf, spielt sie ab Sequenz 1 neu ab und filtert im Prozess, das ganze Journal pro Aufruf."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_sqlitequery", "label": "SqliteQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_postgresquery", "label": "PostgresQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_mariadbquery", "label": "MariaDbQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_cassandraquery", "label": "CassandraQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_mongoquery", "label": "MongoQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_relationalquery", "label": "RelationalQuery", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die dialektneutrale Basis, von der SqliteQuery und PostgresQuery benannte Subklassen sind."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_offset", "label": "Offset (timestamp, persistenceId, sequenceNr)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compound-Reihenfolge: Events verschiedener Entities werden nach Timestamp verschachtelt, Events derselben Entity bleiben in ihrer Sequenz."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_tagfilter", "label": "TagFilter (any / all)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_eventsbytag", "label": "eventsByTag (Live-Stream)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_currenteventsbytag", "label": "currentEventsByTag (One-Shot)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_allpersistenceids", "label": "allPersistenceIds (Fan-out-Primitiv)", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emittiert einmal pro Stream, nicht einmal pro Journal - ein Konsument, der ueber einen Neustart nicht zweimal handeln darf, braucht einen eigenen Checkpoint. Der Stream haelt ein In-Process-Set jeder emittierten Id; eine billigere High-Water-Mark waere falsch, weil Ids nicht in sortierter Reihenfolge entstehen."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_currentpersistenceidspaginated", "label": "currentPersistenceIdsPaginated", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Cursor ist eine Persistence-Id, kein undurchsichtiges Token - ein abgebrochener Durchlauf setzt mit afterPersistenceId fort. Die Ordnung des Backends spielt fuer den Konsumenten nie eine Rolle, weil der Cursor in genau derselben Ordnung verglichen wird."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_livequeryoptions", "label": "LiveQueryOptions (pollIntervalMs)", "file_type": "concept", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_persistence_persistence_query_compaction_leaves_the_tag_index", "label": "Ein kompaktiertes Event verlaesst auch den Tag-Index", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "delete ist gegen die Read-Seite genauso spezifiziert wie gegen read. Backends mit Index auf dem Event-Datensatz bekommen das geschenkt; die mit separater Struktur loeschen daraus im selben Aufruf und VOR den Events, damit ein Crash mitten im Delete keine Zeilen zurueck laesst, deren Schluessel sich nicht rekonstruieren lassen."}, {"id": "docs_src_content_docs_de_persistence_persistence_query_no_warning_on_suboptimal_pairing", "label": "Ein Journal mit InMemoryQuery zu paaren warnt nicht", "file_type": "rationale", "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Ergebnisse sind identisch, nur die Last verraet es - hat das Backend eine eigene Query-Klasse, nutze sie."}], "edges": [{"source": "docs_src_content_docs_de_persistence_persistence_query_inmemoryquery", "target": "docs_src_content_docs_de_persistence_persistence_query_persistencequery", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/persistence-query.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_persistence_persistence_query_sqlitequery", "target": "docs_src_content_docs_de_persistence_persistence_query_persistencequery", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/persistence/persistence