{"nodes": [{"id": "docs_src_content_docs_de_cluster_sharding_overview_cluster_sharding", "label": "Cluster-Sharding", "file_type": "document", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Actor pro Entity-Key, verteilt \u00fcber Cluster-Nodes: Entity-ID extrahieren, auf einen Shard hashen, der Koordinator entscheidet den Host, die lokale Region routet."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_region", "label": "Region-Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine pro Node; sie entscheidet \u00fcber Passivierung, weil nur sie den Verkehr \u00fcber alle Shards des Nodes sieht \u2014 deshalb ist maxEntities eine Obergrenze pro Node."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_shard", "label": "Shard-Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_coordinator", "label": "Sharding-Koordinator", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Einer pro Cluster, Singleton auf dem Leader."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_entity", "label": "Entity-Actor", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_shardkey", "label": "ShardKey", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Identit\u00e4t ist allein der typeName; der Extractor reitet mit, damit die deklarierende Klasse die einzige Wahrheitsquelle ist."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_numshards_agreement", "label": "numShards ist eine clusterweite Vereinbarung", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zwei Nodes mit unterschiedlichen Werten legen dieselbe Entity-ID in unterschiedliche Shards und betreiben beide eine lebende Instanz unter Pfaden, die nie kollidieren \u2014 bei einer persistenten Entity zwei Schreiber auf einer persistenceId. Der Koordinator verweigert deshalb eine nicht \u00fcbereinstimmende Region; das Urteil kommt als Log-Zeile, weil Registrierung asynchron ist."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_coordinatorstatestore", "label": "coordinatorStateStore mit gestempeltem Snapshot", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ohne Stempel und Verweigerungspr\u00fcfung setzte der Ladepfad verweigerte Regionen zur\u00fcck in den Platzierungs-Pool \u2014 ein Rolling Deploy h\u00e4tte das Split-Routing \u00fcber den Snapshot wiederhergestellt statt \u00fcber den Registrierungs-Handshake."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_passivation", "label": "Passivierung", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Region puffert Nachrichten w\u00e4hrend des Stoppens und spielt sie an die frische Inkarnation zur\u00fcck; In-Memory-State \u00fcbersteht das nicht."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_shard_passivation", "label": "Shards passivieren ebenfalls", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Region beh\u00e4lt die Ownership \u2014 nur der Actor geht \u2014, der Shard bleibt also routbar und die n\u00e4chste Nachricht erstellt Shard und Entity gemeinsam neu, ohne Umweg \u00fcber den Koordinator."}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_entity_identity", "label": "Entity-Identit\u00e4t (this.entityId / this.entity)", "file_type": "concept", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_sharding_overview_entity_name_escaping", "label": "Injektive Maskierung des Entity-Namens", "file_type": "rationale", "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein geteilter Name w\u00fcrde die zweite Entity unter einem vergebenen Namen starten lassen, und der Fehler rei\u00dft den Shard mitsamt allen Entities darin mit. Der Pfad ist ein Etikett, entityId ist der Wert."}], "edges": [{"source": "docs_src_content_docs_de_cluster_sharding_overview_cluster_sharding", "target": "docs_src_content_docs_de_cluster_sharding_overview_region", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/de/cluster/sharding/overview.mdx", "sourc