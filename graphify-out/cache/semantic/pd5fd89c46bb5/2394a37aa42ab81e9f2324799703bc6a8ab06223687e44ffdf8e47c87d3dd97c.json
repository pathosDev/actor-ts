{"nodes": [{"id": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "label": "DowningProvider", "file_type": "code", "rationale": "Ein winziges Interface: decide(view) liefert die Adressen, die zwangsweise herabgestuft werden; eine leere Menge heisst 'noch keine Entscheidung \u2014 abwarten'. Jedes Cluster-Event fuehrt den Provider mit der aktuellen Sicht erneut aus.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_keepmajority", "label": "KeepMajority", "file_type": "code", "rationale": "Der allgemeinste Default ohne externe Abhaengigkeiten, vorhersagbar bei ungeradem N; bei exaktem N/2-Split fahren beide Seiten herunter, und Mehrheit per Zaehlung ist blind fuer physische Topologie.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_keepoldest", "label": "KeepOldest", "file_type": "code", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_keepreferee", "label": "KeepReferee", "file_type": "code", "rationale": "Die vorhersagbarste Strategie und fuer jede Cluster-Groesse geeignet, aber der Schiedsrichter ist ein Single Point of Failure \u2014 faellt er aus, kann niemand entscheiden, wofuer downAllIfBelowQuorum existiert.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_staticquorum", "label": "StaticQuorum", "file_type": "code", "rationale": "Strenger als Mehrheit und bewusst fail-stop; erholt sich nicht automatisch, und weil das Quorum bei jeder Mitgliedschaftsaenderung geprueft wird, blockiert eine zu grosse Quorum-Groesse den Scale-Up.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_leasemajority", "label": "LeaseMajority", "file_type": "code", "rationale": "Mehrheit plus eine Koordinations-Lease \u2014 doppelte Sicherheit fuer unberechenbare Netze, hilft aber nicht, wenn der Lease-Provider selbst weg-partitioniert ist.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_clusterpartitionview", "label": "ClusterPartitionView", "file_type": "code", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_oldest_is_lowest_address", "label": "Aeltestes heisst niedrigste Adresse, nicht laengste Laufzeit", "file_type": "rationale", "rationale": "Im Gossip-Payload reist keine monoton wachsende Join-Sequenz mit, also sortiert die Strategie nach host:port wie Cluster.leader(); wer sie waehlt, will einen deterministischen uebereinstimmenden Tiebreaker und muss dafuer sorgen, dass die ueberlebende Node die niedrigste Adresse hat.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_abandoned_acquire", "label": "Aufgegebenes Acquire", "file_type": "rationale", "rationale": "Ein Acquire wird unerwuenscht durch Timeout oder eine weitergezogene Partitionssicht. Drei Regeln: das spaete Ergebnis wird per Epoch verworfen; ein spaeter Gewinn wird released und bis dahin startet nichts Neues, weil zwei ueberlappende Versuche das Aufraeumen eine gerade beanspruchte Lease loeschen liessen; und schlaegt das Release fehl, geht die Strategie in Fail-safe. Nichts zu entscheiden ist immer sicher, falsch zu entscheiden nicht.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_no_strategy_manual_ops", "label": "Keine Strategie bedeutet manuelle Operationen", "file_type": "rationale", "rationale": "Ohne Provider sieht der Cluster unreachable Mitglieder fuer immer und Operatoren muessen cluster.down() aufrufen \u2014 akzeptabel mit On-Call-Personen, nicht bei auto-skalierten unbeaufsichtigten Deployments.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_de_cluster_downing_strategies_strategy_selection", "label": "Eine Strategie auswaehlen", "file_type": "rationale", "rationale": "Drei Fragen in Reihenfolge: gerade oder ungerade Groesse, gibt es einen stabilen Tie-Breaker-Node, und ist Fail-Stop besser als ein moeglicher Falsche-Seite-Gewinn. Gerade Cluster ohne Tie-Breaker toetet jede Partition komplett.", "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_de_cluster_downing_strategies_keepmajority", "target": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_downing_strategies_keepoldest", "target": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_downing_strategies_keepreferee", "target": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_downing_strategies_staticquorum", "target": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_downing_strategies_leasemajority", "target": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_downing_strategies_downingprovider", "target": "docs_src_content_docs_de_cluster_downing_strategies_clusterpartitionview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/de/cluster/downing-strategies.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_de_cluster_downing_strategies_