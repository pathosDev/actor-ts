{"nodes": [{"id": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "label": "CachedSnapshotStore", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A decorator that wraps any SnapshotStore with a TTL read-through cache for loadLatest, backed by any Cache. Worth it only when the underlying store has measurable read latency - slow object storage, expensive decryption, high actor churn, recovery storms; for sub-millisecond SQLite reads it is pure overhead. The underlying store is the constructor's first argument, not an option."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstoreoptions", "label": "CachedSnapshotStoreOptions", "file_type": "concept", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cache (required, typically Redis), ttlMs (default 5 minutes) and keyPrefix (default 'snap:') which prevents collisions in shared caches."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_writethroughinvalidate", "label": "save is write-through-with-invalidate", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Cache semantics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It delegates then DELETES the cache entry rather than writing the new snapshot back: in a cluster two nodes may race on save, and a local write would leave a stale entry. The next read repopulates, and the TTL is the safety net if a node crashes between the underlying write and the invalidation."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_loadbeforenotcached", "label": "loadBefore is deliberately not cached", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Cache semantics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Too many possible seq values, and it is used rarely - only during recovery."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_sharedcacheacrossnodes", "label": "Sharing the cache across nodes", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Performance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backed by Redis or Memcached every node reads the same cache, so a snapshot loaded on one node is a hit on all the others; an in-memory cache gives each node its own copy and a fresh node pays the full underlying-load cost."}, {"id": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cacheexternalmodifications", "label": "The cache assumes it is the only writer", "file_type": "rationale", "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Pitfalls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything else writing to the underlying store (a manual SQL update, a batch backfill) makes the cache return stale data - set a TTL or invalidate manually."}], "edges": [{"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstoreoptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_writethroughinvalidate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_loadbeforenotcached", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_sharedcacheacrossnodes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cacheexternalmodifications", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshots_snapshotstore", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "intro", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_sqlite_sqlitesnapshotstore", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## When you need it", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_persistence_snapshot_stores_in_memory_inmemorysnapshotstore", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Where to next", "weight": 1.0}, {"source": "docs_src_content_docs_persistence_snapshot_stores_cached_snapshot_store_cachedsnapshotstore", "target": "docs_src_content_docs_routing_strategies_clustersmallestmailbox", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/src/content/docs/persistence/snapshot-stores/cached-snapshot-store.mdx", "source_location": "## Cache semantics", "weight": 1.0}], "hyperedges": []}