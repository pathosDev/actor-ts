{"nodes": [{"id": "docs_src_content_docs_fundamentals_become_and_stash_become", "label": "context.become", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swaps the function the framework calls on the next message, so the behavior is the state \u2014 no flag fields and no if-ladder. It does not touch instance fields, so state cleanup on the transition is the actor responsibility."}, {"id": "docs_src_content_docs_fundamentals_become_and_stash_stackedbehaviors", "label": "Stacked behaviors (discardOld=false) and unbecome", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The right tool for a transient sub-behavior that should restore a stable base behavior once done; for plain toggles the default replace form is cleaner."}, {"id": "docs_src_content_docs_fundamentals_become_and_stash_stash", "label": "context.stash", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parks the currently-handled message and must be called from inside a user-message handler; calling it elsewhere throws StashOutsideHandlerError."}, {"id": "docs_src_content_docs_fundamentals_become_and_stash_unstashall", "label": "unstashAll", "file_type": "concept", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FIFO replay \u2014 messages return in the order they were stashed, and on a PriorityMailbox they are re-inserted through the priority function so an unstashed message rejoins its tier rather than the absolute front."}, {"id": "docs_src_content_docs_fundamentals_become_and_stash_stashcapacity", "label": "Stash capacity bound (1024)", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded to prevent memory leaks from runaway stashing; overflow throws, which is why a stash-on-not-ready branch always needs a timeout beside it."}, {"id": "docs_src_content_docs_fundamentals_become_and_stash_initphasepattern", "label": "become + stash init-phase pattern", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The become makes the transition explicit while stash and unstashAll make sure no traffic is dropped during the initialization window."}, {"id": "docs_src_content_docs_fundamentals_become_and_stash_stashlostonrestart", "label": "The stash is lost on restart", "file_type": "rationale", "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The instance is thrown away with its buffer, and the new instance has none of the state that made those messages unhandleable \u2014 they go to dead letters so the loss is at least visible."}], "edges": [{"source": "docs_src_content_docs_fundamentals_become_and_stash_become", "target": "docs_src_content_docs_fundamentals_actor_actor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash_become", "target": "docs_src_content_docs_fundamentals_become_and_stash_stackedbehaviors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash_stash", "target": "docs_src_content_docs_fundamentals_become_and_stash_unstashall", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash_stash", "target": "docs_src_content_docs_fundamentals_become_and_stash_stashcapacity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash_initphasepattern", "target": "docs_src_content_docs_fundamentals_become_and_stash_become", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash_initphasepattern", "target": "docs_src_content_docs_fundamentals_become_and_stash_stash", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash_stashlostonrestart", "target": "docs_src_content_docs_fundamentals_become_and_stash_stash", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/src/content/docs/fundamentals/become-and-stash.mdx", "source_location": null, "weight": 1}, {"source": "docs_src_content_docs_fundamentals_become_and_stash