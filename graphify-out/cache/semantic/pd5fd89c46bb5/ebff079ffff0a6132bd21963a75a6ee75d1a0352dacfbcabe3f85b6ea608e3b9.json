{"nodes": [{"id": "docs_src_content_docs_cluster_worker_mesh_worker_mesh", "label": "Worker mesh", "file_type": "concept", "rationale": "JavaScript is single-threaded per actor system, so parallelism inside one OS process means several ActorSystems \u2014 one per worker thread \u2014 all joining the same cluster over a MessageChannel transport.", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_workercluster", "label": "WorkerCluster", "file_type": "code", "rationale": "Automates the manual wiring: spawns a pool from one entrypoint module, runs the hello/init/ready handshake, registers each worker with a shared broker, and restarts crashed workers per a restart policy.", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_workerclusteroptions", "label": "WorkerClusterOptions", "file_type": "code", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_workernode", "label": "WorkerNode", "file_type": "code", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_workerbroker", "label": "WorkerBroker", "file_type": "code", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_messagechanneltransport", "label": "MessageChannelTransport", "file_type": "code", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_star_topology", "label": "The mesh is a star, not a full mesh", "file_type": "rationale", "rationale": "One broker on the main thread holds a port per node and relays every frame, so N workers need N channels instead of binomial(N,2) \u2014 linear wiring at the price of making the main thread the relay for all cross-node traffic.", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_structured_clone", "label": "Structured clone instead of framing", "file_type": "rationale", "rationale": "postMessage between threads carries the same rich types (Map, Set, Date) that the TCP wire's tagged JSON tree carries, without the text round-trip.", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_top_level_await_hazard", "label": "Top-level await hangs the worker handshake", "file_type": "rationale", "rationale": "On Bun a top-level await in a worker suspends the module loader, so incoming messages never dispatch and WorkerNode.join() never completes; call it from inside an async main().", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_src_content_docs_cluster_worker_mesh_cpu_bound_only", "label": "Worker mesh only pays off for CPU-bound work", "file_type": "rationale", "rationale": "Most actor workloads are I/O-bound, where the wait is the bottleneck and threads do not help; and if multi-process works it is more flexible (different machines, different runtimes, standard tooling).", "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_src_content_docs_cluster_worker_mesh_worker_mesh", "target": "docs_src_content_docs_cluster_worker_mesh_workercluster", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_worker_mesh_workercluster", "target": "docs_src_content_docs_cluster_worker_mesh_workerclusteroptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_worker_mesh_workercluster", "target": "docs_src_content_docs_cluster_worker_mesh_workernode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_worker_mesh_workercluster", "target": "docs_src_content_docs_cluster_worker_mesh_workerbroker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_worker_mesh_star_topology", "target": "docs_src_content_docs_cluster_worker_mesh_workerbroker", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/content/docs/cluster/worker-mesh.mdx", "source_location": null, "weight": 1.0}, {"source": "docs_src_content_docs_cluster_worker_mesh_messagechanneltransport", "target": "docs_src_content_docs_cluster_worker_me