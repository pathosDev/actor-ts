{
  "name": "actor-ts",
  "version": "0.17.0",
  "description": "An actor-model framework for TypeScript — runs on Bun, Node.js and Deno",
  "author": "pathosDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathosDev/actor-ts.git"
  },
  "bugs": {
    "url": "https://github.com/pathosDev/actor-ts/issues"
  },
  "homepage": "https://actor-ts.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "default": "./dist/cache/index.js"
    },
    "./cluster": {
      "types": "./dist/cluster/index.d.ts",
      "import": "./dist/cluster/index.js",
      "default": "./dist/cluster/index.js"
    },
    "./coordination": {
      "types": "./dist/coordination/index.d.ts",
      "import": "./dist/coordination/index.js",
      "default": "./dist/coordination/index.js"
    },
    "./crdt": {
      "types": "./dist/crdt/index.d.ts",
      "import": "./dist/crdt/index.js",
      "default": "./dist/crdt/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.js",
      "default": "./dist/delivery/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js",
      "default": "./dist/devtools/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js",
      "default": "./dist/discovery/index.js"
    },
    "./fsm": {
      "types": "./dist/fsm/index.d.ts",
      "import": "./dist/fsm/index.js",
      "default": "./dist/fsm/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js",
      "default": "./dist/io/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js",
      "default": "./dist/logging/index.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "import": "./dist/management/index.js",
      "default": "./dist/management/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "default": "./dist/metrics/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js",
      "default": "./dist/persistence/index.js"
    },
    "./serialization": {
      "types": "./dist/serialization/index.d.ts",
      "import": "./dist/serialization/index.js",
      "default": "./dist/serialization/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js",
      "default": "./dist/testkit/index.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "import": "./dist/tracing/index.js",
      "default": "./dist/tracing/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "import": "./dist/util/index.js",
      "default": "./dist/util/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:ui && bunx tsc",
    "build:lib": "bunx tsc",
    "ui:install": "bun install --cwd devtools-ui",
    "build:ui": "bun scripts/build-devtools-ui.mjs",
    "check:ui": "bun scripts/build-devtools-ui.mjs --check",
    "check:doc-samples": "node scripts/check-doc-samples.mjs",
    "dev:devtools": "bun scripts/devtools-dev.ts",
    "watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "bunx tsc --noEmit && bun scripts/ui-toolchain.mjs --typecheck",
    "typecheck:ui": "bun scripts/ui-toolchain.mjs --typecheck",
    "typecheck:dev": "bunx tsc -p tsconfig.dev.json --noEmit",
    "typecheck:bench": "bunx tsc -p tsconfig.bench.json",
    "typecheck:compare": "bunx tsc -p benchmarks/comparison/tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:gate": "bun scripts/coverage-gate.mjs",
    "test:stress": "bun scripts/stress-test.mjs",
    "test:integration": "docker compose -f tests/integration/docker-compose.integration.yml up --build --abort-on-container-exit --exit-code-from controller",
    "test:integration:teardown": "docker compose -f tests/integration/docker-compose.integration.yml down -v --remove-orphans",
    "test:integration:broker": "bun scripts/integration-compose.mjs",
    "test:integration:broker:teardown": "bun scripts/integration-compose.mjs --down",
    "test:integration:brokers": "bun scripts/integration-compose.mjs --all",
    "test:integration:brokers:teardown": "bun scripts/integration-compose.mjs --all --down",
    "test:examples": "bun tests/examples/run-examples.mjs",
    "test:ui": "bun scripts/ui-toolchain.mjs --test",
    "smoke:bun": "bun tests/smoke/run-cases.mjs",
    "smoke:node": "bun run build:lib && ACTOR_TS_SMOKE_USE_DIST=1 node tests/smoke/run-cases.mjs",
    "smoke:deno": "bun run build:lib && ACTOR_TS_SMOKE_USE_DIST=1 deno run --allow-read --allow-env --allow-write --allow-net --allow-run tests/smoke/run-cases.mjs",
    "smoke": "bun run smoke:bun && bun run smoke:node && bun run smoke:deno",
    "lint:publint": "publint",
    "lint:types-exports": "attw --pack --profile esm-only",
    "lint:knip": "knip-bun --no-progress",
    "lint:package": "bun run build && bun run lint:publint && bun run lint:types-exports && bun run lint:knip",
    "lint:audit": "bun audit --audit-level=high",
    "bench": "bun run benchmarks/run-all.ts",
    "bench:smoke": "ACTOR_TS_BENCH_SMOKE=1 bun run benchmarks/run-all.ts",
    "bench:compare": "bun run benchmarks/comparison/run-comparison.ts",
    "bench:compare:smoke": "ACTOR_TS_BENCH_SMOKE=1 bun run benchmarks/comparison/run-comparison.ts",
    "bench:compare:report": "bun run benchmarks/comparison/report.ts",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun test && bun run test:ui"
  },
  "keywords": [
    "actor",
    "actor-model",
    "concurrency",
    "cluster",
    "typescript",
    "bun",
    "node",
    "deno"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@fastify/static": "^10.1.0",
