{
  "$comment": "Configuration for scripts/mutation-run.mjs (#1368). `ignore` drops mutants that are noise rather than findings; `maxTestsPerFile` caps a derived test list (--max-tests-per-file overrides it); `testMap` names a file's tests outright; `sets` names the bounded file lists a scheduled run mutates. String and template literals are never mutated at all — the lexer does not look inside them — so log, error and metric texts need no entry here.",
  "ignore": [
    {
      "operators": [
        "removed-call"
      ],
      "pattern": "\\b(?:log|logger)\\.(?:trace|debug|info|warn|error)\\(",
      "reason": "Removing a log statement changes no behaviour a test should bind; the message itself is a string and is never mutated."
    },
    {
      "operators": [
        "removed-call"
      ],
      "pattern": "\\bconsole\\.(?:log|info|warn|error|debug|trace)\\(",
      "reason": "Console output is diagnostics, not behaviour."
    },
    {
      "operators": [
        "removed-call"
      ],
      "pattern": "\\bthis\\._report\\(",
      "reason": "ActorCell's guarded wrapper around its logger (#1749). Removing it removes a log line and nothing else; the v0.19.0 Pv triage found four survivors that were exactly that."
    }
  ],
  "maxTestsPerFile": 25,
