# Runner image for the Microsoft SQL Server live-integration suite (#399).
#
# Identical shape to the other broker runners — installs deps from the shared
# tests/integration/brokers/package.json (which lists `mssql` as a regular
# dependency, mirroring a real end-user install), then runs the persistence
# contract against the live SQL Server service.
# See tests/integration/brokers/README.md for the package.json rationale.

FROM oven/bun:1.3-debian

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY tests/integration/brokers/package.json ./package.json
RUN bun install --no-progress --ignore-scripts

COPY tsconfig.json ./
COPY src/ src/
COPY tests/ tests/

ENV NODE_ENV=production

CMD ["bun", "tests/integration/brokers/mssql/runner.ts"]
