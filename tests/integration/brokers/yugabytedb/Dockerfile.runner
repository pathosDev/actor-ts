# Runner image for the YugabyteDB wire-compatibility suite (#401).
#
# Identical shape to the other broker runners.  Note it installs the SAME deps
# as every other suite from tests/integration/brokers/package.json — the only
# driver it needs is `pg`, because this suite exercises the existing Postgres
# stores against a different server rather than a new backend.

# Digest-pinned so the tree says which image a run used.  Dependabot moves the
# digest as 1.4.x is rebuilt; the minor moves with `.bun-version`, by hand —
# the policy is in tests/integration/Dockerfile.node.  #1597
FROM oven/bun:1.4-debian@sha256:4f6e31d1a54d6a3dd312daef655fc998101b5043d52e12592ac293ef04b9bc73

RUN apt-get update  && apt-get install -y --no-install-recommends ca-certificates curl  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY tests/integration/brokers/package.json ./package.json
RUN bun install --no-progress --ignore-scripts

COPY tsconfig.json ./
COPY src/ src/
COPY tests/ tests/

ENV NODE_ENV=production

CMD ["bun", "tests/integration/brokers/yugabytedb/Runner.ts"]
